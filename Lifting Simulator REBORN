------------------------------------------------------------------ MUSCLE READER (works in Conceal mode)
-- Conceal mode makes leaderstats.Muscle read 0 (it hides your stat from other players).
-- Your own HUD still shows the real number: PlayerGui.Main_Gui.DataMenu_Frame.Muscle.Status.Text  ("3.9M/5M" = muscle / storage)
-- so when leaderstats says 0 / is missing, the part before the "/" is read instead.
local MUSCLE_SUFFIXES = {
	"k", "m", "b", "t", "qa", "qi", "sx", "sp", "oc", "no", "dc", "ud", "dd", "td", "qad", "qid", "sxd", "spd", "ocd", "nod",
	"vg", "uvg", "dvg", "tvg", "qavg", "qivg", "sxvg", "spvg", "ocvg", "novg", "tg", "utg", "dtg", "ttg", "qatg", "qitg", "sxtg",
	"sptg", "octg", "notg",
}
local MUSCLE_MULT = {}
for i, nm in ipairs(MUSCLE_SUFFIXES) do MUSCLE_MULT[nm] = 10 ^ (3 * i) end
local function parseShortNumber(text)
	if type(text) ~= "string" then return nil end
	local clean = text:gsub("<[^>]->", ""):gsub("[%$,%s]", "")
	local num, suf = clean:match("^(%d*%.?%d+)(%a*)$")
	if not num then return nil end
	local mult = 1
	if suf ~= "" then
		mult = MUSCLE_MULT[suf:lower()]
		if not mult then return nil end
	end
	return tonumber(num) * mult
end
-- returns muscle (number or nil), and where it came from ("leaderstats" / "hud")
local function getMuscle()
	local ls = player:FindFirstChild("leaderstats")
	local mv = ls and ls:FindFirstChild("Muscle")
	local v = mv and tonumber(mv.Value)
	if v and v > 0 then return v, "leaderstats" end
	local ok, t = pcall(function() return player.PlayerGui.Main_Gui.DataMenu_Frame.Muscle.Status.Text end)
	if ok and type(t) == "string" then
		local cur = t:match("^%s*([^/]+)")
		local n = cur and parseShortNumber(cur)
		if n then return n, "hud" end
	end
	return v, "leaderstats"
end

