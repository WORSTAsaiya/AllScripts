			-- Plays a tween with its own style and direction.
			local function tw(obj, props, t, style, dir)
				TweenService:Create(obj, TweenInfo.new(t, style or Enum.EasingStyle.Quint, dir or Enum.EasingDirection.Out), props):Play()
