			task.wait(0.5)
			if gui.Parent ~= record.guiHome and record.guiHome and record.guiHome.Parent then pcall(function() gui.Parent = record.guiHome end) end
			if not gui.Enabled and not record.guiSuspended then gui.Enabled = true end
		end
	end)
