			local ROLE = { "DOING NOW", "UP NEXT", "THEN", "AFTER THAT", "LATER" }
			local ST = FX.Status
			-- status key -> { card title, glyph }
			local META = {
				lift = { "Auto Lift", "💪" }, sell = { "Auto Sell", "💰" }, sellfull = { "Auto Sell", "💰" },
				rejoin = { "Auto Rejoin", "🔄" }, reborn = { "Auto Reborn", "♻" }, sellon = { "Auto Enable Sell", "🔛" }, weight = { "Auto Buy Weight", "🏋" },
				dna = { "Auto Buy DNA", "🧬" }, alter = { "Auto Body Alter", "🔁" }, sweight = { "Smart Weight", "🧠" }, sdna = { "Smart DNA", "🧬" },
				kill = { "Auto Kill", "☠" }, tp = { "Teleport", "🚀" }, webhook = { "Webhook Logger", "📡" },
			}

			-- Formats seconds as a time text.
			local function fmt(sec)
				sec = math.max(0, math.ceil(sec))
				if sec >= 3600 then return string.format("%d:%02d:%02d", sec // 3600, (sec % 3600) // 60, sec % 60) end
				return string.format("%02d:%02d", sec // 60, sec % 60)
			end

			local stack = new("Frame", {
