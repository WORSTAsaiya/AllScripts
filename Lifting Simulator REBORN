			if tonumber(src) then return "rbxassetid://" .. src end
			if src:find("^rbxassetid://") or src:find("^rbxasset://") or src:find("^rbxthumb://") then return src end
			local id = src:match("roblox%.com/asset/?%?id=(%d+)")
