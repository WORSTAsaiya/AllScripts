				end
				if name then
					local low = tostring(name):lower()
					for _, e in ipairs(list) do if e.tool.Name:lower() == low then return e.tool, e.held end end
					for _, e in ipairs(list) do if e.tool.Name:lower():find(low, 1, true) or low:find(e.tool.Name:lower(), 1, true) then return e.tool, e.held end end
				end
				for _, e in ipairs(list) do if e.held then return e.tool, true end end   -- nothing matched by name: a weight already in your hand
				return nil
			end
			local function liveCheck()
				local f = FX.farm
				local name = f and f.topWeightName and f.topWeightName()
				local tool, held = findWeightTool(name)
