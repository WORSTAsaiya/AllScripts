			-- Builds the ordered list: working now first, then waiting (soonest timer first).
			local function build(now)
				local act, wt = {}, {}
				for i, key in ipairs(ST.order) do
					local txt = ST.text[key]
					if txt and not HIDE_FROM_HOME[key] then
						local at = ST.untilAt[key]
						local left = at and math.max(at - now, 0) or nil
						local it = { key = key, text = txt, left = left, i = i }
						if left ~= nil or txt:find("^Waiting") then wt[#wt + 1] = it else act[#act + 1] = it end
					end
				end
				table.sort(wt, function(a, b)
					local la, lb = a.left or math.huge, b.left or math.huge
					if la ~= lb and math.floor(la) ~= math.floor(lb) then return la < lb end
					return a.i < b.i
				end)
				local list, info = {}, {}
				for _, it in ipairs(act) do list[#list + 1] = it.key info[it.key] = it end
				for _, it in ipairs(wt) do list[#list + 1] = it.key info[it.key] = it end
