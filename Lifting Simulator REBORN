	------------------------------------------------------------ buying
	-- waits for the loop's generation; pause = seconds to wait after this round
	local function buyToggle(key, flag, statusKey, name, icon, desc, step)
		return {
			type = "toggle", name = name, icon = icon, default = false, desc = desc,
			callback = function(on)
				env[flag] = on == true
				if not on then Status.set(statusKey, nil) return end
				local my = newGen(key)
				task.spawn(function()
					while env[flag] and gens[key] == my do
						local pause = step(my)
						if not env[flag] or gens[key] ~= my then break end
						task.wait(pause or 1)
					end
					if gens[key] == my then Status.set(statusKey, nil) end
				end)
			end,
		}
	end

	-- polls fn() every 0.05s for up to `secs`; true as soon as it returns something truthy
	local function waitFor(fn, secs)
		local t0 = os.clock()
		while os.clock() - t0 < secs do
			if fn() then return true end
			task.wait(0.05)
		end
		return fn() and true or false
	end

	-- Body Alter (stage up) resets weights / DNA: the shop scan for them is dropped so it is read again.
	local lastStage = stageValue()
	local function syncStage()
		local s = stageValue()
		if s == nil then return end
		if lastStage ~= nil and s ~= lastStage then
			Shop.invalidate("weight")
			Shop.invalidate("dna")
			dbg("stage changed", tostring(lastStage), "->", tostring(s), "- weights / DNA are read from the shop again")
		end
		lastStage = s
	end
	Shop.init({ weight = WEIGHTS, dna = DNKS, alter = STAGES }, {
		stage = stageValue, num = dataNum, log = dbg, skip = skipRow,
		wanted = function() return env.BuyWeight or env.BuyDnk or env.BuyStage or env.SmartWeight or env.SmartDNA end,
	})
	local function heldTool()
		local ch = player.Character
		local t = ch and ch:FindFirstChildOfClass("Tool")
		return t and t.Name or "none"
	end

	-- The server gives the new weight tool but leaves your hands empty (seen in the spy log); the game's own Buy button re-equips it on the
	-- client. So: if a weight was in your hand before the buy, equip the new one once it arrives.
	local function equipAfterBuy(row, heldBefore)
		if heldBefore == "none" or heldBefore == "Fists" or heldBefore == "Stomp" then return end
		local want = row and row.ToolName
		local bp = player:FindFirstChildOfClass("Backpack")
		if not (want and bp) then return end
		if not waitFor(function() return bp:FindFirstChild(want) end, 2) then return end
		local ch = player.Character
		local hum = ch and ch:FindFirstChildOfClass("Humanoid")
		local tool = bp:FindFirstChild(want)
		if hum and tool and tool:IsA("Tool") then pcall(function() hum:EquipTool(tool) end) end
	end

	-- the three Auto Buy loops now buy through the shop UI (FX.ShopBuy). `info` = what the shop says: best owned + the next one for sale.
	local function shopInfo(kind, statusKey)
		local info = Shop.info(kind)
		if info then return info end
		Status.set(statusKey, "Reading the shop")
		local why
		info, why = Shop.refresh(kind)
		if not info then Status.set(statusKey, "Can't read the shop: " .. tostring(why)) return nil end
		return info
	end
	local function retryLater(reason) return reason == "stale" or reason == "notile" or reason == "busy" end

	local function autoWeight()
		syncStage()
		if env.SmartWeight then Status.set("weight", "Paused - Smart Weight is on") return 1 end
		if not WEIGHTS then Status.set("weight", "Can't read the weight list") return 3 end
		local info = shopInfo("weight", "weight")
		if not info then return 2 end
		if info.done then Status.set("weight", "Waiting - all weights owned") return 3 end
		local row, nextId = info.row, info.id
		if row.donate then Status.set("weight", "Waiting - the next weight is a Robux item") return 3 end
		local name, price, cash = tostring(row.Name), tonumber(row.Price), readCash()
		if price and cash and cash < price * 0.98 then
			Status.set("weight", "Waiting for enough coins for " .. name)
			return 0.3
		end
		Status.set("weight", "Buying " .. name)
		local heldBefore = heldTool()
		local ok, reason = Shop.buy("weight", nextId)
		dbg("BuyWeight (shop)", nextId, name, "->", tostring(ok), tostring(reason), "| in hand:", heldTool())
		if ok then
			task.spawn(equipAfterBuy, row, heldBefore)
			return 0.02
		end
		if retryLater(reason) then return 0.2 end
		Status.set("weight", "Can't buy " .. name .. " (" .. tostring(reason) .. ")")
		return 2
	end

