			local probing = false   -- (kept as a flag the update loop checks; the probe itself is gone)

			-- ------------------------------------------------ the update loop
			task.spawn(function()
				while alive and hero.Parent do
					local f = FX.farm
					if f then
						local now = os.clock()
						-- the next Body Alter (re-read every 2 s) gives the real stage number: stage = next - 1
						if now - altAt > 2 then
							altAt = now
							altN, altPrice = f.nextAlter()
						end
						-- stage, next body alter and best weight are checked every tick, so a change is seen within half a second.
						-- A part that can't be read right now (nil) is ignored, so a flickering read never counts as a change.
						local parts = { f.stage(), altN, f.topWeight() }
						local changed = false
							local weightFrom, weightTo
						for i = 1, 3 do
							local v = parts[i]
							if v ~= nil then
								local sv = tostring(v)
								if lastParts[i] ~= nil and lastParts[i] ~= sv then
										if i == 3 then weightFrom, weightTo = tonumber(lastParts[i]), tonumber(sv) else changed = true end
									end
								lastParts[i] = sv
							end
						end
						-- an event multiplier changed (x20 started / ended, or you typed a number): the gain per lift scales with it, no re-measure
						do
							local mm = FX.Events.muscle or 1
							if lastMuscleMult and mm ~= lastMuscleMult and lastMuscleMult > 0 and perLift then
								perLift = perLift * mm / lastMuscleMult
								perLiftTxt = fmt(perLift, 3)
							end
							lastMuscleMult = mm
						end
						-- a new weight needs no re-measure, no equip / lift / unequip: the gain per lift scales with the weight's own base gain
						if weightTo and not changed then
							local gOld, gNew = weightFrom and gainOfWeight(weightFrom), gainOfWeight(weightTo)
							if perLift and gOld and gNew and gOld > 0 then
								perLift = perLift * gNew / gOld
								perLiftTxt, perSrc = fmt(perLift, 3), "weight"
							else
								changed = true
							end
						end
						if changed then
							-- the old gain per lift is no longer true: the tiles show "..." until the new one is measured
							needMeasure, tries = true, 0
							perLift, perLiftTxt, perSrc = nil, nil, nil
							liveTries = 0
							if liveOn then liveQueued, liveDueAt = true, now + 0.6 end   -- short wait so the new weight tool has arrived in your backpack
						end
						-- next weight to buy (for the "time until next weight" tile)
						local w, why = f.nextWeight()
						nwName, nwPrice, nwDone = w and w.name, w and w.price, (w == nil and why == "done")
						nwIdx = w and w.idx
						-- Check Player Status [Live]: when switched on, right after a weight / stage change (equip, lift once, unequip), and every 2 minutes.
						-- A change that arrives while a check is running stays queued, and a check that couldn't find the tool is retried (up to 4 times).
						if liveOn and not liveBusy and (liveRequest or (liveQueued and now >= liveDueAt) or now - lastLive > 120) then
							liveBusy, liveRequest, liveQueued = true, false, false
							task.spawn(function()
								local ok, done = pcall(liveCheck)
								lastLive = os.clock()
								if not (ok and done) and liveTries < 4 then
									liveTries = liveTries + 1
									liveQueued, liveDueAt = true, os.clock() + 1.5
								end
								liveBusy = false
							end)
						end
						if page.Visible then
							local stage, maxStage = f.stage(), f.maxStage and f.maxStage()
							if type(stage) ~= "number" then stage = nil end
							valueLbl.stage.Text = stage and (tostring(stage) .. (maxStage and (" / " .. maxStage) or "")) or "--"
							valueLbl.reborn.Text = "Coming Soon?"   -- no reborn system in this game
							local lps, mode, running = f.liftRate()
							local gps = perLift and perLift * lps or nil
							valueLbl.lift.Text = perLiftTxt or "..."
							if gps then
								valueLbl.min.Text, valueLbl.hour.Text, valueLbl.day.Text = fmt(gps * 60), fmt(gps * 3600), fmt(gps * 86400)
							else
								valueLbl.min.Text, valueLbl.hour.Text, valueLbl.day.Text = "...", "...", "..."
							end
							-- time until the next weight: what you still miss (cash + muscle sold) divided by the income you really earn per second
							-- (measured over the last ~10 s; before that is known, the gain per lift x lifts per second). Updates live every half second.
							do
								local cash, muscle = f.cash(), muscleNow()
								local sellRate = f.sellRate()
								local tnow = os.clock()
								local have = (cash and muscle) and (cash + muscle * sellRate) or nil
								if have then
									local last = incHist[#incHist]
									-- start over after a gap (page was hidden), an x2 change, or a drop (a purchase)
									if last and (tnow - last[1] > 3 or sellRate ~= incRate or have < last[2] * 0.95) then incHist = {} end
									incRate = sellRate
									incHist[#incHist + 1] = { tnow, have }
									while #incHist > 2 and tnow - incHist[1][1] > 12 do table.remove(incHist, 1) end
								end
								local measured
								if #incHist >= 4 then
									local first, newest = incHist[1], incHist[#incHist]
									if newest[1] - first[1] >= 3 and newest[2] > first[2] then measured = (newest[2] - first[2]) / (newest[1] - first[1]) end
								end
								-- same income model as the Body Alter tile (gain per lift x lifts/s x sell rate); the noisy measured income is only a fallback
								local income = (gps and gps * sellRate) or measured or nil
								local txt = "--"
								local nwEta
								if nwDone then
									txt = "All weights owned"
								elseif nwPrice and have then
									if have >= nwPrice then txt = "Ready now" resetEta() nwDeadline = nil
									elseif income and income > 0 then
											-- steady countdown: fixed finish time that only drifts slowly toward each new estimate
											local newDl = tnow + (nwPrice - have) / income
											if not nwDeadline or nwFor ~= nwPrice then
												nwDeadline, nwFor = newDl, nwPrice
											else
												local remain = math.max(nwDeadline - tnow, 0)
												local diff = newDl - nwDeadline
												if math.abs(diff) > math.max(5, remain * 0.25) then
													nwDeadline = newDl
												else
													nwDeadline = nwDeadline + math.clamp(diff, -0.1, 0.1)
												end
											end
											nwEta = math.max(nwDeadline - tnow, 0)
											txt = durClock(nwEta)
									else txt = "..." end
								end
								valueLbl.nextw.Text = txt
								-- time until the next Body Alter; once every Body Alter is bought this tile is the (not yet existing) reborn.
								-- Needs Smart Weight: the estimate includes every weight it will buy on the way.
								local atReborn = stage ~= nil and maxStage ~= nil and stage >= maxStage and not altN   -- every Body Alter bought
								capLbl.nexta.Text = atReborn and "TIME UNTIL YOUR REBORN" or "TIME UNTIL NEXT BODY ALTER"
								local target = altPrice
								local rtxt = "..."
								if atReborn then
									rtxt = "Coming soon?"   -- no reborn system in this game
									resetReborn()
									rbDeadline = nil
								elseif not (f.smartWeightOn and f.smartWeightOn()) then
									rtxt = "Enable Smart Weight"
									resetReborn()
									rbDeadline = nil
								elseif have and perLift and gps and gps > 0 and target then
									local top, cap = f.topWeight(), f.weightCap()
									local gTop = top and gainOfWeight(top)
									if have >= target then
										rtxt = "Ready now"
										resetReborn()
										rbDeadline, rbFor, rbGood = nil, target, tnow
									elseif gTop and cap then
										local unit = (perLift / gTop) * lps * sellRate   -- coins per second per point of weight gain
										local ok, eta = pcall(simulateTarget, f, have, target, unit, top, cap)
										if ok and eta then
											-- steady countdown: a fixed finish time that only drifts slowly toward each new estimate
											-- (a big miss, or a new target = new stage, snaps to the new estimate)
											local newDl = tnow + eta
											if not rbDeadline or rbFor ~= target then
												rbDeadline, rbFor = newDl, target
											else
												local remain = math.max(rbDeadline - tnow, 0)
												local diff = newDl - rbDeadline
												if math.abs(diff) > math.max(5, remain * 0.25) then
													rbDeadline = newDl
												else
													rbDeadline = rbDeadline + math.clamp(diff, -0.1, 0.1)   -- max 0.1s per half second tick
												end
											end
											rbGood = tnow
										end
									end
								end
								-- a read that fails for a moment keeps showing the running countdown instead of "..."
								if rtxt == "..." and rbDeadline and rbFor == target and tnow - rbGood < 10 then
									rtxt = durClock(rbDeadline - tnow)
								end
								valueLbl.nexta.Text = rtxt
								-- if the Body Alter (or Reborn) comes before the next weight can be bought, that weight is the last one of this stage
								local aEta
								if rtxt == "Ready now" then aEta = 0
								elseif rbDeadline and rbFor == target and rtxt ~= "..." and rtxt ~= "Enable Smart Weight" and rtxt ~= "Calculating..." and rtxt ~= "Coming soon?" then aEta = rbDeadline - tnow end
								if nwPrice and not nwDone and ((nwEta and aEta and aEta < nwEta) or (nwIdx and f.weightCap() and nwIdx > f.weightCap())) then
									valueLbl.nextw.Text = "Max weight"
								end
							end
							live.Text = ("%.2f lifts/s - %s%s"):format(lps, mode, running and "" or " (Auto Lift off)")
							if not probing then
								local ok, msg = pcall(recommend, gps, stage ~= nil and maxStage ~= nil and stage >= maxStage)
								msg = ok and msg or "Measuring..."
								if not perLift then msg = msg .. "  (Gain per lift appears after your next sale while Auto Lift runs, or turn on Check Player Status [Live].)" end
								if liveMsg and os.clock() < liveMsgUntil then msg = liveMsg end
								recTxt.Text = msg
							end
						end
					end
					task.wait(0.5)
				end
			end)
		end

