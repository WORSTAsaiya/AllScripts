			-- countdown text: 45s, 12m 05s, 3h 20m, 2d 4h (changes every second instead of jumping between minutes)
			local function durClock(sec)
				if sec ~= sec or sec > 12960000 then return "Calculating..." end   -- NaN / about 5+ months: not a real estimate
				sec = math.max(0, math.ceil(sec))
				if sec < 60 then return sec .. "s" end
				if sec < 3600 then return string.format("%dm %02ds", math.floor(sec / 60), sec % 60) end
				if sec < 86400 then return string.format("%dh %02dm", math.floor(sec / 3600), math.floor((sec % 3600) / 60)) end
