				local wrap = new("CanvasGroup", {   -- wrapper fades (GroupTransparency); PAD keeps the card border from being clipped
					Size = UDim2.fromOffset(536 + PAD * 2, CARD_H + PAD * 2), BackgroundTransparency = 1, BorderSizePixel = 0, ZIndex = 2,
