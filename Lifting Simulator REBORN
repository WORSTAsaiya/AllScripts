	------------------------------------------------------------ SMART WEIGHT / SMART DNA
	local SMART_LIMITS = {
		["10% of next stage"] = 0.10, ["25% of next stage"] = 0.25, ["50% of next stage"] = 0.50, ["100% of next stage"] = 1.00,
	}
	local smartLimit = "25% of next stage"
	local DNA_MARGIN = 1.1            -- one full sale must cover the next stage's price + 10%
	local wFails, wBroken = 0, false  -- Smart Weight: the server refused an out-of-order buy N times / stop trying
	local dFails, dBroken = 0, false  -- same for Smart DNA
	local lastProbe = -math.huge      -- last time Smart DNA sold once just to measure the coin rate

	local function resetSkip() wFails, wBroken, dFails, dBroken = 0, false, 0, false end

	-- the same rules smartWeight() / smartDnk() use, so "Sell If Enough" only sells for what they will really buy
	SmartWants.weight = function(id, r)
		local stage = stageValue()
		local srow = stage and rowOf(STAGES, stage + 1)
		local sprice = srow and tonumber(srow.Price)
		local limit = sprice and sprice * (SMART_LIMITS[smartLimit] or 0.25) or math.huge
		return (tonumber(r.Price) or math.huge) <= limit
	end
	SmartWants.dna = function(id, r)
		local stage = stageValue()
		local srow = stage and rowOf(STAGES, stage + 1)
		local sprice = srow and tonumber(srow.Price)
		if not sprice then return false end   -- no stage left: Smart DNA has nothing to aim for
		local rate = sellRate()
		local needStorage = sprice * DNA_MARGIN / math.max(rate, 1e-9)
		local targetId, lastNormal
		for i = 1, countOf(DNKS) do
			local d = rowOf(DNKS, i)
			if d and not d.donate and not skipRow(d) then
				lastNormal = i
				if not targetId and (tonumber(d.Capacity) or 0) >= needStorage then targetId = i end
			end
		end
		targetId = targetId or lastNormal
		return targetId ~= nil and id <= targetId
	end

	------------------------------------------------------------ helpers the Home page "Player Status" card uses
	-- Everything is read from the same configs / data the buy loops use, so the card never opens the shop itself.
	local function weightRowSkipped(id)
		local r = rowOf(WEIGHTS, id)
		return (not r) or (r.donate and true or false) or skipRow(r)
	end
	local function maxStageNum() return STAGES and countOf(STAGES) or 0 end
	local GAIN_KEYS_PRINTED = false
	local function weightGain(id)   -- base muscle gain of a weight, from its config row (the first numeric field named like gain / power / muscle)
		local r = rowOf(WEIGHTS, id)
		if type(r) ~= "table" then return nil end
		if not GAIN_KEYS_PRINTED and id == 1 then
			GAIN_KEYS_PRINTED = true
			local keys = {}
			for k, v in pairs(r) do keys[#keys + 1] = tostring(k) .. "=" .. tostring(v) end
			table.sort(keys)
			dbg("weight #1 config fields:", table.concat(keys, ", "))
		end
		for _, pass in ipairs({ { "gain" }, { "power" }, { "muscle" } }) do
			for k, v in pairs(r) do
				if type(k) == "string" and k:lower():find(pass[1], 1, true) and tonumber(v) and tonumber(v) > 0 then return tonumber(v) end
			end
		end
		return nil
	end
	FX.farm = {
		stage = stageValue, cash = readCash, muscle = readMuscle, fmt = fmtNum,
		maxStage = function() local n = maxStageNum() return n > 0 and n or nil end,
		-- the next Body Alter you could buy: its stage number and price (nil when there is none left)
		nextAlter = function()
			local s = stageValue()
			if not (s and STAGES) then return nil end
			local r = rowOf(STAGES, s + 1)
			if not r or r.donate then return nil end
			return s + 1, tonumber(r.Price)
		end,
		sellRate = function() return (sellRate()) end,   -- coins per muscle (measured from a real sale when there was one, x2 with the pass)
		weightGain = weightGain,
		topWeight = function() return WEIGHTS and bestWeight() or nil end,
		-- the weight tool is called like the config's ToolName
		topWeightName = function()
			if not WEIGHTS then return nil end
			local r = rowOf(WEIGHTS, bestWeight())
			return r and tostring(r.ToolName or r.Name) or nil
		end,
		-- the next weight to buy: { idx, price, name }, or nil + "done" / "unknown"
		nextWeight = function()
			if not WEIGHTS then return nil, "unknown" end
			for id = bestWeight() + 1, countOf(WEIGHTS) do
				if not weightRowSkipped(id) then
					local r = rowOf(WEIGHTS, id)
					return { idx = id, price = tonumber(r.Price), name = tostring(r.Name or id) }
				end
			end
			return nil, "done"
		end,
		-- the whole weight list ({ idx, price, has, name }), the weights Smart Weight never buys, and Smart Weight's state
		shop = function()
			local list = {}
			if not WEIGHTS then return list end
			local best = bestWeight()
			for id = 1, countOf(WEIGHTS) do
				local r = rowOf(WEIGHTS, id)
				if r then list[#list + 1] = { idx = id, price = tonumber(r.Price), has = id <= best, name = tostring(r.Name or id) } end
			end
			return list
		end,
		skipWeight = function(i) return weightRowSkipped(i) end,
		smartWeightOn = function() return env.SmartWeight == true end,
		-- the highest weight Smart Weight is allowed to buy right now (the same limit rule smartWeight() uses)
		weightCap = function()
			if not WEIGHTS then return nil end
			local s = stageValue()
			local srow = s and STAGES and rowOf(STAGES, s + 1)
			local sprice = srow and tonumber(srow.Price)
			local limit = sprice and sprice * (SMART_LIMITS[smartLimit] or 0.25) or math.huge
			local cap = 0
			for id = 1, countOf(WEIGHTS) do
				if not weightRowSkipped(id) then
					local p = tonumber(rowOf(WEIGHTS, id).Price)
					if not p or p > limit then break end
					cap = id
				end
			end
			return cap
		end,
		-- lifts per second at the running lift speed (or the Fast Lifter speed if Auto Lift is off), its name, and whether it is running
		liftRate = function()
			local running = env.gain == true
			local c = (running and curLiftChoice) or LIFT_FAST
			local d = LIFT_DELAY[c]
			-- measured rate (real lifts of the last 3 minutes) while Auto Lift runs; the delay's nominal rate only until enough data exists
			local rate = running and measuredLiftRate() or nil
			return rate or (d and (1 / d) or 60), LIFT_SHORT[c] or "", running
		end,
	}

	local lastSwWait = nil
	local lastRescan = { weight = 0, dna = 0 }
	local function rescanIfWaiting(kind)   -- the saved shop reading can be stale (e.g. right after Body Alter): re-read it every 30 s while waiting
		if os.clock() - lastRescan[kind] > 30 then
			lastRescan[kind] = os.clock()
			Shop.invalidate(kind)
		end
	end
	local function smartWeight()
		syncStage()
		if not (WEIGHTS and STAGES) then Status.set("sweight", "Can't read the weight / stage list") return 3 end
		local stage = stageValue()
		if not stage then Status.set("sweight", "Can't read your stage") return 3 end
		local srow = rowOf(STAGES, stage + 1)
		local sprice = srow and tonumber(srow.Price)
		local limit = sprice and sprice * (SMART_LIMITS[smartLimit] or 0.25) or math.huge   -- no stage left = no limit
		local cash = readCash()
		if not cash then Status.set("sweight", "Can't read your coins") return 1 end
		local info = shopInfo("weight", "sweight")
		if not info then return 2 end
		local best = info.best

		-- nextRow = the next weight in order, pick = the most expensive one that is allowed AND affordable (prices only go up, so stop at the first miss)
		local nextRow, pick
		for id = best + 1, countOf(WEIGHTS) do
			local r = rowOf(WEIGHTS, id)
			if r and not r.donate and not skipRow(r) then
				local p = tonumber(r.Price)
				if not nextRow then nextRow = { id = id, row = r, price = p } end
				if not p or p > limit or p > cash then break end
				pick = { id = id, row = r, price = p }
				break   -- this game's shop only sells the next weight (the rest are locked): only ever buy the next one, never jump ahead
			end
		end
		if not nextRow then Status.set("sweight", "Waiting - all weights owned") return 5 end
		if not pick then
			rescanIfWaiting("weight")
			-- say WHY it is waiting in the console, once per change (not every tick)
			local why = (nextRow.price and nextRow.price > limit) and "above the limit" or "not enough coins"
			local sig = why .. tostring(nextRow.id) .. tostring(stage)
			if sig ~= lastSwWait then
				lastSwWait = sig
				dbg("Smart Weight waiting:", why, "| next #" .. tostring(nextRow.id), tostring(nextRow.row.Name), "price", tostring(nextRow.price), "| limit", tostring(limit), "| cash", tostring(cash))
			end
			if nextRow.price and nextRow.price > limit then
				Status.set("sweight", ("Waiting for the next stage (%s is above the limit)"):format(tostring(nextRow.row.Name)))
				return 1
			end
			Status.set("sweight", "Waiting for enough coins for " .. tostring(nextRow.row.Name))
			return 0.3
		end

		local jump = pick.id > nextRow.id
		Status.set("sweight", (jump and "Jumping to " or "Buying ") .. tostring(pick.row.Name))
		local heldBefore = heldTool()
		local ok, reason = Shop.buy("weight", pick.id)
		dbg("Smart BuyWeight (shop)", pick.id, tostring(pick.row.Name), "->", tostring(ok), tostring(reason), "| jump:", tostring(jump))
		if ok then
			wFails = 0
			task.spawn(equipAfterBuy, pick.row, heldBefore)
			return 0.02
		end
		if retryLater(reason) then return 0.2 end
		if jump and (reason == "refused" or reason == "blocked") then   -- the shop won't sell it out of order
			wFails = wFails + 1
			if wFails >= 3 then
				wBroken = true
				warn("[WORST Hub] The shop doesn't sell weights out of order - Smart Weight now buys them in order.")
			end
			return 0.5
		end
		Status.set("sweight", "Can't buy " .. tostring(pick.row.Name) .. " (" .. tostring(reason) .. ")")
		return 2
	end

	local function smartDnk()
		syncStage()
		if FX.infiniteSize then Status.set("sdna", nil) return 5 end   -- Infinite Size owners never need DNA
		if not (DNKS and STAGES) then Status.set("sdna", "Can't read the DNA / stage list") return 3 end
		local stage = stageValue()
		if not stage then Status.set("sdna", "Can't read your stage") return 3 end
		local srow = rowOf(STAGES, stage + 1)
		local sprice = srow and tonumber(srow.Price)
		if not sprice then Status.set("sdna", "Waiting - all stages bought") return 5 end

		-- coins per muscle: measured from a real sale. If there has been none yet, sell once to measure it (once every 30 s at most).
		local rate, measured = sellRate()
		if not measured then
			local m = readMuscle()
			if m and m > 0 and not selling and not FX.Events.found and os.clock() - lastProbe > 30 then   -- not needed when the event window was read (same rule as Sell If Enough)
				lastProbe = os.clock()
				Status.set("sdna", "Measuring coins per muscle (one sale)")
				doSell("measuring the coin rate")
				return 0.5
			end
		end

		-- target = the first normal DNA whose storage covers the next stage's price in ONE sale
		local needStorage = sprice * DNA_MARGIN / math.max(rate, 1e-9)
		local targetId, lastNormal
		for id = 1, countOf(DNKS) do
			local r = rowOf(DNKS, id)
			if r and not r.donate and not skipRow(r) then
				lastNormal = id
				if not targetId and (tonumber(r.Capacity) or 0) >= needStorage then targetId = id end
			end
		end
		targetId = targetId or lastNormal
		if not targetId then Status.set("sdna", "Can't read the DNA list") return 3 end

		local info = shopInfo("dna", "sdna")
		if not info then return 2 end
		local best = info.best
		if best >= targetId then
			rescanIfWaiting("dna")
			local trow = rowOf(DNKS, targetId)
			local covers = (tonumber(trow and trow.Capacity) or 0) * rate
			if covers >= sprice then
				Status.set("sdna", ("Waiting for the next stage (you own DNA #%d, storage already covers %s coins)"):format(best, fmtNum(sprice)))
			else
				Status.set("sdna", ("Waiting (biggest normal DNA #%d reached: one sale = ~%s of the %s the stage needs)"):format(best, fmtNum(covers), fmtNum(sprice)))
			end
			return 2
		end
		local cash = readCash()
		if not cash then Status.set("sdna", "Can't read your coins") return 1 end

		local nextRow, pick
		for id = best + 1, targetId do
			local r = rowOf(DNKS, id)
			if r and not r.donate and not skipRow(r) then
				local p = tonumber(r.Price)
				if not nextRow then nextRow = { id = id, row = r, price = p } end
				if not p or p > cash then break end
				pick = { id = id, row = r, price = p }
				break   -- the shop only sells the next DNA (the rest are locked): only ever buy the next one, never jump ahead
			end
		end
		if not nextRow then Status.set("sdna", "Waiting for the next stage (nothing left to buy)") return 3 end
		if not pick then
			rescanIfWaiting("dna")
			Status.set("sdna", ("Waiting for enough coins for %s (stage needs ~%s storage)"):format(tostring(nextRow.row.Name), fmtNum(needStorage)))
			return 0.3
		end

		local jump = pick.id > nextRow.id
		Status.set("sdna", (jump and "Jumping to " or "Buying ") .. tostring(pick.row.Name))
		local ok, reason = Shop.buy("dna", pick.id)
		dbg("Smart BuyDnk (shop)", pick.id, tostring(pick.row.Name), "->", tostring(ok), tostring(reason),
			"| rate", string.format("%.3f", rate), measured and "(measured)" or "(estimated)", "| jump:", tostring(jump))
		if ok then
			dFails = 0
			return 0.02
		end
		if retryLater(reason) then return 0.2 end
		if jump and (reason == "refused" or reason == "blocked") then
			dFails = dFails + 1
			if dFails >= 3 then
				dBroken = true
				warn("[WORST Hub] The shop doesn't sell DNA out of order - Smart DNA now buys it in order.")
			end
			return 0.5
		end
		Status.set("sdna", "Can't buy " .. tostring(pick.row.Name) .. " (" .. tostring(reason) .. ")")
		return 2
	end

	rest[#rest + 1] = {
		type = "toggle", name = "Hide Shop While Buying", icon = "🙈", default = true,
		desc = "Buying clicks the game's own shop buttons. On = the shop is kept open off-screen where you can't see it. Off = it shows on screen.",
		callback = function(on) Shop.setHidden(on == true) end,
	}

	local smartLimitEntry = {
		type = "dropdown", name = "Smart Weight Limit", icon = "🎚", width = 300,
		desc = "Smart Weight never buys a weight that costs more than this share of the next stage's price.",
		options = { "10% of next stage", "25% of next stage", "50% of next stage", "100% of next stage" },
		default = smartLimit,
		callback = function(option)
			if option and SMART_LIMITS[option] then smartLimit = option end
		end,
	}
	local smartWeightToggle = buyToggle("smartweight", "SmartWeight", "sweight", "Smart Weight", "🧠",
		"Buys the most expensive weight you can afford within the limit above (skips the cheaper ones). Pauses Auto Buy Weight.", smartWeight)
	do
		local inner = smartWeightToggle.callback
		smartWeightToggle.callback = function(on)
			if on then resetSkip() end
			inner(on)
		end
	end
	rest[#rest + 1] = smartLimitEntry
	rest[#rest + 1] = smartWeightToggle
	if not FX.infiniteSize then
		local smartDnaToggle = buyToggle("smartdna", "SmartDNA", "sdna", "Smart DNA", "🧬",
			"Only buys the storage needed so one full sale covers the next stage (uses your real coins per muscle). Never buys weights. Pauses Auto Buy DNA.", smartDnk)
		local inner = smartDnaToggle.callback
		smartDnaToggle.callback = function(on)
			if on then resetSkip() end
			inner(on)
		end
		rest[#rest + 1] = smartDnaToggle
	end

	------------------------------------------------------------ Macro: lift + sell when it covers the next thing, in one place
	local macro = {
		{
			type = "toggle", name = "Auto Gain Muscle (Fast)", icon = "💪", default = false,
			desc = "Lifts at the Fast Lifter speed. Shares the lift loop with the Lifting page.",
			callback = function(on)
				if on then startLift(LIFT_FAST) else stopLift() end
			end,
		},
		{
			type = "toggle", name = "Auto Sell Muscle (Sell If Enough)", icon = "💰", default = false,
			desc = "Sells only when cash + muscle covers the next weight, DNA or stage you are buying, or when the storage is full. Shares the sell loop with the Sell page.",
			callback = function(on)
				stopSell()
				if on then startSmartSell(SELL_ENOUGH) end
			end,
		},
	}

	-- ---------------------------------------------------------------- Smart Weight / Auto Body Alter / Smart DNA on this page too
	-- Same switches as on the Buy page: flipping either one flips the other (the feature itself only starts / stops once).
	-- Smart DNA only exists without the Infinite Size gamepass, so it is simply skipped when the Buy page has no such entry.
	do
		local at = math.min(3, #macro + 1)
		for _, nm in ipairs({ "Smart Weight", "Auto Body Alter", "Smart DNA" }) do
			local buyEntry
			for _, en in ipairs(rest) do if type(en) == "table" and en.name == nm then buyEntry = en break end end
			if buyEntry then
				local inner = buyEntry.callback
				local macroEntry
				macroEntry = {
					type = "toggle", name = nm, icon = buyEntry.icon, default = false,
					desc = buyEntry.desc,
					callback = function(on)
						if buyEntry._setUI and buyEntry._get then
							if buyEntry._get() ~= (on == true) then buyEntry._setUI(on == true) end
						else
							inner(on)
						end
					end,
				}
				buyEntry.callback = function(on)
					inner(on)
					if macroEntry._setUI and macroEntry._get and macroEntry._get() ~= (on == true) then macroEntry._setUI(on == true) end
				end
				table.insert(macro, at, macroEntry)
				at = at + 1
			end
		end
	end

	-- ---------------------------------------------------------------- Auto Reborn: this game has no reborn system yet
	table.insert(macro, { type = "info", name = "Auto Reborn", icon = "♻", desc = "Coming Soon? (this game has no reborn system yet)" })

	-- ---------------------------------------------------------------- WORST TOGGLE: the whole macro in one switch
	do
		local function findEntry(list, name)
			for _, en in ipairs(list) do if type(en) == "table" and en.name == name then return en end end
		end
		local function setTo(en, v)
			if en and en._setUI then pcall(en._setUI, v) end
		end
		table.insert(macro, 1, {
			type = "toggle", name = "WORST TOGGLE", icon = "👑", default = false,
			desc = "One switch for the whole macro: Sell If Enough, Gain Muscle (fast), Smart Weight, Auto Body Alter, Smart DNA (only without the Infinite Size gamepass). Also switches Anti AFK and Auto Rejoin on if they are off. Turning it off stops the macro features (Anti AFK / Auto Rejoin stay on).",
			callback = function(on)
				local sellEn, gainEn = findEntry(macro, "Auto Sell Muscle (Sell If Enough)"), findEntry(macro, "Auto Gain Muscle (Fast)")
				local buys = {
					findEntry(rest, "Smart Weight"),
					findEntry(rest, "Auto Body Alter"),
					findEntry(rest, "Smart DNA"),   -- keep LAST: nil with the Infinite Size gamepass (no entry), and ipairs stops at a nil
				}
				if on then
					-- the buy switches go ON first and Sell last: Sell If Enough decides what to sell for by looking at which buy switches are on
					-- (and what Smart Weight / Smart DNA would really buy). Started first, it saw none on, took every next item as a target and sold at once.
					for _, en in ipairs(buys) do setTo(en, true) end
					setTo(gainEn, true)
					setTo(sellEn, true)
					-- Anti AFK / Auto Rejoin are normally ON from the start: only switch them on if they were turned off in Settings
					if Extras and Extras.antiAfk and Extras.antiAfk._get and not Extras.antiAfk._get() then setTo(Extras.antiAfk, true) end
					if Extras and Extras.autoRejoin and Extras.autoRejoin._get and not Extras.autoRejoin._get() then setTo(Extras.autoRejoin, true) end
				else
					setTo(sellEn, false)
					setTo(gainEn, false)
					for _, en in ipairs(buys) do setTo(en, false) end
				end
			end,
		})
	end

	-- stops everything when the hub is unloaded
	table.insert(cleanupHooks, function()
		env.gain, env.Sell, env.BuyWeight, env.BuyStage, env.BuyDnk = false, false, false, false, false
		env.SmartWeight, env.SmartDNA = false, false
		FX.ShopBuy.stop()   -- puts the shop back and closes it
	end)

	return { pages = {
		{ name = "Lifting", entries = { entries[1], entries[2] } },
		{ name = "Sell",    entries = { entries[3], entries[4] } },
		{ name = "Buy",     entries = rest },
		{ name = "Macro",   entries = macro },
	} }
end)()

------------------------------------------------------------------ BLOODLINE & ISLANDS (island teleports first; the CFrames come from the old game)
-- The island start points below are copied from the old No Limit Lifting Simulator script (Hercules -> Divinities; the later islands don't exist in this game). They may not be the same in
-- Lifting Simulator: REBORN, so the Teleport button checks for ground at the target and brings you back when there is none.
-- Auto Kill (the bloodline farm) is the old one ported: it stands on every kill spot of the chosen island and stomps with the Foot / Stomp tool.
TAB_SCRIPTS["Bloodline & Islands"] = (function()
	local Status = FX.Status

	local ISLANDS = {
		{ "Hercules",   CFrame.new(1272.44, 94.00, 1851.11) },
		{ "Ares",       CFrame.new(4055.03, 94.01, 1815.06) },
		{ "Poseidon",   CFrame.new(6665.31, 94.01, 1902.04) },
		{ "Hades",      CFrame.new(9393.84, 94.01, 1875.97) },
		{ "Athena",     CFrame.new(11798.42, 94.01, 1875.52) },
		{ "Zeus",       CFrame.new(14596.24, 94.01, 1904.77) },
		{ "Cronus",     CFrame.new(17247.50, 94.01, 1848.54) },
		{ "Robots",     CFrame.new(19979.43, 94.01, 1889.56) },
		{ "Bugs",       CFrame.new(22494.12, 94.01, 1858.39) },
		{ "Cyber",      CFrame.new(25107.67, 94.01, 1889.34) },
		{ "Divinities", CFrame.new(27536.45, 94.01, 1815.89) },
	}
	local NAMES, CFRAMES = {}, {}
	for i, it in ipairs(ISLANDS) do NAMES[i] = it[1] CFRAMES[it[1]] = it[2] end
	local islandChoice = NAMES[1]

	local function getRoot()
		local ch = player.Character
		return ch and ch:FindFirstChild("HumanoidRootPart")
	end

	-- is there something solid under the target? (a ray from a bit above it, straight down, ignoring your own character)
	local function groundBelow(pos)
		local params = RaycastParams.new()
		params.FilterType = Enum.RaycastFilterType.Exclude
		params.FilterDescendantsInstances = { player.Character }
		return workspace:Raycast(pos + Vector3.new(0, 20, 0), Vector3.new(0, -400, 0), params)
	end

	-- ---------------------------------------------------------------- Bloodline farm (Auto Kill)
	-- every kill spot of each island, copied from the old script (Middle, Devil 1/2, Angel 1/2). Spots with the same coordinates are visited once.
	local BLOODLINE_SPOTS = {
		{ "Hercules",   { {2142, 72.96, 1886.86},     {1750, -57.5004883, 1882.00024},       {2442, -57.5004883, 1870.00024},       {2122.85, 4.83, 2153.45},   {2135.10, 4.83, 1618.96} } },
		{ "Ares",       { {4790.08, 72.96, 1883.74},  {5116, -57.5004883, 1850.00024},       {5006, -57.5004883, 1670.00024},       {4480.53, -66.96, 1873.10}, {4619.06, 67.86, 2191.77} } },
		{ "Poseidon",   { {7423.88, 116.17, 1894.63}, {7258.40039, -57.5004883, 1694.07031}, {7580, -57.5004883, 1902.0802},        {7641.90, 113.07, 1713.49}, {7027.47, 113.07, 1899.24} } },
		{ "Hades",      { {10077.96, 130.46, 1889.09},{10069.1484, -57.5004883, 2283.63013}, {9942.18848, -57.800293, 1490.21021},   {9622.37, 112.30, 1882.91}, {10496.92, 112.60, 1875.61} } },
		{ "Athena",     { {12711.25, 167.06, 1837.08},{12301.7012, -57.5004883, 1887.00024}, {12879.7617, -57.5004883, 1642.82019}, {13082.91, 155.06, 1796.23},{12649.79, 155.66, 2171.43} } },
		{ "Zeus",       { {15343.09, 161.06, 1847.09},{15551.2803, -54.5004883, 2091.14014}, {15097, -54.5004883, 1925.00024},      {15654.08, 158.06, 1810.93},{15173.99, 158.06, 2181.33} } },
		{ "Cronus",     { {17967.72, 231.39, 1872.65},{18350.7109, -57.6010742, 1898.51025}, {17671.1699, -57.6547852, 1983.44019}, {17862.35, 255.39, 1476.00} } },
		{ "Robots",     { {20655.21, 227.00, 1896.29},{20583.1621, -57.6010742, 1682.76025}, {20628, -57.6547852, 2078.58008},      {20436.26, 301.16, 1946.15},{20904.26, 308.96, 1933.62} } },
		{ "Bugs",       { {23318.71, 692.53, 2022.52} } },
		{ "Cyber",      { {25971.24, 708.20, 1999.64} } },
		{ "Divinities", { {28713.60, 1434.99, 2041.96} } },
	}
	local SPOTS = {}
	for _, b in ipairs(BLOODLINE_SPOTS) do
		local list, seen = {}, {}
		for _, q in ipairs(b[2]) do
			local k = q[1] .. "," .. q[2] .. "," .. q[3]
			if not seen[k] then seen[k] = true list[#list + 1] = CFrame.new(q[1], q[2], q[3]) end
		end
		SPOTS[b[1]] = list
	end

	local VirtualUser = game:GetService("VirtualUser")
	-- the Foot tool is called "Stomp" in this game
	local function isStomp(item)
		if not item:IsA("Tool") then return false end
		local n = item.Name:lower()
		return n:find("stomp", 1, true) ~= nil or n:find("foot", 1, true) ~= nil
	end
	local function equipStomp()
		local ch, bp = player.Character, player:FindFirstChild("Backpack")
		local hum = ch and ch:FindFirstChildOfClass("Humanoid")
		if not (hum and bp) then return end
		for _, item in ipairs(ch:GetChildren()) do
			if isStomp(item) then return end   -- already in the hand
		end
		for _, item in ipairs(bp:GetChildren()) do
			if isStomp(item) then hum:EquipTool(item) return end
		end
	end

	local bloodlineChoice = NAMES[1]
	local killToggle
	local killGen = 0
	local SPOT_WAIT = 3   -- seconds on every spot (same as the old script)

	-- waits `sec` seconds but stops early when the toggle is switched off / the bloodline is changed; false = it was stopped
	local function sleepWhileKilling(sec, my)
		local t0 = os.clock()
		while alive and killGen == my and os.clock() - t0 < sec do task.wait(0.1) end
		return alive and killGen == my
	end

	local function stopKill()
		killGen += 1
		Status.set("kill", nil)
	end

	local function startKill()
		killGen += 1
		local my = killGen
		local name = bloodlineChoice
		local spots = SPOTS[name] or {}
		Status.set("kill", ("%s - starting..."):format(name))
		task.spawn(function()
			while alive and killGen == my do
				if not getRoot() then
					Status.set("kill", "Waiting for your character to respawn")
					task.wait(0.5)
				else
					equipStomp()
					local missed = 0
					for i, cf in ipairs(spots) do
						local root = getRoot()
						if not (alive and killGen == my and root) then break end
						Status.set("kill", ("%s - stomping at spot %d/%d"):format(name, i, #spots))
						root.CFrame = cf
						task.wait(0.3)
						root = getRoot()
						if root and (root.Position - cf.Position).Magnitude > 150 then
							missed += 1   -- you fell away from the spot: there is nothing under it in this game
						else
							pcall(function() VirtualUser:ClickButton1(Vector2.new(9e9, 9e9)) end)
							if not sleepWhileKilling(SPOT_WAIT, my) then break end
						end
					end
					if killGen == my and missed > 0 and missed >= #spots then
						-- every spot is invalid: stop instead of falling again and again
						Status.set("kill", ("%s - no valid kill spot, stopped"):format(name))
						warn(("[WORST Hub] Auto Kill: none of the %d kill spots of %s exist in this game."):format(#spots, name))
						killGen += 1
						if killToggle and killToggle._setUI then pcall(killToggle._setUI, false) end
						break
					end
				end
			end
		end)
	end

	local entries = {}

	entries[#entries + 1] = {
		type = "dropdown", name = "Choose Bloodline", icon = "⚔", width = 260,
		desc = "Which island Auto Kill farms (Hercules to Divinities).",
		options = NAMES, default = bloodlineChoice,
		callback = function(option)
			if option == nil then return end
			bloodlineChoice = option
			if killToggle and killToggle._get and killToggle._get() then startKill() end   -- switch bloodline while running
		end,
	}

	killToggle = {
		type = "toggle", name = "Auto Kill", icon = "☠", default = false,
		desc = "Teleports to the kill spots of the chosen bloodline and stomps them with the Foot (Stomp). It equips the Foot by itself.",
		callback = function(on)
			if on then startKill() else stopKill() end
		end,
	}
	entries[#entries + 1] = killToggle

	entries[#entries + 1] = {
		type = "dropdown", name = "Choose Island", icon = "🏝", width = 260,
		desc = "Which island the Teleport button takes you to (Hercules to Divinities).",
		options = NAMES, default = islandChoice,
		callback = function(option)
			if option == nil then return end
			islandChoice = option
		end,
	}

	entries[#entries + 1] = {
		type = "button", name = "Teleport to Island", icon = "🚀", btnText = "Teleport", noSave = true,
		desc = "Teleports you to the island chosen above. If there is no ground at that spot in this game, you are sent back to where you were.",
		run = function()
			local cf = CFRAMES[islandChoice]
			if not cf then error("Pick an island first", 0) end
			local root = getRoot()
			if not root then error("Your character isn't loaded", 0) end
			local origin = root.CFrame
			local wasAnchored = root.Anchored
			Status.set("tp", "Going to " .. islandChoice)
			local ok, err = pcall(function()
				root.Anchored = true   -- you can't fall while the area around the target loads
				root.CFrame = cf   -- instant teleport
				local found
				local t0 = os.clock()
				repeat   -- the ground may need a moment to stream in
					found = groundBelow(cf.Position)
					if found then break end
					task.wait(0.2)
				until os.clock() - t0 > 3
				if not found then
					root.CFrame = origin
					error(("No ground at %s (%.0f, %.0f, %.0f): this coordinate is probably not valid in this game. You were sent back."):format(
						islandChoice, cf.X, cf.Y, cf.Z), 0)
				end
			end)
			if root.Parent then root.Anchored = wasAnchored end
			Status.set("tp", nil)
			if not ok then error(tostring(err), 0) end
			return true
		end,
	}

	return entries
end)()

------------------------------------------------------------------ WEBHOOK (ported from the "Enable Webhook Logger" of ASAIYAGUINEW.lua)
-- Webhook URL box + Enable Webhook Logger toggle. While it is on, your username, muscle, stage and cash are posted to the webhook
-- right away and then every 10 minutes (same message as the old script).
TAB_SCRIPTS.Webhook = (function()
	local Status = FX.Status
	local SEND_EVERY = 600
	local webhookURL = ""
	local loggerToggle
	local gen = 0

	-- 1.2K / 1.20M / 1.20B
	local function formatBigNumber(num)
		for i = #MUSCLE_SUFFIXES, 1, -1 do
			if num >= 10 ^ (3 * i) then
				return string.format("%.2f%s", num / 10 ^ (3 * i), (MUSCLE_SUFFIXES[i]:gsub("^%l", string.upper)))
			end
		end
		return tostring(num)
	end

	-- the executor's HTTP request function (nil when it has none)
	local function getHttpFunction()
		return (syn and syn.request) or http_request or request or (fluxus and fluxus.request) or nil
	end

	-- posts the stats to the webhook; returns true when it was sent
	local function sendStats()
		local http = getHttpFunction()
		if not (http and webhookURL ~= "") then return false end

		local ls = player:FindFirstChild("leaderstats")
		local muscleV, stageV = ls and ls:FindFirstChild("Muscle"), ls and ls:FindFirstChild("Stage")
		local muscle = getMuscle() or 0
		local stage = stageV and stageV.Value or 0
		local cashText = "N/A"
		pcall(function() cashText = player.PlayerGui.Main_Gui.DataMenu_Frame.Cash.Status.Text end)
		local displayCash = (tostring(cashText):gsub("0%.00%s*", ""))
		local muscleDisplay = (muscle == 0) and "Concealed :lock:" or formatBigNumber(muscle)

		local data = {
			["content"] = "**:bust_in_silhouette: Username:** " .. player.Name ..
				"\n**:muscle: Muscle Stat:** " .. muscleDisplay ..
				"\n**:cyclone: Stage:** " .. stage ..
				"\n**:moneybag: Cash:** " .. displayCash,
			["username"] = "Stat Logger",
			["avatar_url"] = "https://cdn.discordapp.com/attachments/1350798224197160982/1359693324813996072/Azuma_Logo.png",
		}
		local ok, err = pcall(http, {
			Url = webhookURL, Method = "POST",
			Headers = { ["Content-Type"] = "application/json" },
			Body = HttpService:JSONEncode(data),
		})
		if not ok then
			warn("Failed to send webhook:", err)
			return false
		end
		print("Webhook sent successfully!")
		return true
	end

	local function stop()
		gen += 1
		Status.set("webhook", nil)
	end

	local function start()
		gen += 1
		local my = gen
		task.spawn(function()
			local function live() return alive and gen == my end
			if not getHttpFunction() then
				warn("Executor does not support sending webhooks.")
				Status.set("webhook", "Waiting - your executor can't send webhooks")
				pcall(function()
					game:GetService("StarterGui"):SetCore("SendNotification", {
						Title = "Unsupported Executor", Text = "Your executor cannot send webhooks.", Duration = 5,
					})
				end)
				return
			end
			while live() do
				if webhookURL == "" then
					Status.set("webhook", "Waiting for a webhook URL (enter it on the Webhook tab)")
					task.wait(1)
				else
					Status.set("webhook", "Sending your stats...")
					local ok = sendStats()
					if not live() then break end
					local nextAt = os.clock() + SEND_EVERY
					while live() and webhookURL ~= "" and os.clock() < nextAt do
						Status.set("webhook", ok and "Waiting for the next report" or "Waiting - the last report failed, retrying",
							nextAt - os.clock())
						task.wait(1)
					end
				end
			end
		end)
	end

	local entries = {
		{
			type = "input", name = "Webhook URL", icon = "🔗", placeholder = "Discord webhook URL",
			desc = "Paste your Discord webhook link here. The stats are posted to it.",
			callback = function(value)
				webhookURL = (tostring(value or ""):gsub("^%s+", ""):gsub("%s+$", ""))
				if loggerToggle and loggerToggle._get and loggerToggle._get() then start() end   -- new URL: report again right away
			end,
		},
	}
	loggerToggle = {
		type = "toggle", name = "Enable Webhook Logger", icon = "📡", default = false,
		desc = "Sends your username, muscle, stage and cash to the webhook every 10 minutes.",
		callback = function(on)
			if on then start() else stop() end
		end,
	}
	entries[#entries + 1] = loggerToggle
	return entries
end)()
