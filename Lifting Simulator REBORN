	-- ---------------------------------------------------------------- Auto Rejoin
	-- When you get kicked / disconnected (a Reborn kicks you too) it teleports you back into the SAME server (same PlaceId + JobId).
	-- A rejoin starts a fresh game session, so the hub is gone. To bring it back, the executor has to run it again:
	-- put the line you normally execute (or its URL / file path) in "Rejoin Loader" and it is queued with queue_on_teleport.
	local TeleportService = game:GetService("TeleportService")
	local GuiService = game:GetService("GuiService")
	local rejoinLoader = ""
	local rejoinConns = {}
	local rejoining = false

	local function stopRejoinWatch()
		for _, c in ipairs(rejoinConns) do pcall(function() c:Disconnect() end) end
		rejoinConns = {}
	end

	-- what the executor should run after the teleport (nil = nothing to queue)
	local function loaderSource()
		local text = rejoinLoader
		if text == "" then return nil end
		if text:lower():match("^https?://") then return ("loadstring(game:HttpGet(%q))()"):format(text) end
		if typeof(isfile) == "function" and not text:find("[%(%)]") then
			local ok, exists = pcall(isfile, text)
			if ok and exists then return ("loadstring(readfile(%q))()"):format(text) end
		end
		return text   -- raw code, e.g. the loadstring(game:HttpGet("...")) line you normally execute
	end

	local function queueAfterTeleport(src)
		if not src then return false end
		local q = (typeof(queue_on_teleport) == "function" and queue_on_teleport)
			or (typeof(queueonteleport) == "function" and queueonteleport)
			or (type(syn) == "table" and typeof(syn.queue_on_teleport) == "function" and syn.queue_on_teleport)
		if not q then return false end
		return pcall(q, src)
	end

	local function doRejoin(why)
		if rejoining or not alive or not env.AutoRejoin then return end
		rejoining = true
		local queued = queueAfterTeleport(loaderSource())
		if not queued and loaderSource() == nil then
			warn("[WORST Hub] Auto Rejoin: no Rejoin Loader set - you will rejoin, but the hub only comes back if your executor auto-executes it.")
		end
		task.spawn(function()
			local attempt = 0
			while alive and env.AutoRejoin and rejoining and attempt < 60 do
				attempt = attempt + 1
				Status.set("rejoin", ("Rejoining the same server (%s) - try %d"):format(why, attempt))
				local ok, err = pcall(function()
					TeleportService:TeleportToPlaceInstance(game.PlaceId, game.JobId, player)
				end)
				if not ok then warn("[WORST Hub] Auto Rejoin:", err) end
				-- if the teleport started, this script dies with the game; still running 8s later = it failed (full / closed server): try again
				task.wait(8)
			end
			if alive and env.AutoRejoin and rejoining then Status.set("rejoin", "Couldn't rejoin that server (it may be closed or full)") end
			rejoining = false
		end)
	end

	E.autoRejoin = {
		type = "toggle", name = "Auto Rejoin", icon = "🔄", default = true,
		desc = "Rejoins the SAME server when you get kicked or disconnected (Reborn kicks you too).",
		callback = function(on)
			env.AutoRejoin = on == true
			stopRejoinWatch()
			rejoining = false
			if not on then Status.set("rejoin", nil) return end
			Status.set("rejoin", "Watching for a kick / disconnect")
			-- 1) the message Roblox shows when you are kicked or disconnected
			table.insert(rejoinConns, GuiService.ErrorMessageChanged:Connect(function(msg)
				if msg ~= nil and tostring(msg) ~= "" then doRejoin("disconnected") end
			end))
			-- 2) the Roblox error window itself (covers executors where the signal above stays silent)
			task.spawn(function()
				pcall(function()
					local gui = game:GetService("CoreGui"):WaitForChild("RobloxPromptGui", 10)
					local overlay = gui and gui:WaitForChild("promptOverlay", 10)
					if overlay and env.AutoRejoin then
						table.insert(rejoinConns, overlay.ChildAdded:Connect(function(child)
							if child.Name == "ErrorPrompt" then doRejoin("error window") end
						end))
					end
				end)
			end)
		end,
	}
	table.insert(cleanupHooks, function() env.AutoRejoin = false stopRejoinWatch() end)

	E.rejoinLoader = {
		type = "input", name = "Rejoin Loader", icon = "📎", placeholder = "URL, file path or the loadstring line you execute",
		desc = "Run again after the rejoin so the hub comes back. Leave empty if your executor auto-executes it.",
		callback = function(value)
			rejoinLoader = (tostring(value or ""):gsub("^%s+", ""):gsub("%s+$", ""))
		end,
	}

	E.general = {
		E.hideInfo, E.equipWeights, E.equipItemDropdown, E.equipItem,
		E.clickBloodline, E.clickKillstreak, E.clickFast,
	}
	return E
end)()

