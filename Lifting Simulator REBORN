			-- a new estimate that is close to the running countdown only nudges it, so the number ticks down evenly; a big change snaps.
			-- one smoother per tile: returns smooth(eta, now, key) and reset()
			local function newSmoother()
				local sEta, sAt, sFor
				return function(eta, now, key)
					if sEta and sFor == key then
						local expect = sEta - (now - sAt)
						if expect > 0 and math.abs(eta - expect) <= math.max(2, expect * 0.25) then eta = expect + (eta - expect) * 0.3 end
					end
					sEta, sAt, sFor = eta, now, key
					return eta
				end, function() sEta = nil end
			end
