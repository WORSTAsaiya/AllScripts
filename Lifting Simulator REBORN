------------------------------------------------------------------ SHOP UI BUYER (used by Auto Buy / Smart Weight / Smart DNA / Auto Body Alter)
-- Buys by clicking the game's own shop buttons, like a player. The shop is shown by script, kept OPEN while a buy toggle is on, and hidden
-- (pushed off-screen + shrunk). What you own is read from the shop tiles (Owned / Equipped), not from the BestWeight / BestDnk counters.
-- One lock: the shop has a single detail panel, so the loops take turns (Body Alter > Weight > DNA).
FX.ShopBuy = (function()
	local pg = player:WaitForChild("PlayerGui")
	local S = {}
	local HIDDEN, OFFSCREEN = true, 5
	local PAGE = { weight = "Page01", dna = "Page02", alter = "Page03" }
	local PRIO = { alter = 1, weight = 2, dna = 3 }
	local cfgs = {}
	local stageFn, numFn = function() return nil end, function() return nil end
	local wantedFn = function() return true end
	local logFn = function() end
	local skipFn = function() return false end
	local lastScanLog = {}
	local alive, busy, weOpened = true, false, false
	local waiting = { 0, 0, 0 }
	local cache = {}   -- kind -> { best = highest owned id, id/row = the next one for sale, done = true when nothing is left }
	local function log(...) logFn(...) end

	local function rowOf(cfg, i) return cfg and (cfg[i] or cfg[tostring(i)]) end
	local function maxId(cfg)
		local n = 0
		for k in pairs(cfg) do
			local v = tonumber(k)
			if v and v > n then n = v end
		end
		return n
	end
	local function clean(t)
		t = tostring(t):gsub("<[^>]->", "")
		t = t:gsub("%s+", " ")
		t = t:gsub("^ ", ""):gsub(" $", "")
		return t:lower()
	end
	local function isShown(o)
		local c = o
		while c and c ~= pg do
			if c:IsA("GuiObject") and not c.Visible then return false end
			if c:IsA("ScreenGui") and not c.Enabled then return false end
			c = c.Parent
		end
		return true
	end
	local function pathOf(o)
		local parts, c = {}, o
		while c and c ~= pg do
			table.insert(parts, 1, c.Name)
			c = c.Parent
		end
		return table.concat(parts, ".")
	end
	local function child(o, ...)
		for _, n in ipairs({ ... }) do
			if not o then return nil end
			o = o:FindFirstChild(n)
		end
		return o
	end
	local function G(...) return child(pg:FindFirstChild("Main_Gui"), ...) end
	local function listeners(o, name)
		if typeof(getconnections) ~= "function" then return 0 end
		local ok, sig = pcall(function() return o[name] end)
		if not ok or not sig then return 0 end
		local ok2, list = pcall(getconnections, sig)
		return (ok2 and type(list) == "table") and #list or 0
	end
	local function buttonOf(o)
		if not o then return nil end
		local c, hops = o, 0
		while c and c ~= pg and hops <= 6 do
			if c:IsA("GuiButton") then return c end
			c = c.Parent
			hops = hops + 1
		end
		c, hops = o, 0
		while c and c ~= pg and hops <= 6 do
			if listeners(c, "InputBegan") > 0 then return c end
			c = c.Parent
			hops = hops + 1
		end
	end
	local function waitFrames(fn, secs)   -- polls once per frame
		local t0 = os.clock()
		while os.clock() - t0 < secs do
			local v = fn()
			if v then return v end
			task.wait()
		end
		return fn()
	end

	---------------------------------------------------------------- pressing (events only: works with the shop off-screen)
	local function signalPress(o)
		local p, s = o.AbsolutePosition, o.AbsoluteSize
		local x, y = p.X + s.X / 2, p.Y + s.Y / 2
		local fake = {
			UserInputType = Enum.UserInputType.MouseButton1, UserInputState = Enum.UserInputState.End,
			KeyCode = Enum.KeyCode.Unknown, Position = Vector3.new(x, y, 0), Delta = Vector3.new(0, 0, 0),
		}
		local fired = {}
		local function fire(name, ...)
			if listeners(o, name) == 0 then return end
			local ok, sig = pcall(function() return o[name] end)
			if not (ok and sig) then return end
			local args = table.pack(...)
			local sent = false
			if typeof(firesignal) == "function" then sent = pcall(firesignal, sig, table.unpack(args, 1, args.n)) end
			if not sent and typeof(getconnections) == "function" then
				local ok2, list = pcall(getconnections, sig)
				if ok2 and type(list) == "table" then
					for _, c in ipairs(list) do pcall(function() c:Fire(table.unpack(args, 1, args.n)) end) end
					sent = true
				end
			end
			if sent then fired[#fired + 1] = name end
		end
		if o:IsA("GuiButton") then
			fire("MouseButton1Down", x, y)
			fire("MouseButton1Up", x, y)
			fire("MouseButton1Click")
			fire("Activated", fake, 1)
		end
		if #fired == 0 then
			fake.UserInputState = Enum.UserInputState.Begin
			fire("InputBegan", fake)
			fake.UserInputState = Enum.UserInputState.End
			fire("InputEnded", fake)
		end
		return fired
	end
	local function press(o)
		local ok, fired = pcall(signalPress, o)
		return ok and #fired > 0
	end

	---------------------------------------------------------------- hiding (off-screen + shrunk)
	local FRAMES = { "UpgradeMenu_Frame", "UpgradeInfo_Frame" }
	local origPos = {}
	local function applyHide(on)
		for _, n in ipairs(FRAMES) do
			local f = G(n)
			if f then
				local sc = f:FindFirstChild("ShopHideScale")
				if on then
					if origPos[f] == nil then origPos[f] = f.Position end
					local o = origPos[f]
					local target = UDim2.new(o.X.Scale + OFFSCREEN, o.X.Offset, o.Y.Scale, o.Y.Offset)
					if f.Position ~= target then f.Position = target end   -- the game moved it back: push it away again
					if not sc then
						sc = Instance.new("UIScale")
						sc.Name = "ShopHideScale"
						sc.Parent = f
					end
					if sc.Scale ~= 0.001 then sc.Scale = 0.001 end
				else
					if sc then sc:Destroy() end
					if origPos[f] then
						f.Position = origPos[f]
						origPos[f] = nil
					end
				end
			end
		end
	end

	---------------------------------------------------------------- navigating
	local function uiState(kind)
		local info, menu = G("UpgradeInfo_Frame"), G("UpgradeMenu_Frame")
		if info and isShown(info) then
			local lst = child(info, "PageList", PAGE[kind])
			if lst and isShown(lst) then return "page" end
			return "otherpage"
		end
		if menu and isShown(menu) then return "menu" end
		return "closed"
	end
	local function openPage(kind)
		for _ = 1, 6 do
			local st = uiState(kind)
			if st == "page" then return true end
			if st == "otherpage" then
				local b = buttonOf(G("UpgradeInfo_Frame", "Back", "TextLabel") or G("UpgradeInfo_Frame", "Back"))
				if not b then log("[ShopBuy] can't find the Back button") return false end
				press(b)
				waitFrames(function() return uiState(kind) ~= "otherpage" end, 2)
			elseif st == "menu" then
				local b = buttonOf(G("UpgradeMenu_Frame", PAGE[kind], "Text") or G("UpgradeMenu_Frame", PAGE[kind]))
				if not b then log("[ShopBuy] can't find the category button " .. PAGE[kind]) return false end
				press(b)
				waitFrames(function() return uiState(kind) == "page" end, 3)
			else
				return false
			end
		end
		return uiState(kind) == "page"
	end

	---------------------------------------------------------------- tiles
	local function pageList(kind) return child(G("UpgradeInfo_Frame"), "PageList", PAGE[kind]) end
	local function buildIndex(list)
		local byName, byLabel = {}, {}
		for _, t in ipairs(list:GetChildren()) do byName[t.Name] = t end
		for _, d in ipairs(list:GetDescendants()) do
			if d.Name == "tlName" and (d:IsA("TextLabel") or d:IsA("TextButton")) then byLabel[clean(d.Text)] = d.Parent end
		end
		return byName, byLabel
	end
	local function tileFor(kind, id, row, byName, byLabel)
		local names = {}
		local function add(n) if n ~= nil then names[#names + 1] = tostring(n) end end
		add(row.Name) add(row.ToolName)
		if kind == "alter" then add("Stage " .. id) end
		for _, n in ipairs(names) do
			if byName[n] then return byName[n] end
		end
		for _, n in ipairs(names) do
			if byLabel[clean(n)] then return byLabel[clean(n)] end
		end
		return nil
	end
	local function tileOwned(tile)
		local p = tile:FindFirstChild("tlPrice")
		local s = p and clean(p.Text)
		return s == "owned" or s == "equipped", s
	end
	local function forSale(tile)   -- not owned and the price label has a number in it
		local owned, s = tileOwned(tile)
		return (not owned) and s ~= nil and s:find("%d") ~= nil
	end

	local function selectTile(tile, list, row)
		local nameLbl = tile:FindFirstChild("tlName")
		local priceLbl = tile:FindFirstChild("tlPrice")
		local label = nameLbl and clean(nameLbl.Text) or clean(tile.Name)
		local accept = {}
		local function addName(n)
			if n ~= nil and tostring(n) ~= "" then accept[clean(n)] = true end
		end
		addName(label) addName(tile.Name) addName(row and row.Name) addName(row and row.ToolName)

		local selName = G("UpgradeInfo_Frame", "Detail", "SelectedName")
		local selPrice = G("UpgradeInfo_Frame", "Detail", "SelectedPrice")
		if not selName then log("[ShopBuy] can't find the detail panel (Detail.SelectedName)") return false end
		local before = clean(selName.Text)
		local function panelMatches()
			local shown = clean(selName.Text)
			if accept[shown] then return true end
			if shown ~= before and selPrice and priceLbl and clean(selPrice.Text) == clean(priceLbl.Text) then return true end
			return false
		end
		if accept[before] then return true end   -- the panel already shows it

		local cands, seen = {}, {}
		local function add(b)
			if b and not seen[b] and b:IsA("GuiButton") then seen[b] = true cands[#cands + 1] = b end
		end
		local c = nameLbl or tile
		while c and c ~= list do
			add(c)
			c = c.Parent
		end
		add(tile)
		for _, d in ipairs(tile:GetDescendants()) do add(d) end
		if #cands == 0 then log("[ShopBuy] no clickable button in the tile [" .. pathOf(tile) .. "]") return false end
		for _, b in ipairs(cands) do
			press(b)
			if waitFrames(panelMatches, 1.0) then return true end
		end
		log("[ShopBuy] the detail panel never showed '" .. label .. "' (it shows '" .. selName.Text .. "')")
		return false
	end

	---------------------------------------------------------------- open / close
	local function forceOpen()
		local menu = G("UpgradeMenu_Frame")
		if not menu then return false end
		if HIDDEN then applyHide(true) end   -- hide BEFORE it becomes visible: no flash
		menu.Visible = true
		local sg = menu:FindFirstAncestorOfClass("ScreenGui")
		if sg and not sg.Enabled then sg.Enabled = true end
		task.wait(0.25)
		if uiState("weight") == "closed" then return false end
		task.wait(0.25)   -- the game's own script must not hide it again
		return uiState("weight") ~= "closed"
	end
	local function ensureOpen()
		if uiState("weight") ~= "closed" then
			-- the shop is already open: left over from the previous run (re-execute) or opened by hand. Take it over so it gets hidden
			-- and put away like our own, instead of staying on screen forever (weOpened was false, so it was never hidden).
			if HIDDEN then weOpened = true applyHide(true) end
			return true
		end
		if forceOpen() then weOpened = true return true end
		applyHide(false)
		log("[ShopBuy] showing the shop by script did not stick")
		return false
	end
	local function closeShop()
		if not weOpened then return end
		weOpened = false
		local info = G("UpgradeInfo_Frame")
		if info and isShown(info) then
			local b = buttonOf(child(info, "Back", "TextLabel") or child(info, "Back"))
			if b then press(b) task.wait(0.1) end
		end
		local menu = G("UpgradeMenu_Frame")
		if menu then menu.Visible = false end
		applyHide(false)
	end

	---------------------------------------------------------------- reading the page / buying
	-- (shop open + page open + lock held) -> { best, id, row } | { best, done = true } | nil, reason
	local function scan(kind)
		local cfg, list = cfgs[kind], pageList(kind)
		if not (cfg and list) then return nil, "no page list" end
		local byName, byLabel = buildIndex(list)
		local best, found, sale = 0, 0, {}
		for id = 1, maxId(cfg) do
			local row = rowOf(cfg, id)
			if row and not skipFn(row) then   -- VIP items are ignored completely
				local tile = tileFor(kind, id, row, byName, byLabel)
				if tile then
					found = found + 1
					if tileOwned(tile) then best = id elseif forSale(tile) then sale[#sale + 1] = id end
				end
			end
		end
		if found == 0 then
			local names = {}
			for _, t in ipairs(list:GetChildren()) do names[#names + 1] = t.Name end
			return nil, "no tile matched the config names. Tiles on this page: " .. table.concat(names, ", ")
		end
		local info = { best = best }
		for _, id in ipairs(sale) do
			if id > best then info.id, info.row = id, rowOf(cfg, id) break end
		end
		if not info.id then info.done = true end
		cache[kind] = info
		local brow = best > 0 and rowOf(cfg, best)
		local msg = ("[ShopBuy] %s: best owned #%d '%s' | next for sale %s"):format(kind, best, brow and tostring(brow.Name) or "-",
			info.id and ("#" .. info.id .. " '" .. tostring(info.row.Name) .. "'") or "none")
		if lastScanLog[kind] ~= msg then lastScanLog[kind] = msg log(msg) end
		return info
	end

	local function doBuy(kind, id)
		local cfg = cfgs[kind]
		local row = cfg and rowOf(cfg, id)
		if not row then return false, "norow" end
		if skipFn(row) then return false, "skipped" end
		if not ensureOpen() then return false, "ui" end
		if not openPage(kind) then return false, "ui" end
		local list = pageList(kind)
		if not list then return false, "ui" end
		local byName, byLabel = buildIndex(list)
		local tile = tileFor(kind, id, row, byName, byLabel)
		if not tile then cache[kind] = nil return false, "notile" end
		if not forSale(tile) then cache[kind] = nil return false, "stale" end   -- already owned: the cache was behind
		if not selectTile(tile, list, row) then return false, "ui" end

		local buyText = G("UpgradeInfo_Frame", "Detail", "BuyButton", "BuyText")
		local buyBtn = buttonOf(buyText or G("UpgradeInfo_Frame", "Detail", "BuyButton"))
		if not buyBtn then log("[ShopBuy] can't find Detail.BuyButton") return false, "ui" end
		local shown = buyText and clean(buyText.Text) or "?"
		if shown ~= "buy now" then
			if shown == "owned" or shown == "equipped" then cache[kind] = nil return false, "stale" end
			log("[ShopBuy] the button says '" .. shown .. "', not 'Buy Now'")
			return false, "blocked"
		end
		if not press(buyBtn) then log("[ShopBuy] Buy Now: no click listeners fired") return false, "ui" end

		local function confirmed()
			if kind == "alter" then return (tonumber(stageFn()) or 0) >= id or (tileOwned(tile)) end
			return (tileOwned(tile)) or (tonumber(numFn(kind == "weight" and "BestWeight" or "BestDnk")) or 0) >= id
		end
		local ok = waitFrames(confirmed, 2.5)
		if not ok then   -- the tile may have been rebuilt: look it up again
			local l2 = pageList(kind)
			if l2 then
				local bn, bl = buildIndex(l2)
				local t2 = tileFor(kind, id, row, bn, bl)
				ok = (t2 ~= nil and (tileOwned(t2))) or false
			end
		end
		if ok then
			local prev = cache[kind]
			local best = math.max(prev and prev.best or 0, id)
			local nrow = rowOf(cfg, id + 1)
			cache[kind] = nrow and { best = best, id = id + 1, row = nrow } or { best = best, done = true }
			if kind == "alter" then cache.weight, cache.dna = nil, nil end   -- Body Alter resets weights / DNA: read them again
			return true
		end
		cache[kind] = nil
		return false, "refused"
	end

	---------------------------------------------------------------- the lock (Body Alter first, then Weight, then DNA)
	local function acquire(kind)
		local p = PRIO[kind] or 3
		waiting[p] = waiting[p] + 1
		while alive and (busy or (function() for i = 1, p - 1 do if waiting[i] > 0 then return true end end return false end)()) do
			task.wait()
			if not wantedFn() then break end
		end
		waiting[p] = waiting[p] - 1
		if not alive or busy or not wantedFn() then return false end
		busy = true
		return true
	end
	local function locked(kind, fn)
		if not acquire(kind) then return nil, "busy" end
		local ok, a, b = pcall(fn)
		busy = false
		if not ok then
			log("[ShopBuy] error:", a)
			return nil, "error: " .. tostring(a)
		end
		return a, b
	end

	---------------------------------------------------------------- public
	function S.init(c, o)
		cfgs = c or {}
		o = o or {}
		stageFn = o.stage or stageFn
		numFn = o.num or numFn
		wantedFn = o.wanted or wantedFn
		logFn = o.log or logFn
		skipFn = o.skip or skipFn
	end
	function S.info(kind) return cache[kind] end
	function S.invalidate(kind)
		if kind then cache[kind] = nil else for k in pairs(cache) do cache[k] = nil end end
	end
	function S.setHidden(on)
		HIDDEN = on == true
		if weOpened then pcall(applyHide, HIDDEN) end
	end
	function S.refresh(kind)
		return locked(kind, function()
			if not ensureOpen() then return nil, "the shop would not open" end
			if not openPage(kind) then return nil, "could not open the page" end
			return scan(kind)
		end)
	end
	function S.buy(kind, id)
		return locked(kind, function() return doBuy(kind, id) end)
	end
	function S.stop()
		alive = false
		task.spawn(function()
			local t0 = os.clock()
			while busy and os.clock() - t0 < 10 do task.wait(0.1) end
			busy = true
			pcall(closeShop)
			pcall(applyHide, false)
			busy = false
		end)
	end

	-- nothing wants the shop any more: put it away
	task.spawn(function()
		while alive do
			task.wait(0.5)
			if weOpened and not busy and not wantedFn() then
				busy = true
				pcall(closeShop)
				busy = false
			elseif weOpened and HIDDEN then
				pcall(applyHide, true)   -- keep it hidden: the game (or the previous run's cleanup) may have moved it back on screen
			end
		end
	end)

	return S
end)()

------------------------------------------------------------------ FARMING (ported to Lifting Simulator: REBORN)
-- Remotes (ReplicatedStorage.Events), taken from a real remote log:
--   lift   : quitSafeZone:FireServer()  ->  l:FireServer()          (no weight tool has to be in the hand: the server uses CurrentWeight)
--   sell   : enterSafeZone:FireServer() ->  SellMuscle:InvokeServer()
--   weight : BuyWeight:InvokeServer(id, <the weights config table>, "Weights")   (the server equips the new weight by itself)
--   DNA    : BuyDnk:InvokeServer(id)
--   stage  : BuyStage:InvokeServer(id)        (not in the log yet: id = stage number, from the UpgradeInfo call site)
-- NOTE: weights / DNA / stages are now bought by clicking the shop UI (FX.ShopBuy, hidden off-screen), not with these remotes.
-- Prices, names and counts come from the game's own config modules (ReplicatedStorage.Configs), state from ReplicatedStorage.Data (HUD / leaderstats as fallback).
-- Set DEBUG = false to silence the [WORST Hub] lines in the console.
------------------------------------------------------------------ EVENTS (multipliers: x20 muscle, x10 coins ...)
-- FX.Events.muscle / FX.Events.coins are the multipliers the estimates use. They come from the game's "Game Event" window
-- (Auto Detect Events) or from the boxes on the Events tab. Everything that depends on them reads FX.Events live.
FX.Events = { muscle = 1, coins = 1, auto = true, found = false }
TAB_SCRIPTS.Events = (function()
	local Ev = FX.Events
	local muscleBox, coinsBox, infoRow
	local lastScan = "not scanned yet"

	local function clean(t) return (tostring(t or ""):gsub("<[^>]->", ""):gsub("\195\151", "x"):gsub("^%s+", ""):gsub("%s+$", "")) end
	local function titleKind(low)
		if low:find("muscle%s*multiplier") then return "muscle" end
		if low:find("coins?%s*multiplier") then return "coins" end
	end
	-- looks inside one container for the "xNN" value (and an active / inactive note) that belongs to ONE multiplier
	-- returns value, status ("on" / "off" / nil), or nil, "mixed" when the container also holds the other multiplier's title
	local function readIn(container, kind, own)
		local val, status
		for _, d in ipairs(container:GetDescendants()) do
			if d:IsA("TextLabel") or d:IsA("TextButton") then
				local low = clean(d.Text):lower()
				local k = titleKind(low)
				if k and k ~= kind then return nil, "mixed" end
				if d ~= own then
					local n = low:match("^x%s*(%d+%.?%d*)$")
					if n and not val then val = tonumber(n) end
					if low:find("in%-?active") or low:find("not%s+active") or low:find("expired") or low:find("ended") or low:find("off") and #low < 12 then status = "off"
					elseif low:find("active") then status = status or "on" end
				end
			end
		end
		return val, status
	end

	-- scans PlayerGui for the Game Event window. returns { muscle = {value, status}, coins = {...} }
	local function scan()
		local found = {}
		local pg = player:FindFirstChild("PlayerGui")
		if not pg then return found end
		local n = 0
		for _, d in ipairs(pg:GetDescendants()) do
			n = n + 1
			if n % 800 == 0 then task.wait() end
			if (d:IsA("TextLabel") or d:IsA("TextButton")) and not found[1] then
				local low = clean(d.Text):lower()
				local kind = titleKind(low)
				if kind and not found[kind] then
					-- "Muscle Multiplier x20" in one label?
					local inline = low:match("multiplier%s*x%s*(%d+%.?%d*)")
					local val, status = inline and tonumber(inline), nil
					if not val then
						local node = d.Parent
						for _ = 1, 3 do
							if not node or node == pg then break end
							local v, st = readIn(node, kind, d)
							if st == "mixed" then break end
							if v then val, status = v, st break end
							node = node.Parent
						end
					end
					if not val then   -- flat window (all labels side by side): take the closest "xNN" label under this title
						local gui = d:FindFirstAncestorOfClass("ScreenGui")
						if gui then
							local tc = d.AbsolutePosition + d.AbsoluteSize / 2
							local bestV, bestD
							for _, e in ipairs(gui:GetDescendants()) do
								if e:IsA("TextLabel") then
									local nn = clean(e.Text):lower():match("^x%s*(%d+%.?%d*)$")
									if nn then
										local ec = e.AbsolutePosition + e.AbsoluteSize / 2
										if ec.Y >= tc.Y - 2 then
											local dist = math.abs(ec.X - tc.X) * 2 + (ec.Y - tc.Y)
											if not bestD or dist < bestD then bestV, bestD = tonumber(nn), dist end
										end
									end
								end
							end
							val = bestV
						end
					end
					if val then found[kind] = { val, status } end
				end
			end
		end
		return found
	end

	local function show(m, c)
		if muscleBox and muscleBox._setText then muscleBox._setText(m) end
		if coinsBox and coinsBox._setText then coinsBox._setText(c) end
	end
	local function refreshInfo()
		if infoRow and infoRow._desc then
			infoRow._desc.Text = ("Using: Muscle x%s, Coins x%s.  %s"):format(tostring(Ev.muscle), tostring(Ev.coins), lastScan)
		end
	end

	-- one detection round; true when at least one multiplier was found
	local function detect()
		local ok, res = pcall(scan)
		if not ok then lastScan = "Detection failed: " .. tostring(res) refreshInfo() return false end
		local m, c = res.muscle, res.coins
		if not m and not c then
			Ev.found = false
			lastScan = "Game Event window not found - using your numbers."
			refreshInfo()
			return false
		end
		Ev.found = true
		if m then Ev.muscle = (m[2] == "off") and 1 or m[1] end
		if c then Ev.coins = (c[2] == "off") and 1 or c[1] end
		show(Ev.muscle, Ev.coins)
		lastScan = "Detected from the game's Game Event window."
		refreshInfo()
		return true
	end

	task.spawn(function()
		task.wait(3)
		while alive do
			if Ev.auto then pcall(detect) end
			for _ = 1, 10 do if not alive then return end task.wait(1) end
		end
	end)

	local function numberCallback(key)
		return function(v)
			v = tonumber(v)
			if v and v > 0 then Ev[key] = v refreshInfo() end
		end
	end

	muscleBox = {
		type = "input", name = "Muscle Multiplier", icon = "💪", numeric = true, default = "1", placeholder = "1 = no event",
		desc = "The muscle multiplier of the running event (x20 = type 20). Auto Detect overwrites it; turn that off to keep your own number.",
		callback = numberCallback("muscle"),
	}
	coinsBox = {
		type = "input", name = "Coins Multiplier", icon = "🪙", numeric = true, default = "1", placeholder = "1 = no event",
		desc = "The coins multiplier of the running event (x10 = type 10). Used for the coins per muscle and every time estimate.",
		callback = numberCallback("coins"),
	}
	infoRow = { type = "info", name = "Event Status", icon = "ℹ", desc = "Waiting for the first detection..." }

	return {
		{
			type = "toggle", name = "Auto Detect Events", icon = "📡", default = true,
			desc = "Reads the game's Game Event window every 10 seconds and fills the two boxes below by itself.",
			callback = function(on)
				Ev.auto = on == true
				if Ev.auto then task.spawn(function() pcall(detect) end) else lastScan = "Auto detect is off - using your numbers." refreshInfo() end
			end,
		},
		muscleBox,
		coinsBox,
		{
			type = "button", name = "Detect Now", icon = "🔍", btnText = "Detect",
			desc = "Reads the Game Event window right now.",
			run = function() return detect() end,
		},
		infoRow,
	}
end)()

TAB_SCRIPTS.Farming = (function()
	local RS = game:GetService("ReplicatedStorage")
	local Events = RS:WaitForChild("Events", 10)
	local Status = FX.Status
	local DEBUG = true
	local function dbg(...) if DEBUG then print("[WORST Hub]", ...) end end

	-- every loop remembers the "generation" it was started in, so switching a feature off and on again never leaves two copies running
	local gens = {}
	local function newGen(key) gens[key] = (gens[key] or 0) + 1 return gens[key] end

	------------------------------------------------------------ remotes
	local function remote(name) return Events and Events:FindFirstChild(name) end
	local function fire(name, ...)
		local r = remote(name)
		if r then pcall(r.FireServer, r, ...) end
	end
	-- returns whatever the server answered (nil when the remote is missing or errored)
	local function invoke(name, ...)
		local r = remote(name)
		if not r then return nil end
		local ok, a, b = pcall(r.InvokeServer, r, ...)
		if ok then return a, b end
		dbg(name, "failed:", a)
		return nil
	end

	------------------------------------------------------------ configs + player data
	local function loadCfg(name)
		local ok, m = pcall(function()
			return require(RS:WaitForChild("Configs", 5):WaitForChild(name, 5))
		end)
		if not ok or type(m) ~= "table" then return nil end
		if m[1] == nil and m["1"] == nil and type(m.Data) == "table" then m = m.Data end
		return m
	end
	local WEIGHTS, DNKS, STAGES = loadCfg("WeightsConfig"), loadCfg("DnkConfig"), loadCfg("StagesConfig")
	local function rowOf(cfg, i) return cfg and (cfg[i] or cfg[tostring(i)]) end
	local function countOf(cfg)
		local n = 0
		if cfg then for k in pairs(cfg) do if tonumber(k) and tonumber(k) > n then n = tonumber(k) end end end
		return n
	end

	local function clientData()
		local ok, D = pcall(function() return require(RS:WaitForChild("Data", 5)) end)
		if not ok or type(D) ~= "table" then return nil end
		return D.client or D
	end
	-- The server pushes every data change to the client as OnClientEvent("set", { key, <parents...> }, value) on the DataService remote.
	-- Mirroring those events gives live Coins / BestWeight / BestDnk / Dnk_capacity / Muscle without depending on how the Data module is built.
	local mirror = {}
	task.spawn(function()
		pcall(function()
			local rem = RS:WaitForChild("DataServiceTyped", 10):WaitForChild("Networker", 10):WaitForChild("_remotes", 10)
				:WaitForChild("DataService", 10):WaitForChild("RemoteEvent", 10)
			connect(rem.OnClientEvent, function(kind, path, value)
				if kind == "set" and type(path) == "table" and #path == 1 and type(path[1]) == "string" then
					mirror[path[1]] = value
				end
			end)
		end)
	end)
	-- the value as it was before the script started listening (the Data module's raw table, or a plain field)
	local function snapshot(key)
		local c = clientData()
		if not c then return nil end
		local ok, raw = pcall(rawget, c, "___X")
		if ok and type(raw) == "table" and raw[key] ~= nil then return raw[key] end
		local ok2, v = pcall(function() return c[key] end)
		if ok2 and v ~= nil and type(v) ~= "function" then return v end
		return nil
	end
	local function dataValue(key)
		local m = mirror[key]
		if m ~= nil then return m end
		return snapshot(key)
	end
	local function dataNum(key) return tonumber(dataValue(key)) end

	local function stageValue()
		local ls = player:FindFirstChild("leaderstats")
		local st = ls and ls:FindFirstChild("Stage")
		return (st and tonumber(st.Value)) or dataNum("Stage")
	end
	local function hudText(name)
		local ok, t = pcall(function() return player.PlayerGui.Main_Gui.DataMenu_Frame[name].Status.Text end)
		return ok and type(t) == "string" and t or nil
	end
	local function readCash()
		return dataNum("Coins") or parseShortNumber(hudText("Cash"))
	end
	local function readMuscle()
		return dataNum("Muscle") or (getMuscle())
	end
	local function readCapacity()
		if FX.infiniteSize then return nil end
		local c = dataNum("Dnk_capacity")
		if c then return c end
		local t = hudText("Muscle")
		return t and parseShortNumber(t:match("/%s*(.+)$")) or nil
	end
	local function fmtNum(n)
		for i = #MUSCLE_SUFFIXES, 1, -1 do
			if n >= 10 ^ (3 * i) then
				return string.format("%.2f%s", n / 10 ^ (3 * i), (MUSCLE_SUFFIXES[i]:gsub("^%l", string.upper)))
			end
		end
		return tostring(math.floor(n))
	end

	-- what you own. "Best" = the highest one bought, read from the shop tiles (FX.ShopBuy). The Data counters are only a fallback for
	-- places that cannot open the shop (the Sell If Enough estimate before any buy toggle has run).
	local Shop = FX.ShopBuy
	local function bestWeight()
		local i = Shop.info("weight")
		return (i and i.best) or dataNum("BestWeight") or 1
	end
	local function bestDnk()
		local i = Shop.info("dna")
		return (i and i.best) or dataNum("BestDnk") or 0
	end
	-- the VIP gamepass items (Dumbell weight, Lion DNA) are never bought and never counted as "owned" or as a target, with or without the pass
	local SKIP_NAMES = { dumbell = true, dumbbell = true, lion = true }
	local function skipRow(r)
		if type(r) ~= "table" then return false end
		for _, n in ipairs({ r.Name, r.ToolName }) do
			if n ~= nil and SKIP_NAMES[tostring(n):lower():gsub("%s+", "")] then return true end
		end
		return false
	end

	------------------------------------------------------------ gamepasses
	local PASSES = { DoubleCoin = 1899985213, InfiniteSize = 1899163274, VIP = 1898641277 }
	local hasPass = {}
	local MPS = game:GetService("MarketplaceService")
	for name, id in pairs(PASSES) do
		local ok, owns = pcall(function() return MPS:UserOwnsGamePassAsync(player.UserId, id) end)
		hasPass[name] = ok and owns == true
	end
	FX.infiniteSize = hasPass.InfiniteSize or (function()   -- Infinite Size owners never need to buy DNA (Aphopis is equipped for them)
		local gp = dataValue("gamepasses")
		return type(gp) == "table" and gp.InfiniteSize == true
	end)()
	pcall(function()
		connect(MPS.PromptGamePassPurchaseFinished, function(plr, id, bought)
			if plr ~= player or not bought then return end
			for name, pid in pairs(PASSES) do
				if pid == id then hasPass[name] = true end
			end
			if id == PASSES.InfiniteSize then FX.infiniteSize = true end
		end)
	end)
	local function owns(name)
		local gp = dataValue("gamepasses")
		if type(gp) == "table" and gp[name] ~= nil then return gp[name] == true end
		return hasPass[name] == true
	end

	-- one line in the console so it is easy to see what the script can read
	task.spawn(function()
		task.wait(1.5)
		local function S(v) return tostring(v) end
		dbg(("data: Coins=%s Muscle=%s Stage=%s BestWeight=%s CurrentWeight=%s BestDnk=%s Dnk_capacity=%s | configs: weights=%d dnks=%d stages=%d | passes: DoubleCoin=%s InfiniteSize=%s")
			:format(S(readCash()), S(readMuscle()), S(stageValue()), S(dataNum("BestWeight")), S(dataNum("CurrentWeight")), S(dataNum("BestDnk")), S(readCapacity()),
				countOf(WEIGHTS), countOf(DNKS), countOf(STAGES), S(owns("DoubleCoin")), S(FX.infiniteSize)))
	end)

	------------------------------------------------------------ sell (shared by every sell mode)
	local selling = false
	local measuredRate   -- coins per muscle, measured from real sales (includes the x10 event, the 2x pass, ...)
	local measuredMult   -- the Events tab coins multiplier at the time of that measurement
	local function doSell(reason)
		if selling then return false end
		selling = true
		local m0, c0 = readMuscle(), readCash()
		fire("enterSafeZone")
		task.wait(0.2)
		local r = invoke("SellMuscle")
		task.wait(0.3)
		fire("quitSafeZone")   -- back out, so lifting works again
		local m1, c1 = readMuscle(), readCash()
		if m0 and m1 and m0 - m1 >= 1 then
			-- SellMuscle returns the coins the sale really paid. Use that first: the cash difference is wrong when a buy loop
			-- (Smart Weight / Smart DNA) spends coins during the 0.5 s wait above, which made the rate read ~0.5 instead of 10.
			local gained = tonumber(r)
			if gained and gained > 0 then
				measuredRate = gained / (m0 - m1)
				measuredMult = FX.Events.coins or 1
			elseif c0 and c1 and c1 > c0 then
				measuredRate = (c1 - c0) / (m0 - m1)
				measuredMult = FX.Events.coins or 1
			end
		end
		dbg(("SellMuscle (%s) -> %s | muscle %s -> %s | cash %s -> %s"):format(tostring(reason), tostring(r), tostring(m0), tostring(m1), tostring(c0), tostring(c1)))
		selling = false
		return r
	end

	------------------------------------------------------------ lift: dropdown + Auto Lift
	local LIFT_FAST   = "Gain Muscle (Fast Lifter speed)"
	local LIFT_NORMAL = "Gain Muscle (Normal speed)"
	local LIFT_MAX    = "Gain Muscle (No delay, unsafe)"
	local LIFT_DELAY = { [LIFT_FAST] = 0.43, [LIFT_NORMAL] = 0.7, [LIFT_MAX] = false }   -- false = no delay at all. Not tuned for this game yet.
	local LIFT_SHORT = { [LIFT_FAST] = "fast", [LIFT_NORMAL] = "normal speed", [LIFT_MAX] = "no delay (unsafe)" }
	local liftChoice = LIFT_NORMAL
	local curLiftChoice   -- the speed that is really running (the Macro page can start Fast while the dropdown says Normal)
	local liftToggle

	-- Real lift rate: every lift that is actually sent is time-stamped; the rate is the lifts of the last 3 minutes divided by the time
	-- they covered (selling pauses, lag and FPS / ping wobble are all counted, nothing is hard coded).
	local LIFT_WINDOW, LIFT_MIN_SPAN = 180, 5
	local LIFT_HOLD, LIFT_HOLD_AFTER = 0.02, 30   -- after 30 s of data the shown rate only changes when the measurement moves more than 2%
	local liftStamps, liftHead, liftN, liftStarted, liftShown = {}, 1, 0, nil, nil   -- liftN = last used index (no # on a table with holes)
	local function noteLift()
		local now = os.clock()
		liftN = liftN + 1
		liftStamps[liftN] = now
		while liftHead <= liftN and liftStamps[liftHead] < now - LIFT_WINDOW do liftHead = liftHead + 1 end
		if liftHead > 512 then   -- compact now and then so the table doesn't grow forever at max speed
			local t, k = {}, 0
			for i = liftHead, liftN do k = k + 1 t[k] = liftStamps[i] end
			liftStamps, liftHead, liftN = t, 1, k
		end
	end
	-- measured lifts per second, or nil while there isn't enough data yet (the first seconds after Auto Lift starts)
	local function measuredLiftRate()
		if not liftStarted then return nil end
		local now = os.clock()
		local from = math.max(liftStarted, now - LIFT_WINDOW)
		local span = now - from
		if span < LIFT_MIN_SPAN then return nil end
		local n = 0
		for i = liftHead, liftN do if liftStamps[i] >= from then n = n + 1 end end
		if n < 2 then return nil end
		local raw = n / span
		-- hold the number steady: per minute / hour / day must not flutter with every FPS or ping wobble
		if not liftShown or span < LIFT_HOLD_AFTER or math.abs(raw - liftShown) > liftShown * LIFT_HOLD then liftShown = raw end
		return liftShown
	end

	local function stopLift()
		env.gain = false
		newGen("gain")
		Status.set("lift", nil)
		liftStarted = nil
	end
	local function startLift(choice)   -- choice = a LIFT_* speed, or nothing = whatever the Lifting page dropdown says
		stopLift()
		env.gain = true
		local my = newGen("gain")
		local c = choice or liftChoice
		curLiftChoice = c
		local delay = LIFT_DELAY[c]
		Status.set("lift", "Lifting - " .. (LIFT_SHORT[c] or tostring(c)))
		liftStamps, liftHead, liftN, liftStarted, liftShown = {}, 1, 0, os.clock(), nil
		task.spawn(function()
			fire("quitSafeZone")   -- the server only counts lifts outside the safe zone
			while env.gain and gens.gain == my do
				if selling then
					task.wait(0.05)
				else
					fire("l")
					noteLift()
					if delay then task.wait(delay) else task.wait() end
				end
			end
		end)
	end

	------------------------------------------------------------ sell: dropdown + Auto Sell
	local SELL_EVERY = {
		["Instant"] = 0.1, ["Half Second"] = 0.6, ["Every 1 Second"] = 1, ["Every 3 Seconds"] = 3, ["Every 5 Seconds"] = 5,
		["Every 10 Seconds"] = 10, ["Every 15 Seconds"] = 15, ["Every 30 Seconds"] = 30, ["Every 60 Seconds"] = 60,
		["Every 5 Minutes"] = 300, ["Every 1 Hour"] = 3600,
	}
	local SELL_FULL, SELL_ENOUGH = "Sell If Full", "Sell If Enough"
	local sellChoice = "Every 3 Seconds"
	local sellToggle
	local SELL_RATE = 1.0           -- cash per muscle sold (2x with the DoubleCoin pass). Not measured in this game yet: the console line after every sale shows the real value.
	local function sellRate()   -- coins per muscle, and true when it was measured from a real sale
		-- the event multiplier is part of every measured sale: if it changes afterwards (event over, number typed), the rate follows
		if measuredRate then return measuredRate * ((FX.Events.coins or 1) / (measuredMult or 1)), true end
		return SELL_RATE * (owns("DoubleCoin") and 2 or 1) * (FX.Events.coins or 1), false
	end
	local ENOUGH_MARGIN = 1.02      -- needs 2% more than the price, so a small error in the estimate doesn't waste a sale
	local FULL_AT = 0.98            -- storage this full = sell anyway, so lifting is never wasted

	-- the next things the buy loops want: { name, price }. Only the buy toggles that are ON count (all of them when none is on).
	local SmartWants = {}   -- filled in by the Smart Weight / Smart DNA section below: would that loop really buy this one?
	local function targets()
		local list = {}
		local anyOn = env.BuyWeight or env.BuyDnk or env.BuyStage or env.SmartWeight or env.SmartDNA
		local function add(on, kind, cfg, nextId, label, smartOn, smartKey)
			if anyOn and not (on or smartOn) then return end
			local i = Shop.info(kind)
			if i and i.done then return end
			local r = (i and i.row) or rowOf(cfg, nextId)   -- the shop's own "next for sale" when it has been read
			if r and (r.donate or skipRow(r)) then r = nil end
			-- Smart Weight / Smart DNA only buy what their own rules allow: never sell for something they would refuse to buy
			if r and not on and smartOn and SmartWants[smartKey] and not SmartWants[smartKey](i and i.id or nextId, r) then r = nil end
			local p = r and tonumber(r.Price)
			if p then list[#list + 1] = { name = label .. " " .. tostring(r.Name or nextId), price = p } end
		end
		add(env.BuyWeight, "weight", WEIGHTS, bestWeight() + 1, "weight", env.SmartWeight, "weight")
		if not FX.infiniteSize then add(env.BuyDnk, "dna", DNKS, bestDnk() + 1, "DNA", env.SmartDNA, "dna") end
		add(env.BuyStage, "alter", STAGES, (stageValue() or 0) + 1, "stage")
		return list
	end

	-- "Sell If Full" / "Sell If Enough": sells when the storage is full, and (Enough) when cash + what the muscle sells for covers the next thing to buy
	local function startSmartSell(mode)
		env.Sell = true
		local my = newGen("sell")
		task.spawn(function()
			local lastSale = 0
			local lastMeasure = -math.huge
			local lastWhy
			while env.Sell and gens.sell == my do
				local muscle, cash, cap = readMuscle(), readCash(), readCapacity()
				if not muscle then
					Status.set("sell", "Waiting - can't read your muscle yet")
				else
					local reason
					if cap and muscle >= cap * FULL_AT then reason = "storage full" end
					local rate, measured = sellRate()
					local first
					if mode == SELL_ENOUGH and cash then
						for _, t in ipairs(targets()) do
							first = first or t
							if cash < t.price and cash + muscle * rate >= t.price * ENOUGH_MARGIN then
								reason = reason or ("enough for " .. t.name)
								break
							end
						end
					end
					-- the coins-per-muscle rate is unknown until one real sale (events / passes can make it 20x the base value). Judging by the
					-- guessed rate makes "Enough" think it can never afford anything and never sell, so sell once to measure it.
					if mode == SELL_ENOUGH and not reason and not measured and not FX.Events.found and muscle > 0 and os.clock() - lastMeasure > 30 then   -- not needed when the event window was read: the rate is already known
						lastMeasure = os.clock()
						reason = "measuring the coin rate"
					end
					if not reason and os.clock() - (lastWhy or -1e9) > 10 then   -- every 10 s: why it is NOT selling (console)
						lastWhy = os.clock()
						dbg("Sell waiting |", first and (first.name .. " costs " .. fmtNum(first.price)) or "no target", "| cash", fmtNum(cash or 0),
							"| muscle", fmtNum(muscle), "| coins/muscle", string.format("%.3f", rate), measured and "(measured)" or "(estimated)",
							"| event coins x" .. tostring(FX.Events.coins), "found:", tostring(FX.Events.found),
							"| storage", cap and (fmtNum(muscle) .. "/" .. fmtNum(cap)) or "?")
					end
					if reason then
						Status.set("sell", "Selling (" .. reason .. ")")
					elseif mode == SELL_ENOUGH and first and cash then
						Status.set("sell", ("%s costs %s - cash %s + muscle %s%s"):format(first.name, fmtNum(first.price), fmtNum(cash), fmtNum(muscle * rate),
							(FX.Events.coins or 1) ~= 1 and (" (x%s coins event)"):format(tostring(FX.Events.coins)) or ""))
					elseif cap then
						Status.set("sell", ("Waiting - storage %s / %s"):format(fmtNum(muscle), fmtNum(cap)))
					else
						Status.set("sell", "Waiting - can't read your storage size")
					end
					if reason and os.clock() - lastSale > 3 then
						lastSale = os.clock()
						doSell(reason)
						if gens.sell ~= my then break end
					end
				end
				task.wait(0.5)
			end
			if gens.sell == my then Status.set("sell", nil) end
		end)
	end

	local function stopSell()
		env.Sell = false
		newGen("sell")
		Status.set("sell", nil)
	end
	local function startSell()
		stopSell()
		if sellChoice == SELL_FULL or sellChoice == SELL_ENOUGH then startSmartSell(sellChoice) return end
		local interval = SELL_EVERY[sellChoice]
		if not interval then return end
		env.Sell = true
		local my = newGen("sell")
		task.spawn(function()
			local last = tick()
			while env.Sell and gens.sell == my do
				local left = interval - (tick() - last)
				if left <= 0 then
					doSell("timer")
					last = tick()
					left = interval
				end
				if interval < 2 then
					Status.set("sell", "Selling constantly (" .. tostring(sellChoice) .. ")")
				else
					Status.set("sell", "Waiting for the next sale", left)
				end
				task.wait(0.1)
			end
		end)
	end

