	do
		local BLACKLIST = { "Athena", "Cronus", "Hades", "Hercules", "Poseidon", "Zeus", "Ares", "Fists", "Stomp" }
		local COMBAT = { Fists = true, Stomp = true }   -- held on purpose (Auto Kill / Auto Attack): never swapped away from
		local PAUSE_FOR_COMBAT = false   -- false = ALWAYS keep the weight equipped (even over Fists / Stomp). true = leave Fists / Stomp alone
		-- The real weights come from the game's own list (ReplicatedStorage.Configs.WeightsConfig: every row's Name / ToolName),
		-- so a god weapon or any other tool is never mistaken for a weight. weightRank maps tool name (lowercase) -> weight number.
		-- If that list can't be read, it falls back to the BLACKLIST above (every tool that is not on it counts as a weight).
		local weightRank
		local weightsTried = false
		local function loadWeightNames()
			if weightsTried then return end
			weightsTried = true
			local ok, m = pcall(function()
				return require(game:GetService("ReplicatedStorage"):WaitForChild("Configs", 5):WaitForChild("WeightsConfig", 5))
			end)
			if not ok or type(m) ~= "table" then
				warn("[WORST Hub] Auto Equip Weight: couldn't read WeightsConfig, using the name blacklist instead.")
				return
			end
			if m[1] == nil and m["1"] == nil and type(m.Data) == "table" then m = m.Data end
			local rank, n = {}, 0
			for k, row in pairs(m) do
				local id = tonumber(k)
				if id and type(row) == "table" then
					for _, nm in ipairs({ row.ToolName, row.Name }) do
						if nm then
							rank[tostring(nm):lower()] = id
							n += 1
						end
					end
				end
			end
			if n > 0 then
				weightRank = rank
				print(("[WORST Hub] Auto Equip Weight: %d weight names read from WeightsConfig."):format(n))
			else
				warn("[WORST Hub] Auto Equip Weight: WeightsConfig had no names, using the name blacklist instead.")
			end
		end
		local function isWeight(item)
			if not item:IsA("Tool") or COMBAT[item.Name] then return false end
			if weightRank then return weightRank[item.Name:lower()] ~= nil end
			return not table.find(BLACKLIST, item.Name)
		end

		-- the tool in your hand right now: weight (true), Fists / Stomp (false, name), or nothing (nil)
		local function inHand()
			local ch = player.Character
			if not ch then return nil end
			for _, item in ipairs(ch:GetChildren()) do
				if item:IsA("Tool") then return item end
			end
			return nil
		end
		local function weightInBackpack()
			local bp, found, bestId = getBackpack(), nil, -1
			if bp then
				for _, item in ipairs(bp:GetChildren()) do
					if isWeight(item) then
						local id = weightRank and weightRank[item.Name:lower()] or 0
						if id >= bestId then found, bestId = item, id end   -- the highest weight; without the list, the last one
					end
				end
			end
			return found
		end
		-- equips the weight and checks it really arrived in your hand. Returns state, name:
		--   "held" (already / now in your hand) | "failed" (could not equip it) | "none" (no weight in the backpack)
		local function equipWeight()
			local hand = inHand()
			if hand and isWeight(hand) then return "held", hand.Name end
			local tool = weightInBackpack()
			if not tool then return "none" end
			local hum = getHum()
			if not hum then return "failed", tool.Name end
			for _ = 1, 3 do
				pcall(function() hum:EquipTool(tool) end)
				local t0 = os.clock()
				repeat task.wait(0.05) until tool.Parent == player.Character or os.clock() - t0 > 0.5
				if tool.Parent == player.Character then return "held", tool.Name end
			end
			return "failed", tool.Name
		end
