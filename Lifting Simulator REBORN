			local TOOL_SKIP = { "Fists", "Fist", "Stomp", "Foot" }
			local function findWeightTool(name)
				local ch, bp = player.Character, player:FindFirstChildOfClass("Backpack")
				local list = {}
				for _, box in ipairs({ ch, bp }) do
					if box then
						for _, t in ipairs(box:GetChildren()) do
