			-- ------------------------------------------------ recommendation
			local function recommend(gps, atMax)
				local f = FX.farm
				if not f then return "Waiting for the macro to load..." end
				local cash, muscle = f.cash(), muscleNow()
				if not (cash and muscle) then return "Can't read your cash or muscle yet." end
				local sellRate = f.sellRate()
				local have = cash + muscle * sellRate
				local target, what
				if altPrice and altN then target, what = altPrice, "Body Alter stage " .. altN end
				if not target then
					if atMax then return "You bought the last Body Alter. Reborn: Coming soon?" end
					return "Keep lifting and buying weights. Turn on the Macro page toggles to automate lifting and selling."
				end
				if have >= target then
					return "You can afford " .. what .. " right now. Sell your muscle and buy it (Auto Body Alter does this)."
				end
				if not gps or gps <= 0 then return "Measuring your gain per lift for " .. what .. "..." end
				local smartOn = f.smartWeightOn and f.smartWeightOn()
				local eta
				if smartOn and rbDeadline and rbFor == target and os.clock() - rbGood < 10 then
					eta = math.max(rbDeadline - os.clock(), 0)   -- same countdown as the tile (includes the weights Smart Weight buys on the way)
				else
					eta = (target - have) / (gps * sellRate)       -- no weight purchases counted
				end
				if eta ~= eta or eta > 12960000 then return "Next: " .. what .. " - calculating..." end
				local msg = ("Next: %s in about %s%s."):format(what, dur(eta), smartOn and "" or " at your current lift speed")
				if not smartOn and eta > 3 * 3600 then msg = msg .. " That's slow: turn on Smart Weight so you keep buying the best weight." end
				return msg
