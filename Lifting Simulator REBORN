			-- base gain of a weight: read from the game's weight config (FX.farm.weightGain). nil = unknown, then a weight change just re-measures.
			local function gainOfWeight(idx)
				local f = FX.farm
				return f and f.weightGain and f.weightGain(idx) or nil
			end

			-- Seconds until `have` coins reach `target` (the next Body Alter price), while Smart Weight buys on the way: it always buys the most expensive weight it can
			-- afford (not above `cap`), every purchase costs coins and raises the income. `unit` = coins per second for each point of weight gain
			-- (gain multiplier x lifts per second x sell rate), so the lift speed is part of every step. nil when something can't be read.
			local function simulateTarget(f, have, target, unit, top, cap)
				local shop = f.shop()
				if #shop == 0 then return nil end
				local cands = {}
				for _, w in ipairs(shop) do
					if w.idx > top and w.idx <= cap and not w.has and w.price and not f.skipWeight(w.idx) and gainOfWeight(w.idx) then
						cands[#cands + 1] = w
					end
				end
				local t, h, cur = 0, have, top
				for _ = 1, #cands + 2 do
					if h >= target then return t end
					while true do   -- buy everything Smart Weight would buy right now
						local best
						for _, w in ipairs(cands) do
							if w.idx > cur and w.price <= h and (not best or w.price > best.price) then best = w end
						end
						if not best then break end
						h, cur = h - best.price, best.idx
					end
					local g = gainOfWeight(cur)
					local rate = g and g * unit
					if not rate or rate <= 0 then return nil end
					local dtTarget = (target - h) / rate
					local nextW   -- the cheapest weight above the one in your hand is the next one to become affordable
					for _, w in ipairs(cands) do
						if w.idx > cur and (not nextW or w.price < nextW.price) then nextW = w end
					end
					if not nextW then return t + dtTarget end
					local dtW = (nextW.price - h) / rate
					if dtW >= dtTarget then return t + dtTarget end
					t, h = t + dtW, nextW.price
				end
				return t
			end
