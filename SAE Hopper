local function moneyText(value)
	local v = tonumber(value) or 0
	local units = { "K", "M", "B", "T", "Qd", "Qi" }
	local u = 0
	while v >= 1000 and u < #units do
		v = v / 1000
		u = u + 1
	end
	local s
	if u == 0 then
		s = ("%d"):format(v)
	elseif v >= 100 then
		s = ("%.0f%s"):format(v, units[u])
	elseif v >= 10 then
		s = ("%.1f%s"):format(v, units[u])
	else
		s = ("%.2f%s"):format(v, units[u])
	end
	return "$" .. s .. "/s"
end

local function formatKg(n)
	n = math.floor(tonumber(n) or 0)
	local s = tostring(n)
	local i = #s % 3
	if i == 0 then i = 3 end
	local out = s:sub(1, i)
	for j = i + 1, #s, 3 do
		out = out .. "," .. s:sub(j, j + 2)
	end
	return out
end

local function mutationText(hit)
	local m = hit.record and hit.record.Mutations
	if type(m) == "table" and #m > 0 then
		local parts = {}
		for _, id in ipairs(m) do
			parts[#parts + 1] = tostring(id)
		end
		return table.concat(parts, ", ")
	end
	return "NONE"
end

