    local entry = getEntry(cat)

    local keys = { norm(cat) }
    if type(entry) == "table" then
        keys[#keys + 1] = norm(entry.DisplayName)
        keys[#keys + 1] = norm(entry._id)
    end
    for _, k in ipairs(keys) do
