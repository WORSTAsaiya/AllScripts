-- trims spaces so a role of " " (blank) is treated as "no ping"
local function cleanRole(r)
    if type(r) ~= "string" then return "" end
    return (r:match("^%s*(.-)%s*$")) or ""
end

-- Role pings by egg weight (kg). First match from the top wins.
local KG_PINGS = {
    { min = 10000000, role = "1556964378094338079" },
    { min = 100000,  role = "1556964342656671805" },
    { min = 1,       role = "1556964297983397900" },
}

local function kgRole(kg)
    if type(kg) ~= "number" then return "" end
    for _, t in ipairs(KG_PINGS) do
        if kg >= t.min then return cleanRole(t.role) end
    end
    return ""
end

-- Role pings by egg value (money/s, includes mutation bonuses). First match wins.
local VALUE_PINGS = {
    { min = 10e9, role = "1557748763710332949" },  -- 10B or more
    { min = 1e9,   role = "1557748744005361704" },  -- 1B - 10B
    { min = 1,     role = "1557748744005361704" },  -- 1 - 1B
}

local function valueRole(value)
    if type(value) ~= "number" then return "" end
    for _, t in ipairs(VALUE_PINGS) do
        if value >= t.min then return cleanRole(t.role) end
    end
    return ""
end

