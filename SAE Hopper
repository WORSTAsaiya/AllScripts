-- Which account is reporting: shown in every webhook footer so multi-account
-- posts can be told apart. Username (not display name) - it's stable.
local function reporterName()
	local lp = Players.LocalPlayer
	if lp then
		local ok, n = pcall(function() return lp.Name end)
		if ok and type(n) == "string" and n ~= "" then
			return n
		end
	end
	return "unknown"
end

local ACCT_TAG   = reporterName()

-- ------------------------------------------------------------------ environment

local function genv()
	local ok, g = pcall(getgenv)
	if ok and type(g) == "table" then
		return g
	end
	return nil
end

-- Stop it from anywhere with:  getgenv().EGG_GRABBER_STOP = true
-- The webhook can also be set by the loader (getgenv().EGG_RELAY_WEBHOOK = "..."),
-- so a publicly hosted copy of this file does not have to contain it.
local function relayWebhook()
	local g = genv()
	local o = g and g.EGG_RELAY_WEBHOOK
	if type(o) == "string" and o ~= "" then
		return o
	end
	return CONFIG.RELAY_WEBHOOK or ""
end

-- Same idea for the download link: the loader can set getgenv().EGG_SCRIPT_URL, so
-- the hosted file itself needs no edits.
local function scriptUrl()
	local g = genv()
	local o = g and g.EGG_SCRIPT_URL
	if type(o) == "string" and o ~= "" then
		return o
	end
	return CONFIG.SCRIPT_URL or ""
end

local function stopped()
	local g = genv()
	return g ~= nil and g.EGG_GRABBER_STOP == true
end

-- ------------------------------------------------------------------ file helpers
--
-- Delta ships readfile/writefile/appendfile, but a limited build might not.
-- Every file touch goes through these so a missing function never kills the run.

local function safeRead(path)
	if type(readfile) ~= "function" then return nil end
	local ok, content = pcall(readfile, path)
	if ok and type(content) == "string" then
		return content
	end
	return nil
end

local function safeWrite(path, data)
	if type(writefile) ~= "function" then return false end
	return (pcall(writefile, path, data))
end

local function safeAppend(path, data)
	if type(appendfile) ~= "function" then return false end
	return (pcall(appendfile, path, data))
end

local function parseRoleIds(v)
	local out = {}
	if type(v) == "table" then
		for _, x in ipairs(v) do
			local s = tostring(x):match("(%d+)")
			if s and s ~= "" then
				out[#out + 1] = s
			end
		end
		return out
	end
	if v == nil then
		return out
	end
	local s = tostring(v)
	for id in s:gmatch("(%d+)") do
		out[#out + 1] = id
	end
	return out
end

local function roleMentionContent(ids)
	local parts = {}
	for i = 1, #ids do
		parts[i] = "<@&" .. ids[i] .. ">"
	end
	return table.concat(parts, " ")
end

local function log(msg)
	print("[egg-grabber] " .. msg)
	safeAppend(LOG, os.date("!%H:%M:%S") .. "  " .. msg .. "\n")
end

local TRACKER_ID_FILE = nil
local trackerMsgId = nil
local lastEggSentAt = os.clock()
local eggsSentThisRun = 0
local lastTrackerPostAt = 0

local function loadTrackerId()
	pcall(function()
		if not ACCT_TAG then return end
		TRACKER_ID_FILE = ("egg-grabber-tracker-id-%s.txt"):format(ACCT_TAG)
		local ok, c = pcall(readfile, TRACKER_ID_FILE)
		if ok and type(c) == "string" then
			c = c:gsub("%s+", "")
			if c:match("^%d+$") then
				trackerMsgId = c
			end
		end
	end)
end

local function saveTrackerId(id)
	pcall(function()
		if not id or not TRACKER_ID_FILE then return end
		trackerMsgId = tostring(id)
		pcall(writefile, TRACKER_ID_FILE, trackerMsgId)
	end)
end

loadTrackerId()

local function sendBotTracker(force)
	pcall(function()
		if not CONFIG or not CONFIG.WEBHOOK_TRACKER then return end
		if CONFIG.WEBHOOK_TRACKER == "" or CONFIG.WEBHOOK_TRACKER:find("PASTE_YOUR", 1, true) then
			return
		end
		if not force and lastTrackerPostAt ~= 0 and os.clock() - lastTrackerPostAt < (CONFIG.TRACKER_MIN_INTERVAL or 15) then
			return
		end

		local now = os.clock()
		local ago = math.floor(now - lastEggSentAt)
		local agoText
		if ago < 60 then
			agoText = ago .. "s ago"
		elseif ago < 3600 then
			agoText = math.floor(ago / 60) .. "m " .. (ago % 60) .. "s ago"
		else
			agoText = math.floor(ago / 3600) .. "h " .. math.floor((ago % 3600) / 60) .. "m ago"
		end

		local botName = reporterName()
		local jobId = game.JobId
		if type(jobId) == "string" and #jobId > 8 then
			jobId = jobId:sub(1, 8) .. "..."
		end

		local payload = {
			username = "Bot Tracker",
			embeds = {
				{
					title = "Egg Hunter Status",
					color = 0x2ECC71,
					fields = {
						{ name = "Bot", value = botName .. " (" .. tostring(ACCT_TAG or "unknown") .. ")", inline = true },
						{ name = "Last Egg Sent", value = agoText, inline = true },
						{ name = "Eggs This Run", value = tostring(eggsSentThisRun), inline = true },
						{ name = "Server", value = "`" .. tostring(jobId) .. "`", inline = true },
						{ name = "Time", value = os.date("!%H:%M:%S UTC"), inline = true },
					},
					footer = { text = "Live tracker • Updates on egg sends" },
					timestamp = os.date("!%Y-%m-%dT%H:%M:%SZ"),
				}
			},
			allowed_mentions = { parse = {} }
		}

		local body = jsonEncode(payload)
		if not body then return end

		if trackerMsgId and trackerMsgId ~= "" then
			local editUrl = CONFIG.WEBHOOK_TRACKER .. "/messages/" .. trackerMsgId
			pcall(httpRequest, {
				Url = editUrl,
				Method = "PATCH",
				Headers = { ["Content-Type"] = "application/json" },
				Body = body,
			})
		else
			local ok, res = pcall(httpRequest, {
				Url = CONFIG.WEBHOOK_TRACKER,
				Method = "POST",
				Headers = { ["Content-Type"] = "application/json" },
				Body = body,
			})
			if ok and type(res) == "table" and res.Body then
				local ok2, data = pcall(jsonDecode, res.Body)
				if ok2 and type(data) == "table" and data.id then
					saveTrackerId(data.id)
				end
			end
		end

		lastTrackerPostAt = os.clock()
	end)
end

-- In-game notifications (the Delta/cloud-phone console can stay blank, so
-- key progress is also shown top-right). Rate-limited: extras inside the
-- window are dropped, never queued.
local lastNotifyAt = 0
local NOTIFY_COOLDOWN = 5

local function notify(text)
	if os.clock() - lastNotifyAt < NOTIFY_COOLDOWN then
		return
	end
	lastNotifyAt = os.clock()
	pcall(function()
		game:GetService("StarterGui"):SetCore("SendNotification", {
			Title = "egg grabber",
			Text = tostring(text):sub(1, 120),
			Duration = 5,
		})
	end)
end

-- Bypasses the cooldown: one-shot diagnostics must never be dropped.
local function notifyForce(text)
	lastNotifyAt = os.clock()
	pcall(function()
		game:GetService("StarterGui"):SetCore("SendNotification", {
			Title = "egg grabber",
			Text = tostring(text):sub(1, 120),
			Duration = 5,
		})
	end)
end

-- Staying-put reasons repeat every poll, so they get their own slower
-- cooldown instead of the regular one. Still always surfaces eventually.
local lastStayNotifyAt = 0
local STAY_NOTIFY_COOLDOWN = 30

local function notifyStay(reason)
	if os.clock() - lastStayNotifyAt < STAY_NOTIFY_COOLDOWN then
		return
	end
	lastStayNotifyAt = os.clock()
	notifyForce("staying put: " .. tostring(reason):sub(1, 60))
end

-- ------------------------------------------------------------------ http / json

local httpRequest = (syn and syn.request)
	or (http and http.request)
	or (fluxus and fluxus.request)
	or http_request
	or request

local function jsonEncode(tbl)
	local ok, s = pcall(function() return HttpService:JSONEncode(tbl) end)
	if ok and type(s) == "string" then
		return s
	end
	if type(json) == "table" and json.encode then
		local ok2, s2 = pcall(json.encode, tbl)
		if ok2 then return s2 end
	end
	return nil
end

local function jsonDecode(text)
	local ok, t = pcall(function() return HttpService:JSONDecode(text) end)
	if ok and type(t) == "table" then
		return t
	end
	if type(json) == "table" and json.decode then
		local ok2, t2 = pcall(json.decode, text)
		if ok2 then return t2 end
	end
	return nil
end

-- ------------------------------------------------------------------ teleport queue

local function queueOnTeleport(code)
	local fn = queue_on_teleport or queueonteleport
	if not fn and syn then
		fn = syn.queue_on_teleport or syn.queueonteleport
	end
	if type(fn) == "function" then
		return (pcall(fn, code))
	end
