		return tostring(n)
	end
	return "unknown"
end

local function bossAliveCheck(inst)
	local okH, hum = pcall(function()
		return inst:FindFirstChildOfClass("Humanoid")
	end)
	if okH and hum then
		local okHp, hp = pcall(function() return hum.Health end)
		if okHp and type(hp) == "number" and hp <= 0 then
			return false
		end
	end
	return true
end

local function scanBossActive()
	local ok, active, evidence = pcall(function()
		local ws = game:GetService("Workspace")
		-- Fast path: exact known names (C-side recursive search, cheap).
		local exact = { "Dr. Scramble", "Dr Scramble", "Dr. Scrambler", "Dr Scrambler" }
		for _, nm in ipairs(exact) do
			local okF, found = pcall(function()
				return ws:FindFirstChild(nm, true)
			end)
			if okF and found then
				if bossAliveCheck(found) then
					return true, bossEvidencePath(found)
				end
			end
		end
		-- Fallback: single Workspace pass, early-out on first "scrambler" hit.
		-- ("Scrambled" eggs do NOT contain "scrambler", so they can't match.)
		for _, v in ipairs(ws:GetDescendants()) do
			local okN, n = pcall(function() return v.Name end)
			if okN and type(n) == "string" then
				local nl = n:lower()
				if not nl:find("egg", 1, true) then
					if nl == "dr. scramble" or nl == "dr scramble" or nl:find("scrambler", 1, true) then
						if bossAliveCheck(v) then
							return true, bossEvidencePath(v)
						end
					end
				end
			end
		end
		return false, nil
	end)
	if not ok then
		return false, nil
	end
	return active == true, evidence
end

