local entryCache = {}
local function getEntry(cat)
    cat = tostring(cat or "")
    if cat == "" then return nil end
    local cached = entryCache[cat]
    if cached ~= nil then return cached or nil end

    local entry = assetDir[cat]
    if entry == nil then
        local want = norm(cat)
        for key, e in pairs(assetDir) do
            if type(e) == "table" then
                local egg = type(e.Egg) == "table" and e.Egg or nil
                if norm(key) == want or norm(e._id) == want or norm(e.DisplayName) == want
                    or (egg and norm(egg.ModelName) == want) then
                    entry = e
                    break
                end
            end
        end
    end
    entryCache[cat] = entry or false
    return entry
end

