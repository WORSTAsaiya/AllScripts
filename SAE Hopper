local function eggKg(r)
    if not EggRecords then return nil end
    local ok, kg = pcall(EggRecords.WeightKg, r)
    if ok and type(kg) == "number" then return kg end
    ok, kg = pcall(EggRecords.WeightKgForScale, r.AssetCategory, r.AssetScale)
    if ok and type(kg) == "number" then return kg end
    return nil
end

local KG_SUFFIXES = { "", "K", "M", "B", "T", "Qa", "Qi" }

-- full number with commas, e.g. 1,092,052 Kg
local function formatKg(kg)
    if not kg then return "?" end
    local text = string.format("%.0f", math.max(kg, 0))
    local count
    repeat
        text, count = text:gsub("^(%d+)(%d%d%d)", "%1,%2")
    until count == 0
    return text .. " Kg"
end

-- ---------------- debug dump + mutation ----------------
local function dumpTable(t, indent, depth)
    indent = indent or "  "
    depth = depth or 0
    for k, v in pairs(t) do
        if type(v) == "table" and depth < 2 then
            print(indent .. tostring(k) .. " = {")
            dumpTable(v, indent .. "  ", depth + 1)
            print(indent .. "}")
        else
            print(indent .. tostring(k) .. " = " .. tostring(v))
        end
    end
end

-- best guess at common field names; if your egg uses a different one,
-- turn on DEBUG_DUMP, find the real name and add it here
local MUTATION_KEYS = { "Mutation", "Mutations", "Variant", "Modifier", "Modifiers", "Trait", "Traits" }

local function eggMutation(r)
    for _, key in ipairs(MUTATION_KEYS) do
        local v = r[key]
        if v ~= nil and v ~= false and v ~= "" then
            if type(v) == "table" then
                local parts = {}
                for k2, v2 in pairs(v) do
                    if type(k2) == "string" then
                        parts[#parts + 1] = k2
                    elseif type(v2) == "table" then
                        parts[#parts + 1] = tostring(v2.DisplayName or v2._id or "?")
                    else
                        parts[#parts + 1] = tostring(v2)
                    end
                end
                if #parts > 0 then return table.concat(parts, ", ") end
            else
                return tostring(v)
            end
        end
    end
    return nil
end

-- ---------------- egg value (money/s) ----------------
local MONEY_SUFFIX = { "", "K", "M", "B", "T", "Qa", "Qi" }

local function formatMoney(n)
    local i = 1
    while n >= 1000 and i < #MONEY_SUFFIX do
        n = n / 1000
        i = i + 1
    end
    return string.format("$%.2f%s/s", n, MONEY_SUFFIX[i])
end

-- variants and mutations stack additively: 1 + sum(each multiplier - 1)
local function bonusMult(mutation)
    local total = 1
    if mutation then
        for name in tostring(mutation):gmatch("[^,]+") do
            local m = BONUS[norm(name)]
            if m then total = total + (m - 1) end
        end
    end
    return total
end

-- returns income without bonuses, and income with bonuses (or nil if unknown)
local function eggIncome(info, kg, mutation)
    local b = EGG_BASE[norm(info.display)]
    if not b or type(kg) ~= "number" or kg <= 0 then return nil end
    local ratio = kg / b.weight
    local weightMult
    -- 37/60 fits eggs at 89% and 95% of base weight and above (checked up to 125x).
    -- 5/3 fits eggs at 0.02% to 1.9% of base weight. The real switch point is somewhere
    -- in between and not known yet, so LOW_CUTOFF is a guess.
    local LOW_CUTOFF = 0.5
    local HIGH_CUTOFF = 125
    if ratio > HIGH_CUTOFF then
        weightMult = (HIGH_CUTOFF ^ (37 / 60)) * ((ratio / HIGH_CUTOFF) ^ 0.40)
    elseif ratio > LOW_CUTOFF then
        weightMult = ratio ^ (37 / 60)
    else
        weightMult = ratio ^ (5 / 3)
    end
    local base = b.income * weightMult
    return base, base * bonusMult(mutation)
end

local function eggValueText(info, kg, mutation)
    local base, final = eggIncome(info, kg, mutation)
    if not base then return "Unknown" end
    if mutation and final ~= base then
        return formatMoney(base) .. " -> " .. formatMoney(final)
    end
    return formatMoney(final)
end

