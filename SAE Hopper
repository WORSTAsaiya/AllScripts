end

local function clearTeleportQueue()
	local fn = clear_teleport_queue or clearteleportqueue
	if not fn and syn then
		fn = syn.clear_teleport_queue
	end
	if type(fn) == "function" then
		pcall(fn)
	end
end

-- Runs in the NEW game after a hop. Tries every reload path Delta offers so a
-- hop never leaves you with a dead script. If none work, the AutoExec file is
-- the only thing that can bring it back (see egg-grabber-delta-autoexec.lua).
local BOOTSTRAP = ([==[
local path = "__SELF__"
local url  = "__URL__"
local g = getgenv and getgenv() or _G
if g.EGG_GRABBER_RUNNING ~= true then
	local loaded = false

	-- 1) re-download from the hosted link (needs nothing saved on this device)
	if url ~= "" then
		for _ = 1, 3 do
			local src
			local okG, body = pcall(function() return game:HttpGet(url) end)
			if okG and type(body) == "string" and #body > 200 then
				src = body
			else
				local rq = request or http_request or (syn and syn.request) or (http and http.request)
				if rq then
					local okR, res = pcall(rq, { Url = url, Method = "GET" })
					if okR and type(res) == "table" and (res.StatusCode or res.status) == 200
						and type(res.Body) == "string" and #res.Body > 200 then
						src = res.Body
					end
				end
			end
			if src then
				local loader = loadstring or load
				local f = loader and loader(src)
				if f then loaded = pcall(f) end
			end
			if loaded then break end
			task.wait(2)
		end
	end

	-- 2) fall back to the file in the workspace
	if not loaded and type(loadfile) == "function" then
		local ok, f = pcall(loadfile, path)
		if ok and type(f) == "function" then
			loaded = pcall(f)
		end
	end
	if not loaded and type(readfile) == "function" then
		local ok, src = pcall(readfile, path)
		if ok and type(src) == "string" then
			local loader = loadstring or load
			if loader then
				local f = loader(src)
				if f then loaded = pcall(f) end
			end
		end
	end
	if not loaded and type(dofile) == "function" then
		loaded = pcall(dofile, path)
	end
	if not loaded then
		warn("[egg-grabber] teleport bootstrap could not reload the script - set CONFIG.SCRIPT_URL, save " .. path .. " in the workspace, or use AutoExec")
	end
end
]==]):gsub("__SELF__", SELF):gsub("__URL__", function() return scriptUrl() end)

-- The code queued for the next server: carries the relay webhook forward (getgenv
-- is wiped on every teleport) and then reloads the script.
local function bootstrapCode()
	local prefix = ""
	local hook = relayWebhook()
	if hook ~= "" then
		prefix = ("pcall(function() getgenv().EGG_RELAY_WEBHOOK = %q end)\n"):format(hook)
	end
	return prefix .. BOOTSTRAP
end

-- ------------------------------------------------------------------ persistent logs

-- Every egg already reported, keyed by server + egg uid. Lives on disk so a hop
-- (which reloads this whole script) does not re-report the same egg. If the file
-- helpers are missing we keep an in-memory copy instead; that only forgets when
-- the game reloads.
local POSTED_LOG  = "egg-grabber-delta-posted.txt"
local memoryPosted = {}

local function readPosted()
	local posted = {}
	local content = safeRead(POSTED_LOG)
	if content then
		for key in content:gmatch("[^\r\n]+") do
			posted[key] = true
		end
	end
	for key in pairs(memoryPosted) do
		posted[key] = true
	end
	return posted
end

local function postedKey(record)
	-- Key must be unique PER SPAWN. Relying on Uid alone breaks when Uid is nil
	-- or shared: the key collapses to "JobId:nil" and every extra egg on the
	-- server is treated as already-reported (only the first ever posts).
	local uid = tostring(record.Uid or "")
	local cat = tostring(record.AssetCategory or "")
	local scale = tostring(record.AssetScale or "")
	local mut = ""
	if type(record.Mutations) == "table" then
		local parts = {}
		for _, m in ipairs(record.Mutations) do
			parts[#parts + 1] = tostring(m)
		end
		mut = table.concat(parts, ",")
	end
	return table.concat({ game.JobId, uid, cat, scale, mut }, ":")
end

local function rememberPosted(record)
	local key = postedKey(record)
	memoryPosted[key] = true
	safeAppend(POSTED_LOG, key .. "\n")
end

-- The server we just teleported out of (rolling, one entry): the self-bounce
-- guard that stops us aiming straight back at the instance we just left.
local LEFT_LOG = "egg-grabber-delta-left.txt"

local function writeLeft(jobId)
	safeWrite(LEFT_LOG, jobId)
end

local function readLeft()
	local content = safeRead(LEFT_LOG)
	if content then
		return content:match("[^%s]+")
	end
	return nil
end

-- Wall-clock stamp of the last join attempt. On disk on purpose: getgenv does
-- not survive a teleport, and the whole point is to measure the gap ACROSS one
-- (a landing we reject can re-hop seconds after arriving).
local JOIN_LOG = "egg-grabber-delta-lastjoin.txt"

local function stampJoin()
	safeWrite(JOIN_LOG, tostring(os.time()))
end

local function readJoinStamp()
	local content = safeRead(JOIN_LOG)
	local n = content and tonumber(content:match("%d+"))
	return n or 0
end

-- Per-account rolling memory of the last few servers we landed on.
local VISITED_MAX = 10
local memoryVisited = {}

local function visitedFile()
	local id = Players.LocalPlayer and Players.LocalPlayer.UserId or "unknown"
	return ("egg-grabber-delta-visited-%s.txt"):format(id)
end

local function readVisited()
	local list = {}
	local content = safeRead(visitedFile())
	if content then
		for line in content:gmatch("[^\r\n]+") do
			local id = line:match("^%s*([^%s]+)%s*$")
			if id and id ~= "" and #list < VISITED_MAX then
				list[#list + 1] = id
			end
		end
	end
	for _, id in ipairs(memoryVisited) do
		if #list >= VISITED_MAX then break end
		list[#list + 1] = id
	end
	return list
end

local function rememberVisit(jobId)
	if not jobId then return end
	local list = readVisited()
	local out = {}
	for _, id in ipairs(list) do
		if id ~= jobId then out[#out + 1] = id end
	end
	out[#out + 1] = jobId
	if #out > VISITED_MAX then
		local trimmed = {}
		for i = #out - VISITED_MAX + 1, #out do
			trimmed[#trimmed + 1] = out[i]
		end
		out = trimmed
	end
	memoryVisited = out
	safeWrite(visitedFile(), table.concat(out, "\n"))
end

-- Simple account identifier for per-account hash rotation.
local function selfId()
	local lp = Players.LocalPlayer
	if lp then
		return tostring(lp.UserId)
	end
	return nil
end

-- Per-account rolling memory of servers that refused us (279 / timed out / "failed").
-- Survives hops so we don't keep re-trying dead servers across hours of running.
local FAILED_TTL = 3600 -- 1 hour

local function failedFile()
	local id = selfId() or "unknown"
	return ("egg-grabber-delta-failed-%s.txt"):format(id)
end

local function readFailed()
	local list = {}
	local content = safeRead(failedFile())
	if content then
		local now = os.time()
		for line in content:gmatch("[^\r\n]+") do
			local id, ts = line:match("^%s*([^%s]+)%s+(%d+)%s*$")
			if id and id ~= "" and ts then
				local age = now - tonumber(ts)
				if age < FAILED_TTL then
					list[#list + 1] = id
				end
			end
		end
	end
	return list
end

local function rememberFailed(jobId)
	if not jobId then return end
	local list = readFailed()
	local out = {}
	for _, id in ipairs(list) do
		if id ~= jobId then out[#out + 1] = id end
	end
	out[#out + 1] = jobId
	if #out > VISITED_MAX then
		local trimmed = {}
		for i = #out - VISITED_MAX + 1, #out do
			trimmed[#trimmed + 1] = out[i]
		end
		out = trimmed
	end
	local now = os.time()
	local lines = {}
	for _, id in ipairs(out) do
		lines[#lines + 1] = id .. " " .. now
	end
	safeWrite(failedFile(), table.concat(lines, "\n"))
end

-- ------------------------------------------------------------------ modules

local function waitLoaded(secs)
	local t0 = os.clock()
	while os.clock() - t0 < secs do
		if game:IsLoaded() then
			return true
		end
		-- Polled tight: a 1s sleep here adds up to a full second of dead air
		-- right after the loading screen clears, before anything else runs.
		task.wait(0.15)
	end
	return game:IsLoaded()
end

local function loadModules()
	if not game:IsLoaded() and not waitLoaded(CONFIG.LOAD_TIMEOUT) then
		return nil, "stuck on loading screen"
	end

	local data   = ReplicatedStorage:WaitForChild("Data", CONFIG.LOAD_TIMEOUT)
	local client = ReplicatedStorage:WaitForChild("Client", CONFIG.LOAD_TIMEOUT)
	if not data or not client then
		return nil, "ReplicatedStorage not ready"
	end
	if not data:WaitForChild("Assets", CONFIG.LOAD_TIMEOUT) then
		return nil, "Assets module missing"
	end
	if not client:WaitForChild("EggState", CONFIG.LOAD_TIMEOUT) then
		return nil, "EggState module missing"
	end

	local okA, assets = pcall(require, ReplicatedStorage.Data.Assets)
	local okE, eggState = pcall(require, ReplicatedStorage.Client.EggState)
	if not okA or not okE then
		return nil, "require failed: " .. tostring(assets) .. " / " .. tostring(eggState)
	end

	return assets, eggState
end

-- Wait until the field-egg records have arrived and stopped changing. Two
-- things make this quick: it polls every 0.25s instead of 1s (so a stable
-- count is confirmed in ~1.5s and a batch of records is noticed almost as
-- soon as it lands), and the "records are simply empty" case gets its own
-- much shorter budget - see CONFIG.EGG_EMPTY_TIMEOUT. A read that keeps
-- ERRORING is different: that is the module genuinely not being ready, so
-- it still gets the full timeout.
local function waitForEggs(eggState, timeout)
	local t0 = os.clock()
	local deadline = t0 + timeout
	local emptyDeadline = t0 + (CONFIG.EGG_EMPTY_TIMEOUT or 8)
	local lastCount = nil
	local stableFor = 0
	while os.clock() < deadline do
		local ok, data = pcall(eggState.ReadFieldEggs)
		if ok and type(data) == "table" then
			local count = (type(data.Records) == "table") and #data.Records or 0
			if count > 0 then
				if count == lastCount then
					stableFor = stableFor + 1
					if stableFor >= 6 then
						return true
					end
				else
					stableFor = 0
					lastCount = count
				end
			else
				stableFor = 0
				lastCount = nil
				if os.clock() >= emptyDeadline then
					return false
				end
			end
		end
		task.wait(0.25)
	end
	return false
end

-- ----------------------------------------------------------------- scanning

local function rarityOf(cfg)
	local r = cfg and cfg.Rarity
	if type(r) == "table" then
		return r._id or r.id or r.Name
	end
	return r
end

-- The weight the game itself shows, taken from AssetItems.WeightKg.
local function weightKg(cfg, rec)
	local base = cfg and tonumber(cfg.ModelWeight)
	if not base then
		return nil
	end
	return base * math.max(tonumber(rec.AssetScale) or 0, 0) ^ 3
end

-- The per-second earnings of THIS specific spawn, mirroring the game's
-- Shared.Util.AssetEarnings.RatePerSecond.
local EARN_STEEP_POWER = 1.85
local EARN_KNEE_SCALE  = 5
local EARN_TAPER_POWER = 1.2
local EARN_MIN_RATE    = 1

local MUTATION_SCALAR = {
	Silver = 1.2, Golden = 2.5, Rainbow = 3.5, Monstrous = 3,
	Boss = 2.75, Scrambled = 2.75, Enchanted = 2.85, Sakura = 1.25,
	GreatBloom = 2.5,
	Nitro = 2.75, Spectral = 2.75, Parasite = 3, Fractured = 2.75,
	Bloom = 1.25, SpiritBloom = 2.5,
}

local function scalePayoutFactor(scale)
	if scale <= EARN_KNEE_SCALE then
		return scale ^ EARN_STEEP_POWER
	end
	return EARN_KNEE_SCALE ^ EARN_STEEP_POWER * (scale / EARN_KNEE_SCALE) ^ EARN_TAPER_POWER
end

local function mutationMultiplier(mutations)
	local m = 1
	if type(mutations) == "table" then
		for _, mid in ipairs(mutations) do
			local scalar = MUTATION_SCALAR[tostring(mid)]
			if scalar then
				m = m + math.max(0, scalar - 1)
			end
		end
	end
	return math.max(1, m)
end

local function earningPerSec(cfg, rec)
	local base = cfg and tonumber(cfg.EarningRate) or 0
	if base <= 0 then
		return 0, 0
	end
	local scale = tonumber(rec and rec.AssetScale) or 0
	if scale <= 0 then
		return base, base
	end
	local plain = base * scalePayoutFactor(scale)
	local raw   = plain * mutationMultiplier(rec.Mutations)
	return math.max(math.round(raw), EARN_MIN_RATE), math.max(math.round(plain), EARN_MIN_RATE)
end

local function scan(assets, eggState)
	local hits = {}

	local ok, data = pcall(eggState.ReadFieldEggs)
	if not ok or type(data) ~= "table" or type(data.Records) ~= "table" then
		return hits
	end

	local directory = assets.Directory
	for _, rec in ipairs(data.Records) do
		local cfg    = directory and directory[rec.AssetCategory]
		local rarity = rarityOf(cfg)
		if rarity and CONFIG.TARGET[tostring(rarity)] then
			local earnFinal, earnBase = earningPerSec(cfg, rec)
			hits[#hits + 1] = {
				record = rec,
				rarity = tostring(rarity),
				name   = (cfg and (cfg.DisplayName or cfg._id)) or rec.AssetCategory,
				weight = weightKg(cfg, rec),
				earn   = earnFinal,
				earnBase = earnBase,
			}
		end
	end

	return hits
end

local function censusText(assets, eggState)
	local counts = {}
	local ok, data = pcall(eggState.ReadFieldEggs)
	if ok and type(data) == "table" and type(data.Records) == "table" then
		local directory = assets.Directory
		for _, rec in ipairs(data.Records) do
			local cfg    = directory and directory[rec.AssetCategory]
			local rarity = tostring(rarityOf(cfg) or "?")
			counts[rarity] = (counts[rarity] or 0) + 1
		end
	end

	local keys = {}
	for k in pairs(counts) do
		keys[#keys + 1] = k
	end
	table.sort(keys)

	local parts = {}
	for _, k in ipairs(keys) do
		parts[#parts + 1] = k .. " " .. counts[k]
	end
	return table.concat(parts, ", ")
end

-- ===== Halloween Dimension ==================================================
-- The halloween map holds a pile of world eggs that are (almost) always up, so
-- their rarity is the only thing worth reacting to. Everything below is
-- additive to the grabber: it reports and remembers, and never touches a hop
-- decision. The spec table maps the egg's own name onto the pet it hatches
-- into ("Rotshroom" -> Toadstool, "Dread Wolf" -> Werewolf), so index every
-- alias.
local hwPets      = nil
local hwPetsWarnAt = 0
local hwEggIndex  = nil
local hwKgIndex   = nil
local hwMath      = nil
local hwBand      = nil

local function halloweenPets()
	if hwPets ~= nil then
		return hwPets
	end
	-- Deliberately NOT a one-shot failure. On the phone the whole stay is over
	-- in a few seconds, so caching a single miss would cost every halloween
	-- egg on that server - and the first scan can land only ~2s after the map
	-- replicates. The game caches require(), so retrying is nearly free.
	local data = ReplicatedStorage:FindFirstChild("Data")
	local mod  = data and data:FindFirstChild("HalloweenPets")
	if not mod then
		if os.clock() - hwPetsWarnAt > 30 then
			hwPetsWarnAt = os.clock()
			log("halloween: HalloweenPets module not replicated yet")
		end
		return nil
	end
	local ok, pets = pcall(require, mod)
	if ok and type(pets) == "table" and type(pets.Specs) == "table" then
		hwPets = pets
		return hwPets
	end
	if os.clock() - hwPetsWarnAt > 30 then
		hwPetsWarnAt = os.clock()
		log("halloween: HalloweenPets module unusable (" .. tostring(pets) .. ")")
	end
	return nil
end

local function halloweenEggIndex(pets)
	if hwEggIndex then
		return hwEggIndex
	end
	local idx = {}
	for key, spec in pairs(pets.Specs) do
		if type(spec) == "table" then
			idx[key] = spec
			if type(spec.EggSource) == "string" then idx[spec.EggSource] = spec end
			if type(spec.Source)    == "string" then idx[spec.Source]    = spec end
			if type(spec.Id)        == "string" then idx[spec.Id]        = spec end
		end
	end
	hwEggIndex = idx
	return idx
end

-- Scale-1 midpoint kg for one halloween egg, plus the Assets.Directory key
-- (`cat`) that the game's own WeightKg / RatePerSecond take as Category - that
-- key is what lets halloweenRange() evaluate the band by hand.
local function halloweenKgIndex(pets)
	if hwKgIndex then
		return hwKgIndex
	end
	local idx = {}
	local ok, assets = pcall(require, ReplicatedStorage.Data.Assets)
	if ok and type(assets) == "table" and type(assets.Directory) == "table" then
		for key, spec in pairs(pets.Specs) do
			if type(spec) == "table" then
				local cfg, catName
				for _, n in ipairs({ spec.Id, key, spec.DisplayName, spec.Source, spec.EggSource }) do
					if type(n) == "string" and assets.Directory[n] then
						cfg     = assets.Directory[n]
						catName = n
						break
					end
				end
				local kg
				if cfg then
					kg = (cfg.Egg and tonumber(cfg.Egg.WeightKg)) or tonumber(cfg.ModelWeight)
				end
				if kg and catName then
					local entry = { kg = kg, cat = catName }
					idx[key] = entry
					if type(spec.EggSource) == "string" then idx[spec.EggSource] = entry end
					if type(spec.Source)    == "string" then idx[spec.Source]    = entry end
					if type(spec.Id)        == "string" then idx[spec.Id]        = entry end
				end
			end
		end
	end
	hwKgIndex = idx
	return idx
end

-- Exact kg/value of one halloween egg needs its rolled AssetScale, and that roll
-- is never replicated before the egg is stolen. What CAN be stated honestly is
-- the band the roll lands in, so read the game's SCALE_BANDS, take the heaviest
-- entry, and evaluate the game's own WeightKg / RatePerSecond at both edges.
local function halloweenMath()
	if hwMath == nil then
		local okA, ai = pcall(require, ReplicatedStorage.Shared.Util.AssetItems)
		local okE, ae = pcall(require, ReplicatedStorage.Shared.Util.AssetEarnings)
		hwMath = (okA and okE) and { items = ai, earn = ae } or false
	end
	if hwMath == false then
		return nil
	end
	return hwMath
end

local function halloweenBand()
	if hwBand == false then
		return nil
	end
	if hwBand then
		return hwBand
	end
	hwBand = false
	local ok, bal = pcall(require, ReplicatedStorage.Shared.Flags.GameplayBalance)
	if ok and type(bal) == "table" and type(bal.Eggs) == "table"
		and type(bal.Eggs.SCALE_BANDS) == "table" then
		local best, total, above = nil, 0, 0
		for _, b in ipairs(bal.Eggs.SCALE_BANDS) do
			if type(b) == "table" and tonumber(b.min) and tonumber(b.max) and tonumber(b.weight) then
				total = total + b.weight
				if not best or b.weight > best.weight then
					best = b
				end
			end
		end
		if best and total > 0 then
			for _, b in ipairs(bal.Eggs.SCALE_BANDS) do
				if type(b) == "table" and tonumber(b.min) and tonumber(b.weight) and b.min > best.max then
					above = above + b.weight
				end
			end
			hwBand = {
				min    = best.min,
				max    = best.max,
				inside = best.weight / total * 100,
				above  = above / total * 100,
			}
			hwBand.below = math.max(0, 100 - hwBand.inside - hwBand.above)
		end
	end
	if hwBand == false then
		return nil
	end
	return hwBand
end

local function halloweenRange(cat)
	if type(cat) ~= "string" then
		return nil
	end
	local band, math_ = halloweenBand(), halloweenMath()
	if not band or not math_ then
		return nil
	end
	local function at(s)
		local rec = { Category = cat, Scale = s, Mutations = {} }
		local okK, kg   = pcall(math_.items.WeightKg, rec)
		local okR, rate = pcall(math_.earn.RatePerSecond, rec)
		if okK and okR and type(kg) == "number" and type(rate) == "number" then
			return kg, rate
		end
		return nil
	end
	local kLo, rLo = at(band.min)
	if not kLo then
		return nil
	end
	local kHi, rHi = at(band.max)
	if not kHi then
		return nil
	end
	return kLo, kHi, rLo, rHi
end

local function halloweenWorldEggs()
	local dim = workspace:FindFirstChild("HalloweenDimension")
	return dim and dim:FindFirstChild("WorldEggs")
end

-- A halloween egg is "available" only while it is still under WorldEggs.
--
-- The original test looked for a StealPrompt ProximityPrompt on the egg. That
-- works for the shop's HalloweenEggHolder display, but the *world* eggs never
-- carry one: a 15-egg sweep of Workspace.HalloweenDimension.WorldEggs found
-- every model with children of just MeshParts and a Hitbox - no prompt at all.
-- The server arms the steal interaction on demand, so the prompt is absent for
-- the whole time the egg sits in the world, and the old test rejected 100% of
-- eggs (Eternal spawns included) and no Halloween webhook ever fired.
--
-- The eggs DO replicate the server's own availability flag:
--   HalloweenEggCanPickUp = true
-- which is the honest client-side signal to gate on. The prompt test is kept as
-- a second accept path in case a build arms it. Once stolen, the model leaves
-- WorldEggs (or flips CanPickUp to false), so both cases still drop out.
local function halloweenEggUp(egg)
	if egg:GetAttribute("HalloweenEggCanPickUp") == true then
		return true
	end
	if egg:GetAttribute("HalloweenEggCanPickUp") == false then
		return false
	end
	local prompt = egg:FindFirstChild("StealPrompt", true)
	return prompt ~= nil and prompt:IsA("ProximityPrompt") and prompt.Enabled == true
end

local function halloweenScan()
	local hits = {}
	if CONFIG.HALLOWEEN ~= true then
		return hits
	end
	local pets  = halloweenPets()
	local index = pets and halloweenEggIndex(pets)
	local kgIdx = pets and halloweenKgIndex(pets)
	local world = halloweenWorldEggs()
	if not index or not world then
		return hits
	end

	for _, egg in ipairs(world:GetChildren()) do
		pcall(function()
			if not egg:IsA("Model") then
				return
			end
			local uid = egg:GetAttribute("HalloweenEggUid")
			local src = egg:GetAttribute("PreparedSourceName")
			if type(uid) ~= "string" or type(src) ~= "string" then
				return
			end
			if not halloweenEggUp(egg) then
				return
			end
			local spec   = index[src]
			local rarity = spec and spec.Rarity
			if not (rarity and CONFIG.TARGET[tostring(rarity)]) then
				return
			end
			local entry = kgIdx and kgIdx[src]
			local hit   = {
				halloween = true,
				uid       = uid,
				-- The world model's visual scale is NOT the AssetScale. A live
				-- sweep of 30 world eggs put 12 of them in 0.66x-0.85x, a region
				-- no legal draw can reach (the only bands below the dominant
				-- 0.85-1.05 are 0.3-0.45 and 0.1-0.2), and several more in the
				-- gap between 1.05 and 1.45. So this number can never be read as
				-- a weight scale - keep it as a diagnostic only.
				scale     = egg:GetScale(),
				zone      = egg:GetAttribute("Zone"),
				rarity    = tostring(rarity),
				name      = (spec.DisplayName or spec.Id or src),
				-- Scale-1 midpoint, NOT the egg's weight. Never render this as an
				-- exact figure; the embed shows the band from halloweenRange.
				weight    = entry and entry.kg or nil,
				earn      = tonumber(spec.EarningRate) or 0,
				record    = { Uid = "hw:" .. uid, State = "World", AssetCategory = src },
			}
			local kLo, kHi, rLo, rHi = halloweenRange(entry and entry.cat)
			if kLo then
				hit.kgLo,   hit.kgHi   = kLo, kHi
				hit.rateLo, hit.rateHi = rLo, rHi
			end
			hits[#hits + 1] = hit
		end)
	end

	return hits
end

