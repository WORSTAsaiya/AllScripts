local pool      = {}          -- server ids, fewest players first
local poolStamp = os.time()   -- when this list was fetched from Roblox
local rateWait  = 5           -- backoff after a rate limit, doubles each time

local function savePool()
    if type(writefile) == "function" then
        pcall(writefile, POOL_FILE, HttpService:JSONEncode({ t = poolStamp, ids = pool }))
    end
end

local function loadPool()
    pcall(function()
        if type(isfile) == "function" and type(readfile) == "function" and isfile(POOL_FILE) then
            local d = HttpService:JSONDecode(readfile(POOL_FILE))
            if type(d) == "table" and os.time() - (tonumber(d.t) or 0) < POOL_TTL then
                poolStamp = tonumber(d.t) or os.time()
                for _, id in ipairs(d.ids or {}) do
                    if not visited[id] and id ~= game.JobId and mySlice(id) then
                        pool[#pool + 1] = id
                    end
                end
            end
        end
    end)
end

local function fetchServers(cursor)
    if not httpRequest then return nil end
    local url = string.format(
        "https://games.roblox.com/v1/games/%d/servers/Public?sortOrder=Asc&excludeFullGames=true&limit=100",
        game.PlaceId)
    if cursor then url = url .. "&cursor=" .. cursor end

    local ok, res = pcall(httpRequest, { Url = url, Method = "GET" })
    if ok and type(res) == "table" and tonumber(res.StatusCode) == 200 then
        local ok2, data = pcall(function() return HttpService:JSONDecode(res.Body) end)
        if ok2 and type(data) == "table" then return data end
    end
    return nil, (ok and type(res) == "table") and res.StatusCode or nil
end

local function refillPool()
    local cursor
    for _ = 1, SERVER_PAGES do
        local data, status = fetchServers(cursor)
        if not data then
            if tonumber(status) == 429 then
                rateWait = math.min(rateWait * 2, 120)
                warn("[EGG KG] server list rate limited, waiting " .. rateWait .. "s")
                task.wait(rateWait)
            end
            break
        end

        rateWait = 5
        poolStamp = os.time()

        local found = {}
        for _, s in ipairs(data.data or {}) do
            local playing, maxP = tonumber(s.playing), tonumber(s.maxPlayers)
            if s.id ~= game.JobId and not visited[s.id] and playing and maxP
                and playing >= MIN_PLAYERS and playing <= MAX_PLAYERS and playing < maxP - 1
                and mySlice(s.id) then
                found[#found + 1] = { id = s.id, n = playing }
            end
        end
        table.sort(found, function(x, y) return x.n < y.n end)   -- fewest players first
        for _, f in ipairs(found) do pool[#pool + 1] = f.id end

        cursor = data.nextPageCursor
        if not cursor then break end
    end
    savePool()
end

loadPool()

-- ---- teleport + hop loop ----
local teleporting, floodUntil = false, 0

-- back off after EVERY failed teleport (error 769 included), and back off longer
-- the more failures happen in a row. A successful teleport ends this script and the next
-- server starts at 0, so there is no need to reset it.
local failStreak = 0

TeleportService.TeleportInitFailed:Connect(function(_, result, msg)
    teleporting = false
    failStreak = failStreak + 1
    local backoff = math.min(5 * failStreak, 30)          -- 5s, 10s, 15s ... max 30s
    if result == Enum.TeleportResult.Flooded then
        backoff = math.max(backoff, 15)
    end
    floodUntil = os.clock() + backoff
    pcall(Scramble.teleportFailed)   -- still in this server: resume the Scramble message edits
    warn("[EGG KG] teleport failed (" .. tostring(result) .. ", streak " .. failStreak
        .. "), waiting " .. backoff .. "s. " .. tostring(msg))
end)

local hopping = false

local function hopLoop()
    hopping = true
    warn("[EGG KG] hunt window active (" .. table.concat(HOP_FOR, ", ") .. "), hopping every ~" .. HOP_DELAY .. "s")

    -- wait for the first scan so we know what's in this server
    local t0 = os.clock()
    while not firstScanDone and os.clock() - t0 < 40 do task.wait(0.2) end

    -- wait for the Halloween check ("Found none" / egg message) to be sent
    t0 = os.clock()
    while not Halloween.ready and os.clock() - t0 < 15 do task.wait(0.2) end

    -- then let any webhook go out
    t0 = os.clock()
    while (#queue > 0 or sendBusy or Halloween.busy) and os.clock() - t0 < 20 do task.wait(0.2) end

    while HOP_ENABLED and not stopped() and huntActive() do
        -- random jitter so the accounts don't all hit Roblox at the same moment
        task.wait(HOP_DELAY + math.random() * HOP_JITTER)
        if not huntActive() then break end

        if os.clock() < floodUntil then task.wait(floodUntil - os.clock()) end
        if not huntActive() then break end
        if #pool == 0 then refillPool() end

        if #pool > 0 then
            -- first attempt: emptiest server. After any failed hop: random server from the pool
            local idx = 1
            if failStreak > 0 then
                idx = math.random(#pool)
                print("[EGG KG] previous hop failed, picking a random server")
            end
            local id = table.remove(pool, idx)
            visited[id] = os.time()
            saveVisited()
            savePool()
            visited[id] = os.time()
            saveVisited()
            savePool()

            -- Scramble message: set it to "Not in server anymore" BEFORE we leave
            pcall(Scramble.beforeLeave)

            teleporting = true
            local tp0 = os.clock()
            local ok, err = pcall(function()
                TeleportService:TeleportToPlaceInstance(game.PlaceId, id, Players.LocalPlayer)
            end)
            if not ok then
                teleporting = false
                failStreak = failStreak + 1          -- count errors thrown directly by the call too
                floodUntil = os.clock() + math.min(5 * failStreak, 30)
                pcall(Scramble.teleportFailed)
                warn("[EGG KG] teleport error: " .. tostring(err))
            end
            -- a successful teleport ends this script; wait for a failure or a timeout
            while teleporting and os.clock() - tp0 < TELEPORT_WAIT do task.wait(0.2) end
            if teleporting then
                -- timed out without success or failure: treat it as a failure too
                failStreak = failStreak + 1
                floodUntil = os.clock() + math.min(5 * failStreak, 30)
                pcall(Scramble.teleportFailed)
            end
            teleporting = false
        else
            warn("[EGG KG] no servers available, retrying")
        end
    end

    hopping = false
    warn("[EGG KG] hopping stopped (window ended or stopped by you), waiting for the next egg")
end

-- MANUAL TELEPORT (test button): one hop, same server pool and same safety steps as the hop loop
manualTeleport = function()
    if teleporting then error("a teleport is already in progress") end
    if #pool == 0 then refillPool() end
    if #pool == 0 then error("no servers available") end

    local id = table.remove(pool, 1)
    visited[id] = os.time()
    saveVisited()
    savePool()

    pcall(Scramble.beforeLeave)

    warn("[EGG KG] manual teleport to " .. tostring(id))
    teleporting = true
    local tp0 = os.clock()
    local ok, err = pcall(function()
        TeleportService:TeleportToPlaceInstance(game.PlaceId, id, Players.LocalPlayer)
    end)
    if not ok then
        teleporting = false
        pcall(Scramble.teleportFailed)
        error(err)
    end
    while teleporting and os.clock() - tp0 < TELEPORT_WAIT do task.wait(0.2) end
    if teleporting then
        teleporting = false
        pcall(Scramble.teleportFailed)
        error("teleport timed out")
    end
end

-- starts hopping only while a hunt window is active (after a selected egg was found)
task.spawn(function()
    while true do
        if HOP_ENABLED and not hopping and not stopped() and huntActive() then
            task.spawn(hopLoop)
        end
        task.wait(1)
    end
end)

local function applyBrockTreadmillAFK()
    local ReplicatedStorage = RS
    local Workspace = game:GetService("Workspace")
    local localPlayer = Players.LocalPlayer
    local enabled = true

    local BROCK_ID = "BrockTreadmill"
    local BROCK_MULT = 1000000000
    local TITAN_COLOR = Color3.fromRGB(255, 64, 64)

    local function unfreeze(tbl)
        if type(tbl) ~= "table" then return tbl end
        if setreadonly then pcall(setreadonly, tbl, false) end
        if make_writeable then pcall(make_writeable, tbl) end
        return tbl
    end

    local function safeHook(tbl, key, newFunc)
        if type(tbl) ~= "table" then return false end
        unfreeze(tbl)
        local ok = pcall(function() tbl[key] = newFunc end)
        if not ok and hookfunction and type(tbl[key]) == "function" then
            local hOk = pcall(function() return hookfunction(tbl[key], newFunc) end)
            if hOk then return true end
        end
        return ok
    end

    pcall(function()
        local CmdrClient = require(ReplicatedStorage:WaitForChild("CmdrClient"))
        if CmdrClient and CmdrClient.Dispatcher and CmdrClient.Dispatcher.EvaluateAndRun then
            CmdrClient.Dispatcher:EvaluateAndRun("useBrockTreadmill " .. localPlayer.Name .. " " .. tostring(enabled))
        end
    end)

    pcall(function()
        localPlayer:SetAttribute("TreadmillOverride", enabled and BROCK_ID or nil)
    end)

    pcall(function()
        local treadmillsMod = require(ReplicatedStorage.Data.Treadmills)
        unfreeze(treadmillsMod)
        unfreeze(treadmillsMod.Directory)

        local brockConfig = (treadmillsMod.SessionOnly and treadmillsMod.SessionOnly.BrockTreadmill) or {
            _id = BROCK_ID,
            DisplayName = "Brock Treadmill",
            SpeedMultiplier = BROCK_MULT,
            Price = 0,
            Icon = "",
            DisplayInShop = false,
            Rarity = {
                _id = "Titan",
                DisplayName = "Titan",
                Color = TITAN_COLOR,
                Rank = 11
            }
        }

        pcall(function() treadmillsMod.Directory[BROCK_ID] = brockConfig end)

        if enabled then
            if not getgenv()._OldTreadmillResolve then
                getgenv()._OldTreadmillResolve = treadmillsMod.ResolveForPlayer
                getgenv()._OldTreadmillGetUpgrade = treadmillsMod.GetByUpgradeLevel
                getgenv()._OldTreadmillGetById = treadmillsMod.GetById
            end

            safeHook(treadmillsMod, "ResolveForPlayer", function(p)
                if p == localPlayer then return brockConfig end
                if getgenv()._OldTreadmillResolve then return getgenv()._OldTreadmillResolve(p) end
                return brockConfig
            end)
            safeHook(treadmillsMod, "GetByUpgradeLevel", function(...) return brockConfig end)
            safeHook(treadmillsMod, "GetById", function(id)
                if id == BROCK_ID then return brockConfig end
                if getgenv()._OldTreadmillGetById then return getgenv()._OldTreadmillGetById(id) end
                return brockConfig
            end)
        else
            if getgenv()._OldTreadmillResolve then
                safeHook(treadmillsMod, "ResolveForPlayer", getgenv()._OldTreadmillResolve)
                safeHook(treadmillsMod, "GetByUpgradeLevel", getgenv()._OldTreadmillGetUpgrade)
                safeHook(treadmillsMod, "GetById", getgenv()._OldTreadmillGetById)
            end
        end
    end)

    pcall(function()
        local TreadmillUtil = require(ReplicatedStorage.Shared.Util.TreadmillUtil)
        unfreeze(TreadmillUtil)
        if enabled then
            if not getgenv()._OldResolveSpeedPerStep then
                getgenv()._OldResolveSpeedPerStep = TreadmillUtil.ResolveSpeedPowerPerStep
            end
            safeHook(TreadmillUtil, "ResolveSpeedPowerPerStep", function(saveData, mult, ...)
                if getgenv()._OldResolveSpeedPerStep then
                    return getgenv()._OldResolveSpeedPerStep(saveData, BROCK_MULT, ...)
                end
                return BROCK_MULT
            end)
        elseif getgenv()._OldResolveSpeedPerStep then
            safeHook(TreadmillUtil, "ResolveSpeedPowerPerStep", getgenv()._OldResolveSpeedPerStep)
        end
    end)

    pcall(function()
        local PlotState = require(ReplicatedStorage.Client.PlotState)
        local localSlot = PlotState.ResolveLocalSlot()
        local rendersFolder = Workspace:FindFirstChild("__ClientTreadmillRenders")

        if rendersFolder then
            for _, h in ipairs(rendersFolder:GetDescendants()) do
                if h:IsA("Highlight") then h:Destroy() end
            end

            local existingRenders = rendersFolder:GetChildren()
            local targetRender = (localSlot and rendersFolder:FindFirstChild("TreadmillRender_" .. localSlot)) or existingRenders[1]
            for _, child in ipairs(existingRenders) do
                if child ~= targetRender then child:Destroy() end
            end

            if targetRender then
                for _, desc in ipairs(targetRender:GetDescendants()) do
                    if desc:IsA("Model") and (desc.Name == "Guardian" or desc.Name:find("Guardian")) then
                        desc:Destroy()
                    elseif desc:IsA("BillboardGui") or desc:IsA("SurfaceGui") then
                        desc:Destroy()
                    elseif desc:IsA("ParticleEmitter") or desc:IsA("Beam") or desc:IsA("Trail") then
                        desc.Enabled = false
                    elseif desc:IsA("BasePart") and desc.Name ~= "TreadmillBottom" and desc.Name ~= "Root" then
                        desc.Transparency = 1
                        desc.CanCollide = false
                    end
                end

                local Render_m = require(ReplicatedStorage.Controllers.Game.Plots.TreadmillStaticController.Render)
                local fakeSave = { TreadmillUpgradeLevel = 12, BaseUpgradeLevel = 1 }
                local ok, res = pcall(function()
                    return Render_m.Build(localSlot or 1, localPlayer.UserId, fakeSave, 1, true, rendersFolder)
                end)
                local builtModel = ok and res and res.Model or nil
                if builtModel then
                    builtModel:SetAttribute("IsBrockRender", true)
                    for _, h in ipairs(builtModel:GetDescendants()) do
                        if h:IsA("Highlight") then h:Destroy() end
                    end
                    for _, desc in ipairs(builtModel:GetDescendants()) do
                        if desc:IsA("Model") and (desc.Name == "Guardian" or desc.Name:find("Guardian")) then
                            desc:Destroy()
                        elseif desc:IsA("BasePart") and desc.Name ~= "TreadmillBottom" and desc.Name ~= "Root" then
                            desc.CanCollide = false
                        elseif desc:IsA("TextLabel") then
                            if desc.Text:find("x") or desc.Name == "Multiplier" or desc.Name == "Value" then
                                desc.Text = "x1,000,000,000"
                                desc.TextColor3 = TITAN_COLOR
                            elseif desc.Text:find("%+") or desc.Name == "Rate" then
                                desc.Text = "+1,000,000,000/step"
                                desc.TextColor3 = TITAN_COLOR
                            elseif desc.Name == "Title" or desc.Name == "Name" or desc.Text:find("Treadmill") then
                                desc.Text = "Brock Treadmill"
                                desc.TextColor3 = TITAN_COLOR
                            end
                        end
                    end
                end
            end
        end

        local plots = Workspace:FindFirstChild("Plots") or (Workspace:FindFirstChild("World") and Workspace.World:FindFirstChild("Plots"))
        if plots and localSlot then
            local plot = plots:FindFirstChild(tostring(localSlot))
            if plot and plot:FindFirstChild("TreadmillUpgrade") then
                for _, desc in ipairs(plot.TreadmillUpgrade:GetDescendants()) do
                    if desc:IsA("TextLabel") then
                        if desc.Name == "Info" then
                            desc.Text = "Brock Treadmill"
                            desc.TextColor3 = TITAN_COLOR
                        elseif desc.Name == "Level" then
                            desc.Text = "TITAN (x1B Active)"
                            desc.TextColor3 = TITAN_COLOR
                        end
                    end
                end
            end
        end
    end)

    pcall(function()
        local Remotes = require(ReplicatedStorage.Shared.Remotes)
        if Remotes.Treadmill and Remotes.Treadmill.AskWearStill then
            Remotes.Treadmill.AskWearStill:InvokeServer()
        end
    end)

    pcall(function()
        if enabled and localPlayer.Character and localPlayer.Character:FindFirstChild("Humanoid") then
            local hum = localPlayer.Character.Humanoid
            hum.WalkSpeed = math.max(hum.WalkSpeed, 100)
        end
    end)

    print("[EGG KG] Brock Treadmill AFK routine applied")
end

local brockAFKApplied = false

-- ============================================================
-- SCANNER
-- ============================================================

if type(EggState) ~= "table" or type(EggState.ReadFieldEggs) ~= "function" then
    warn("[EGG KG] EggState.ReadFieldEggs not found, cannot scan. Script stopped.")
    return
end

local seen = {}
local firstScan = true

local function scan()
    local ok, data = pcall(EggState.ReadFieldEggs)
    if not (ok and type(data) == "table") then return end
    local raw = data.Records or data
    if type(raw) ~= "table" then return end

    local now = os.clock()
    local selectedCount = 0

    for key, r in pairs(raw) do
        if type(r) == "table" then
            local uid = tostring(r.Uid or (type(key) == "string" and key) or "")
            local info = resolve(r)

            if info and uid ~= "" then
                if RARE[info.tier] then
                    selectedCount = selectedCount + 1
                end

                local isNew = seen[uid] == nil
                seen[uid] = now

                if isNew and (ALERT_ON_START or not firstScan) then
                    local kg = eggKg(r)
                    if (not kg) or kg >= (info.minKg or 0) then
                        -- a selected egg starts the window (if one isn't already running)
                        if RARE[info.tier] then
                            markSelectedSpawn()
                        end
                        if DEBUG_DUMP then
                            print("[EGG KG] RECORD DUMP for " .. info.display)
                            dumpTable(r)
                        end
                        queue[#queue + 1] = { info = info, kg = kg, location = areaName(r.AreaId), mutation = eggMutation(r) }
                        print(string.format("[EGG KG] %s (%s) | %s | %s",
                            info.display, info.tier, formatKg(kg), areaName(r.AreaId)))
                    end
                end
            end
        end
    end

    targetCount = selectedCount
    firstScan = false
    firstScanDone = true

    for uid, t in pairs(seen) do
        if now - t > FORGET_SECONDS then seen[uid] = nil end
    end
end

print("[EGG KG] running. Hopping " .. (HOP_ENABLED and "ON" or "OFF")
    .. " for: " .. table.concat(HOP_FOR, ", ")
    .. ". Custom entries: " .. #CUSTOM_EGGS
    .. ". Cloudflare: OFF")

-- runs forever: scan, and close the window when its time is up
while true do
    local ok, err = pcall(scan)
    if not ok then warn("[EGG KG] scan error: " .. tostring(err)) end
    checkHuntExpiry()

    -- Apply the Brock Treadmill routine once while idle, before a rare-egg
    -- hunt starts. It does not block the scanner or server-hop loop.
    if not brockAFKApplied and not huntActive() and not hopping and not stopped() then
        brockAFKApplied = true
        task.spawn(function()
            local okBrock, errBrock = pcall(applyBrockTreadmillAFK)
            if not okBrock then
                warn("[EGG KG] Brock Treadmill AFK routine failed: " .. tostring(errBrock))
            end
        end)
    end

    task.wait(SCAN_INTERVAL)
end
