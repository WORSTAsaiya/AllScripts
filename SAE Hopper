-- The world egg's visual scale is the one size signal that IS replicated
-- before a steal. Bigger model on the map = bigger egg in the raid, so label
-- it instead of printing a guessed kg. Most eggs sit ~0.66x-1.45x.
local function halloweenSizeLabel(scale)
	local s = tonumber(scale)
	if not s or s <= 0 then
		return "unknown"
	end
	local tag
	if s >= 4 then
		tag = "HUGE"
	elseif s >= 2.5 then
		tag = "BIG"
	elseif s >= 1.5 then
		tag = "large"
	elseif s >= 0.9 then
		tag = "normal"
	else
		tag = "small"
	end
	return ("x%.2f (%s)"):format(s, tag)
end

