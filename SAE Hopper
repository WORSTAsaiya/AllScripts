-- --------------------------------------------------------------------- hop

-- The v2 servers/Public endpoint returns REAL playing counts.
-- v1, NOT v2: v1 is the only one that returns a per-server `ping`, and
-- sortOrder=Asc still gives the least-populated servers first - so one fetch
-- buys both the emptiest candidates and the laggy ones we should never join.
local SERVER_LIST_URL = "https://games.roblox.com/v1/games/%d/servers/Public?sortOrder=Asc&limit=50&excludeFullGames=true"

-- Single-account mobile build: on-disk cache + circuit breaker to stay
-- under Roblox's rate limit. Cache survives hops so 429s are impossible
-- once we have one good list.
--
-- LIST_TTL = 0, matching the desktop hunter: ask for a FRESH list every hop.
-- A server list has a shelf life - it only says which servers existed when
-- Roblox drew it up. Reusing one for minutes is the main way "Connection
-- Failed (279)" gets in: servers shut down, restart or fill while we wait, and
-- we then jump at a JobId that is no longer routable. The disk cache is still
-- here as the 429 / circuit-breaker fallback below, which is what it is for.
local LIST_TTL        = 0      -- seconds to reuse on-disk cache between hops
local LIST_STALE_OK   = 600    -- on a 429, serve cache if it is at most this old
local LIST_CACHE_FILE = "egg-grabber-delta-serverlist.cache" -- "<epoch>\n<body>"
local lastListFetch   = 0      -- spacing between live page requests

-- circuit breaker state (in-memory, resets on script reload)
local cbBlockUntil = 0
local cbCount      = 0
local cbWindow     = 0

local function cacheRead()
	local ok, content = pcall(readfile, LIST_CACHE_FILE)
	if ok and type(content) == "string" then
		local ts, body = content:match("^(%d+)\r?\n(.*)$")
		if ts and body and body ~= "" then
			return tonumber(ts), body
		end
	end
	return nil, nil
end

local function cacheWrite(body)
	pcall(writefile, LIST_CACHE_FILE, tostring(os.time()) .. "\n" .. body)
end

local function cbIsBlocked()
	if cbBlockUntil > os.time() then
		return true, cbBlockUntil - os.time()
	end
	return false, 0
end

local function cbRecord429()
	local now = os.time()
	if now > cbWindow + 60 then
		cbWindow = now
		cbCount = 0
	end
	cbCount = cbCount + 1
	if cbCount >= 3 then
		cbBlockUntil = now + 120
	end
end

local function urlEncode(s)
	return (tostring(s):gsub("([^%w%-%._~])", function(c)
		return ("%%%02X"):format(string.byte(c))
	end))
end

-- One live page request, retrying only on 429 and honouring Retry-After.
-- Returns the raw body string, or nil + reason.
local function requestPage(url)
	for attempt = 1, 2 do
		local ok, res = pcall(httpRequest, { Url = url, Method = "GET" })

		if ok and type(res) == "table" and (res.StatusCode or res.status) == 200 then
			cbCount = 0
			return res.Body or res.body
		end

		if ok and type(res) == "table" and (res.StatusCode or res.status) == 429 then
			cbRecord429()
			local delay = 2 + math.random() * 0.4
			local h = res.Headers
			local ra = h and (h["Retry-After"] or h["retry-after"])
			if tonumber(ra) and tonumber(ra) > 0 then
				delay = math.max(delay, math.min(tonumber(ra), 30))
			end
			if attempt < 2 then
				log(("server list rate-limited (429) - retrying in %.1fs"):format(delay))
				task.wait(delay)
			end
		else
			local detail = type(res) == "table" and tostring(res.StatusCode or res.status) or tostring(res)
			return nil, "list request failed (" .. detail .. ")"
		end
	end
	return nil, "rate limited (429)"
end

-- Walk up to CONFIG.LIST_PAGES pages of the quietest-first list and merge them
-- into ONE body shaped like a single endpoint response ({ data = {...} }).
-- Pages are spaced by CONFIG.LIST_PAGE_GAP seconds (kept small so a hop stays
-- fast) and a 429 is retried instead of killing the hop.
local function fetchServerList()
	local baseUrl = SERVER_LIST_URL:format(game.PlaceId)
	local cursor  = nil
	local merged  = {}
	local pages   = 0
	local lastWhy = nil

	for _ = 1, CONFIG.LIST_PAGES do
		local url = baseUrl
		if cursor then
			url = baseUrl .. "&cursor=" .. urlEncode(cursor)
		end

		local now = os.time()
		if now < lastListFetch + CONFIG.LIST_PAGE_GAP then
			task.wait((lastListFetch + CONFIG.LIST_PAGE_GAP) - now)
		end
		lastListFetch = os.time()

		local body, why = requestPage(url)
		if not body then
			lastWhy = why
			break
		end

		local page = jsonDecode(body)
		if not page or type(page.data) ~= "table" then
			lastWhy = "list did not decode"
			break
		end

		for _, s in ipairs(page.data) do
			merged[#merged + 1] = s
		end
		pages = pages + 1

		cursor = page.nextPageCursor
		if not cursor then break end
	end

	if pages == 0 then
		return nil, lastWhy or "list request failed"
	end
	return merged, pages
end

-- Fetch-or-reuse entry point. forceFresh (used right before a hop) skips the
-- cache so we never target a server that died in the cached window.
local function getServerList(forceFresh)
	if type(httpRequest) ~= "function" then
		return nil, "no http function"
	end

	local blocked, rem = cbIsBlocked()
	if blocked then
		local ts, body = cacheRead()
		if ts and body and (os.time() - ts) <= LIST_STALE_OK then
			log(("server list blocked by circuit breaker (%ds left) - using own cache (age %ds)"):format(rem or 0, os.time() - ts))
			return { StatusCode = 200, Body = body }
		end
		log(("server list blocked by circuit breaker (%ds left) - no usable cache"):format(rem or 0))
		return nil, "list blocked by circuit breaker"
	end

	local now = os.time()
	if not forceFresh then
		local ts, body = cacheRead()
		if ts and body and (now - ts) <= LIST_TTL then
			log(("server list from own cache (age %ds)"):format(now - ts))
			return { StatusCode = 200, Body = body }
		end
	end

	local merged, pages = fetchServerList()
	if not merged then
		-- fall back to even a stale cache rather than stall - but if this was a
		-- force-fresh hop, only trust a cache that is seconds old.
		local ts, body = cacheRead()
		if ts and body then
			local age = now - ts
			if not forceFresh or age <= 3 then
				log(("server list request failed - using own cache (age %ds)"):format(age))
				return { StatusCode = 200, Body = body }
			end
			log(("ignoring %ds-old server list for a fresh hop"):format(age))
		end
		return nil, "list request failed"
	end

	local body = jsonEncode({ data = merged })
	cacheWrite(body)
	log(("server list: %d servers from %d page(s)"):format(#merged, pages))
	return { StatusCode = 200, Body = body }
end

-- ---------------------------------------------------------------- multi-account
-- Each account owns the servers whose id hashes to its slot, so no two of your
-- accounts ever target the same server.
local mySlot, slotCount = 1, 1
do
	local me = Players.LocalPlayer and Players.LocalPlayer.Name or ""
	local list = CONFIG.ACCOUNTS
	if type(list) == "table" and #list > 1 then
		slotCount = #list
		local found = false
		for i, n in ipairs(list) do
			if tostring(n):lower() == me:lower() then
				mySlot = i
				found = true
			end
		end
		if not found then
			log("WARNING: '" .. me .. "' is not in CONFIG.ACCOUNTS - it will share slot 1 and may collide with that account")
		else
			log(("multi-account: '%s' is slot %d of %d"):format(me, mySlot, slotCount))
		end
		-- each account sees only ~1/N of the list, so read more pages per hop
		CONFIG.LIST_PAGES = math.max(tonumber(CONFIG.LIST_PAGES) or 1, 3)
	end
end

local function mySlice(id)
	if slotCount <= 1 then return true end
	local h = 0
	for i = 1, #id do h = (h * 31 + id:byte(i)) % 1000003 end
	return h % slotCount == mySlot - 1
end

local function pickTargets(forceFresh)
	local list, why = getServerList(forceFresh)
	if not list or not list.Body then
		return nil, why
	end

	local data = jsonDecode(list.Body)
	if not data or type(data.data) ~= "table" then
		return nil, "list did not decode"
	end

	local left = readLeft()
	local visited = readVisited()
	local visitedSet = {}
	for _, id in ipairs(visited) do
		visitedSet[id] = true
	end

	-- Load failed servers (servers that gave 279 / timed out / refused)
	local failed = readFailed()
	local failedSet = {}
	for _, id in ipairs(failed) do
		failedSet[id] = true
	end

	local wantMax     = CONFIG.MAX_POP_ON_LAND - 1
	local idealListed = CONFIG.MIN_POP_ON_LAND - 1

	local function collect(useVisited)
		local candidates, considered, skipped, laggy = {}, 0, 0, 0

		for _, s in ipairs(data.data) do
			if type(s.id) == "string" and type(s.playing) == "number" then
				considered = considered + 1

				local ping    = tonumber(s.ping)
				local skipPing = tonumber(CONFIG.LIST_PING_SKIP) or 0
				local isLaggy  = skipPing > 0 and ping ~= nil and ping > skipPing

				local bounce = s.id == game.JobId or s.id == left
				local full   = s.playing >= s.maxPlayers
				local empty  = s.playing < 0
				if CONFIG.MIN_POP_ON_LAND == 1 then empty = false end
				local over   = s.playing > wantMax
				local seen   = useVisited and visitedSet[s.id] == true
				-- Also skip servers that previously refused us (279 / timeout / failed)
				local dead   = failedSet[s.id] == true
				-- another of your accounts owns this server
				local notMine = not mySlice(s.id)
				-- Strict 2/7-3/7 only: listed playing 1-2, nothing else aimed at.
				local band   = s.playing ~= 1 and s.playing ~= 2

				if bounce or full or empty or over or seen or band or isLaggy or dead or notMine then
					skipped = skipped + 1
					if isLaggy then laggy = laggy + 1 end
					if dead then log(("skipping %s - previously failed"):format(s.id)) end
				else
					local popScore = 0
					if s.playing < idealListed then
						popScore = (idealListed - s.playing) * 10
					elseif s.playing > idealListed then
						popScore = (s.playing - idealListed) * 10
					end

					-- Ping is a tie-break, not the driver: population moves in
					-- steps of 10, ping in steps of 0.01/ms, so two servers of
					-- equal population are ordered by whichever is closer.
					local score = popScore + (ping or 150) / 100

					candidates[#candidates + 1] = {
						id = s.id,
						playing = s.playing,
						ping = ping,
						score = score,
					}
				end
			end
		end

		table.sort(candidates, function(a, b) return a.score < b.score end)
		return candidates, considered, skipped, laggy
	end

	local candidates, considered, skipped, laggy = collect(true)
	if #candidates == 0 then
		candidates, considered, skipped, laggy = collect(false)
	end

	log(("candidates: %d of %d listed (%d skipped, %d over the %dms ping limit)")
		:format(#candidates, considered, skipped, laggy,
			tonumber(CONFIG.LIST_PING_SKIP) or 0))

	-- Rotate DEEP into the candidate list, like the desktop hunter.
	-- TARGET_LIST_START (25/60) is the slot we START at - we skip the
	-- contested head (which every other bot grabs) and probe from
	-- deeper in the list. Fully random to spread 24 bots with no coordination.
	local function rotateToStart(t)
		local n = #t
		if n <= 1 then return t end
		local base = math.min(CONFIG.TARGET_LIST_START - 1, n - 1)
		local startAt = 1 + math.random(0, base)
		if startAt < 1 then startAt = 1 end
		if startAt > n then startAt = 1 end
		local rotated = {}
		for i = startAt, n do rotated[#rotated + 1] = t[i] end
		for i = 1, startAt - 1 do rotated[#rotated + 1] = t[i] end
		return rotated
	end

	if #candidates == 0 then
		return nil, ("no joinable server among %d listed (%d skipped)"):format(considered, skipped)
	end

	return rotateToStart(candidates)
end

local teleportFailures = 0

-- Gap after a refused join. Flat 1s like the desktop hunter: the fresh
-- 200-server list + deadIds means we don't need exponential backoff.
local function hopBackoff(failures)
	local waitFor = tonumber(CONFIG.HOP_RETRY_WAIT) or 1
	log(("backing off %ds before the next join attempt"):format(waitFor))
	local t0 = os.clock()
	while os.clock() - t0 < waitFor do
		if stopped() then return end
		task.wait(0.5)
	end
end

local function hopRound()
	if not CONFIG.HOP then
		log("HOP is false - staying in this server")
		return false
	end

	writeLeft(game.JobId)
	teleportFailures = 0

	-- In-hop memory of servers that refused us this round (deadIds mirrors
	-- the desktop hunter's pattern). Prevents retrying the same dead server
	-- multiple times within one hop() call.
	local deadIds = {}

	-- Join pacing, before the budget starts so this wait is not charged to it.
	local gap = tonumber(CONFIG.MIN_HOP_GAP) or 0
	if gap > 0 then
		local since = os.time() - readJoinStamp()
		if since < gap then
			-- Clamped to the gap itself: a clock jump backwards must not turn
			-- into an hour-long hold on a "negative" age.
			local waitFor = math.min(gap - since, gap)
			log(("pacing the hop: %ds since the last join, holding %ds"):format(since, waitFor))
			local t0 = os.clock()
			while os.clock() - t0 < waitFor do
				if stopped() then return false end
				task.wait(0.5)
			end
		end
	end

	-- Total wall-clock budget for one hop() call. Without this, the attempts -
	-- each of which can stall on waitForLanding - can burn ~4 minutes in one.
	local hopStart = os.clock()
	local HOP_BUDGET = 75

	local verdict = nil
	local verdictConn = nil
	local lpWait = os.clock()
	local lp = Players.LocalPlayer
	while not lp and os.clock() - lpWait < 5 do
		task.wait(0.2)
		lp = Players.LocalPlayer
	end
	if lp then
		verdictConn = lp.OnTeleport:Connect(function(state)
			verdict = tostring(state)
		end)
	end

	-- Every return below must go through this first: a refused/timed-out hop
	-- stays in the same session, so a leaked OnTeleport connection per attempt
	-- piles up over a long stay. Nil-safe (lp may never have resolved).
	local function disconnect()
		if verdictConn then
			pcall(function() verdictConn:Disconnect() end)
			verdictConn = nil
		end
	end

	local function awaitVerdict(secs)
		local t0 = os.clock()
		while os.clock() - t0 < secs do
			task.wait(0.2)
			if stopped() then return nil end
			if verdict then
				if verdict:find("InProgress") then return "inprogress" end
				if verdict:find("Failed") then return "failed" end
			end
		end
		return nil
	end

	local function waitForLanding(maxSecs)
		local t0 = os.clock()
		while os.clock() - t0 < maxSecs do
			task.wait(0.5)
			if stopped() then return false end
		end
		return true
	end

	local function armBootstrap()
		-- Clear the per-join lock so the next join can start a fresh instance
		-- even if getgenv survived the teleport.
		local gg = genv()
		if gg ~= nil then
			gg.EGG_GRABBER_RUNNING = false
			gg.EGG_GRABBER_STOP = false
		end
		clearTeleportQueue()
		if queueOnTeleport(bootstrapCode()) then
			log("teleport bootstrap queued")
		else
			log("WARNING: this executor will not queue the teleport bootstrap - after a hop the script can only restart via Delta's AutoExec folder")
		end
	end

	-- Always fetch a FRESH list right before hopping: the cached list can be up
	-- to LIST_TTL old, and a server that died in that window causes Roblox's
	-- "Connection Failed (279)" dialog. Fresh data = far fewer dead targets.
	log("refreshing server list before hop")
	local targets, listWhy = pickTargets(true)
	if not targets and CONFIG.ALLOW_MATCHMAKER then
		log("no candidates (" .. tostring(listWhy) .. ") - going to matchmaker for an available server")
		verdict = nil
		local ok, err = pcall(function()
			armBootstrap()
			stampJoin()
			TeleportService:Teleport(game.PlaceId)
		end)
		if not ok then
			log("matchmaker teleport failed: " .. tostring(err))
			task.wait(5)
			disconnect()
			return false
		end
		local v = awaitVerdict(CONFIG.TARGET_VERDICT)
		if v == "inprogress" then
			if waitForLanding(8) then
				log("matchmaker accepted but never left (no verdict) - retrying this hop")
				disconnect()
				return false
			end
			disconnect()
			return false
		else
			log("matchmaker refused (" .. tostring(v) .. ") - will try again on next cycle")
			task.wait(5)
			disconnect()
			return false
		end
	elseif not targets then
		-- Matchmaker disabled: a crowded server is worse than staying put, since
		-- we cannot hop out of the ones it drops us into. Wait for the next cycle
		-- rather than teleport blind.
		log("no low-pop candidates (" .. tostring(listWhy) .. ") and matchmaker disabled - staying put")
		notifyStay(listWhy)
		disconnect()
		return false
	end

	local idx = 0
	local refetches = 0
	while teleportFailures < CONFIG.MAX_TELEPORT_RETRIES do
		idx = idx + 1

		if os.clock() - hopStart > HOP_BUDGET then
			log(("hop budget (%.0fs) exceeded - giving up this round"):format(HOP_BUDGET))
			break
		end

		if targets and idx <= #targets then
			local cand = targets[idx]

			-- Skip servers that already failed this hop round (deadIds mirrors desktop hunter)
			if deadIds[cand.id] then
				log(("skipping %s - already failed this hop round"):format(cand.id))
			else
				verdict = nil
				armBootstrap()

				local ok, err = pcall(function()
					stampJoin()
					TeleportService:TeleportToPlaceInstance(game.PlaceId, cand.id)
				end)

				if not ok then
					teleportFailures = teleportFailures + 1
					deadIds[cand.id] = true
					rememberFailed(cand.id)
					log("TeleportToPlaceInstance failed: " .. tostring(err))
				else
					local v = awaitVerdict(CONFIG.TARGET_VERDICT)

					if v == "inprogress" then
						log(("target accepted -> %s (%d playing) - leaving"):format(cand.id, cand.playing))
						notify("hopping to a new server")
						if waitForLanding(8) then
							teleportFailures = teleportFailures + 1
							deadIds[cand.id] = true
							rememberFailed(cand.id)
							log(("accepted but never left (%s) - attempt %d/%d")
								:format(cand.id, teleportFailures, CONFIG.MAX_TELEPORT_RETRIES))
						else
							disconnect()
							return false
						end
					else
						teleportFailures = teleportFailures + 1
						deadIds[cand.id] = true
						rememberFailed(cand.id)
						log(("target refused %s (%s) - attempt %d/%d")
							:format(cand.id, v or ("no verdict in " .. CONFIG.TARGET_VERDICT .. "s"),
								teleportFailures, CONFIG.MAX_TELEPORT_RETRIES))
					end
				end

				if teleportFailures < CONFIG.MAX_TELEPORT_RETRIES then
					hopBackoff(teleportFailures)
				end
			end
		elseif CONFIG.ALLOW_MATCHMAKER then
			verdict = nil
			armBootstrap()

			local ok, err = pcall(function()
				stampJoin()
				TeleportService:Teleport(game.PlaceId)
			end)

			if not ok then
				teleportFailures = teleportFailures + 1
				log("matchmaker teleport failed: " .. tostring(err))
			else
				log("no more candidates - the matchmaker decides")
				local v = awaitVerdict(CONFIG.TARGET_VERDICT)

				if v == "inprogress" then
					if waitForLanding(8) then
						teleportFailures = teleportFailures + 1
						log(("matchmaker accepted but never left - attempt %d/%d")
							:format(teleportFailures, CONFIG.MAX_TELEPORT_RETRIES))
					else
						disconnect()
						return false
					end
				else
					teleportFailures = teleportFailures + 1
					log(("matchmaker refused (%s) - attempt %d/%d")
						:format(v or "no verdict", teleportFailures, CONFIG.MAX_TELEPORT_RETRIES))
					targets, listWhy = pickTargets()
					idx = 0
				end
			end

			if teleportFailures < CONFIG.MAX_TELEPORT_RETRIES then
				hopBackoff(teleportFailures)
			end
		else
			-- Matchmaker disabled: we ran through every targeted candidate and
			-- Roblox refused them all. Refetch a fresh list and try again rather
			-- than handing the choice to the matchmaker.
			refetches = refetches + 1
			if refetches > CONFIG.MAX_LIST_REFETCHES then
				log("targeted candidates exhausted (" .. tostring(listWhy) .. ") - staying put")
				notifyStay("candidates exhausted: " .. tostring(listWhy))
				break
			end
			log(("targeted candidates exhausted - refetching list (%d/%d)")
				:format(refetches, CONFIG.MAX_LIST_REFETCHES))
			task.wait(1)
			targets, listWhy = pickTargets(true)
			if not targets then
				log("no low-pop candidates after refetch (" .. tostring(listWhy) .. ") - staying put")
				notifyStay("refetch: " .. tostring(listWhy))
				break
			end
			idx = 0
		end
	end

	disconnect()
	log("giving up on teleport after " .. CONFIG.MAX_TELEPORT_RETRIES .. " attempts")
	return false
end

-- hop() never gives up: it runs hopRound() in a loop with a pause between
-- rounds. If a round exhausts MAX_TELEPORT_RETRIES, the candidate list was
-- stale or Roblox was busy - wait HOP_ROUND_PAUSE and start a fresh round
-- with a new server list. This matches the desktop hunter's resilience.
local function hop()
	CONFIG.hbStatus = "Hopping"
	if CONFIG.sendBeat then task.spawn(CONFIG.sendBeat) end   -- tell the relay right now
	if not CONFIG.HOP then
		return hopRound()
	end

	local round = 0
	while true do
		round += 1
		if hopRound() then
			return true
		end
		if stopped() then
			return false
		end

		log(("hop round %d found nowhere to go - waiting %ds then retrying")
			:format(round, CONFIG.HOP_ROUND_PAUSE))

		local t0 = os.clock()
		while os.clock() - t0 < CONFIG.HOP_ROUND_PAUSE do
			if stopped() then return false end
			task.wait(0.5)
		end
	end
end

-- -------------------------------------------------------------------- main

-- Report any fresh eggs without affecting flow: no hop, no error, just
-- post-and-remember. Used for the initial landing scan and the per-poll
-- opportunistic check. Returns 1 posted, 2 failed, 0 nothing fresh.
local function tryReportFreshOnly(hits)
	if #hits == 0 then
		return 0
	end
	local posted = readPosted()
	local fresh = {}
	for _, hit in ipairs(hits) do
		if not posted[postedKey(hit.record)] then
			fresh[#fresh + 1] = hit
		end
	end
	if #fresh == 0 then
		return 0
	end
	log(("found %d fresh egg(s) on this server - posting"):format(#fresh))
	local sent = post(fresh, #Players:GetPlayers())
	for _, hit in ipairs(sent) do
		rememberPosted(hit.record)
	end
	if #sent > 0 then
		return 1
	end
	return 2
end

local function tryReportAny(hits)
	if #hits == 0 then
		return false
	end
	local posted = readPosted()
	local fresh  = {}
	for _, hit in ipairs(hits) do
		if not posted[postedKey(hit.record)] then
			fresh[#fresh + 1] = hit
		end
	end
	if #fresh == 0 then
		return false
	end
	log(("quick-scan found %d target egg(s) - posting"):format(#fresh))
	local sent = post(fresh, #Players:GetPlayers())
	for _, hit in ipairs(sent) do
		rememberPosted(hit.record)
	end
	return #sent > 0
end

-- Post everything visible on this server BEFORE we teleport, and wait for the
-- post to actually go through (webhook cooldown included). A hop must never
-- throw away an egg we already saw. Returns true when nothing is left unsent.
local function flushEggs(assets, eggState)
	if relayWebhook() == "" then
		return true
	end
	for _ = 1, 6 do
		local before  = lastPostAttempt
		local verdict = tryReportFreshOnly(scan(assets, eggState))
		if verdict == 0 then
			return true
		end
		if verdict == 1 then
			-- Short gap: this pass only exists to catch a SECOND egg that was
			-- already on screen, so a full second of waiting buys little.
			log("egg(s) reported before hopping - re-checking for more")
			task.wait(0.5)
		else
			-- Eggs are visible but did not go out. Wait out the webhook
			-- cooldown, but if the post itself is failing, give up quickly
			-- instead of freezing the hunt on one server.
			local cooldownLeft = (CONFIG.POST_COOLDOWN or 0) - (os.clock() - lastPostAttempt)
			if lastPostAttempt ~= before or cooldownLeft <= 0 then
				log("egg post failed before hopping - retrying")
				task.wait(2)
			else
				log(("egg(s) unsent - waiting %.0fs for the webhook cooldown"):format(cooldownLeft))
				task.wait(cooldownLeft + 0.5)
			end
		end
	end
	return false
end

-- Median ping (ms) over a few GetNetworkPing samples. Returns nil when the
-- local player isn't around to measure.
local function avgPingMs()
	local lp = Players.LocalPlayer
	if not lp then
		return nil
	end
	local samples = math.max(1, CONFIG.PING_SAMPLES or 3)
	local vals = {}
	for i = 1, samples do
		local ok, p = pcall(function() return lp:GetNetworkPing() end)
		if ok and type(p) == "number" then
			vals[#vals + 1] = p * 1000
		end
		if i < samples then
			-- Only relevant when PING_SAMPLES > 1; kept short so a multi-sample
			-- read never becomes the slowest thing on a landing.
			task.wait(0.3)
		end
	end
	if #vals == 0 then
		return nil
	end
	table.sort(vals)
	return vals[math.ceil(#vals / 2)]
end

-- ---------------------------------------------------------------- spawn wave
-- The map refreshes on 5-minute wall-clock boundaries (:00/:05/...).
-- Cycle: keep hopping and posting all cycle, then stop from 4:30 and hold the
-- current server through the wave, resuming at 5:05.
local SPAWN_PERIOD = 300
local SPAWN_SETTLE = 5
local SPAWN_HOLD_AT = 270 -- 4:30 into the cycle: stop hopping, hold for wave

local function hoppingPaused()
	local e = os.time() % SPAWN_PERIOD
	return e >= SPAWN_HOLD_AT or e < SPAWN_SETTLE
end

-- ------------------------------------------------------- 3D rendering off
-- Roblox has no "stop drawing" switch, so this stacks four cheap layers:
--   1. every BasePart under workspace gets LocalTransparencyModifier = 1, so
--      the renderer skips it - re-applied as parts stream in, because the
--      character's fade-through-wall code overwrites it every few seconds;
--   2. shadows off + lowest render quality (one-time);
--   3. an FPS cap - the single biggest GPU/battery lever on a phone;
--   4. a full-screen cover over whatever still draws (terrain, sky, UI).
-- Nothing here touches replication: EggState, the Halloween world and the
-- boss scan read objects and attributes, never pixels - all keep working.
-- Originals live in getgenv (wiped on teleport anyway, and a teleport rebuilds
-- the whole world) so DISABLE_3D = false can genuinely put things back.
local RENDER_GUI   = "EggGrabberRenderOff"
local LTM_STORE    = "EGG_GRABBER_HIDDEN_LTM"
local RENDER_SAVED = "EGG_GRABBER_RENDER_SAVED"

local function envTable(key)
	local g = genv()
	if g == nil then return nil end
	if type(g[key]) ~= "table" then g[key] = {} end
	return g[key]
end

local function hidePart(part, store)
	if store ~= nil and store[part] == nil then
		store[part] = part.LocalTransparencyModifier
	end
	if part.LocalTransparencyModifier ~= 1 then
		part.LocalTransparencyModifier = 1
	end
end

local function sweepHidden(root, store)
	if root == nil then return end
	pcall(function()
		for _, d in ipairs(root:GetDescendants()) do
			if d:IsA("BasePart") then
				hidePart(d, store)
			end
		end
	end)
end

-- The periodic re-hide walks only the parts we already hid, not the whole
-- workspace. GetDescendants() hands back every Instance in the game - scripts,
-- folders, attachments, sounds - so that table is several times bigger than the
-- part list and gets rebuilt on every pass: the single most expensive thing in
-- here, and pure GC pressure on a phone. New parts are caught by
-- DescendantAdded the moment they stream in, so nothing is missed.
local function rehideStored(store)
	if store == nil then return end
	pcall(function()
		for part in pairs(store) do
			if part == nil or part.Parent == nil or not part:IsA("BasePart") then
				store[part] = nil -- destroyed/streamed out: stop tracking it
			elseif part.LocalTransparencyModifier ~= 1 then
				part.LocalTransparencyModifier = 1
			end
		end
	end)
end

local function renderOffGraphics()
	local saved = envTable(RENDER_SAVED)
	local qualityOK, shadowsOK, fpsOK = false, false, false

	pcall(function()
		local rs = settings().Rendering
		if saved ~= nil and saved.quality == nil then
			saved.quality = rs.QualityLevel
		end
		-- The enum member name has changed across Roblox versions; try the
		-- known spellings rather than assume one.
		for _, name in ipairs({ "Level01", "QualityLevel1", "Level1" }) do
			local ok, item = pcall(function() return Enum.RenderQuality[name] end)
			if ok and item then
				rs.QualityLevel = item
				break
			end
		end
		if saved ~= nil and saved.shadowTech == nil then
			saved.shadowTech = rs.ShadowTechnology
		end
		rs.ShadowTechnology = Enum.ShadowTechnology.NoShadows
		qualityOK = true
	end)

	pcall(function()
		local lighting = game:GetService("Lighting")
		if saved ~= nil and saved.globalShadows == nil then
			saved.globalShadows = lighting.GlobalShadows
		end
		lighting.GlobalShadows = false
		shadowsOK = true
	end)

	local fps = tonumber(CONFIG.RENDER_OFF_FPS) or 0
	if fps <= 0 then
		fpsOK = true
	elseif type(setfpscap) == "function" then
		pcall(function()
			if saved ~= nil then saved.fps = true end
			setfpscap(fps)
			fpsOK = true
		end)
	else
		-- No setfpscap in this executor: not a failure, there is simply no
		-- cap to set. Treating it as one is what made the caller re-apply the
		-- render settings on every sweep, which is a hitch on every sweep.
		fpsOK = true
	end

	-- A script fired very early can land before Lighting or the render
	-- settings exist, so the caller retries this a few times right after a
	-- landing - and then stops for good. These writes rebuild Roblox's render
	-- state; a permanent retry is a permanent stutter.
	return qualityOK and shadowsOK and fpsOK
end

-- Undo everything the layers above changed. Part transparency is restored from
-- LTM_STORE; the FPS cap has no readable original, so it goes back to Roblox's
-- usual default of 60.
local function renderOffRestore()
	local saved = envTable(RENDER_SAVED)
	if saved ~= nil then
		pcall(function()
			if saved.quality ~= nil then
				settings().Rendering.QualityLevel = saved.quality
			end
			if saved.shadowTech ~= nil then
				settings().Rendering.ShadowTechnology = saved.shadowTech
			end
		end)
		pcall(function()
			if saved.globalShadows ~= nil then
				game:GetService("Lighting").GlobalShadows = saved.globalShadows
			end
		end)
		if saved.fps and type(setfpscap) == "function" then
			pcall(setfpscap, 60)
		end
		for k in pairs(saved) do saved[k] = nil end
	end

	local store = envTable(LTM_STORE)
	if store ~= nil then
		for part, prev in pairs(store) do
			pcall(function()
				if part.Parent ~= nil and part:IsA("BasePart") then
					part.LocalTransparencyModifier = prev
				end
			end)
			store[part] = nil
		end
	end

	local lp = Players.LocalPlayer
	local pg = lp and lp:FindFirstChildOfClass("PlayerGui")
	local gui = pg and pg:FindFirstChild(RENDER_GUI)
	if gui then gui:Destroy() end
end

-- There is no blocking call anywhere above this point, so renderOffEnable()
-- reaches the two instant layers while the loading screen is still up: the
-- settings (quality/shadows/FPS) and a hide-the-parts sweep over whatever has
-- already streamed in. Only the cover has to wait for PlayerGui to replicate,
-- so it is spawned and retried instead of holding up the hunter.
local renderOffDone = false

local function renderOffEnable()
	if renderOffDone then
		return CONFIG.DISABLE_3D == true
	end
	renderOffDone = true

	if CONFIG.DISABLE_3D ~= true then
		-- Also clean up after a previous run that HAD it on, so flipping the
		-- key off really does put the world back.
		local lp = Players.LocalPlayer
		local pg = lp and lp:FindFirstChildOfClass("PlayerGui")
		local store = envTable(LTM_STORE)
		if (pg and pg:FindFirstChild(RENDER_GUI)) or (store and next(store) ~= nil) then
			renderOffRestore()
			log("3D rendering back on - world restored")
		end
		return false
	end

	local store = envTable(LTM_STORE)
	local graphicsDone = renderOffGraphics()
	local graphicsTries = 1
	sweepHidden(workspace, store) -- yields nothing: hides everything already in the map

	-- Streamed parts get hidden the moment they arrive, so the periodic pass
	-- further down only has to repair the ones the game itself un-hides (the
	-- local character's own parts, mainly).
	local conn = nil
	local function hookNewParts()
		if conn or workspace == nil then return end
		local ok, c = pcall(function()
			return workspace.DescendantAdded:Connect(function(d)
				if d:IsA("BasePart") then
					pcall(hidePart, d, store)
				end
			end)
		end)
		if ok then conn = c end
	end
	hookNewParts()

	task.spawn(function()
		-- No panel wanted: drop one left over from a previous run and stop
		-- here. The parts stay hidden either way - the screen is just left
		-- readable, so Delta's own menu is no longer buried under a white
		-- sheet.
		if CONFIG.SHOW_COVER ~= true then
			local lp = Players.LocalPlayer
			local pg = lp and lp:FindFirstChildOfClass("PlayerGui")
			local gui = pg and pg:FindFirstChild(RENDER_GUI)
			if gui then pcall(function() gui:Destroy() end) end
			return
		end

		-- 1) The cover. PlayerGui does not exist while the loading screen is
		--    still up, so poll fast and drop the panel in the moment it does -
		--    DURING the load, not after it. Bounded, and it never gives up on
		--    the first miss the way the old one-shot version did.
		--    Its own task on purpose: a late PlayerGui must never hold up the
		--    sweeps in the task below.
		local deadline = os.clock() + 90
		while os.clock() < deadline and not stopped() do
			local lp = Players.LocalPlayer
			local pg = lp and lp:FindFirstChildOfClass("PlayerGui")
			if pg then
				local ok = pcall(function()
					local old = pg:FindFirstChild(RENDER_GUI)
					if old then old:Destroy() end

					local gui = Instance.new("ScreenGui")
					gui.Name           = RENDER_GUI
					gui.ResetOnSpawn   = false
					gui.IgnoreGuiInset = true
					gui.DisplayOrder   = tonumber(CONFIG.RENDER_OFF_DISPLAY_ORDER) or 9999

					local cover = Instance.new("Frame")
					cover.Name             = "cover"
					cover.AnchorPoint      = Vector2.new(0.5, 0.5)
					cover.Position         = UDim2.fromScale(0.5, 0.5)
					cover.Size             = UDim2.fromScale(2, 2) -- bleeds past any inset
					cover.BackgroundColor3 = CONFIG.RENDER_OFF_COLOR or Color3.new(1, 1, 1)
					cover.BorderSizePixel  = 0
					cover.Active           = false -- taps fall through to the game
					cover.Parent           = gui

					gui.Parent = pg
				end)
				if ok then break end
			end
			task.wait(0.1)
		end
	end)

	-- 2) Keep everything applied for as long as this server lives.
	task.spawn(function()
		local lastFullSweep = os.clock()
		while not stopped() do
			-- The three graphics writes are retried a handful of times right
			-- after a landing (a run can beat Lighting / RenderSettings into
			-- existence) and then left alone for good. Rewriting them rebuilds
			-- Roblox's render state, so retrying them on every pass - which is
			-- what the previous build did - was a hitch on every pass.
			if not graphicsDone and graphicsTries < 10 then
				graphicsTries = graphicsTries + 1
				graphicsDone = renderOffGraphics()
			end
			hookNewParts()

			task.wait(4)
			if stopped() then break end

			-- Roblox's own camera code resets LocalTransparencyModifier on the
			-- LOCAL CHARACTER every few frames (the first-person fade), so that
			-- is the only thing that genuinely needs repairing on a short timer
			-- - and it is a handful of parts. Sweeping every tracked part here
			-- instead is tens of thousands of property reads inside a single
			-- frame, which is what the stutter every few seconds was.
			local char = Players.LocalPlayer and Players.LocalPlayer.Character
			sweepHidden(char, store)

			local fullEvery = tonumber(CONFIG.RENDER_OFF_FULL_SWEEP) or 60
			if fullEvery > 0 and os.clock() - lastFullSweep >= fullEvery then
				lastFullSweep = os.clock()
				rehideStored(store)
			end
		end
		if conn then pcall(function() conn:Disconnect() end) end
	end)

	local fps = tonumber(CONFIG.RENDER_OFF_FPS) or 0
	local covered = CONFIG.SHOW_COVER == true and ", screen covered" or ""
	log(fps > 0
		and ("3D rendering OFF - world hidden, FPS capped at %d"):format(fps) .. covered
		or ("3D rendering OFF - world hidden" .. covered))
	return true
end

local function main()
	-- Kill the 3D view before anything else: every wait below is replication
	-- (game:IsLoaded, WaitForChild, ReadFieldEggs), so hiding the world costs
	-- the hunter exactly nothing.
	renderOffEnable()

	-- A load failure is routine right after a hop: this file reruns while the
	-- DataModel is still coming up, so ReplicatedStorage is often not ready
	-- yet. Wait it out and retry in place FIRST - spending a hop on a module
	-- that simply had not replicated yet is what fed the teleport storm.
	local assets, eggState = loadModules()
	if not assets then
		log("load failed: " .. tostring(eggState) .. " - retrying load in place")
		task.wait(CONFIG.LOAD_RETRY_WAIT)
		assets, eggState = loadModules()
	end
	if not assets then
		log("still not loaded: " .. tostring(eggState) .. " - hopping to another server")
		if hop() then
			return
		end
		-- Neither loading nor hopping worked. Do not end the run: raise, and
		-- the supervisor below waits and calls main() again.
		error("load failed and could not hop")
	end

	log(("landed on server %s (%d/%d)"):format(game.JobId, #Players:GetPlayers(), CONFIG.SERVER_CAPACITY))
	notify(("landed %d/%d players"):format(#Players:GetPlayers(), CONFIG.SERVER_CAPACITY))
	rememberVisit(game.JobId)

	local players = #Players:GetPlayers()
	if players > CONFIG.MAX_POP_ON_LAND then
		log(("landed in a %d/%d server - quick scanning before hopping (want up to %d)")
			:format(players, CONFIG.SERVER_CAPACITY, CONFIG.MAX_POP_ON_LAND))
		waitForEggs(eggState, CONFIG.QUICK_SCAN_SECS)
		if tryReportAny(scan(assets, eggState)) then
			log("target egg found on busy landing - reported, still hopping")
		end
		flushEggs(assets, eggState)
		task.wait(CONFIG.REJECT_DELAY)
		if hop() then
			return
		end
		log("nowhere to go - staying here after all")
	elseif players < CONFIG.MIN_POP_ON_LAND then
		if players == 0 then
			log("landed with 0 players - hopping")
			task.wait(CONFIG.REJECT_DELAY)
			if hop() then return end
		end
	elseif readLeft() == game.JobId then
		log("rejecting landing: the server we just left")
		task.wait(CONFIG.REJECT_DELAY)
		if hop() then
			return
		end
		log("nowhere to go - staying here after all")
	end

	if not waitForEggs(eggState, CONFIG.LOAD_TIMEOUT) then
		log("egg data did not populate in time - scanning anyway")
	end

	-- Report anything already sitting here first, and wait for the post to
	-- actually go through (webhook cooldown included), so the ping hop below
	-- never skips eggs on this server.
	flushEggs(assets, eggState)

	-- Halloween Dimension: purely additive reporting. Its eggs are (almost)
	-- always up, so the result is ignored and never gates a hop - and nothing
	-- about the boss scan is run because of it.
	tryReportHalloween(#Players:GetPlayers())
	log(halloweenCensusText())

	-- Ping gate: eggs (if any) are already reported above, so a laggy server
	-- can be skipped without losing anything. One GetNetworkPing read, so it
	-- costs nothing measurable.
	if CONFIG.MAX_PING_MS and CONFIG.MAX_PING_MS > 0 then
		local ping = avgPingMs()
		if ping and ping > CONFIG.MAX_PING_MS then
			log(("high ping %.0fms (want <=%dms) - hopping"):format(ping, CONFIG.MAX_PING_MS))
			if hop() then
				return
			end
		elseif ping then
			log(("ping %.0fms - good, staying"):format(ping))
		end
	end

	local started       = os.clock()
	local lastSummary   = os.clock()
	local lastRepeatLog = 0
	local lastBossScan  = 0
	local lobbyStuckAt  = 0

	while true do
		if stopped() then
			log("stopped by EGG_GRABBER_STOP flag")
			return
		end

		if not game:IsLoaded() then
			-- Client is not in a game (279 / disconnect / error screen). Do NOT
			-- teleport from here - doing so forces the client to relaunch which
			-- takes the other clones down with it. Wait for the reconnect
			-- (Play button / Termux / AutoExec once loaded) instead.
			if lobbyStuckAt == 0 then
				lobbyStuckAt = os.clock()
			end
			if os.clock() - lobbyStuckAt >= 30 then
				log("client not loaded 30s+ - waiting for reconnect, not teleporting")
			else
				log("lost the server / stuck on loading - waiting for reconnect")
			end
			task.wait(2)
		else
			lobbyStuckAt = 0
		end

		local hits    = scan(assets, eggState)
		local players = #Players:GetPlayers()
		CONFIG.hbStatus = "Scanning"

		-- Opportunistic post of anything fresh the moment it is seen; the
		-- branches below only hop once it has actually gone through.
		tryReportFreshOnly(hits)

		-- Halloween Dimension eggs: additive reporting only - never a hop or
		-- hold reason, since they are (almost) always present on every server.
		tryReportHalloween(players)

		-- Dr. Scramble boss detection (DISABLED)
		--[[
		if not bossAlerted[game.JobId] and os.clock() - lastBossScan >= BOSS_SCAN_INTERVAL then
			lastBossScan = os.clock()
			local active, evidence = scanBossActive()
			if active then
				log("Dr. Scramble active (" .. tostring(evidence) .. ") - sending alert")
				if postBossAlert(players, evidence) then
					bossAlerted[game.JobId] = true
				end
			end
		end
		]]--

		if #hits > 0 then
			local posted = readPosted()
			local fresh  = {}
			for _, hit in ipairs(hits) do
				if not posted[postedKey(hit.record)] then
					fresh[#fresh + 1] = hit
				end
			end

			if #fresh == 0 then
				if hoppingPaused() then
					log("holding for spawn wave")
				else
					log(("all %d target egg(s) visible already reported (%d/%d) - hopping to search for fresh")
						:format(#hits, players, CONFIG.SERVER_CAPACITY))
					if hop() then
						return
					end
				end
			else
				log(("FOUND %d target egg(s) (%d already reported), %d/%d players - posting")
					:format(#fresh, #hits - #fresh, players, CONFIG.SERVER_CAPACITY))
				notify(("found %d target egg(s)"):format(#fresh))

				local sent = post(fresh, players)
				for _, hit in ipairs(sent) do
					rememberPosted(hit.record)
				end

				if #sent >= #fresh then
					if CONFIG.DWELL > 0 then
						log(("holding %ss so the join link stays alive"):format(CONFIG.DWELL))
						task.wait(CONFIG.DWELL)
					end

					log("target egg reported - hopping on to keep hunting")
					notify("egg posted - hopping")
					if hoppingPaused() then
						log("target egg reported - holding for spawn wave")
					else
					if hop() then
						return
					end
					end
					log("nowhere to go - staying here after all")
				elseif #sent > 0 then
					log(("posted %d of %d egg(s) - staying to retry the rest")
						:format(#sent, #fresh))
				else
					log("post did not go through - staying to retry")
				end
			end
		else
			if os.clock() - lastSummary >= 30 then
				lastSummary = os.clock()
				log(("watching (%ds)   %s   %s")
					:format(math.floor(os.clock() - started), censusText(assets, eggState), halloweenCensusText()))
			end

			if hoppingPaused() then
				log("holding for spawn wave")
			else
				log("no target eggs on this server - hopping to search elsewhere")
				if hop() then
					return
				end
			end
			started = os.clock()
			lastSummary = os.clock()
			lastRepeatLog = 0
		end

		task.wait(CONFIG.POLL)
	end
end

-- -------------------------------------------------------------------- start

-- Only run in the target experience. This makes the script safe to keep in
-- AutoExec: in every other game it just exits.
if tostring(game.PlaceId) ~= tostring(CONFIG.PLACE_ID) then
	print("[egg-grabber] wrong place (" .. tostring(game.PlaceId) .. ") - not starting")
	notifyForce("wrong game - join Steal An Egg first")
	return
end

-- One instance per executor environment.
local g = genv()
if g ~= nil and g.EGG_GRABBER_RUNNING then
	print("[egg-grabber] duplicate start ignored - already running")
	notifyForce("already running - reset flags to restart")
	return
end

-- Persistent kill switch (getgenv is wiped on every teleport).
local okS, stopFile = pcall(readfile, STOP_FILE)
if okS and type(stopFile) == "string" and stopFile:match("%s*1") then
	print("[egg-grabber] kill switch set (egg-grabber-delta-stop.txt) - not starting")
	notifyForce("kill switch set - clear stop file")
	return
end

if g ~= nil then
	g.EGG_GRABBER_RUNNING = true
end

-- Report up front how this run will restart after a hop, so a silent stop is
-- never a mystery.
do
	local qfn = queue_on_teleport or queueonteleport
	local saved = false
	if type(isfile) == "function" then
		local okF, present = pcall(isfile, SELF)
		saved = okF and present == true
	end
	log(("restart check: queue=%s loadfile=%s readfile=%s saved=%s")
		:format(
			type(qfn) == "function" and "yes" or "NO",
			type(loadfile) == "function" and "yes" or "NO",
			type(readfile) == "function" and "yes" or "NO",
			saved and "yes" or "NO"))
	if not saved and scriptUrl() == "" then
		log("WARNING: '" .. SELF .. "' is not saved in Delta's workspace and no script URL is set, so a hop cannot reload the script. Set SCRIPT_URL, save the file there, or use AutoExec.")
	end
end

-- Anti-AFK: REMOVED on purpose. Steal An Egg's BAC anti-cheat kicks for
-- VirtualUser input (that was the trigger for BAC-5516 / BAC-8518). Delta has
-- its own built-in anti-AFK - turn that on in the Delta menu instead of using
-- this script.

-- Supervisor: main() must never be allowed to end the run. The only way it
-- returns is via the stop switch or a successful hop (which reloads this file
-- on the new server); any other exit - an error, or a load failure with
-- nowhere to hop - means the hunt would sit dead until someone noticed.
-- So wrap it: if it comes back without being stopped and without having
-- hopped, wait and run it again. Nothing is lost by retrying: main()
-- re-reads the world on entry and the instance lock is only released on a
-- clean stop.
-- ---------------------------------------------------------------- heartbeat
-- Tells the relay this account is alive so the website can list it. One tiny
-- POST every HEARTBEAT_EVERY seconds, in its own thread (never blocks hopping).
CONFIG.HEARTBEAT_EVERY = 10
CONFIG.beatFails = 0
-- one beat. Also called straight away when a hop starts (status "Hopping"), so the
-- relay knows this account is teleporting and keeps it Online during the gap.
function CONFIG.sendBeat()
	local url = (tostring(CONFIG.HUB_URL or ""):gsub("/publish/?$", "")) .. "/beat"
	local key = CONFIG.hubKey()
	if type(httpRequest) ~= "function" or key == "" or key:find("PUT_FINDER", 1, true) then return end
	local status = CONFIG.hbStatus or "Starting"
	if hoppingPaused() then status = "Holding for wave" end
	local body = jsonEncode({ name = ACCT_TAG, status = status, eggs = eggsSentThisRun })
	if not body then return end
	local ok, res = pcall(httpRequest, {
		Url = url, Method = "POST",
		Headers = { ["Content-Type"] = "application/json", ["x-key"] = key },
		Body = body,
	})
	local code = ok and type(res) == "table" and (res.StatusCode or res.status) or nil
	if code == 200 then
		CONFIG.beatFails = 0
	else
		CONFIG.beatFails = CONFIG.beatFails + 1
		if CONFIG.beatFails == 1 or CONFIG.beatFails % 6 == 0 then
			log("heartbeat failed (" .. tostring(code or res) .. ") x" .. CONFIG.beatFails)
		end
	end
end
task.spawn(function()
	while not stopped() do
		CONFIG.sendBeat()
		task.wait(CONFIG.HEARTBEAT_EVERY)
	end
end)

task.spawn(function()
	while true do
		local ok, err = pcall(main)
		if stopped() then
			break
		end
		if not ok then
			log("main() error: " .. tostring(err) .. " - restarting in " .. CONFIG.MAIN_RESTART_WAIT .. "s")
		else
			log("main() returned without hopping - restarting in " .. CONFIG.MAIN_RESTART_WAIT .. "s")
		end
		local t0 = os.clock()
		while os.clock() - t0 < CONFIG.MAIN_RESTART_WAIT do
			if stopped() then break end
			task.wait(0.5)
		end
		if stopped() then break end
	end

	-- Only reached on a real stop: clear the in-memory flag so a fresh
	-- execute can start again.
	local g2 = genv()
	if g2 ~= nil then
		g2.EGG_GRABBER_RUNNING = false
	end
end)
