-- ============================================================
-- SCRAMBLE TRACKER
-- One message per Scramble fight: posted once (join link + phase + boss HP),
-- edited every SCRAMBLE_EDIT_EVERY seconds while the boss is alive, then
-- "Boss Dead." when Phase becomes "Defeated".
-- Right before a rare-egg hop, Scramble.beforeLeave() edits the message to
-- "Not in server anymore". This module never starts hopping on its own.
-- ============================================================
local Scramble = {}

do
    local S = {
        id = nil, url = nil, startedAt = nil, lastEdit = 0,
        done = false, dead = false, left = false,
        editing = false, sending = false, retryAt = 0, noArena = 0,
    }

    local JSON_HEADERS = { ["Content-Type"] = "application/json" }

    local function on()
        return workspace:GetAttribute("Event_ScrambleBoss") == true
    end

    local function commas(n)
        n = tonumber(n)
        if not n then return "?" end
        local text = string.format("%.0f", math.max(n, 0))
        local count
        repeat
            text, count = text:gsub("^(%d+)(%d%d%d)", "%1,%2")
        until count == 0
        return text
    end

    local function bar(p)
        p = math.clamp(tonumber(p) or 0, 0, 1)
        local n = math.floor(p * 12 + 0.5)
        return string.rep("█", n) .. string.rep("░", 12 - n)
    end

    -- reads everything we show, straight from Workspace.ScrambleArena
    local function read()
        local f = {}
        local a = workspace:FindFirstChild("ScrambleArena")
        if a then
            f.arena = true
            f.phase = a:GetAttribute("Phase")
            f.hp = a:GetAttribute("Health")
            f.max = a:GetAttribute("MaxHealth")
            f.spawnsAt = a:GetAttribute("SpawnsAt")
            f.coreStage = a:GetAttribute("CoreStage")
            f.hits = a:GetAttribute("HumanHits")
            local ball = a:FindFirstChild("Ball")
            f.ratio = ball and ball:GetAttribute("DamageRatio") or nil
        end
        return f
    end

    -- returns a field label and text for the current phase
    local function progress(f)
        local ph = tostring(f.phase or "Unknown")
        if ph == "Waiting" then
            local at = tonumber(f.spawnsAt)
            if at and at > os.time() then
                return "Boss", "Spawning <t:" .. math.floor(at) .. ":R>"
            end
            return "Boss", "Spawning soon"
        elseif ph == "Mech" then
            local hp, mx = tonumber(f.hp), tonumber(f.max)
            if hp and mx and mx > 0 then
                return "Boss HP", "```" .. bar(hp / mx) .. " " .. math.floor(hp / mx * 100 + 0.5)
                    .. "%\n" .. commas(hp) .. " / " .. commas(mx) .. " HP```"
            end
            return "Boss HP", "Unknown"
        elseif ph == "Ejecting" then
            return "Boss HP", "```Mech destroyed, boss ejecting```"
        elseif ph == "Ball" then
            local r = tonumber(f.ratio) or 0
            local stage = tonumber(f.coreStage)
            local extra = stage and ("\nCore stage " .. math.min(stage + 1, 3) .. " / 3") or ""
            return "Ball phase", "```" .. bar(r) .. " " .. math.floor(r * 100 + 0.5) .. "%" .. extra .. "```"
        elseif ph == "Human" then
            local h = tonumber(f.hits) or 0
            return "Human phase", "```" .. bar(h / 3) .. " " .. h .. " / 3 hits```"
        elseif ph == "Final" then
            return "Final phase", "```Dr. Scramble is almost down```"
        end
        return "Phase", "```" .. ph .. "```"
    end

    local function embed(mode, f)
        local now = os.time()
        local link = serverLink()
        local joinText = link and ("[**Click to Join Server**](" .. link .. ")") or "**Unavailable**"
        local detected = "<t:" .. (S.startedAt or now) .. ":R>"

        local e = {
            timestamp = os.date("!%Y-%m-%dT%H:%M:%SZ", now),
            footer    = { text = FOOTER_TEXT .. " • Scramble Alert" },
        }

        if mode == "dead" or mode == "ended" then
            local dead = (mode == "dead")
            e.title = "🧪  DR. SCRAMBLE EVENT ENDED  🧪"
            e.description = dead and "**Boss Dead.**" or "**The Scramble event has ended.**"
            e.color = dead and 0xE74C3C or 0x95A5A6
            e.fields = {
                { name = "❌ Status",   value = dead and "**Defeated**" or "**Finished**", inline = true },
                { name = "⏱️ Detected", value = detected, inline = true },
                { name = "⌛ Ended",    value = "<t:" .. now .. ":R> (<t:" .. now .. ":t>)", inline = true },
            }
            return e
        end

        e.title = "🧪  DR. SCRAMBLE EVENT  🧪"
        e.description = "*The Scramble boss event is running in this server.*"

        if mode == "left" then
            e.color = 0xE67E22
            e.fields = {
                { name = "📡 Status", value = "**Left the server**", inline = true },
                { name = "🔗 Server", value = joinText, inline = true },
                { name = "⏱️ Detected", value = detected, inline = true },
                { name = "❤️ Boss HP", value = "**Not in server anymore**", inline = false },
                { name = "🔄 Last updated", value = "<t:" .. now .. ":R>", inline = false },
            }
        else
            local label, text = progress(f)
            e.color = 0x2ECC71
            e.fields = {
                { name = "📡 Status", value = "**Boss alive**", inline = true },
                { name = "🎯 Phase",  value = "**" .. tostring(f.phase or "Unknown") .. "**", inline = true },
                { name = "🔗 Server", value = joinText, inline = true },
                { name = "❤️ " .. label, value = text, inline = false },
                { name = "⏱️ Detected", value = detected, inline = true },
                { name = "🔄 Last updated", value = "<t:" .. now .. ":R>", inline = true },
            }
        end
        return e
    end

    -- POST with ?wait=true so Discord returns the message id (needed to edit it later)
    local function postWait(url, payload)
        if not httpRequest then warn("[EGG KG] No http request function in this executor") return nil end
        if not validUrl(url) then warn("[EGG KG] Scramble webhook not set or invalid") return nil end

        for _ = 1, 4 do
            local ok, res = pcall(httpRequest, {
                Url = url .. "?wait=true", Method = "POST",
                Headers = JSON_HEADERS, Body = HttpService:JSONEncode(payload),
            })
            if ok and type(res) == "table" then
                local code = tonumber(res.StatusCode)
                if code == 429 then
                    local wait = 1
                    pcall(function() wait = tonumber(HttpService:JSONDecode(res.Body).retry_after) or 1 end)
                    task.wait(wait + 0.1)
                elseif code and code >= 200 and code < 300 then
                    local okj, data = pcall(function() return HttpService:JSONDecode(res.Body) end)
                    if okj and type(data) == "table" and data.id then return tostring(data.id) end
                    return nil
                else
                    warn("[EGG KG] Scramble post failed, status " .. tostring(code))
                    return nil
                end
            else
                task.wait(1)
            end
        end
        return nil
    end

    -- edit an existing webhook message. returns ok, statusCode
    local function patchMessage(url, id, payload)
        if not httpRequest then return false end
        for _ = 1, 3 do
            local ok, res = pcall(httpRequest, {
                Url = url .. "/messages/" .. id, Method = "PATCH",
                Headers = JSON_HEADERS, Body = HttpService:JSONEncode(payload),
            })
            if ok and type(res) == "table" then
                local code = tonumber(res.StatusCode)
                if code == 429 then
                    local wait = 1
                    pcall(function() wait = tonumber(HttpService:JSONDecode(res.Body).retry_after) or 1 end)
                    task.wait(wait + 0.1)
                elseif code and code >= 200 and code < 300 then
                    return true, code
                else
                    return false, code
                end
            else
                task.wait(1)
            end
        end
        return false
    end

    local function reset()
        S.id, S.url, S.startedAt = nil, nil, nil
        S.lastEdit, S.retryAt, S.noArena = 0, 0, 0
        S.done, S.dead, S.left = false, false, false
    end

    local function sendFirst(f)
        S.sending = true
        S.startedAt = os.time()
        local url = (SCRAMBLE_WEBHOOK ~= "" and SCRAMBLE_WEBHOOK) or WEBHOOKS.Secret
        local role = cleanRole(SCRAMBLE_ROLE)
        local mention = (role ~= "") and ("<@&" .. role .. "> ") or ""

        local id = postWait(url, {
            username   = BOT_NAME,
            avatar_url = (BOT_AVATAR ~= "") and BOT_AVATAR or nil,
            content    = mention .. "🧪 **Dr. Scramble event is active in this server**",
            allowed_mentions = { parse = { "roles" } },
            embeds     = { embed("alive", f) },
        })
        S.sending = false

        if id then
            S.id, S.url, S.lastEdit = id, url, os.clock()
            print("[EGG KG] Scramble event detected, message sent")
        else
            S.retryAt = os.clock() + 15
            warn("[EGG KG] Scramble message failed to send, retrying in 15s")
        end
    end

    local function editAlive(f)
        S.editing = true
        local ok, code = patchMessage(S.url, S.id, { embeds = { embed("alive", f) } })
        S.editing = false
        S.lastEdit = os.clock()
        if not ok and code == 404 then
            S.dead = true   -- message was deleted, stop editing it
            warn("[EGG KG] Scramble message was deleted, no more edits")
        end
    end

    local function finish(mode, f)
        S.editing = true
        patchMessage(S.url, S.id, { embeds = { embed(mode, f) } })
        S.editing = false
        S.done = true
        print("[EGG KG] Scramble message set to " .. (mode == "dead" and "Boss Dead." or "event ended"))
    end

    local function step()
        local isOn = on()
        local f = read()

        -- event over
        if not isOn then
            if S.id and not S.done and not S.dead and not S.left then finish("ended", f) end
            if S.id or S.done or S.dead then reset() end
            return
        end

        -- boss dead (also covers joining a server after the boss already died: no alert)
        if f.phase == "Defeated" then
            if S.id and not S.done and not S.dead and not S.left then finish("dead", f) end
            S.done = true
            return
        end

        -- a new fight started after a finished one
        if S.done then reset() end

        -- give the arena a few seconds to load before the first message
        if not f.arena then
            S.noArena = S.noArena + 1
            if S.noArena < 8 then return end
        else
            S.noArena = 0
        end

        if S.left then return end

        if not S.id then
            if S.dead or os.clock() < S.retryAt then return end
            sendFirst(f)
        elseif not S.dead and os.clock() - S.lastEdit >= SCRAMBLE_EDIT_EVERY then
            editAlive(f)
        end
    end

    -- called by the hopper right BEFORE teleporting away
    function Scramble.beforeLeave()
        if not SCRAMBLE_ENABLED or not on() then return end
        local f = read()
        if f.phase == "Defeated" then return end

        -- let the first message go out, then let any edit in flight finish
        local t0 = os.clock()
        while not S.id and not S.dead and not S.done and os.clock() - t0 < 8 do task.wait(0.2) end
        t0 = os.clock()
        while (S.editing or S.sending) and os.clock() - t0 < 6 do task.wait(0.1) end

        if not S.id or S.done or S.dead then return end
        S.left = true   -- stops the 10s edits
        local ok = patchMessage(S.url, S.id, { embeds = { embed("left", f) } })
        print("[EGG KG] Scramble message set to 'Not in server anymore'" .. (ok and "" or " (edit failed)"))
    end

    -- called when a teleport fails: we are still here, so resume the 10s edits
    function Scramble.teleportFailed()
        if S.left then
            S.left = false
            S.lastEdit = 0
        end
    end

    if SCRAMBLE_ENABLED then
        task.spawn(function()
            while true do
                local ok, err = pcall(step)
                if not ok then warn("[EGG KG] scramble error: " .. tostring(err)) end
                task.wait(1)
            end
        end)
    end
end

-- ============================================================
-- HALLOWEEN DIMENSION TRACKER
-- These eggs are NOT in EggState.ReadFieldEggs, so they get their own scanner.
-- Reads Workspace.HalloweenDimension.WorldEggs (Zone 2 / Haunted Swamp is skipped).
-- Per server it sends ONE message:
--   "Found none"       when no selected-rarity egg is there
--   the egg embed(s)   when there is one (and if an egg shows up later, the same
--                      message is edited, replacing "Found none")
-- NEW in v5.3: every rare egg found is ALSO sent once to the Worker
-- (/push + /alert) so it appears on the Live Spawn page (HALLOWEEN_SITE).
-- ============================================================
local Halloween = { ready = not HALLOWEEN_ENABLED, busy = false }

if HALLOWEEN_ENABLED then
    task.spawn(function()
        if not httpRequest then Halloween.ready = true return end

        local ZONES = { [1] = "Graveyard", [3] = "Abandoned Manor" }
        local SKIP_ZONES = { [2] = true }

        -- key = PreparedSourceName, lowercase, no spaces
        --   name  = name shown in Discord
        --   site  = name the website uses (the page calls Gorillastein "Abomination Kong")
        --   value = text for the Discord embed, num = money/s as a number for the website
        local EGGS = {
            -- Zone 1: Graveyard
            ["whiskers"]        = { name = "Whiskers",        tier = "Epic" },
            ["jesterpop"]       = { name = "Jesterpop",       tier = "Legendary" },
            ["candlefang"]      = { name = "Candlefang",      tier = "Mythic" },
            ["spiritknight"]    = { name = "Spirit Knight",   tier = "Cosmic" },
            ["graveyardbrute"]  = { name = "Graveyard Brute", site = "Graveyard Brute", tier = "Secret",  value = "75M/s",  num = 75e6 },
            ["ghostreaper"]     = { name = "Ghost Reaper",    site = "Ghost Reaper",    tier = "Eternal", value = "300M/s", num = 300e6 },
            -- Zone 3: Abandoned Manor
            ["halloweenroyalmimicegg"] = { name = "Mimic Chest", tier = "Legendary" },
            ["mimicchest"]      = { name = "Mimic Chest",     tier = "Legendary" },
            ["crowshade"]       = { name = "Crowshade",       tier = "Mythic" },
            ["hexedpumpkin"]    = { name = "Hexed Pumpkin",   tier = "Cosmic" },
            ["dreadwolf"]       = { name = "Werewolf",        site = "Werewolf",         tier = "Secret",  value = "1.3B/s", num = 1.3e9 },
            ["werewolf"]        = { name = "Werewolf",        site = "Werewolf",         tier = "Secret",  value = "1.3B/s", num = 1.3e9 },
            ["frankensteinkongegg"] = { name = "Gorillastein", site = "Abomination Kong", tier = "Eternal", value = "3.5B/s", num = 3.5e9 },
            ["abominationkong"] = { name = "Gorillastein",    site = "Abomination Kong", tier = "Eternal", value = "3.5B/s", num = 3.5e9 },
            ["gorillastein"]    = { name = "Gorillastein",    site = "Abomination Kong", tier = "Eternal", value = "3.5B/s", num = 3.5e9 },
            ["voidseerpumpkin"] = { name = "Voidseer Pumpkin", site = "Voidseer Pumpkin", tier = "Divine", value = "14B/s", num = 14e9 },
        }

        local reported = {}

        -- returns: list of selected-rarity eggs, folderFound, totalEggsSeen
        local function scanEggs()
            local dim    = workspace:FindFirstChild("HalloweenDimension")
            local folder = dim and dim:FindFirstChild("WorldEggs")
            local list, total = {}, 0
            if not folder then return list, false, 0 end

            for _, m in ipairs(folder:GetChildren()) do
                local zone = tonumber(m:GetAttribute("Zone")) or 0
                if not SKIP_ZONES[zone] then
                    total = total + 1
                    local src  = m:GetAttribute("PreparedSourceName")
                    local info = src and EGGS[norm(src)]

                    if not info then
                        local key = m:GetFullName() .. tostring(m:GetAttribute("HalloweenEggUid"))
                        if not reported[key] then
                            reported[key] = true
                            local a = {}
                            for k, v in pairs(m:GetAttributes()) do a[#a + 1] = k .. "=" .. tostring(v) end
                            print("[HALLOWEEN] unidentified egg, zone " .. zone .. ", attrs: " .. table.concat(a, ", "))
                        end
                    elseif RARE[info.tier] then
                        list[#list + 1] = {
                            uid   = tostring(m:GetAttribute("HalloweenEggUid") or m:GetFullName()),
                            name  = info.name,
                            site  = info.site or info.name,   -- NEW: name used on the website
                            num   = info.num,                 -- NEW: money/s as a number
                            tier  = info.tier,
                            zone  = zone,
                            value = info.value,
                        }
                    end
                end
            end
            return list, true, total
        end

        local function embedFor(e)
            local style = STYLE[e.tier]
            local link = serverLink()
            local fields = {
                { name = "🥚 Egg",    value = "**" .. e.name .. " Egg**", inline = true },
                { name = "💎 Rarity", value = "**" .. e.tier .. "**",     inline = true },
                { name = "🔗 Server", value = link and ("[**Click to Join Server**](" .. link .. ")") or "**Unavailable**", inline = true },
                { name = "📍 Zone",   value = "**" .. (ZONES[e.zone] or "Halloween Dimension") .. "** (Zone " .. tostring(e.zone) .. ")", inline = false },
                { name = "💰 Egg Value", value = "```" .. (e.value or "Unknown") .. "```", inline = false },
            }
            local embed = {
                title       = "🎃  HALLOWEEN " .. style.title .. "  🎃",
                description = "*" .. style.tag .. "*\n" .. playerInfoText(),
                color       = style.color,
                fields      = fields,
                footer      = { text = FOOTER_TEXT .. " • Halloween " .. e.tier .. " Alert" },
                timestamp   = os.date("!%Y-%m-%dT%H:%M:%SZ", os.time()),
            }
            local img = IMAGES_N[norm(e.name)]
            if img and tostring(img):find("^https?://") then embed.thumbnail = { url = img } end
            return embed
        end

        local function noneEmbed()
            local link = serverLink()
            return {
                title       = "🎃  HALLOWEEN DIMENSION  🎃",
                description = "**Found none**\n" .. playerInfoText(),
                color       = 0x95A5A6,
                fields      = { { name = "🔗 Server", value = link and ("[**Click to Join Server**](" .. link .. ")") or "**Unavailable**", inline = false } },
                footer      = { text = FOOTER_TEXT .. " • Halloween Scan" },
                timestamp   = os.date("!%Y-%m-%dT%H:%M:%SZ", os.time()),
            }
        end

        local function payloadFor(list, ping)
            if #list == 0 then
                return {
                    content = "🎃 **Halloween Dimension:** Found none",
                    embeds  = { noneEmbed() },
                    allowed_mentions = { parse = {} },
                }
            end

            local names, embeds, mention, roleSeen = {}, {}, "", {}
            for i, e in ipairs(list) do
                names[#names + 1] = "**" .. e.name .. " Egg**"
                if i <= 10 then embeds[#embeds + 1] = embedFor(e) end
                local r = cleanRole(ROLE_IDS[e.tier])
                if r ~= "" and not roleSeen[r] then
                    roleSeen[r] = true
                    mention = mention .. "<@&" .. r .. "> "
                end
            end
            return {
                content = (ping and mention or "") .. "🎃 " .. table.concat(names, ", ") .. " in the Halloween Dimension",
                embeds  = embeds,
                allowed_mentions = ping and { parse = { "roles" } } or { parse = {} },
            }
        end

        local function request(method, url, payload)
            for _ = 1, 4 do
                local ok, res = pcall(httpRequest, {
                    Url = url, Method = method,
                    Headers = { ["Content-Type"] = "application/json" },
                    Body = HttpService:JSONEncode(payload),
                })
                if ok and type(res) == "table" then
                    local code = tonumber(res.StatusCode)
                    if code == 429 then
                        local wait = 1
                        pcall(function() wait = tonumber(HttpService:JSONDecode(res.Body).retry_after) or 1 end)
                        task.wait(wait + 0.1)
                    elseif code and code >= 200 and code < 300 then
                        return res
                    else
                        warn("[HALLOWEEN] webhook failed, status " .. tostring(code) .. " " .. tostring(res.Body))
                        return nil
                    end
                else
                    task.wait(1)
                end
            end
            return nil
        end

        -- ---------------- NEW: send rare Halloween eggs to the Live Spawn page ----------------
        local ALERT_URL = (FEED_PUSH_URL:gsub("/push$", "/alert"))
        local pushedSite = {}   -- uid -> true, so each egg is sent to the site only once

        local function pushHalloweenToSite(e)
            if not HALLOWEEN_SITE or not httpRequest or FEED_PUSH_URL == "" then return end
            if game.JobId == "" then return end

            local valueText = e.num and formatMoney(e.num) or "Unknown"   -- "$1.30B/s": the page only reads this format
            local eggName   = e.site .. " Egg"
            local image     = IMAGES_N[norm(e.name)] or ""
            local headers   = { ["Content-Type"] = "application/json", ["x-key"] = FEED_KEY }

            -- 1) /push: key-holder view (join link) + Discord subscribers of the site
            pcall(httpRequest, {
                Url = FEED_PUSH_URL, Method = "POST", Headers = headers,
                Body = HttpService:JSONEncode({
                    egg = eggName, rarity = e.tier, kg = "?", mutation = "NONE",
                    value = valueText, image = image, test = false,
                    players = #Players:GetPlayers() .. "/" .. Players.MaxPlayers,
                    placeId = tostring(game.PlaceId), jobId = game.JobId,
                }),
            })

            -- 2) /alert: public view, history and voice alert
            pcall(httpRequest, {
                Url = ALERT_URL, Method = "POST", Headers = headers,
                Body = HttpService:JSONEncode({
                    type = "egg", egg = eggName, rarity = e.tier,
                    location = ZONES[e.zone] or "Halloween Dimension",
                    value = valueText, image = image, status = "Active",
                }),
            })
            print("[HALLOWEEN] sent to Live Spawn page: " .. eggName)
        end

        local url = (HALLOWEEN_WEBHOOK ~= "" and HALLOWEEN_WEBHOOK) or WEBHOOKS.Secret
        if not validUrl(url) then
            warn("[HALLOWEEN] webhook not set or invalid")
            Halloween.ready = true
            return
        end

        local startedAt = os.clock()
        local msgId, retryAt = nil, 0
        local shown = {}       -- uid -> true, eggs already in the message
        local lastDebug = ""

        while true do
            local ok, err = pcall(function()
                local list, hasFolder, total = scanEggs()

                -- NEW: every rare egg goes to the website once, whether or not Discord worked
                for _, e in ipairs(list) do
                    if not pushedSite[e.uid] then
                        pushedSite[e.uid] = true
                        task.spawn(pushHalloweenToSite, e)
                    end
                end

                if HALLOWEEN_DEBUG then
                    local sig = tostring(hasFolder) .. ":" .. total .. ":" .. #list
                    if sig ~= lastDebug then
                        lastDebug = sig
                        print("[HALLOWEEN] WorldEggs folder " .. (hasFolder and "found" or "NOT found")
                            .. ", eggs seen: " .. total .. ", selected rarity: " .. #list)
                    end
                end

                local fresh = false
                for _, e in ipairs(list) do
                    if not shown[e.uid] then fresh = true end
                end

                if not msgId then
                    local graceOver = (os.clock() - startedAt) >= HALLOWEEN_GRACE
                    if (#list > 0 or graceOver) and os.clock() >= retryAt then
                        Halloween.busy = true
                        local res = request("POST", url .. "?wait=true", (function()
                            local pl = payloadFor(list, true)
                            pl.username = BOT_NAME
                            pl.avatar_url = (BOT_AVATAR ~= "") and BOT_AVATAR or nil
                            return pl
                        end)())
                        if res then
                            pcall(function() msgId = HttpService:JSONDecode(res.Body).id end)
                        end
                        if msgId then
                            for _, e in ipairs(list) do
                                shown[e.uid] = true
                                if HALLOWEEN_HOPS then markSelectedSpawn() end
                                print("[HALLOWEEN] rare spotted: " .. e.name .. " (" .. e.tier .. ")")
                            end
                            if #list == 0 then print("[HALLOWEEN] sent 'Found none'") end
                        else
                            retryAt = os.clock() + 15
                            warn("[HALLOWEEN] message failed to send, retrying in 15s")
                        end
                        Halloween.busy = false
                        Halloween.ready = true
                    end
                elseif fresh then
                    -- an egg showed up after "Found none" (or another one appeared): edit the same message
                    Halloween.busy = true
                    local res = request("PATCH", url .. "/messages/" .. msgId, payloadFor(list, false))
                    if res then
                        for _, e in ipairs(list) do
                            if not shown[e.uid] then
                                shown[e.uid] = true
                                if HALLOWEEN_HOPS then markSelectedSpawn() end
                                print("[HALLOWEEN] rare spotted: " .. e.name .. " (" .. e.tier .. ")")
                            end
                        end
                    end
                    Halloween.busy = false
                end
            end)
            if not ok then
                Halloween.busy = false
                warn("[HALLOWEEN] error: " .. tostring(err))
            end
            task.wait(1)
        end
    end)
end

