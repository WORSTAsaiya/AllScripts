-- ---------------------------------------------------------------- joiner hub
function CONFIG.hubKey()
	local g = genv()
	local o = g and g.EGG_HUB_KEY
	if type(o) == "string" and o ~= "" then
		return o
	end
	return CONFIG.HUB_KEY or ""
