local RELAY_SUFFIX = { "", "K", "M", "B", "T", "Qa", "Qi" }
local function relayMoney(n)
	n = tonumber(n) or 0
	local i = 1
	while n >= 1000 and i < #RELAY_SUFFIX do
		n = n / 1000
		i = i + 1
	end
