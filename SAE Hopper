function CONFIG.publishToHub(a)
	local url, key = CONFIG.HUB_URL, CONFIG.hubKey()
	if type(httpRequest) ~= "function" or type(url) ~= "string" or url == ""
		or key == "" or key:find("PUT_FINDER", 1, true) then
		return
	end
	task.spawn(function()
		a.sent = DateTime.now().UnixTimestampMillis   -- <-- the one new line
		local body = jsonEncode(a)
		if not body then return end
		local ok, res = pcall(httpRequest, {
			Url     = url,
			Method  = "POST",
			Headers = { ["Content-Type"] = "application/json", ["x-key"] = key },
			Body    = body,
		})
		if not ok then log("hub send failed: " .. tostring(res)) end
	end)
end

local function relayPayload(hit, players)
	local tier = tostring(hit.rarity)
	local mut  = mutationText(hit)
	local kg, kgText, valueText, num, zoneName

	if hit.halloween then
		-- exact roll is not visible before a steal, so show the range
		zoneName = HALLOWEEN_ZONES[tonumber(hit.zone) or 0] or "Halloween Dimension"
		mut = "NONE"
		if hit.rateLo and hit.rateHi and hit.kgLo and hit.kgHi then
			valueText = relayMoney(hit.rateLo) .. " - " .. relayMoney(hit.rateHi)
			kgText    = formatKg(hit.kgLo) .. " Kg - " .. formatKg(hit.kgHi) .. " Kg"
			num       = hit.rateHi
		else
			local e = tonumber(hit.earn) or 0
			valueText = e > 0 and (relayMoney(e) .. " (base)") or "Unknown"
			kgText    = "?"
			num       = e
		end
	else
		kg     = tonumber(hit.weight)
		kgText = kg and (formatKg(kg) .. " Kg") or "?"
		local final, base = tonumber(hit.earn) or 0, tonumber(hit.earnBase) or 0
		if final > 0 then
			if mut ~= "NONE" and base > 0 and final ~= base then
				valueText = relayMoney(base) .. " -> " .. relayMoney(final)
			else
				valueText = relayMoney(final)
			end
		else
			valueText = "Unknown"
		end
		num = final
	end

	local roles, roleSeen = {}, {}
	local function addRole(r)
		r = cleanRole(r)
		if r ~= "" and not roleSeen[r] then roleSeen[r] = true roles[#roles + 1] = r end
	end
	addRole(ROLE_IDS[tier])
	addRole(pingRole(KG_PINGS, kg))
	addRole(pingRole(VALUE_PINGS, num))

	CONFIG.publishToHub({
		placeId  = tostring(game.PlaceId),
		jobId    = game.JobId,
		egg      = tostring(hit.name),
		tier     = tier,
		value    = tonumber(num) or 0,
		kg       = kgText or "",
		mutation = (mut ~= "NONE") and mut or "",
		players  = tostring(players) .. "/" .. tostring(Players.MaxPlayers),
	})

	local img  = petImage(hit.name)
	local data = jsonEncode({
		egg       = tostring(hit.name) .. " Egg",
		tier      = tier,
		kg        = kgText,
		mutation  = mut,
		value     = valueText,
		image     = img,
		egg_image = eggImageOf(img),
		sample    = playerSample(),
		loc       = zoneName or "",
		players   = tostring(players) .. "/" .. tostring(Players.MaxPlayers),
		placeId   = tostring(game.PlaceId),
		jobId     = game.JobId,
		roles     = roles,
		test      = false,
	})
	if not data then return nil end

	return {
		username         = RELAY_NAME,
		avatar_url       = RELAY_AVATAR,
		content          = "EGGKG" .. data,
		allowed_mentions = { parse = {} },
	}
end

local function buildPayload(hits, players, webLink, directLink, roleId)
	local capacityLine = ("**%d/%d players**"):format(players, CONFIG.SERVER_CAPACITY)

	local title
	local description
	if #hits == 1 then
		local hit   = hits[1]
		local where = hit.halloween and " in the Halloween Dimension" or ""
		title       = ("%s EGG SPAWNED%s"):format(hit.rarity, hit.halloween and " (HALLOWEEN)" or "")
		description = ("A %s Egg has appeared%s!\n%s"):format(hit.rarity, where, capacityLine)
	else
		title = #hits .. " TARGET EGGS"
		local lines = {}
		for _, hit in ipairs(hits) do
			-- Halloween eggs: show the on-map visual size (the real size signal
			-- before a steal) instead of a guessed kg band.
			if hit.halloween then
				lines[#lines + 1] = ("**%s** — size %s (%s)"):format(
					hit.name, halloweenSizeLabel(hit.scale), moneyText(hit.earn))
			else
				lines[#lines + 1] = ("**%s** — %.2f kg (%s)"):format(hit.name, hit.weight or 0, moneyText(hit.earn))
			end
		end
		description = table.concat(lines, "\n") .. "\n" .. capacityLine
	end

	local mentionRoles = parseRoleIds(roleId)
	local content
	if #mentionRoles > 0 then
		content = roleMentionContent(mentionRoles)
	end

	local fields
	if #hits == 1 then
		local hit = hits[1]
		fields = {
			{ name = "🥚 Egg",          value = hit.name,  inline = true },
			{ name = "🔹 Rarity",       value = hit.rarity, inline = true },
			{ name = "🔗 Server",       value = ("[Click to Join Server](%s)"):format(webLink), inline = true },
			{ name = "🧬 Egg Mutation", value = mutationText(hit), inline = false },
			{ name = "💰 Egg Value",    value = moneyText(hit.earn), inline = false },
			{ name = "🔐 Direct Link",  value = "`" .. directLink .. "`", inline = false },
		}
		-- Halloween eggs: the world model's visual scale IS replicated, so show
		-- that instead of a guessed kg/value band. A bigger model on the map is
		-- a bigger egg - the raid target is the visually large one.
		if hit.halloween then
			fields[#fields + 1] = {
				name   = "📏 Visual Scale",
				value  = halloweenSizeLabel(hit.scale),
				inline = true,
			}
		else
			fields[#fields + 1] = {
				name   = "⚖️ Egg Kg",
				value  = formatKg(hit.weight or 0) .. " Kg",
				inline = false,
			}
		end
	else
		fields = {
			{ name = "🔗 Server", value = ("[Click to Join Server](%s)"):format(webLink), inline = false },
		}
	end

	return {
		username = "egg grabber",
		allowed_mentions = { parse = {}, roles = mentionRoles },
		content = content,
		embeds = {
			{
				title = title,
				url = webLink,
				description = description,
				fields = fields,
				footer = { text = "Egg Alert • " .. reporterName() },
				timestamp = os.date("!%Y-%m-%dT%H:%M:%SZ"),
				color = COLORS[hits[1].rarity] or 0x5865F2,
			},
		},
	}
end

local function sendToWebhook(url, hits, players, roleId, direct)
	if type(httpRequest) ~= "function" then
		log("no HTTP function available in this executor - cannot post")
		return false
	end

	local payload
	if direct then
		-- plain Discord embed (for a normal channel that no bot cog reads)
		local webLink, directLink = joinLinks()
		payload = buildPayload(hits, players, webLink, directLink, roleId or "")
	else
		payload = relayPayload(hits[1], players)
	end
	if not payload then
		log("could not build the message")
		return false
	end
	local body    = jsonEncode(payload)
	if not body then
		log("could not encode the Discord payload")
		return false
	end

	for attempt = 1, CONFIG.MAX_POST_RETRIES do
		local ok, res = pcall(httpRequest, {
			Url = url,
			Method = "POST",
			Headers = { ["Content-Type"] = "application/json" },
			Body = body,
		})

		if ok and type(res) == "table" then
			local code = res.StatusCode or res.status or 0
			log("webhook replied " .. tostring(code) .. " (attempt " .. attempt .. ")")
			if code >= 200 and code < 300 then
				return true
			end
			if code ~= 429 then
				return false
			end
			task.wait(3)
		else
			log("webhook error: " .. tostring(res))
			task.wait(2)
		end
	end

	return false
end

-- Two separate cooldown clocks, one per route:
--   lastPostAttempt   field eggs (main / big webhooks) - attempt-based, so a
--                     burst of eggs is paced and flushEggs can wait it out.
--   lastHalloweenFail halloween webhook - FAILURE-based, matching the PC
--                     build: a halloween egg that sent fine must not block the
--                     next one.
local lastPostAttempt    = 0
local lastHalloweenFail  = 0

-- Which webhook (and optional role ping) ONE egg belongs on.
local function hitWebhook(hit)
	local url = relayWebhook()
	if type(url) ~= "string" or url == "" or url:find("PASTE_YOUR", 1, true) then
		return nil, nil, "main"
	end
	-- every alert goes through the relay webhook; the bot cog does the pinging
	return url, nil, "main"
end

-- Send ONE Discord message PER egg, each with the full single-egg detail. This
-- means a spawn that started as two eggs but now has one left is reported as
-- that one egg alone - never bundled into a "2 TARGET EGGS" card that still
-- lists an egg somebody already stole.
--
-- Returns the list of hits that were actually delivered, so the caller only
-- remembers (and stops re-reporting) the ones that really went through.
local function post(hits, players)
	local sent = {}
	if #hits == 0 then
		return sent
	end

	if relayWebhook() == "" then
		log("no webhook configured - cannot report")
		return sent
	end

	-- The cooldown is PER ROUTE, not global. Halloween eggs go to their own
	-- Discord webhook, so they must not inherit the field-egg clock: with the
	-- old shared, success-based timer, any field egg posted on landing silently
	-- swallowed every halloween egg on that server - and since this build
	-- leaves within seconds, the 30s never expired before the hop. That is why
	-- the phone got almost none while the PC build (whose cooldown only trips
	-- after a FAILED post) got them all.
	local isHalloween = hits[1].halloween == true
	if isHalloween then
		if os.clock() - lastHalloweenFail < CONFIG.POST_COOLDOWN then
			return sent
		end
	else
		if os.clock() - lastPostAttempt < CONFIG.POST_COOLDOWN then
			return sent
		end
		lastPostAttempt = os.clock()
	end

	for _, hit in ipairs(hits) do
		local url, roleId, label = hitWebhook(hit)
		if url then
			if label ~= "main" then
				log(label .. " - posting on its own")
			end
			if sendToWebhook(url, { hit }, players, roleId) then
				sent[#sent + 1] = hit
				-- 1B+/s eggs ALSO get a copy on the big webhook (VIP ping); the relay
				-- above stays the full feed.
				local big = CONFIG.WEBHOOK_BIG
				if not hit.halloween and type(big) == "string" and big ~= ""
					and not big:find("PASTE_YOUR", 1, true)
					and (tonumber(hit.earn) or 0) >= (tonumber(CONFIG.BIG_VALUE_THRESHOLD) or 1e9) then
					log("1B+/s egg - also posting to the big webhook")
					pcall(sendToWebhook, big, { hit }, players, CONFIG.VIP_ROLE_ID, true)
				end
				-- lastEggSentAt = os.clock()
				-- eggsSentThisRun += 1
				-- pcall(sendBotTracker)
			elseif hit.halloween then
				-- Only a failed halloween send backs the route off.
				lastHalloweenFail = os.clock()
			end
		else
			log("main webhook not configured - cannot report")
		end
	end

	return sent
end

-- Report the Halloween Dimension's world eggs. Additive only: they are (almost)
-- always up on every server, so the result never influences a hop decision.
local function tryReportHalloween(players)
	if CONFIG.HALLOWEEN ~= true then
		return
	end
	local hits = halloweenScan()
	if #hits == 0 then
		return
	end
	local posted = readPosted()
	local fresh  = {}
	for _, hit in ipairs(hits) do
		if not posted[postedKey(hit.record)] then
			fresh[#fresh + 1] = hit
		end
	end
	if #fresh == 0 then
		return
	end

	-- Last check before the request goes out: an egg somebody took between the
	-- scan and the send is dropped (nil = the world could not be read, so never
	-- drop a real egg on a failed read).
	local ready = {}
	for _, hit in ipairs(fresh) do
		local avail = stillAvailableHalloween(hit.uid)
		if avail == false then
			log(("dropped %s before send - already taken or gone from the world")
				:format(tostring(hit.name)))
		else
			ready[#ready + 1] = hit
		end
	end
	if #ready == 0 then
		return
	end

	log(("halloween: %d target egg(s) up on this server - posting"):format(#ready))
	local sent = post(ready, players)
	for _, hit in ipairs(sent) do
		rememberPosted(hit.record)
	end
end

