-- SEND ALL MUTATIONS: every egg currently in the server that has a mutation
-- ============================================================
local function sendAllMutations()
    if type(EggState) ~= "table" or type(EggState.ReadFieldEggs) ~= "function" then
        error("EggState.ReadFieldEggs not available")
    end

    local ok, data = pcall(EggState.ReadFieldEggs)
    if not (ok and type(data) == "table") then error("could not read field eggs") end
    local raw = data.Records or data
    if type(raw) ~= "table" then error("no egg records") end

    local lines, scanned = {}, 0
    for _, r in pairs(raw) do
        if type(r) == "table" then
            scanned = scanned + 1
            local mutation = eggMutation(r)
            if mutation then
                local cat = r.AssetCategory or r.Category
                local entry = getEntry(cat)
                local name = (type(entry) == "table" and tostring(entry.DisplayName or cat))
                    or tostring(cat or "Unknown")
                local valueText = eggValueText({ display = name }, eggKg(r), mutation)
                lines[#lines + 1] = string.format("**%s** • %s • 🧬 %s • 💰 %s • %s",
                    name, formatKg(eggKg(r)), mutation, valueText, areaName(r.AreaId))
            end
        end
    end

    local link = serverLink()
    local header = "🧬 **Mutation test**: " .. #lines .. " mutated egg(s) out of " .. scanned .. " scanned"

    if #lines == 0 then
        post(WEBHOOKS.Secret, {
            username = BOT_NAME,
            avatar_url = (BOT_AVATAR ~= "") and BOT_AVATAR or nil,
            content = header .. "\nNo mutations found. If you expect some, turn on DEBUG_DUMP and check the real field name in MUTATION_KEYS.",
        })
        return
    end

    -- split into embeds under Discord's 4096-char description limit
    local embeds, cur = {}, ""
    local function flush()
        if cur ~= "" then
            embeds[#embeds + 1] = {
                title = "🧬  MUTATED EGGS  🧬",
                description = cur,
                color = 0x2ECC71,
            }
            cur = ""
        end
    end
    for _, line in ipairs(lines) do
        if #cur + #line + 1 > 3800 then flush() end
        cur = cur .. line .. "\n"
    end
    flush()

    if link then
        embeds[#embeds].fields = { { name = "🔗 Server", value = "[**Click to Join Server**](" .. link .. ")", inline = false } }
    end
    embeds[#embeds].timestamp = os.date("!%Y-%m-%dT%H:%M:%SZ", os.time())

    -- max 10 embeds per message; send 5 at a time to stay safe on total size
    for i = 1, #embeds, 5 do
        local batch = {}
        for j = i, math.min(i + 4, #embeds) do batch[#batch + 1] = embeds[j] end
        post(WEBHOOKS.Secret, {
            username = BOT_NAME,
            avatar_url = (BOT_AVATAR ~= "") and BOT_AVATAR or nil,
            content = (i == 1) and header or nil,
            embeds = batch,
        })
        task.wait(SEND_GAP)
    end
end

