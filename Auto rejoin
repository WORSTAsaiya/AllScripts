#!/data/data/com.termux/files/usr/bin/bash
# Layout is picked automatically (freeform if enabled on the device, else split-screen with 2 apps).
# Usage:  bash setup.sh            (it asks how many accounts; usernames are auto-detected)
#         bash setup.sh user1 user2  (or give the usernames directly)
# Clones are found automatically: com.roblox.client first, then every installed
# com.roblox.clien<letter> (and com.roblox.clien) in alphabetical order, up to 20.
set -e

# input comes from the keyboard even if the script was started oddly
if [ -t 0 ]; then exec 3<&0
elif { exec 3</dev/tty; } 2>/dev/null; then :
else exec 3<&0; fi

# ---- tools: update, install, and self-repair a broken curl/mirror ----
if [ -z "$DRY_RUN" ]; then
  export DEBIAN_FRONTEND=noninteractive
  APT_OPTS="-o Dpkg::Options::=--force-confold"

  install_tools() {
    apt update -y >/dev/null 2>&1 || true
    apt full-upgrade -y $APT_OPTS >/dev/null 2>&1 || true
    pkg install -y which android-tools tmux termux-api jq curl sqlite >/dev/null 2>&1 || true
  }

  echo "Updating tools (first run can take a few minutes)..."
  install_tools

  # if curl is broken, switch to the official Cloudflare mirror and redo it
  if ! curl --version >/dev/null 2>&1; then
    echo "curl is broken, switching mirror and repairing..."
    echo "deb https://packages-cf.termux.dev/apt/termux-main stable main" > "$PREFIX/etc/apt/sources.list"
    install_tools
    pkg install --reinstall -y openssl libcurl curl >/dev/null 2>&1 || true
  fi

  curl --version >/dev/null 2>&1 || { echo "curl is still broken. Run termux-change-repo manually, then rerun."; exit 1; }
fi

# ---- root check ----
if ! su -c "id" </dev/null 2>/dev/null | grep -q "uid=0"; then
  echo "No root (uid=0). This setup needs a rooted device."
  exit 1
fi

# ---- layout: freeform if the device has it switched on, otherwise split-screen (max 2 apps) ----
# override with:  LAYOUT=split bash setup.sh   or   LAYOUT=freeform bash setup.sh
if [ -z "$LAYOUT" ]; then
  ff=$(su -c "settings get global enable_freeform_support" </dev/null 2>/dev/null | tr -d '\r\n')
  if [ "$ff" = "1" ]; then LAYOUT=freeform; else LAYOUT=split; fi
fi
if [ "$LAYOUT" = "split" ]; then MAXA=2; else MAXA=20; fi

# ---- find the clones, in a fixed order ----
installed=$(su -c "pm list packages" </dev/null | sed 's/^package://' | tr -d '\r')
FOUND=()
# the original app first
if echo "$installed" | grep -qx "com.roblox.client"; then FOUND+=("com.roblox.client"); fi
# then every clone: com.roblox.clien + optional single letter (no guessing needed, it just lists what's installed)
while IFS= read -r p; do
  [ -n "$p" ] && FOUND+=("$p")
done < <(echo "$installed" | grep -E '^com\.roblox\.clien[a-z]?$' | grep -vx 'com.roblox.client' | sort || true)
if [ ${#FOUND[@]} -gt $MAXA ]; then FOUND=("${FOUND[@]:0:$MAXA}"); fi
if [ ${#FOUND[@]} -eq 0 ]; then echo "No Roblox clones found."; exit 1; fi

stty sane 2>/dev/null || true
echo "Layout: $LAYOUT (max $MAXA accounts on this device)"
echo "Found ${#FOUND[@]} Roblox app(s): ${FOUND[*]}"

valid_user() { [[ "$1" =~ ^[A-Za-z0-9_]{3,20}$ ]]; }

# find the logged-in username of a clone by reading its Roblox cookie (needs root)
detect_user() {
  local pkg=$1 db tmp cookie resp name
  db=$(su -c "find /data/data/$pkg -name Cookies -type f" </dev/null 2>/dev/null | head -1 | tr -d '\r')
  [ -z "$db" ] && return 1
  tmp="$HOME/.ck_$pkg.db"
  su -c "cat '$db'" </dev/null > "$tmp" 2>/dev/null
  su -c "cat '$db-wal'" </dev/null > "$tmp-wal" 2>/dev/null || true
  [ -s "$tmp-wal" ] || rm -f "$tmp-wal"
  cookie=$(sqlite3 "$tmp" "select value from cookies where name='.ROBLOSECURITY' and host_key like '%roblox.com' order by last_access_utc desc limit 1" 2>/dev/null)
  rm -f "$tmp" "$tmp-wal"
  [ -z "$cookie" ] && return 1
  resp=$(curl -s -m 15 -H "Cookie: .ROBLOSECURITY=$cookie" https://users.roblox.com/v1/users/authenticated)
  name=$(echo "$resp" | jq -r '.name // empty' 2>/dev/null)
  [ -z "$name" ] && return 1
  echo "$name"
}

USERS=()
if [ $# -gt 0 ]; then
  # non-interactive: bash setup.sh user1 user2 ...
  if [ $# -gt ${#FOUND[@]} ]; then
    echo "You gave $# usernames but this device ($LAYOUT layout) can run ${#FOUND[@]} account(s)."
    exit 1
  fi
  for u in "$@"; do
    valid_user "$u" || { echo "'$u' is not a valid Roblox username."; exit 1; }
    USERS+=("$u")
  done
else
  # interactive: only ask how many accounts, usernames are auto-detected
  while true; do
    printf "How many accounts? (1-%d): " "${#FOUND[@]}"
    read -r -u 3 count
    if [[ "$count" =~ ^[0-9]+$ ]] && [ "$count" -ge 1 ] && [ "$count" -le ${#FOUND[@]} ]; then break; fi
    echo "Type a number from 1 to ${#FOUND[@]}."
  done
  for ((k=0; k<count; k++)); do
    u=$(detect_user "${FOUND[$k]}" || true)
    if valid_user "$u"; then
      echo "[${FOUND[$k]}] detected: $u"
      USERS+=("$u")
    else
      echo "[${FOUND[$k]}] couldn't auto-detect (not logged in?)."
      while true; do
        printf "[%s] username: " "${FOUND[$k]}"
        read -r -u 3 u
        u=$(echo "$u" | tr -d '[:space:]')
        if valid_user "$u"; then USERS+=("$u"); break; fi
        echo "  Not valid. Use the Roblox username, not the display name."
      done
    fi
  done
fi

N=${#USERS[@]}
PKGS=("${FOUND[@]:0:$N}")

echo
echo "Setting up:"
for ((k=0; k<N; k++)); do echo "  [${PKGS[$k]}] = \"${USERS[$k]}\""; done
echo

# ---- window slots: a grid sized to the screen (left top right bottom); Termux takes cell 0 ----
SCREEN=$(su -c "wm size" </dev/null 2>/dev/null | tr -d '\r' | grep -oE '[0-9]+x[0-9]+' | tail -1)
SW=${SCREEN%x*}; SH=${SCREEN#*x}
[[ "$SW" =~ ^[0-9]+$ && "$SH" =~ ^[0-9]+$ ]] || { SW=720; SH=1280; }
TOP=33; BOT=$((SH-7))
TOTAL=$((N+1))                       # accounts + Termux
COLS=1; while [ $((COLS*COLS)) -lt $TOTAL ]; do COLS=$((COLS+1)); done
ROWS=$(( (TOTAL + COLS - 1) / COLS ))
CW=$((SW/COLS)); CH=$(( (BOT-TOP)/ROWS ))
SLOTS=()
for ((i=0; i<TOTAL; i++)); do
  l=$(( (i%COLS)*CW )); t=$(( TOP + (i/COLS)*CH ))
  SLOTS+=("$l $t $((l+CW)) $((t+CH))")
done

# only 1 account: center the Roblox window, Termux fills the screen behind it
if [ "$N" -eq 1 ] && [ "$LAYOUT" != "split" ]; then
  CW=$((SW/2)); CH=$((BOT-TOP))
  l=$(( (SW-CW)/2 ))
  SLOTS=("0 $TOP $SW $BOT" "$l $TOP $((l+CW)) $((TOP+CH))")
  COLS=1; ROWS=1
fi

TERMUX_SLOT="${SLOTS[0]}"
[ "$LAYOUT" = "split" ] || echo "Screen ${SW}x${SH}: ${COLS}x${ROWS} grid, windows ${CW}x${CH}"

# ---- keep Termux's on-screen keyboard hidden ----
mkdir -p ~/.termux
touch ~/.termux/termux.properties
grep -q '^hide-soft-keyboard-on-startup' ~/.termux/termux.properties || echo 'hide-soft-keyboard-on-startup = true' >> ~/.termux/termux.properties
termux-reload-settings >/dev/null 2>&1 || true

# ---- config.sh ----
{
  echo "PLACE=107778070777162"
  echo "LAYOUT=$LAYOUT"
  echo "PACKAGES=(${PKGS[*]})"
  printf "declare -A USER_OF=("
  k=0
  for p in "${PKGS[@]}"; do printf " [%s]=%s" "$p" "${USERS[$k]}"; k=$((k+1)); done
  echo " )"
  echo "declare -A SLOT=("
  i=0
  for p in "${PKGS[@]}"; do echo "  [$p]=\"${SLOTS[$((i+1))]}\""; i=$((i+1)); done
  echo ")"
  echo "TERMUX_SLOT=\"$TERMUX_SLOT\""
  echo "declare -A MODE=("
  i=0
  for p in "${PKGS[@]}"; do
    if [ "$LAYOUT" = "split" ]; then m=$((3+i)); else m=5; fi
    echo "  [$p]=$m"; i=$((i+1))
  done
  echo ")"
} > ~/config.sh

# ---- place.sh ----
cat > ~/place.sh << 'EOF'
#!/data/data/com.termux/files/usr/bin/bash
source ~/config.sh
[ "$LAYOUT" = split ] && exit 0
stack=$(su -c "am stack list")
place_one() {
  local pkg=$1 slot=$2 id
  id=$(echo "$stack" | grep "^ *taskId=[0-9]*: $pkg/" | head -1 | sed 's/.*taskId=\([0-9]*\):.*/\1/')
  [ -n "$id" ] && su -c "am task resize $id $slot"
}
for pkg in "${PACKAGES[@]}"; do place_one "$pkg" "${SLOT[$pkg]}"; done
place_one com.termux "$TERMUX_SLOT"
EOF

# ---- fix.sh ----
cat > ~/fix.sh << 'EOF'
#!/data/data/com.termux/files/usr/bin/bash
source ~/config.sh
[ "$LAYOUT" = split ] && exit 0
# only relaunch Termux if it is really gone (relaunching every loop pops up the keyboard)
if ! su -c "am stack list" </dev/null 2>/dev/null | grep -q "^ *taskId=[0-9]*: com.termux/"; then
  su -c "am start --windowingMode 5 -n com.termux/com.termux.app.TermuxActivity" >/dev/null 2>&1
  sleep 1
fi
bash ~/place.sh >/dev/null 2>&1
EOF

# ---- go.sh ----
cat > ~/go.sh << 'EOF'
#!/data/data/com.termux/files/usr/bin/bash
source ~/config.sh
for pkg in "${PACKAGES[@]}"; do su -c "am force-stop $pkg"; done
sleep 2
[ "$LAYOUT" = split ] || su -c "am start --windowingMode 5 -n com.termux/com.termux.app.TermuxActivity"
sleep 3
for pkg in "${PACKAGES[@]}"; do
  su -c "am start --windowingMode ${MODE[$pkg]} -a android.intent.action.VIEW -d 'roblox://placeID=$PLACE' -p $pkg"
  sleep 20
  bash ~/place.sh
done
sleep 10
bash ~/place.sh
EOF

# ---- roblox.sh (watchdog) ----
cat > ~/roblox.sh << 'EOF'
#!/data/data/com.termux/files/usr/bin/bash
source ~/config.sh
LOAD_WAIT=45
CHECK_EVERY=20
GRACE=180
FAILS_NEEDED=3
declare -A ID_OF LAUNCHED FAILS

names=$(printf '%s\n' "${USER_OF[@]}" | jq -R . | jq -sc .)
resp=$(curl -s -m 15 -X POST https://users.roblox.com/v1/usernames/users -H "Content-Type: application/json" -d "{\"usernames\":$names,\"excludeBannedUsers\":true}")
for pkg in "${PACKAGES[@]}"; do
  ID_OF[$pkg]=$(echo "$resp" | jq -r --arg n "${USER_OF[$pkg]}" '.data[] | select(.name==$n) | .id')
  LAUNCHED[$pkg]=$(date +%s)
  FAILS[$pkg]=0
  echo "$pkg -> ${USER_OF[$pkg]} (${ID_OF[$pkg]})"
done

launch() {
  local pkg=$1
  echo "[$(date +%T)] launching $pkg (${USER_OF[$pkg]})"
  su -c "am force-stop $pkg"
  sleep 2
  su -c "am start --windowingMode ${MODE[$pkg]} -a android.intent.action.VIEW -d 'roblox://placeID=$PLACE' -p $pkg"
  sleep 8; bash ~/place.sh >/dev/null 2>&1
  LAUNCHED[$pkg]=$(date +%s)
  FAILS[$pkg]=0
  sleep $LOAD_WAIT
}

get_presence() {
  local ids
  ids=$(printf '%s\n' "${ID_OF[@]}" | jq -R 'tonumber' | jq -sc .)
  curl -s -m 15 -X POST https://presence.roproxy.com/v1/presence/users -H "Content-Type: application/json" -d "{\"userIds\":$ids}"
}

while true; do
  pres=$(get_presence)
  pres_ok=0
  echo "$pres" | jq -e '.userPresences' >/dev/null 2>&1 && pres_ok=1
  [ $pres_ok -eq 0 ] && echo "[$(date +%T)] presence unavailable, only checking processes"
  for pkg in "${PACKAGES[@]}"; do
    if [ -z "$(su -c "pidof $pkg")" ]; then
      echo "[$(date +%T)] $pkg process is down"
      launch "$pkg"
      continue
    fi
    [ $pres_ok -eq 1 ] || continue
    t=$(echo "$pres" | jq -r --argjson id "${ID_OF[$pkg]}" '.userPresences[] | select(.userId==$id) | .userPresenceType')
    [ -z "$t" ] && continue
    if [ "$t" = "2" ]; then
      FAILS[$pkg]=0
    elif [ $(( $(date +%s) - ${LAUNCHED[$pkg]} )) -gt $GRACE ]; then
      FAILS[$pkg]=$(( ${FAILS[$pkg]} + 1 ))
      echo "[$(date +%T)] $pkg (${USER_OF[$pkg]}) not in game, strike ${FAILS[$pkg]}/$FAILS_NEEDED"
      [ ${FAILS[$pkg]} -ge $FAILS_NEEDED ] && launch "$pkg"
    fi
  done
  bash ~/fix.sh
  sleep $CHECK_EVERY
done
EOF

chmod +x ~/place.sh ~/fix.sh ~/go.sh ~/roblox.sh
echo "---- config.sh ----"
cat ~/config.sh

[ -n "$DRY_RUN" ] && { echo "(dry run: not starting)"; exit 0; }

# ---- copy every file from Delta/Scripts into Delta/Autoexecute ----
SRC=/sdcard/Delta/Scripts
DST=/sdcard/Delta/Autoexecute
if su -c "[ -d \"$SRC\" ]" </dev/null 2>/dev/null; then
  su -c "mkdir -p \"$DST\"" </dev/null 2>/dev/null || true
  copied=0
  while IFS= read -r f; do
    [ -n "$f" ] || continue
    su -c "cp -f \"$SRC/$f\" \"$DST/$f\"" </dev/null 2>/dev/null && copied=$((copied+1))
  done < <(su -c "ls -1 \"$SRC\"" </dev/null 2>/dev/null | tr -d '\r')
  echo "Copied $copied file(s) from Scripts to Autoexecute."
else
  echo "Delta Scripts folder not found ($SRC), skipping copy."
fi

# ---- start ----
termux-wake-lock
tmux kill-server 2>/dev/null || true
tmux new -d -s start 'bash ~/go.sh; tmux new -d -s roblox "bash ~/roblox.sh > ~/roblox.log 2>&1"'
echo "Started. Check progress with:  cat ~/roblox.log"
