-- JSON request with automatic retry when Discord says "rate limited" (429).
-- Returns the response on success (2xx), nil otherwise.
local function sendRequest(method, url, body, attempts, quiet)
    if not alive() then return nil end
    if not httpRequest then
        if not quiet then warn("[EGG] No HTTP request function found in this executor.") end
        return nil
    end

    for _ = 1, attempts or 1 do
        local ok, res = pcall(function()
            return httpRequest({
                Url     = url,
                Method  = method,
                Headers = { ["Content-Type"] = "application/json" },
                Body    = HttpService:JSONEncode(body),
            })
        end)

        if not ok then
            if not quiet then warn("[EGG] request failed:", res) end
            return nil
        end

        local code = tonumber(res.StatusCode) or 0

        if code == 429 then
            task.wait(retryAfter(res) + 0.1)
        elseif code < 200 or code >= 300 then
            if not quiet then warn("[EGG] HTTP", code, res.Body) end
            return nil
        else
            return res
        end
    end

    return nil
end

-- Fire-and-forget webhook post. retry = true keeps trying through rate limits.
local function postWebhook(url, payload, retry)
    if not validUrl(url) then
        warn("[EGG] Webhook not set or invalid.")
        return
    end
    task.spawn(sendRequest, "POST", url, payload, retry and 4 or 1, not retry)
end

