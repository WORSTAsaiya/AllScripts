-- ---------- snapshot of every egg in the game ----------
-- Source 1: EggState.ReadFieldEggs()
-- Source 2: AreaEggSlotsClient (eggs ReadFieldEggs doesn't return, e.g. Angels/Demons)
-- Returns: counts, ids, ok, eggs
--   eggs = one entry per egg that exists now: { uid, k, nameKey, catKey, areaId }

-- Halloween Dimension eggs currently on the map: uid -> counts key (filled by the Halloween scanner in PART 5).
-- They are added to the counts the bot receives (see the main loop) and are LATCHED together with the normal
-- eggs: they only change when the normal board resets (the "Next update" reroll), exactly like the other boards.
-- They are NOT added to ids / eggs, so they never trigger the new-cycle detector or a second rare alert.
local HALLOWEEN_LIVE = {}

local function buildSnapshot()
    local counts, ids, eggs = {}, {}, {}

    local ok, es = pcall(function() return require(RS.Client.EggState) end)
    if not (ok and es) then
        return counts, ids, false, eggs
    end

    local records = {}

    -- SOURCE 1
    local ok2, data = pcall(es.ReadFieldEggs)
    if ok2 and type(data) == "table" then
        local raw = data.Records or data
        if type(raw) == "table" then
            for key, r in pairs(raw) do
                if type(r) == "table" then
                    if not r.Uid and type(key) == "string" then r.Uid = key end
                    table.insert(records, r)
                end
            end
        end
    end

    -- SOURCE 2
    local slotsFolder = workspace:FindFirstChild("AreaEggSlotsClient")
    if slotsFolder then
        local seenUid = {}
        for _, existing in ipairs(records) do
            local eu = tostring(existing.Uid or "")
            if eu ~= "" then seenUid[eu] = true end
        end

        local function scanSlots(container)
            for _, slot in ipairs(container:GetChildren()) do
                if slot:IsA("Folder") or slot:IsA("Model") then
                    scanSlots(slot)
                end

                local uid = slot.Name
                if uid and uid ~= "" and not seenUid[tostring(uid)] then
                    local category = slot:GetAttribute("Category") or slot:GetAttribute("AssetCategory")

                    if category and category ~= "" then
                        table.insert(records, {
                            Uid = uid,
                            AssetCategory = category,
                            AreaId = slot:GetAttribute("AreaId") or slot:GetAttribute("Area"),
                            State = "Slot",
                            PhysicalModel = slot,
                        })
                        seenUid[tostring(uid)] = true
                    end
                end
            end
        end

        scanSlots(slotsFolder)
    end

    -- PROCESS RECORDS
    for _, r in ipairs(records) do
        local uid      = tostring(r.Uid or "")
        local category = r.AssetCategory or r.Category
        local info     = category and getAssetInfo(category) or nil
        local name     = info and info.Name or category

        if S.DEBUG_PRINT then
            print("[EGG DEBUG]",
                "UID =", uid,
                "Category =", tostring(category),
                "Name =", tostring(name),
                "AreaId =", tostring(r.AreaId),
                "Area =", getAreaDisplayName(r.AreaId),
                "State =", tostring(r.State))
        end

        if name and not (S.IGNORE_FIRST_AREA and uid:find("FirstArea")) then
            -- prefer the game's DisplayName, fall back to the internal AssetCategory
            local k = norm(name)
            k = ALIASES[k] or ALIASES[norm(category)] or k

            counts[k] = (counts[k] or 0) + 1

            local id = (uid ~= "") and (uid .. "|" .. k) or (k .. "#" .. counts[k])
            ids[id] = true

            eggs[#eggs + 1] = {
                uid     = uid,
                k       = k,
                nameKey = norm(name),
                catKey  = category and norm(category) or "",
                areaId  = r.AreaId,
            }
        end
    end

    if S.DEBUG_PRINT then
        local total = 0
        for _, n in pairs(counts) do total = total + n end
        print("[EGG DEBUG] records:", #records, "counted:", total)
        for k, n in pairs(counts) do print("[EGG DEBUG] count", k, n) end
    end

    return counts, ids, true, eggs
end


-- ---------- rare egg detector ----------
-- Runs on every scan. Every rare egg gets exactly one alert (tracked by uid).
-- Alerts go through a small queue so a burst doesn't hit Discord's rate limit.

local alertQueue = {}

task.spawn(function()
    while alive() do
        local a = table.remove(alertQueue, 1)
        if a then
            local ckey, cttl
            local srv = S.CLAIM_PER_SERVER and (tostring(game.JobId) .. "_") or ""
            if S.CLAIM_BY_NAME then
                ckey = "egg_" .. srv .. a.name .. "_" .. tostring(a.location or "")
                cttl = S.CLAIM_NAME_TTL
            else
                local id = (a.uid and a.uid ~= "") and a.uid or a.name
                ckey = "egg_" .. srv .. id
                cttl = 1800
            end

            local relayed = false
            if S.RELAY_TO_BOT and validUrl(WEBHOOKS.Debug) then
                local okR, sentR = pcall(relayEgg, a.name, a.tier, a.location, a.uid)
                relayed = okR and sentR == true
                debugLog(string.format("RELAY %s -> bot (%s)", tostring(a.name),
                    relayed and "sent" or "FAILED, using the old claim + webhook path"))
                if relayed then task.wait(S.ALERT_SEND_GAP) end
            end

            if not relayed then
                local shouldSend, why = claim(ckey, cttl)
                debugLog(string.format("CLAIM %s -> %s (%s) key=`%s`",
                    tostring(a.name), shouldSend and "SEND" or "SKIP", tostring(why), ckey:sub(1, 80)))

                if shouldSend then
                    pcall(sendEggEmbed, a.name, a.tier, a.location)
                    task.wait(S.ALERT_SEND_GAP)
                end
            end
        else
            task.wait(0.05)
        end
    end
end)

local rareEverSeen  = {}   -- debug
local rarePresent   = {}   -- debug: uid/name -> true while it was in the last scan
local alerted       = ENV.WORST_ALERTED      -- uid -> last time this egg was seen (os.clock)
local alertedNoUid  = ENV.WORST_ALERTED_NU   -- egg name -> uid-less copies already alerted
local firstRareScan = true

local function checkRare(eggs)
    local now = os.clock()
    local noUidNow = {}
    local presentNow = {}

    for _, e in ipairs(eggs) do
        local info = RARE_INFO[e.k] or RARE_INFO[e.nameKey] or RARE_INFO[e.catKey]

        if info then
            local isNew = false
            presentNow[(e.uid ~= "") and e.uid or ("noUid:" .. info.name)] = info.name

            if e.uid ~= "" then
                if alerted[e.uid] == nil then isNew = true end
                alerted[e.uid] = now
            else
                -- no unique id: count copies instead (2 Stags = 2 alerts)
                local n = (noUidNow[info.name] or 0) + 1
                noUidNow[info.name] = n

                if n > (alertedNoUid[info.name] or 0) then
                    alertedNoUid[info.name] = n
                    isNew = true
                end
            end

            if isNew and (S.ALERT_EXISTING_ON_START or not firstRareScan) then
                local location = ZONE_OF[e.k] or ZONE_OF[e.nameKey] or getAreaDisplayName(e.areaId)

                alertQueue[#alertQueue + 1] = {
                    name     = info.name,
                    tier     = info.tier,
                    location = location,
                    uid      = e.uid,
                }

                print("[EGG] rare spotted:", info.name, "(" .. info.tier .. ")")
                debugLog(string.format("**ALERT** %s (%s) uid=`%s` area=%s loc=%s hadUid=%s",
                    info.name, info.tier, e.uid ~= "" and e.uid or "NONE",
                    tostring(e.areaId), tostring(location), tostring(e.uid ~= "")))
            end
        end
    end

    firstRareScan = false

    -- debug: log rare eggs that dropped out of the scan (flicker detector)
    for key, name in pairs(rarePresent) do
        if not presentNow[key] then
            debugLog(string.format("VANISHED %s key=`%s`", tostring(name), tostring(key)))
        end
    end
    for key, name in pairs(presentNow) do
        if not rarePresent[key] and rareEverSeen[key] then
            debugLog(string.format("REAPPEARED %s key=`%s`", tostring(name), tostring(key)))
        end
        rareEverSeen[key] = true
    end
    rarePresent = presentNow

    -- forget eggs that have been gone for a while
    for uid, seenAt in pairs(alerted) do
        if now - seenAt > S.ALERT_FORGET_SECONDS then alerted[uid] = nil end
    end
    for name in pairs(alertedNoUid) do
        if not noUidNow[name] then alertedNoUid[name] = nil end
    end
end


-- ---------- Dr. Scramble banner reader ----------
-- PlayerGui.DrScrambleTradeIn.DrScrambleTradeInMain.CurrentEggInfoHolder.EggName
-- Returns: name ("Experimental Pets"), secondsLeft (or nil)

local function readScramble()
    local pg     = Players.LocalPlayer and Players.LocalPlayer:FindFirstChild("PlayerGui")
    local gui    = pg and pg:FindFirstChild("DrScrambleTradeIn")
    local main   = gui and gui:FindFirstChild("DrScrambleTradeInMain")
    local holder = main and main:FindFirstChild("CurrentEggInfoHolder")
    if not holder then return nil end

    local nameLabel = holder:FindFirstChild("EggName")
    if not (nameLabel and nameLabel:IsA("TextLabel")) then return nil end

    -- "Experimental Pets Banner" -> "Experimental Pets"
    local name = cleanText(nameLabel.Text)
    name = name:gsub("%s*Banner%s*$", "")
    if name == "" then return nil end

    -- optional: "Rotates in: 50m 42s" -> seconds
    local left = nil
    for _, obj in ipairs(holder:GetDescendants()) do
        if obj:IsA("TextLabel") then
            local t = cleanText(obj.Text)
            if t:lower():find("rotates in") then
                local h = tonumber(t:match("(%d+)%s*h")) or 0
                local m = tonumber(t:match("(%d+)%s*m")) or 0
                local s = tonumber(t:match("(%d+)%s*s")) or 0
                if h + m + s > 0 then left = h * 3600 + m * 60 + s end
                break
            end
        end
    end

    return name, left
end


-- ---------- feed message ----------
-- cycleAge = seconds since the current egg cycle started (nil until seen).

local function sendFeed(counts, cycleAge)
    local data = {}
    for k, v in pairs(counts) do data[k] = v end

    if cycleAge then data._age = cycleAge end

    -- Dr. Scramble banner (skipped if the GUI isn't found)
    local okS, scrambleName, scrambleLeft = pcall(readScramble)
    if okS and scrambleName then
        data._scramble = scrambleName
        if scrambleLeft then data._scramble_left = scrambleLeft end
    end

    -- Butterfly Bloom running?
    local bLeft = butterflyLeft()
    if bLeft then
        data._butterfly = 1
        data._butterfly_left = bLeft
    end

    -- Race open?
    local rLeft = raceLeft()
    if rLeft then
        data._race = 1
        data._race_left = rLeft
    end

    local body = "EGGDATA" .. HttpService:JSONEncode(data)

    if #body > 1990 then
        warn("[EGG FEED] payload too long (" .. #body .. " chars)")
        return
    end

    postWebhook(WEBHOOKS.Feed, { username = "egg-feed", content = body })
end


-- ---------- feed helpers ----------

-- current Halloween egg counts (counts key -> number), from the Halloween scanner in PART 5
local function hCounts()
    local c = {}
    for _, hk in pairs(HALLOWEEN_LIVE) do c[hk] = (c[hk] or 0) + 1 end
    return c
end

local function copyCounts(t)
    local c = {}
    for k, v in pairs(t) do c[k] = v end
    return c
end

local function signature(t)
    local parts = {}
    for k, n in pairs(t) do parts[#parts + 1] = k .. ":" .. n end
    table.sort(parts)
    return table.concat(parts, "|")
end

local function diffIds(a, b)
    local gone, fresh = 0, 0
    for id in pairs(a) do if not b[id] then gone  = gone  + 1 end end
    for id in pairs(b) do if not a[id] then fresh = fresh + 1 end end
    return gone, fresh
end

local function zonesComplete(counts)
    local perZone, unmapped = {}, 0

    for k, n in pairs(counts) do
        local zone = ZONE_OF[k]
        if zone then
            perZone[zone] = (perZone[zone] or 0) + n
        else
            unmapped = unmapped + n
        end
    end

    local shortBy = 0
    for _, zone in ipairs(NORMAL_ZONES) do
        shortBy = shortBy + math.max(0, S.EGGS_PER_ZONE - (perZone[zone] or 0))
    end

    return shortBy <= unmapped
end


-- ---------- feed loop ----------

task.spawn(function()
    local latched, cycleStart = {}, nil
    local hLatched = {}   -- Halloween eggs, latched on the same cycle as `latched`
    local windowIds, windowAt = nil, 0
    local settling, settleStart = false, 0
    local lastSig, lastSentAt = nil, 0

    -- new-cycle detector (for the countdown)
    local refIds, refAt, rerollAt = nil, 0, nil

    while alive() do
        pcall(function()
            local live, ids, ok, eggs = buildSnapshot()
            if not ok then return end

            -- rare alerts run on every scan, before any settling/latching
            local okR, errR = pcall(checkRare, eggs)
            if not okR then warn("[EGG] rare check failed: " .. tostring(errR)) end

            local now = os.clock()

            -- NEW-CYCLE DETECTOR
            -- CYCLE_NEW_EGGS or more brand new eggs vs. a recent snapshot = reroll
            if refIds == nil then
                refIds, refAt = ids, now
            else
                local _, fresh = diffIds(refIds, ids)

                if fresh >= S.CYCLE_NEW_EGGS
                    and (rerollAt == nil or now - rerollAt > S.CYCLE_MIN_GAP)
                then
                    rerollAt = now
                    refIds, refAt = ids, now
                    print("[EGG] new egg cycle detected")
                elseif now - refAt >= S.CYCLE_REF_SECS then
                    refIds, refAt = ids, now
                end
            end

            if windowIds == nil then
                windowIds, windowAt = ids, now
                latched, cycleStart = copyCounts(live), now
                hLatched = hCounts()
            else
                local _, fresh = diffIds(windowIds, ids)

                -- only NEW eggs appearing starts a new cycle. Eggs disappearing
                -- (the game clears the field ~10s before the reroll) is ignored.
                local bigChange = fresh >= S.RESET_IF_CHANGED
                local locked = cycleStart ~= nil and (now - cycleStart) < S.REROLL_LOCKOUT

                if bigChange and not locked then
                    latched, cycleStart = copyCounts(live), now
                    hLatched = hCounts()
                    settling, settleStart = true, now
                    windowIds, windowAt = ids, now
                else
                    for k, n in pairs(live) do
                        if n > (latched[k] or 0) then latched[k] = n end
                    end
                    for k, n in pairs(hCounts()) do
                        if n > (hLatched[k] or 0) then hLatched[k] = n end
                    end
                    if now - windowAt >= S.WINDOW_SECONDS then
                        windowIds, windowAt = ids, now
                    end
                end
            end

            local justSettled = false

            if settling then
                if zonesComplete(latched) or (now - settleStart) >= S.SETTLE_TIMEOUT then
                    settling, justSettled = false, true
                else
                    return
                end
            end

            local latchActive = S.LATCH_ENABLED
                and cycleStart ~= nil
                and (now - cycleStart) < S.LATCH_SECONDS

            local shown = copyCounts(latchActive and latched or live)
            for k, n in pairs(latchActive and hLatched or hCounts()) do
                shown[k] = (shown[k] or 0) + n
            end
            local sig   = signature(shown)

            -- banner / event changes are sent right away instead of waiting for the heartbeat
            local okB, bannerName = pcall(readScramble)
            if okB and bannerName then sig = sig .. "|scramble:" .. bannerName end
            if butterflyLeft() then sig = sig .. "|butterfly:1" end
            if raceLeft()      then sig = sig .. "|race:1" end

            local changed = sig ~= lastSig
            local beat    = (now - lastSentAt) >= S.HEARTBEAT

            if ((changed or justSettled) and (now - lastSentAt) >= S.MIN_SEND_GAP) or beat then
                lastSig    = sig
                lastSentAt = now
                sendFeed(shown, rerollAt and math.floor(now - rerollAt) or nil)
            end
        end)

        task.wait(S.CHECK_INTERVAL)
    end
end)


