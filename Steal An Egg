-- ============================================================
-- CLAIM: only ONE account sends each alert
-- claim(key, ttl) -> shouldSend (bool), reason (string)
-- Fails open: if the claim system breaks, the alert is sent anyway.
-- ============================================================
local MY_ID = HttpService:GenerateGUID(false)

local function claimFile(key, ttl)
    if not (readfile and writefile and isfile) then return true end

    local file = "worst_claim_" .. tostring(key):gsub("[^%w_%-]", "_") .. ".txt"

    local function read()
        if not isfile(file) then return nil end
        local ok, txt = pcall(readfile, file)
        if not ok then return nil end
        local id, t = tostring(txt):match("^(.-)|(%d+)$")
        if id and os.time() - tonumber(t) < ttl then return id end
        return nil
    end

    local owner = read()
    if owner then return owner == MY_ID end

    task.wait(math.random() * 0.3)          -- jitter so accounts don't write at the same instant
    owner = read()
    if owner then return owner == MY_ID end

    pcall(writefile, file, MY_ID .. "|" .. os.time())
    task.wait(0.5)                          -- last writer wins; verify it was us
    return read() == MY_ID
end

local function claimSite(key, ttl)
    if not httpRequest or SITE.URL == "" then return true, "no http function (sent anyway)" end
    local ok, res = pcall(function()
        return httpRequest({
            Url     = (SITE.URL:gsub("/alert$", "/claim")),
            Method  = "POST",
            Headers = { ["Content-Type"] = "application/json", ["x-key"] = SITE.KEY },
            Body    = HttpService:JSONEncode({ key = key, id = MY_ID, ttl = ttl }),
        })
    end)
    if not ok then return true, "request error (sent anyway): " .. tostring(res) end
    if not res then return true, "no response (sent anyway)" end
    if tonumber(res.StatusCode) ~= 200 then
        return true, "HTTP " .. tostring(res.StatusCode) .. " (sent anyway)"
    end
    local ok2, data = pcall(function() return HttpService:JSONDecode(res.Body) end)
    if not ok2 or type(data) ~= "table" then return true, "bad reply (sent anyway)" end
    if data.winner == true then return true, "won" end
    return false, "lost"
end

local function claim(key, ttl)
    if not S.CLAIM_ENABLED then return true, "claim off" end
    local ok, result, why
    if S.CLAIM_MODE == "site" then
        ok, result, why = pcall(claimSite, key, ttl)
    else
        ok, result = pcall(claimFile, key, ttl)
        why = result and "won" or "lost"
    end
    if not ok then return true, "error (sent anyway): " .. tostring(result) end
    return result, why
end

