            { name = "❌ Status",  value = "**Finished**",        inline = true },
            { name = "⏱️ Started", value = "**<t:" .. startedAt .. ":R>**", inline = true },
            { name = "⌛ ENDED",   value = "**Ended <t:" .. endsAt .. ":R>** (<t:" .. endsAt .. ":t>)", inline = false },
        }
    else
        title  = "🦋  BUTTERFLY BLOOM ACTIVE  🦋"
        desc   = "*A swarm of butterflies roam the servers*"
        color  = 0xFF69B4
        fields = {
            { name = "🦋 Event",     value = "**Butterfly Bloom**", inline = true },
            { name = "✅ Status",    value = "**Active**",          inline = true },
            { name = "⏱️ Started",   value = "**<t:" .. startedAt .. ":R>**", inline = true },
            { name = "⏳ TIME LEFT", value = "**Disappears <t:" .. endsAt .. ":R>** (<t:" .. endsAt .. ":t>)", inline = false },
        }
    end

    return {
        title       = title,
        description = desc,
        color       = color,
        thumbnail   = { url = BUTTERFLY.IMAGE },
        fields      = fields,
        footer      = footer("Secret Alert"),
        timestamp   = isoNow(),
    }
end

local function sendButterflyEmbed(startedAt, duration)
    if not validUrl(WEBHOOKS.Butterfly) then
        warn("[Butterfly] webhook missing or invalid")
        return
    end

    local endsAt = startedAt + duration

    -- the BOT posts it (in every channel that ran !bot_butterfly / !bot_all) and edits it when the event ends.
    -- The webhook posts below are ONLY used if the relay is off or failed (same as the eggs).
    task.spawn(function()
        local relayed = S.RELAY_TO_BOT and validUrl(WEBHOOKS.Debug) and relayButterfly(startedAt, endsAt)
        debugLog("RELAY butterfly bloom -> bot (" .. (relayed and "sent" or "FAILED or off, using the old webhook copy") .. ")")
        if relayed then return end
        mirrorStartEdit({
            username   = BOT.NAME,
            avatar_url = (BOT.AVATAR ~= "") and BOT.AVATAR or nil,
            content    = "**Butterfly Bloom** just started!",
            allowed_mentions = { parse = {} },
            embeds     = { buildButterflyEmbed(startedAt, endsAt, false) },
        }, math.max(endsAt - os.time(), 0) + 1, function()
            return {
                content = "**Butterfly Bloom** has ended.",
                allowed_mentions = { parse = {} },
                embeds  = { buildButterflyEmbed(startedAt, endsAt, true) },
            }
        end)

        -- fallback only (relay off / failed): the old direct webhook post + the "ended" edit
        -- 1. send with ?wait=true so Discord returns the message id
        local res = sendRequest("POST", WEBHOOKS.Butterfly .. "?wait=true", {
            username   = BOT.NAME,
            avatar_url = (BOT.AVATAR ~= "") and BOT.AVATAR or nil,
            content    = "<@&" .. ROLES.Butterfly .. "> **Butterfly Bloom** just started!",
            allowed_mentions = { roles = { ROLES.Butterfly } },
            embeds     = { buildButterflyEmbed(startedAt, endsAt, false) },
        }, 4)

        local messageId
        if res then
            pcall(function() messageId = HttpService:JSONDecode(res.Body).id end)
        end

        if not messageId then
            warn("[Butterfly] could not get message id, end edit skipped")
            return
        end

        -- 2. wait until the event ends, then edit the same message
        task.wait(math.max(endsAt - os.time(), 0) + 1)

        local edited = sendRequest("PATCH", WEBHOOKS.Butterfly .. "/messages/" .. messageId, {
            content = "**Butterfly Bloom** has ended.",
            allowed_mentions = { parse = {} },
            embeds  = { buildButterflyEmbed(startedAt, endsAt, true) },
        }, 4)

        if edited then
            print("[Butterfly] message edited to finished")
        else
            warn("[Butterfly] edit failed")
        end
    end)
end

local function onButterflyBegan(name, duration)
    if tostring(name) ~= BUTTERFLY.EVENT then return end

    -- remember when the event ends so the feed reports it as running.
    -- Done BEFORE the cooldown check so the board is always correct.
    local dur = tonumber(duration) or BUTTERFLY.DEFAULT_DURATION
    butterflyEndsAt = os.time() + dur

    local now = os.time()
    if now - lastButterflyAt < BUTTERFLY.COOLDOWN then
        print("[Butterfly] skipped (cooldown)")
        return
    end
    lastButterflyAt = now

    if not claim("butterfly", BUTTERFLY.COOLDOWN) then
        print("[Butterfly] another account already sent it")
        return
    end

    sendButterflyEmbed(now, dur)
    pushSite({ type = "butterfly", image = BUTTERFLY.IMAGE })
    print("[Butterfly] alert sent")
end

local function hookButterfly(remote)
    if remote:IsA("RemoteEvent") and remote.Name == "RE/LiveEvents/Began" then
        remote.OnClientEvent:Connect(onButterflyBegan)
        print("[Butterfly] hooked " .. remote:GetFullName())
    end
end

