            username   = BOT.NAME,
            avatar_url = (BOT.AVATAR ~= "") and BOT.AVATAR or nil,
            content    = style.emoji .. " **" .. name .. "** just spawned!",
            allowed_mentions = { parse = {} },
            embeds     = { embed },
        }, true)
    end
