local hadPreviousRun = ENV.WORST_RUN ~= nil
local RUN_ID = {}
ENV.WORST_RUN = RUN_ID
ENV.WORST_ALERTED     = ENV.WORST_ALERTED     or {}   -- uid -> last seen
ENV.WORST_ALERTED_NU  = ENV.WORST_ALERTED_NU  or {}   -- name -> uid-less copies alerted
ENV.WORST_SEEN_H      = ENV.WORST_SEEN_H      or {}   -- halloween uid -> last seen

local function alive() return ENV.WORST_RUN == RUN_ID end


