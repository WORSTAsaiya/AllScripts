local function sendEggEmbed(eggName, tier, location)
    local style = STYLE[tier]
    local data  = RARE_EGGS[eggName] or {}

    -- tier role + the creature's own role (if it has one)
    local mention = ROLES[tier] and ("<@&" .. ROLES[tier] .. ">") or ""
    if data.role then
        mention = mention .. " <@&" .. data.role .. ">"
    end

    local name     = (DISPLAY_OF[norm(eggName)] or prettyName(eggName)) .. " Egg"
    local now      = os.time()
    local imageUrl = data.image
    local value    = (data.value and data.value ~= "") and data.value or "VALUE NOT SET"

    local description = "*" .. style.tag .. "*"
    if S.SHOW_LOCATION and location and location ~= "" then
        description = description .. "\n📍 **" .. location .. "**"
    end

    local embed = {
        title       = style.emoji .. "  " .. style.title .. "  " .. style.emoji,
        description = description,
        color       = style.color,
        fields = {
            { name = "🥚 Egg",       value = "**" .. name .. "**",      inline = true  },
            { name = "💎 Rarity",    value = "**" .. tier .. "**",      inline = true  },
            { name = "⏱️ Spotted",   value = "**<t:" .. now .. ":R>**", inline = true  },
            { name = "💰 EGG VALUE", value = "```" .. value .. "```",   inline = false },
        },
        footer    = footer(tier .. " Alert"),
        timestamp = os.date("!%Y-%m-%dT%H:%M:%SZ", now),
    }

    -- no image set = no thumbnail, the alert just sends without one
    if imageUrl and imageUrl ~= "" then
        embed.thumbnail = { url = imageUrl }
    end

    -- egg form as the big picture under the text
    local eggImg = eggImageOf(data)
    if eggImg then
        embed.image = { url = eggImg }
    end

    pushSite({
        type     = "egg",
        egg      = (data.siteName or prettyName(eggName)) .. " Egg",
        rarity   = tier,
        location = location or "",
        value    = value,
        image    = (imageUrl and imageUrl:find("^https://")) and imageUrl or "",
