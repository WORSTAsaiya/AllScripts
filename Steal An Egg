RS.DescendantAdded:Connect(hookButterfly)


-- ============================================================
-- UFO SIGHTINGS
-- The game fires RE/UFOSightings/State many times per event (progress updates), so each
-- Event.Id is sent ONCE. Event.Variant "Regular" -> "normal"; anything else (e.g. "Rare") -> "rare".
-- The seen-list survives a re-execute, so re-running the script does not re-send a live UFO.
-- ============================================================

local seenUfo = ENV.WORST_SEEN_UFO or {}   -- event id -> time it ends
ENV.WORST_SEEN_UFO = seenUfo

local function onUfoState(data)
    if not alive() then return end
    if type(data) ~= "table" then return end

    local ev = data.Event
    if type(ev) ~= "table" or ev.Id == nil or ev.Variant == nil then return end

    local id        = tostring(ev.Id)
    local rawVar    = tostring(ev.Variant)
    local low       = rawVar:lower()
    local variant   = (low == "regular" or low == "normal") and "normal" or "rare"
    local startedAt = tonumber(ev.StartsAt) or os.time()
    local endsAt    = tonumber(ev.EndsAt) or (startedAt + 300)

    local now = os.time()
    if endsAt <= now then return end       -- already over
    if seenUfo[id] then return end         -- already sent this one
    seenUfo[id] = endsAt

    for k, v in pairs(seenUfo) do          -- forget old ones
        if v < now - 3600 then seenUfo[k] = nil end
    end

    print("[UFO] " .. variant .. " sighting (" .. id .. ", game says '" .. rawVar .. "')")

    task.spawn(function()
        if not (S.RELAY_TO_BOT and validUrl(WEBHOOKS.Debug)) then
            warn("[UFO] RELAY_TO_BOT is off or the Debug webhook is missing, so the UFO alert was not sent")
            return
        end
        local relayed = relayUfo(id, variant, startedAt, endsAt, rawVar)
        debugLog(string.format("RELAY ufo %s (game variant '%s') id=%s -> bot (%s)",
            variant, rawVar, id, relayed and "sent" or "FAILED"))
    end)
end

local function hookUfo(remote)
    if remote:IsA("RemoteEvent") and remote.Name == UFO.REMOTE then
        remote.OnClientEvent:Connect(onUfoState)
        print("[UFO] hooked " .. remote:GetFullName())
    end
end

