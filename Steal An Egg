    local img = data.image
    if type(img) ~= "string" or not img:find("^https://stealanegg%.tools/") then return nil end

    local out, n = img:gsub("_Pet%.png$", "_Egg.png")
    if n == 0 then out, n = img:gsub("%.png$", "_Egg.png") end
