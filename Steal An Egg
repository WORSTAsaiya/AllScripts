-- PART 4: RACING EVENT (RaceRally)
-- Green = you can still join, red = join window closed.
-- ============================================================

do
    -- ---------- timer reader ----------
    local function readTimerText()
        local pg  = Players.LocalPlayer and Players.LocalPlayer:FindFirstChild("PlayerGui")
        local hud = pg and pg:FindFirstChild("HUD")
        if not hud then return nil end

        for _, name in ipairs({ "GameHUD", "TradmilHud" }) do
            local h  = hud:FindFirstChild(name)
            local br = h and h:FindFirstChild("BottomRight")
            local rt = br and br:FindFirstChild("RaceTimer")
            local v  = rt and rt:FindFirstChild("Value")
            if v and v:IsA("TextLabel") then
                return (v.Text:gsub("<[^>]->", ""))
            end
        end
        return nil
    end

    -- "Race in 28:27" -> 1707 (seconds), or nil
    local function secondsUntilNextRace()
        local text = readTimerText()
        if not text or not text:lower():find("race in") then return nil end

        local a, b, c = text:match("(%d+):(%d+):?(%d*)")
        if not (a and b) then return nil end

        if c ~= "" then
            return tonumber(a) * 3600 + tonumber(b) * 60 + tonumber(c)
        end
        return tonumber(a) * 60 + tonumber(b)
    end

    -- ---------- embed ----------
    local function buildRaceEmbed(startTs, joinEndsAt, nextTs, closed)
        local nextField = {
            name  = "🔁 NEXT RACING",
            value = "**Starts <t:" .. nextTs .. ":R>** (<t:" .. nextTs .. ":t>)",
            inline = false,
        }
        local locField = { name = "📍 Location", value = "**" .. RACE.LOCATION .. "**", inline = false }

        local title, desc, color, fields

        if closed then
            title, desc, color = "🏁  RACING EVENT STARTED  🏁", "*The race has already begun*", RACE.COLOR_CLOSED
            fields = {
                { name = "🏁 Event",   value = "**Racing**",          inline = true },
                { name = "❌ Status",  value = "**Already Started**", inline = true },
                { name = "⏱️ Started", value = "**<t:" .. startTs .. ":R>**", inline = true },
                locField, nextField,
            }
        else
            title, desc, color = "🏁  RACING EVENT TIME  🏁", "*The race is open, jump in!*", RACE.COLOR_OPEN
            fields = {
                { name = "🏁 Event",       value = "**Racing**",    inline = true },
                { name = "✅ Status",      value = "**Race Open**", inline = true },
                { name = "⏳ Join closes", value = "**<t:" .. joinEndsAt .. ":R>**", inline = true },
                locField, nextField,
            }
        end

        return {
            title       = title,
            description = desc,
            color       = color,
            thumbnail   = { url = RACE.IMAGE },
            fields      = fields,
            footer      = footer("Racing Alert"),
            timestamp   = isoNow(),
        }
    end

    -- ---------- alert ----------
    local lastRaceStart = 0

    local function onRaceStart(joinEndsAt)
        local now = os.time()
        if now - lastRaceStart < RACE.COOLDOWN then
            return -- already handled (remote / attribute / timer can all fire)
        end
        lastRaceStart = now

        joinEndsAt = tonumber(joinEndsAt) or (now + RACE.JOIN)

        -- sanity check: if the game's value looks wrong, use the default window
        if joinEndsAt < now or joinEndsAt > now + 600 then
            joinEndsAt = now + RACE.JOIN
        end

        -- tell the board feed the race is open (cleared when the join window ends)
        raceEndsAt = joinEndsAt

        if not claim("race", RACE.COOLDOWN) then
            print("[RacingWebhook] another account already sent it")
            return
        end

        pushSite({ type = "race", location = RACE.LOCATION, status = "Race Open", image = RACE.IMAGE })

        local startTs   = now
        local guessNext = startTs + RACE.INTERVAL
        print("[RacingWebhook] race started! sending alert")

        mirrorStartEdit({
            username   = BOT.NAME,
            avatar_url = BOT.AVATAR,
            content    = "**Racing Event** just started! Join now!",
            allowed_mentions = { parse = {} },
            embeds     = { buildRaceEmbed(startTs, joinEndsAt, guessNext, false) },
        }, math.max(0, joinEndsAt - os.time()) + 2, function()
            local nextTs = guessNext
            local secs = secondsUntilNextRace()
            if secs and secs > 0 then nextTs = os.time() + secs end
            return {
                content = "**Racing Event** has already started.",
                allowed_mentions = { parse = {} },
                embeds  = { buildRaceEmbed(startTs, joinEndsAt, nextTs, true) },
            }
        end)

        local res = sendRequest("POST", WEBHOOKS.Racing .. "?wait=true", {
            username   = BOT.NAME,
            avatar_url = BOT.AVATAR,
            content    = ("<@&%s> **Racing Event** just started! Join now!"):format(ROLES.Racing),
            allowed_mentions = { roles = { ROLES.Racing } },
            embeds     = { buildRaceEmbed(startTs, joinEndsAt, guessNext, false) },
        }, 4)
        if not res then return end

        local messageId
        pcall(function() messageId = HttpService:JSONDecode(res.Body).id end)
        if not messageId then
            warn("[RacingWebhook] could not get message id, edit skipped")
            return
        end

        -- when the join window closes, turn it red
        task.wait(math.max(0, joinEndsAt - os.time()) + 2)

        -- use the game's real "Race in M:SS" countdown for the next race if available
        local nextTs = guessNext
        local secs = secondsUntilNextRace()
        if secs and secs > 0 then nextTs = os.time() + secs end

        sendRequest("PATCH", WEBHOOKS.Racing .. "/messages/" .. messageId, {
            content = "**Racing Event** has already started.",
            allowed_mentions = { parse = {} },
            embeds  = { buildRaceEmbed(startTs, joinEndsAt, nextTs, true) },
        }, 4)
    end

    -- ---------- trigger 1: the remote ----------
    local function hookRace(r)
        if r:IsA("RemoteEvent") and r.Name == "RE/LiveEvents/Began" then
            r.OnClientEvent:Connect(function(name, _, info)
                if tostring(name) ~= RACE.EVENT then return end
                local joinEndsAt = type(info) == "table" and info.JoinEndsAt or nil
                task.spawn(onRaceStart, joinEndsAt)
            end)
            print("[RacingWebhook] hooked " .. r:GetFullName())
        end
    end

    for _, d in ipairs(RS:GetDescendants()) do hookRace(d) end
    RS.DescendantAdded:Connect(hookRace)

    -- ---------- trigger 2: workspace attribute ----------
    workspace:GetAttributeChangedSignal("RaceRallyRunning"):Connect(function()
        if workspace:GetAttribute("RaceRallyRunning") == true then
            task.wait(0.5)
            task.spawn(onRaceStart, workspace:GetAttribute("RaceRallyJoinEndsAt"))
        end
    end)

    -- ---------- trigger 3: timer says "Race open!" ----------
    -- Fires only when the timer ENTERS the open state, so polling can't resend the alert.
    task.spawn(function()
        local wasRaceOpen = false

        while alive() do
            local ok, timerText = pcall(readTimerText)

            -- a temporarily missing GUI/text should not re-arm the alert
            if ok and timerText then
                local isRaceOpen = timerText:lower():find("race open", 1, true) ~= nil
                if isRaceOpen and not wasRaceOpen then
                    task.spawn(onRaceStart, nil)
                end
                wasRaceOpen = isRaceOpen
            end

            task.wait(0.5)
        end
    end)

    local secs = secondsUntilNextRace()
    print("[RacingWebhook] running. Next race in "
        .. (secs and (math.floor(secs / 60) .. "m " .. secs % 60 .. "s") or "?"))
end


-- ============================================================
-- PART 5: HALLOWEEN DIMENSION
-- These eggs are NOT returned by EggState.ReadFieldEggs, so they get their
-- own scanner. It reads Workspace.HalloweenDimension.WorldEggs and sends
-- each Secret / Eternal / Divine egg through the normal alert queue
-- (same embed, same tier webhook, same website push).
--
--   Zone 1 = Graveyard        Graveyard Brute (Secret), Ghost Reaper (Eternal)
--   Zone 2 = Haunted Swamp    BloodBloom (Secret), Shelltide Voyager (Eternal)
--   Zone 3 = Abandoned Manor  Werewolf (Secret), Gorillastein (Eternal), Voidseer Pumpkin (Divine)
--
-- The Halloween Egg pets (Bone Emperor, Phantom Dragon, Zombified ...) are
-- picked up by the normal feed scanner through RARE_EGGS, not by this one.
-- ============================================================

if S.HALLOWEEN_ENABLED then
    task.spawn(function()
        local ZONE_NAMES = {
            [1] = "Halloween Dimension • Graveyard",
            [2] = "Halloween Dimension • Haunted Swamp",
            [3] = "Halloween Dimension • Abandoned Manor",
        }

        -- game source name (lowercase, letters/digits only) -> RARE_EGGS key
        local SOURCES = {
            graveyardbrute      = "graveyard brute",
            ghostreaper         = "ghost reaper",
            bloodbloom          = "bloodbloom",
            shelltidevoyager    = "shelltide voyager",
            dreadwolf           = "werewolf",
            werewolf            = "werewolf",
            frankensteinkongegg = "gorillastein",
            abominationkong     = "gorillastein",
            gorillastein        = "gorillastein",
            voidseerpumpkin     = "voidseer pumpkin",
        }

        local function cleanKey(s)
            return (tostring(s or ""):lower():gsub("[^%w]", ""))
        end

        local function lookupKey(k)
            if k == "" then return nil end
            if SOURCES[k] then return SOURCES[k] end
            local stripped = k:gsub("egg$", "")
            return SOURCES[stripped]
        end

        -- the common Halloween eggs (not in RARE_EGGS). cleaned name -> counts key (same as norm(display name))
        local HCOMMON = {}
        for _, display in ipairs({
            "Whiskers", "Jesterpop", "Candlefang", "Spirit Knight",
            "Hooded Gerbil", "Toadstool", "Patchwork Imp", "Haunted Scorpio",
            "Mimic Chest", "Crowshade", "Hexed Pumpkin",
        }) do
            HCOMMON[cleanKey(display)] = norm(display)
        end

        local function commonKey(m)
            local candidates = {
                m:GetAttribute("PreparedSourceName"),
                m:GetAttribute("SourceName"),
                m:GetAttribute("Category"),
                m.Name,
            }
            for i = 1, 4 do
                local k = cleanKey(candidates[i])
                if k ~= "" then
                    local hit = HCOMMON[k] or HCOMMON[(k:gsub("egg$", ""))]
                    if hit then return hit end
                end
            end
            return nil
        end

        -- returns the RARE_EGGS key for this egg model, or nil if it is not a rare one
        local function resolveEgg(m)
            local candidates = {
                m:GetAttribute("PreparedSourceName"),
                m:GetAttribute("SourceName"),
                m:GetAttribute("Category"),
                m.Name,
            }
            for i = 1, 4 do
                local key = lookupKey(cleanKey(candidates[i]))
                if key then return key end
            end
            return nil
        end

        -- Keep an egg counted for a few seconds after it was last seen, so one missed scan never flips it to "gone".
        local HKEEP = 10
        local hKeep = {}   -- uid -> { k = counts key, t = last seen }
        local function syncLive(found)
            local t = os.clock()
            for uid, ck in pairs(found) do hKeep[uid] = { k = ck, t = t } end
            for uid, e in pairs(hKeep) do
                if t - e.t > HKEEP then hKeep[uid] = nil end
            end
            for uid in pairs(HALLOWEEN_LIVE) do HALLOWEEN_LIVE[uid] = nil end
            for uid, e in pairs(hKeep) do HALLOWEEN_LIVE[uid] = e.k end
        end

        local seenH, reportedH = ENV.WORST_SEEN_H, {}   -- uid -> last seen, unidentified-egg log guard
        local hPresent, hEver = {}, {}    -- debug
        local firstScan = true

        while alive() do
            pcall(function()
                local dim    = workspace:FindFirstChild("HalloweenDimension")
                local folder = dim and dim:FindFirstChild("WorldEggs")
                if not folder then
                    syncLive({})   -- folder not loaded: eggs expire after HKEEP seconds instead of vanishing at once
                    return
                end

                local hLive = {}   -- uid -> counts key, copied into HALLOWEEN_LIVE at the end of this scan

                local now = os.clock()
                local hNow = {}

                for _, m in ipairs(folder:GetChildren()) do
                    local zone = tonumber(m:GetAttribute("Zone")) or 0

                    if zone == 2 and not S.HALLOWEEN_SCAN_SWAMP then
                        -- skipped by setting
                    else
                        local eggKey = resolveEgg(m)
                        local info   = eggKey and RARE_EGGS[eggKey]

                        -- every Halloween egg (rare or common) counts toward the board
                        local countKey = eggKey and norm(eggKey) or commonKey(m)
                        if countKey then
                            hLive[tostring(m:GetAttribute("HalloweenEggUid") or m:GetFullName())] = countKey
                        end

                        if info then
                            local uid = tostring(m:GetAttribute("HalloweenEggUid") or m:GetFullName())
                            local isNew = seenH[uid] == nil
                            seenH[uid] = now
                            hNow[uid] = eggKey

                            if isNew and (S.ALERT_EXISTING_ON_START or not firstScan) then
                                alertQueue[#alertQueue + 1] = {
                                    name     = eggKey,
                                    tier     = info.tier,
                                    location = ZONE_NAMES[zone] or "Halloween Dimension",
                                    uid      = uid,
                                }
                                print("[HALLOWEEN] rare spotted:", eggKey, "(" .. info.tier .. ")", "zone", zone)
                                debugLog(string.format("**HALLOWEEN ALERT** %s (%s) uid=`%s` zone=%s src=%s",
                                    eggKey, info.tier, uid, tostring(zone),
                                    tostring(m:GetAttribute("PreparedSourceName") or m:GetAttribute("SourceName") or m.Name)))
                            end
                        elseif S.DEBUG_PRINT then
                            local key = m:GetFullName() .. tostring(m:GetAttribute("HalloweenEggUid"))
                            if not reportedH[key] then
                                reportedH[key] = true
                                local a = {}
                                for k, v in pairs(m:GetAttributes()) do a[#a + 1] = k .. "=" .. tostring(v) end
                                print("[HALLOWEEN] not a rare egg, zone " .. zone .. ", attrs: " .. table.concat(a, ", "))
                            end
                        end
                    end
                end

                firstScan = false

                syncLive(hLive)

                for uid, name in pairs(hPresent) do
                    if not hNow[uid] then debugLog("HALLOWEEN VANISHED " .. name .. " uid=`" .. uid .. "`") end
                end
                for uid, name in pairs(hNow) do
                    if not hPresent[uid] and hEver[uid] then debugLog("HALLOWEEN REAPPEARED " .. name .. " uid=`" .. uid .. "`") end
                    hEver[uid] = true
                end
                hPresent = hNow

                -- forget eggs that have been gone for a while
                for uid, seenAt in pairs(seenH) do
                    if now - seenAt > S.ALERT_FORGET_SECONDS then seenH[uid] = nil end
                end
            end)

            task.wait(S.HALLOWEEN_INTERVAL)
        end
    end)

    print("[EGG] Halloween Dimension scanner running")
end

-- ============================================================
-- PART 6: REJOIN BUTTON
-- A button in the middle of the screen. Click it to rejoin the game.
-- Tries the SAME server first; if that fails (full / closed) it joins any server.
-- ============================================================

if S.REJOIN_BUTTON then
    task.spawn(function()
        local TeleportService = game:GetService("TeleportService")
        local lp = Players.LocalPlayer
        if not lp then return end

        -- remove the button left by a previous run of this script
        pcall(function()
            if ENV.WORST_GUI then ENV.WORST_GUI:Destroy() end
        end)

        local gui = Instance.new("ScreenGui")
        gui.Name = "WorstRejoin"
        gui.ResetOnSpawn = false
        gui.IgnoreGuiInset = true
        gui.DisplayOrder = 999
        gui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling

        local parented = false
        if gethui then parented = pcall(function() gui.Parent = gethui() end) end
        if not parented then
            parented = pcall(function() gui.Parent = game:GetService("CoreGui") end)
        end
        if not parented then
            gui.Parent = lp:WaitForChild("PlayerGui")
        end
        ENV.WORST_GUI = gui

        local btn = Instance.new("TextButton")
        btn.Name = "Rejoin"
        btn.AnchorPoint = Vector2.new(0.5, 0.5)
        btn.Position = UDim2.new(0.5, 0, 0.5, 0)
        btn.Size = UDim2.new(0, 170, 0, 46)
        btn.BackgroundColor3 = Color3.fromRGB(231, 76, 60)
        btn.BorderSizePixel = 0
        btn.AutoButtonColor = true
        btn.Text = "Rejoin"
        btn.TextColor3 = Color3.new(1, 1, 1)
        btn.TextSize = 20
        btn.Font = Enum.Font.GothamBold
        btn.Parent = gui

        local corner = Instance.new("UICorner")
        corner.CornerRadius = UDim.new(0, 10)
        corner.Parent = btn

        local busy = false
        btn.MouseButton1Click:Connect(function()
            if busy then return end
            busy = true
            btn.Text = "Rejoining..."
            debugLog("REJOIN button pressed")

            -- 1) same server
            local ok = pcall(function()
                TeleportService:TeleportToPlaceInstance(game.PlaceId, game.JobId, lp)
            end)

            -- 2) if that errors, or the teleport fails, join any server
            local failConn
            failConn = TeleportService.TeleportInitFailed:Connect(function()
                if failConn then failConn:Disconnect() end
                pcall(function() TeleportService:Teleport(game.PlaceId, lp) end)
            end)

            if not ok then
                pcall(function() TeleportService:Teleport(game.PlaceId, lp) end)
            end

            task.delay(15, function()
                busy = false
                if btn.Parent then btn.Text = "Rejoin" end
            end)
        end)
    end)
end

print("[EGG] running!")
