local assetInfoCache = {}

local function normalizeAssetName(s)
    return tostring(s or ""):lower():gsub("[^%a%d]", "")
end

local function getAssetInfo(category)
    local categoryKey = tostring(category or "")
    if categoryKey == "" then return nil end
    if assetInfoCache[categoryKey] then return assetInfoCache[categoryKey] end

    local directory = type(Assets) == "table" and Assets.Directory or nil
    local entry = type(directory) == "table" and directory[categoryKey] or nil

    -- fallback: compare normalized category against key, _id, DisplayName, Egg.ModelName
    if entry == nil and type(directory) == "table" then
        local wanted = normalizeAssetName(categoryKey)

        for key, candidate in pairs(directory) do
            if type(candidate) == "table" then
                local values = {
                    tostring(key),
                    tostring(candidate._id or ""),
                    tostring(candidate.DisplayName or ""),
                }
                local egg = type(candidate.Egg) == "table" and candidate.Egg or nil
                if egg then values[#values + 1] = tostring(egg.ModelName or "") end

                for _, value in ipairs(values) do
                    if value ~= "" and normalizeAssetName(value) == wanted then
                        entry = candidate
                        break
                    end
                end
            end
            if entry ~= nil then break end
        end
    end

    local info = {
        Name = type(entry) == "table" and tostring(entry.DisplayName or categoryKey) or categoryKey,
        Category = categoryKey,
        Rarity = "Common",
        RarityNumber = 0,
        Icon = type(entry) == "table" and entry.Icon or nil,
    }

    if type(entry) == "table" then
        local rarity = type(entry.Rarity) == "table" and entry.Rarity or nil
        if rarity then
            info.Rarity = tostring(rarity.DisplayName or rarity._id or "Common")
            info.RarityNumber = tonumber(rarity.RarityNumber or rarity.Rank) or 0
        end
    end

    assetInfoCache[categoryKey] = info
    return info
end

local function getAreaDisplayName(areaId)
    local key = tostring(areaId or "")
    if key == "" then return "" end

    local directory = type(Areas) == "table" and (Areas.Directory or Areas) or nil
    local entry = type(directory) == "table" and directory[key] or nil

    if type(entry) == "table" then
        return tostring(entry.DisplayName or key)
    end
    return key
end


