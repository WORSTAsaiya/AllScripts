-- ------------------------------------------------------------------ login
-- Nothing is fetched and no egg is listed until a key has been accepted by the relay.
ACC.tokenFile  = "WorstEggFinder_token.txt"
ACC.deviceFile = "WorstEggFinder_device.txt"

-- one id per device: a key works on one device at a time, so a second login kicks the first
ACC.getDevice = function()
	local id
	pcall(function() id = game:GetService("RbxAnalyticsService"):GetClientId() end)
	if type(id) ~= "string" or id == "" then
		pcall(function() if isfile and readfile and isfile(ACC.deviceFile) then id = readfile(ACC.deviceFile) end end)
		if type(id) ~= "string" or id == "" then
			id = HttpService:GenerateGUID(false)
			pcall(function() if writefile then writefile(ACC.deviceFile, id) end end)
		end
	end
	return (tostring(id):gsub("%s+", ""))
end

ACC.readToken = function()
	if type(CONFIG.KEY) == "string" and CONFIG.KEY ~= "" then return CONFIG.KEY end
	local ok, d = pcall(function() if isfile and readfile and isfile(ACC.tokenFile) then return readfile(ACC.tokenFile) end end)
	if ok and type(d) == "string" then
		d = d:gsub("%s+", "")
		if d ~= "" then return d end
	end
	return nil
end
ACC.saveToken  = function(t) pcall(function() if writefile then writefile(ACC.tokenFile, t) end end) end
ACC.clearToken = function() pcall(function() if writefile then writefile(ACC.tokenFile, "") end end) end

ACC.startFeed = function()
	ACC.gen = ACC.gen + 1
	local gen = ACC.gen
	task.spawn(function()
		-- 1) fill the list right now over plain HTTP (does not wait for the WebSocket)
		task.spawn(function() pull(false, gen) end)

		-- 2) while the WebSocket is not connected yet, keep pulling so nothing is missed
		if WebSocket and WebSocket.connect then
			task.spawn(function()
				while ACC.live(gen) do
					if not wsLive then pull(true, gen) end
					task.wait(0.4)
				end
			end)
		end

		-- 3) the WebSocket itself: instant pushes once it is up
		while ACC.live(gen) do
			local hadWS = runWebSocket(gen)
			if not hadWS then runPolling(60, gen) else task.wait(0.3) end
		end
	end)
end

-- returns ok, errorText, rejected   (rejected = the relay said no; false = could not reach it)
-- throws away the current list and stops the running feed (used by logout and when a key replaces the free version)
ACC.resetFeed = function()
	ACC.gen = ACC.gen + 1
	wsLive = false
	for _, a in ipairs(alerts) do removeCard(a) end
	alerts = {}
	sessionEnd = nil
	lastId = 0
	autoDone = {}
	pollPrimed = false
end

-- joins the free feed (no key). Returns ok, errorText like ACC.login
ACC.startFree = function()
	if not CONFIG.FREE then return false, "Log in to see eggs. Tap STATUS." end
	return ACC.login("@free", true)
end

ACC.login = function(token, isFree)
	if not reqFn then return false, "This executor can't make web requests.", false end
	local okR, res = pcall(reqFn, {
		Url = CONFIG.HUB_HTTP .. "/client/login", Method = "POST",
		Headers = { ["Content-Type"] = "application/json" },
		Body = HttpService:JSONEncode({ token = token, device = ACC.device, player = LocalPlayer.Name }),
	})
	if not okR or type(res) ~= "table" then return false, "Could not reach the server.", false end
	local okJ, d = pcall(function() return HttpService:JSONDecode(res.Body) end)
	if not okJ or type(d) ~= "table" then return false, "Server error. Try again.", false end
	if d.ok ~= true then
		if tostring(d.error or ""):find("Hopper accounts", 1, true) then
			ACC.killHopper()
			return false, "", false
		end
		return false, tostring(d.error or "Login failed."), (tonumber(res.StatusCode or res.status) == 401)
	end
	if ACC.session then ACC.resetFeed() end   -- a key replacing the free version: start from a clean list
	ACC.session = { token = token, free = isFree == true, unlimited = d.unlimited == true or isFree == true, expireClock = os.clock() + (tonumber(d.secondsLeft) or 0), bots = d.bots, freeMax = tonumber(d.freeMax) }
	ACC.checking = false
	if not isFree then ACC.saveToken(token) end
	ACC.refreshStatus()
	syncCards()
	ACC.startFeed()
	return true
end

ACC.logout = function(reason, keepToken, noFree)
	ACC.session = nil
	ACC.checking = false
	ACC.resetFeed()                -- stops the running feed and clears the list
	ACC.connBad = false
	if not keepToken then ACC.clearToken() end
	syncCards()
	ACC.refreshStatus()
	if CONFIG.FREE and not noFree then
		-- back to the free version, with the login window open so they can enter another key
		task.spawn(function() ACC.startFree(); ACC.notifyLogin(reason) end)
	else
		ACC.showLogin(reason)   -- no free version to fall back to: the login window opens
	end
end

ACC.say = function(text, bad)
	if ACC.ui then
		ACC.ui.status.Text = text or ""
		ACC.ui.status.TextColor3 = bad and Color3.fromRGB(255, 120, 120) or C.ash
	end
end

ACC.build = function()
	if ACC.ui then return ACC.ui end
	local dim = mk("TextButton", {
		Size = UDim2.new(1, 0, 1, 0), BackgroundColor3 = C.black, BackgroundTransparency = 0.2,
		Text = "", AutoButtonColor = false, ZIndex = 40, Visible = false,
	}, body)
	local card = mk("Frame", {
		Size = UDim2.new(1, -28, 0, 190), AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.new(0.5, 0, 0, 155), BackgroundColor3 = C.popup,
	}, dim)
	corner(card, 10)
	stroke(card, C.ash, 2)
	local scale = mk("UIScale", { Scale = 0.8 }, card)   -- pop in / pop out
	local ui = { dim = dim, card = card, scale = scale, open = false }
	local function label(size, pos, text, color, font, ts)
		return mk("TextLabel", {
			Size = size, Position = pos, BackgroundTransparency = 1, Text = text, TextColor3 = color,
			Font = font, TextSize = ts, TextXAlignment = Enum.TextXAlignment.Left,
		}, card)
	end
	ui.title = label(UDim2.new(1, -50, 0, 20), UDim2.new(0, 14, 0, 10), "LOGIN", C.white, Enum.Font.GothamBlack, 15)
	ui.sub = label(UDim2.new(1, -28, 0, 16), UDim2.new(0, 14, 0, 32), "", C.ash, Enum.Font.Gotham, 11)
	ui.input = mk("TextBox", {
		Size = UDim2.new(1, -28, 0, 36), Position = UDim2.new(0, 14, 0, 58), BackgroundColor3 = C.box, Text = "",
		PlaceholderText = "Paste your key here", PlaceholderColor3 = C.ash, TextColor3 = C.white,
		Font = Enum.Font.GothamBold, TextSize = 13, ClearTextOnFocus = false,
	}, card)
	corner(ui.input, 6)
	stroke(ui.input, C.line, 1.5)
	ui.btn = mk("TextButton", {
		Size = UDim2.new(1, -28, 0, 36), Position = UDim2.new(0, 14, 0, 102), BackgroundColor3 = C.light,
		Text = "Login", TextColor3 = C.black, Font = Enum.Font.GothamBlack, TextSize = 14,
	}, card)
	corner(ui.btn, 8)
	ui.status = label(UDim2.new(1, -28, 0, 40), UDim2.new(0, 14, 0, 144), "", C.ash, Enum.Font.GothamBold, 11)
	ui.status.TextWrapped = true
	ui.status.TextYAlignment = Enum.TextYAlignment.Top
	local x = mk("TextButton", {
		Size = UDim2.new(0, 26, 0, 22), Position = UDim2.new(1, -36, 0, 8), BackgroundColor3 = C.line,
		Text = "X", TextColor3 = C.white, Font = Enum.Font.GothamBold, TextSize = 12,
	}, card)
	corner(x, 6)
	x.MouseButton1Click:Connect(function() ACC.hideLogin() end)

	local function submit()
		if ACC.busy then return end
		if ACC.session and not ACC.session.free then ACC.logout("Logged out.") return end
		local t = (ui.input.Text or ""):gsub("%s+", "")
		if t == "" then ACC.say("Enter your key first.", true) return end
		ACC.busy = true
		ui.btn.Text = "Checking..."
		ACC.say("Checking key...", false)
		task.spawn(function()
			local ok, err = ACC.login(t)
			ACC.busy = false
			ui.btn.Text = "Login"
			if ok then
				ui.input.Text = ""
				ACC.hideLogin()
			else
				ACC.say(err or "Login failed.", true)
			end
		end)
	end
	ui.btn.MouseButton1Click:Connect(submit)
	ui.input.FocusLost:Connect(function(enter) if enter and (not ACC.session or ACC.session.free) then submit() end end)
	ui.items = collect(dim)
	ACC.ui = ui
	return ui
end

ACC.hideLogin = function()
	local ui = ACC.ui
	if not ui or not ui.open then return end
	ui.open = false
	fadeItems(ui.items, 0.16, true, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
	tween(ui.scale, 0.18, { Scale = 0.8 }, Enum.EasingStyle.Back, Enum.EasingDirection.In)
	task.delay(0.2, function()
		if not ui.open then ui.dim.Visible = false end
	end)
end

-- Only opened by the player (STATUS / Login button). Messages that come up while the window is
-- closed (bad saved key, kicked, time ran out, free unreachable) wait in ACC.pending and are shown
-- the next time the player presses Login.
ACC.notifyLogin = function(msg, prefill)
	if ACC.ui and ACC.ui.open then
		ACC.showLogin(msg, prefill)            -- already open: just refresh it in place
	else
		ACC.pending = { msg = msg, prefill = prefill }
	end
end

ACC.showLogin = function(msg, prefill)
	local ui = ACC.build()
	if not ui.open then
		ui.open = true
		ui.dim.Visible = true
		setAlpha(ui.items, true)
		ui.scale.Scale = 0.8
		fadeItems(ui.items, 0.2, false)
		tween(ui.scale, 0.3, { Scale = 1 }, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
	end
	if msg == nil and prefill == nil and ACC.pending then
		msg, prefill = ACC.pending.msg, ACC.pending.prefill
	end
	ACC.pending = nil
	local on = ACC.session ~= nil and not ACC.session.free
	ui.title.Text = on and "ACCOUNT" or "LOGIN"
	ui.input.Visible = not on
	ui.btn.Text = on and "Log out" or "Login"
	if prefill and not on then ui.input.Text = prefill end
	if on then
		local S = ACC.session
		ui.sub.Text = S.unlimited and "Logged in. No time limit." or "Logged in."
		local b = S.bots
		ACC.say((type(b) == "table" and b.total) and ("Bots: " .. tostring(b.assigned) .. " of " .. tostring(b.total) .. " active") or "", false)
	else
		local isFree = ACC.session ~= nil and ACC.session.free == true
		ui.sub.Text = isFree and "Free version. Enter a key for full access." or "Enter the key you were given."
		local cap = isFree and tonumber(ACC.session.freeMax) or nil
		local capText = (cap and cap > 0 and cap < 1e18) and ("Free: eggs up to $" .. fmt(cap) .. "/s, shown a moment late.") or "Free: shown a moment late."
		if (msg == nil or msg == "") and isFree then ACC.say(capText, false)
		else ACC.say(msg or "", msg ~= nil and msg ~= "") end
	end
end

-- hopper account detected while running: stop every feed and remove the window completely
ACC.killHopper = function()
	if stopped then return end
	stopped = true
	ACC.gen = ACC.gen + 1
	env.EGG_HUB_RUNNING = nil
	env.EGG_HUB_SYNC = nil
	warn("[Joiner] This account runs SAE HOPPERS - the Joiner can't be used here.")
	pcall(function() gui:Destroy() end)
end

ACC.device = ACC.getDevice()
task.spawn(function()
	while not stopped do
		task.wait(5)
		if hopperRunning() then
			stopped = true
			env.EGG_HUB_RUNNING = nil
			env.EGG_HUB_SYNC = nil
			warn("[Joiner] SAE HOPPERS started on this device - closing the Joiner.")
			pcall(function() gui:Destroy() end)
			break
		end
	end
end)
hubVal.MouseButton1Click:Connect(function() ACC.showLogin() end)

-- ...and only then check the saved key, so no card exists yet to be caught by it
task.spawn(function()
	if CONFIG.DEMO then
		ACC.checking = false
		ACC.session = { token = "demo", unlimited = true, expireClock = 0 }
		ACC.refreshStatus()
		syncCards()
		return runDemo()
	end
	local saved = ACC.readToken()
	if saved then
		local ok, err, rejected = ACC.login(saved)
		if ok then return end
		if rejected then ACC.clearToken() end
		ACC.startFree()   -- a bad or expired key falls back to the free version
		ACC.checking = false
		ACC.refreshStatus()
		syncCards()
		ACC.notifyLogin(err, (not rejected) and saved or nil)   -- no pop up on execute: waits for the Login button
	else
		local okF, errF = ACC.startFree()
		ACC.checking = false
		ACC.refreshStatus()
		syncCards()
		if not okF then ACC.showLogin(errF) end   -- the login window only pops up if free is off or unreachable
	end
end)
