-- ------------------------------------------------------------------- helpers
local UNITS = { { 1e18, "Qi" }, { 1e15, "Qa" }, { 1e12, "T" }, { 1e9, "B" }, { 1e6, "M" }, { 1e3, "K" } }

local function fmt(n)
	n = tonumber(n) or 0
	for _, u in ipairs(UNITS) do
		if n >= u[1] then
			local s = ("%.2f"):format(n / u[1]):gsub("%.?0+$", "")
			return s .. u[2]
		end
	end
	return ("%d"):format(n)
end

local function formatValue(n)
	n = tonumber(n) or 0
	for _, u in ipairs(UNITS) do
		if n >= u[1] then return ("$%.2f%s"):format(n / u[1], u[2]) end
	end
	return ("$%d"):format(n)
end

-- slider position (0..1) <-> value. 0 at the far left, then 1K .. 1Qa on a log scale.
local function posToValue(p)
	if p < 0.03 then return 0 end
	local v = 10 ^ (3 + ((p - 0.03) / 0.97) * 12)
	return tonumber(("%.3g"):format(v))
end
local function valueToPos(v)
	if v <= 0 then return 0 end
	return 0.03 + 0.97 * ((math.log(v, 10) - 3) / 12)
end

local function timeAgo(born)
	local s = math.max(0, os.clock() - born)
	if s < 60 then return math.floor(s) .. "s ago" end
	return math.floor(s / 60) .. "m ago"
end

local reqFn = (syn and syn.request) or (http and http.request) or http_request or request

local function tween(obj, t, props, style, dir)
	local tw = TweenService:Create(obj, TweenInfo.new(t, style or Enum.EasingStyle.Quad, dir or Enum.EasingDirection.Out), props)
	tw:Play()
	return tw
end

-- Fade helpers. CanvasGroup is unreliable on mobile executors, so instead of
-- GroupTransparency we remember every element's own transparencies and tween those.
local function collect(root)
	local items = {}
	local function add(o)
		if o:IsA("GuiObject") and o.BackgroundTransparency < 1 then
			items[#items + 1] = { o, "BackgroundTransparency", o.BackgroundTransparency }
		end
		if o:IsA("TextLabel") or o:IsA("TextButton") or o:IsA("TextBox") then
			items[#items + 1] = { o, "TextTransparency", o.TextTransparency }
		end
		if o:IsA("UIStroke") then
			items[#items + 1] = { o, "Transparency", o.Transparency }
		end
		if o:IsA("ImageLabel") or o:IsA("ImageButton") then
			items[#items + 1] = { o, "ImageTransparency", o.ImageTransparency }
		end
	end
	add(root)
	for _, d in ipairs(root:GetDescendants()) do add(d) end
	return items
end

local function setAlpha(items, hidden)
	for _, it in ipairs(items) do it[1][it[2]] = hidden and 1 or it[3] end
end

local function fadeItems(items, t, hidden, style, dir)
	for _, it in ipairs(items) do
		tween(it[1], t, { [it[2]] = hidden and 1 or it[3] }, style, dir)
	end
end

-- ------------------------------------------------------------ picture loader
-- Roblox cannot show web pictures directly, so each one is downloaded once, saved to a
-- small folder and shown through getcustomasset. If the executor lacks any of those
-- functions the cards simply have no picture (everything else still works).
local IMG_DIR   = "WorstEggFinder_img"
local assetFn   = (type(getcustomasset) == "function" and getcustomasset) or (type(getsynasset) == "function" and getsynasset) or nil
local CAN_IMG   = CONFIG.IMAGES and reqFn ~= nil and assetFn ~= nil
	and type(writefile) == "function" and type(isfile) == "function" and type(readfile) == "function"
local imgAsset  = {}   -- url -> asset string, or false when it could not be loaded
local imgBusy   = {}   -- url -> list of callbacks waiting for it

if CAN_IMG and type(makefolder) == "function" then
	pcall(function() if not (isfolder and isfolder(IMG_DIR)) then makefolder(IMG_DIR) end end)
end

local function fetchOne(url)
	if imgAsset[url] ~= nil then return imgAsset[url] end
	local fname = (url:match("([^/]+)$") or "img"):gsub("%?.*$", ""):gsub("[^%w%._%-]", "_")
	local path = IMG_DIR .. "/" .. fname
	local ok, asset = pcall(function()
		if not isfile(path) then
			local res = reqFn({ Url = url, Method = "GET" })
			if not (res and res.StatusCode == 200 and type(res.Body) == "string" and res.Body:sub(2, 4) == "PNG") then
				return false
			end
			writefile(path, res.Body)
		end
		return assetFn(path)
	end)
	imgAsset[url] = (ok and asset) or false
	return imgAsset[url]
end

-- urls = list tried in order; cb(asset) runs with the first one that loads (never if none do)
local imgWarned = {}
local function loadImage(urls, cb)
	if not CAN_IMG then return end
	task.spawn(function()
		for _, url in ipairs(urls) do
			local a = fetchOne(url)
			if a then cb(a) return end
		end
		-- nothing worked: say so once per pet, with every address tried, so a bad name is easy to spot
		local key = table.concat(urls, "|")
		if not imgWarned[key] then
			imgWarned[key] = true
			warn("[egg-finder] no picture found, tried: " .. table.concat(urls, "  "))
		end
	end)
end

-- Every picture comes from stealanegg.tools (CONFIG.IMAGE_BASE). The site's file names are not
-- the same for every pet, so several likely names are tried in order and the first one that
-- downloads is used (a name that fails is remembered, so it is never requested twice).
local function imageUrlsFor(petName)
	local name   = tostring(petName or "")
	local under  = (name:gsub("%s+", "_"))
	local mapped = PET_IMAGES[name:lower()]
	local urls, seen = {}, {}
	local function add(file)
		if file and file ~= "" and not seen[file] then
			seen[file] = true
			urls[#urls + 1] = CONFIG.IMAGE_BASE .. file
		end
	end
	local function eggOf(file)
		local e, n = file:gsub("_Pet%.png$", "_Egg.png")
		if n == 0 then e = file:gsub("%.png$", "_Egg.png") end
		return e
	end
	if CONFIG.IMAGE_MODE ~= "pet" then
		if mapped then add(eggOf(mapped)) end
		add(under .. "_Egg.png")
	end
	add(mapped)
	add(under .. "_Pet.png")
	add(under .. ".png")
	return urls
end

