-- RESIZE: drag the grip (dots) in the bottom-right corner of the window. The size is remembered.
do
	local SIZE_FILE = "WorstEggFinder_size.json"
	local MIN_W, MIN_H, MAX_W, MAX_H = 300, 340, 640, 900
	local function setSize(w, h)
		local cam = workspace.CurrentCamera
		local vp = cam and cam.ViewportSize or Vector2.new(1280, 720)
		local maxW = math.max(MIN_W, math.min(MAX_W, vp.X - 10))
		local maxH = math.max(MIN_H, math.min(MAX_H, vp.Y - 10))
		main.Size = UDim2.new(0, math.clamp(w, MIN_W, maxW), 0, math.clamp(h, MIN_H, maxH))
	end
	local function saveSize()
		if type(writefile) ~= "function" then return end
		pcall(writefile, SIZE_FILE, HttpService:JSONEncode({ main.Size.X.Offset, main.Size.Y.Offset }))
	end
	pcall(function()   -- restore the last size
		if type(isfile) == "function" and type(readfile) == "function" and isfile(SIZE_FILE) then
			local d = HttpService:JSONDecode(readfile(SIZE_FILE))
			if type(d) == "table" and tonumber(d[1]) and tonumber(d[2]) then setSize(tonumber(d[1]), tonumber(d[2])) end
		end
	end)

	local grip = mk("TextButton", {
		Name = "ResizeGrip", Size = UDim2.new(0, 36, 0, 36), AnchorPoint = Vector2.new(1, 1), Position = UDim2.new(1, 0, 1, 0),
		BackgroundTransparency = 1, Text = "", AutoButtonColor = false, ZIndex = 60,
	}, main)
	for r = 0, 2 do
		for c = 0, 2 do
			if c + r >= 2 then   -- 6 dots in a triangle
				local dot = mk("Frame", {
					Size = UDim2.new(0, 3, 0, 3), AnchorPoint = Vector2.new(1, 1), BackgroundColor3 = C.ashLite, BorderSizePixel = 0,
					Position = UDim2.new(1, -(8 + (2 - c) * 5), 1, -(8 + (2 - r) * 5)), ZIndex = 61,
				}, grip)
				corner(dot, 2)
			end
		end
	end

	local sizing, startIn, startW, startH
	grip.InputBegan:Connect(function(i)
		if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
			sizing, startIn = true, i.Position
			startW, startH = main.Size.X.Offset, main.Size.Y.Offset
			hidePopup(openPopup)
			i.Changed:Connect(function()
				if i.UserInputState == Enum.UserInputState.End then sizing = false saveSize() end
			end)
		end
	end)
	UIS.InputChanged:Connect(function(i)
		if sizing and (i.UserInputType == Enum.UserInputType.MouseMovement or i.UserInputType == Enum.UserInputType.Touch) then
			local d = (i.Position - startIn) / math.max(mainScale.Scale, 0.1)
			setSize(startW + d.X, startH + d.Y)
		end
	end)
end

