-- fresh (covers the moment right after a hop, before the hopper has started again).
local HOPPER_MARK = "worst-hopper-active.txt"
local function hopperRunning()
	if env.EGG_GRABBER_RUNNING == true then return true end
	if type(isfile) == "function" and type(readfile) == "function" then
		local ok, t = pcall(function() if isfile(HOPPER_MARK) then return tonumber(readfile(HOPPER_MARK)) end end)
		if ok and t and math.abs(os.time() - t) < 120 then return true end
	end
	return false
end
