local function hidePopup(p)
	if not p then return end
	if openPopup == p then
		openPopup = nil
		blocker.Visible = false
	end
	fadeItems(p.items, 0.15, true, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
	tween(p.frame, 0.15, { Position = p.pos + UDim2.new(0, 0, 0, -10) }, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
	task.delay(0.17, function()
		if openPopup ~= p then p.frame.Visible = false end
	end)
end

local function showPopup(p)
	if openPopup == p then return hidePopup(p) end   -- tap again = close
	if openPopup then hidePopup(openPopup) end
	openPopup = p
	blocker.Visible = true
	p.frame.Visible = true
	setAlpha(p.items, true)
	p.frame.Position = p.pos + UDim2.new(0, 0, 0, -10)
	fadeItems(p.items, 0.2, false)
	tween(p.frame, 0.22, { Position = p.pos }, Enum.EasingStyle.Back)
end

