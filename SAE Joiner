-- Gold / Silver / Rainbow cards are painted all over with a metallic gradient, get a
-- glossy top, a light sweep that glides across, and a pulsing glowing border.
-- Text on these cards is dark so it stays readable on the bright background.
local function seq(list)
	local k = {}
	for i, v in ipairs(list) do k[i] = ColorSequenceKeypoint.new(v[1], Color3.fromRGB(v[2], v[3], v[4])) end
	return ColorSequence.new(k)
end
local THEMES = {
	golden = {
		bg = seq({ { 0, 255, 242, 168 }, { 0.30, 255, 204, 48 }, { 0.62, 232, 166, 18 }, { 1, 255, 226, 104 } }),
		glow = Color3.fromRGB(255, 218, 70),
		text = Color3.fromRGB(36, 24, 0), sub = Color3.fromRGB(64, 44, 0), valHex = "#241800",
		chipText = Color3.fromRGB(255, 218, 70),
	},
	silver = {
		bg = seq({ { 0, 255, 255, 255 }, { 0.30, 214, 219, 228 }, { 0.62, 176, 182, 194 }, { 1, 240, 243, 249 } }),
		glow = Color3.fromRGB(255, 255, 255),
		text = Color3.fromRGB(16, 18, 24), sub = Color3.fromRGB(44, 48, 58), valHex = "#101218",
		chipText = Color3.fromRGB(240, 244, 252),
	},
	rainbow = {
		bg = seq({ { 0, 255, 128, 128 }, { 0.20, 255, 204, 110 }, { 0.40, 160, 238, 140 }, { 0.60, 116, 208, 255 }, { 0.80, 178, 148, 255 }, { 1, 255, 138, 214 } }),
		rainbow = true,
		text = Color3.fromRGB(12, 12, 16), sub = Color3.fromRGB(34, 34, 44), valHex = "#0C0C10",
		chipText = Color3.new(1, 1, 1),
	},
}
local DARK_TILE = Color3.fromRGB(22, 22, 26)

-- colour of a ColorSequence at position t (0..1)
local function seqAt(cs, t)
	local k = cs.Keypoints
	if t <= k[1].Time then return k[1].Value end
	for i = 2, #k do
		if t <= k[i].Time then
			local p, q = k[i - 1], k[i]
			return p.Value:Lerp(q.Value, (t - p.Time) / math.max(q.Time - p.Time, 1e-6))
		end
	end
	return k[#k].Value
end

-- theme for the two-variety card: the shiny theme when there is one, otherwise one made from the chip colour
local function themeFor(name, style)
	local t = THEMES[tostring(name):lower()]
	if t then return t end
	local b = (style and style.bg) or Color3.fromRGB(90, 90, 100)
	return {
		bg = ColorSequence.new({
			ColorSequenceKeypoint.new(0, b:Lerp(Color3.new(1, 1, 1), 0.55)),
			ColorSequenceKeypoint.new(0.5, b),
			ColorSequenceKeypoint.new(1, b:Lerp(Color3.new(0, 0, 0), 0.15)),
		}),
		glow = b, chipText = b,
	}
end

local function metaText(a)
	local parts = {}
	if a.kg and a.kg ~= "" then parts[#parts + 1] = a.kg end
	if a.players and a.players ~= "" then parts[#parts + 1] = a.players end
	if a.lat then parts[#parts + 1] = ("%.1fs delay"):format(a.lat / 1000) end
	parts[#parts + 1] = timeAgo(a.born)
	return table.concat(parts, "  •  ")
end

