	if ACC.session.free then
		if lbl then lbl.Text = "STATUS" end
		hubVal.Text = "Free"
		hubVal.TextColor3 = ACC.connBad and C.ash or C.white
		return
	end
	if lbl then lbl.Text = "TIME LEFT" end
	hubVal.Text = ACC.session.unlimited and "Unlimited" or ACC.fmtLeft(ACC.session.expireClock - os.clock())
	hubVal.TextColor3 = ACC.connBad and C.ash or C.white
end

