ACC.fmtLeft = function(sec)
	sec = math.max(0, math.floor(sec))
	local d, h, m = math.floor(sec / 86400), math.floor(sec % 86400 / 3600), math.floor(sec % 3600 / 60)
	if d > 0 then return d .. "d " .. h .. "h" end
	if h > 0 then return h .. "h " .. m .. "m" end
	return m .. "m " .. (sec % 60) .. "s"
end
ACC.refreshStatus = function()
	local lbl = hubBox:FindFirstChildOfClass("TextLabel")
	if not ACC.session then
		if lbl then lbl.Text = "STATUS" end
		hubVal.Text = ACC.checking and "..." or "Login"
		hubVal.TextColor3 = C.white
