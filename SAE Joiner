	if th then
		for _, ch in ipairs(c:GetChildren()) do
			if ch:IsA("GuiObject") then ch.ZIndex = 2 end
		end
		for _, ch in ipairs(c:GetChildren()) do
			if ch == sweep or (ch:IsA("Frame") and ch.Size.Y.Scale == 0.55) then ch.ZIndex = 1 end
		end
	end

	local items = collect(c)
	setAlpha(items, true)
	local entry = { wrap = wrap, card = c, sub = sub, items = items, join = join, img = img, expired = false }
	cards[a] = entry
	if isExpired(a) then styleExpired(entry) end

	task.delay(delay or 0, function()
		if not wrap.Parent then return end
		tween(wrap, 0.22, { Size = UDim2.new(1, -6, 0, CARD_H) })
		fadeItems(items, 0.28, false)
		tween(c, 0.3, { Position = UDim2.new(0, 0, 0, 0) }, Enum.EasingStyle.Back)
	end)

	-- shine animations (only themed cards): pulsing glow, gliding sweep, flowing rainbow
	if th then
		task.delay((delay or 0) + 0.7, function()
			if not wrap.Parent then return end
			local pulse = TweenInfo.new(0.9, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, -1, true)
			TweenService:Create(cardStroke, pulse, { Thickness = 3.4, Transparency = 0.35 }):Play()
			if strokeGrad then
				TweenService:Create(strokeGrad, TweenInfo.new(2.6, Enum.EasingStyle.Linear, Enum.EasingDirection.Out, -1, false), { Rotation = 360 }):Play()
			end
			if th.rainbow and bgGrad then
				bgGrad.Offset = Vector2.new(-0.35, 0)
				TweenService:Create(bgGrad, TweenInfo.new(2.4, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, -1, true), { Offset = Vector2.new(0.35, 0) }):Play()
			end
		end)
		task.spawn(function()
			task.wait((delay or 0) + 0.5 + math.random() * 1.5)
			while wrap.Parent and not stopped do
				sweep.Position = UDim2.new(-0.3, 0, 0.5, 0)
				tween(sweep, 0.9, { Position = UDim2.new(1.3, 0, 0.5, 0) }, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut)
				task.wait(3.3)
			end
		end)
	end
end

local function removeCard(a)
	local e = cards[a]
	if not e then return end
	cards[a] = nil
	fadeItems(e.items, 0.18, true, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
	tween(e.card, 0.18, { Position = UDim2.new(0, -36, 0, 0) }, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
	tween(e.wrap, 0.22, { Size = UDim2.new(1, -6, 0, 0) })
	task.delay(0.26, function() e.wrap:Destroy() end)
end

syncCards = function()
	local shown = 0
	for _, a in ipairs(alerts) do
		if passes(a) then
			shown = shown + 1
			if not cards[a] then makeCard(a, CONFIG.STAGGER and math.min(0.4, (shown - 1) * 0.04) or 0) end
		else
			removeCard(a)
		end
	end
	emptyLabel.Visible = shown == 0
	emptyLabel.Text = (#alerts == 0) and "Waiting for alerts..." or "No alerts match your filters"
end
env.EGG_HUB_SYNC = syncCards

local function addAlert(a, skipSync)
	if type(a) ~= "table" or not a.jobId then return end
	if a.id and a.id > lastId then lastId = a.id end
	for _, e in ipairs(alerts) do
		if a.id and e.id == a.id then return end
	end
	-- latency probe: only for brand-new alerts (not history) that carry the hopper's send time
	if CONFIG.DEBUG_LATENCY and tonumber(a.sent) and a.sent > 0 and (tonumber(a.age) or 0) < 10000 then
		local now = DateTime.now().UnixTimestampMillis
		local ts  = tonumber(a.ts) or now
		a.lat = now - a.sent
		print(("[latency] %s | hopper->relay %dms | relay->you %dms | total %dms | via %s")
			:format(tostring(a.egg), ts - a.sent, now - ts, a.lat, wsLive and "WebSocket" or "HTTP"))
	end
	seqCount = seqCount + 1
	a.seq = seqCount
	a.valueNum = tonumber(a.value) or 0
	a.born = os.clock() - ((tonumber(a.age) or 0) / 1000)

	-- all eggs of a wave disappear together: one deadline per session, counted from
	-- the first egg reported in it. An egg born after that deadline starts a new session.
	if not sessionEnd or a.born >= sessionEnd then
		sessionEnd = a.born + CONFIG.EXPIRE_SECS
	end
	a.expireAt = sessionEnd

	-- clean the name and pin the tier from the table so it can never be mislabelled
	a.egg = tostring(a.egg or "Egg"):gsub("%s+[Ee]gg$", "")
	local mutRaw = a.mutation or a.variety or a.variant or a.mut
	local prefix, rest = splitMutationPrefix(a.egg)
	if prefix then
		a.egg = rest
		if readMutation(mutRaw) == nil then mutRaw = prefix end
	end
	a.mutation = readMutation(mutRaw)   -- nil when none
	a.tier = PET_TIER[norm(a.egg)] or tostring(a.tier or "")

	table.insert(alerts, 1, a)
	while #alerts > CONFIG.MAX_CARDS do
		removeCard(table.remove(alerts))
	end
	if not skipSync then syncCards() end
	return a
end

