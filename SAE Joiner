-- ------------------------------------------------------------ egg varieties (mutations)
-- bg / fg = chip colours. rainbow = true gives the chip a rainbow gradient.
-- A variety that is not listed still shows, as a plain grey chip, so new ones never get lost.
local MUTATIONS = {
	silver  = { name = "Silver",  bg = Color3.fromRGB(205, 210, 220), fg = Color3.fromRGB(10, 10, 12) },
	golden  = { name = "Golden",  bg = Color3.fromRGB(255, 196, 36),  fg = Color3.fromRGB(10, 10, 12) },
	rainbow = { name = "Rainbow", bg = Color3.fromRGB(255, 255, 255), fg = Color3.fromRGB(10, 10, 12), rainbow = true },
	diamond = { name = "Diamond", bg = Color3.fromRGB(96, 205, 255),  fg = Color3.fromRGB(10, 10, 12) },
}
local MUT_ALIAS = { gold = "golden", gilded = "golden" }

-- "Golden" / "gold" / " RAINBOW " -> display name + style. Returns nil for none / normal / empty.
local function readMutation(m)
	m = tostring(m or ""):gsub("^%s+", ""):gsub("%s+$", "")
	local k = norm(m)
	if k == "" or k == "none" or k == "normal" or k == "regular" or k == "default" then return nil end
	k = MUT_ALIAS[k] or k
	local s = MUTATIONS[k]
	if s then return s.name, s end
	return m, { name = m, bg = Color3.fromRGB(90, 90, 100), fg = Color3.fromRGB(255, 255, 255) }
end

-- "Golden Stag" -> "Golden", "Stag"
local function splitMutationPrefix(name)
	local low = name:lower()
	for word in pairs(MUTATIONS) do
		if low:sub(1, #word + 1) == word .. " " then
			return name:sub(1, #word), name:sub(#word + 2)
		end
	end
	for word, k in pairs(MUT_ALIAS) do
		if low:sub(1, #word + 1) == word .. " " then
			return MUTATIONS[k].name, name:sub(#word + 2)
		end
	end
end

