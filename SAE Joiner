local function metaText(a)
	local parts = {}
	if a.kg and a.kg ~= "" then parts[#parts + 1] = a.kg end
	if a.players and a.players ~= "" then parts[#parts + 1] = a.players end
	if a.lat then parts[#parts + 1] = ("%.1fs delay"):format(a.lat / 1000) end
	parts[#parts + 1] = timeAgo(a.born)
	return table.concat(parts, "  •  ")
end

local CARD_H = 70
local IMG_W   = CONFIG.IMAGES and 60 or 0   -- space kept for the picture on the left

local function makeCard(a, delay)
	-- wrap = layout slot (grows open), card = the visible frame that slides + fades in
	local wrap = mk("Frame", {
		Size = UDim2.new(1, -6, 0, 0), BackgroundTransparency = 1, ClipsDescendants = true, LayoutOrder = -a.seq,
	}, list)
	local c = mk("Frame", {
		Size = UDim2.new(1, 0, 0, CARD_H), Position = UDim2.new(0, 36, 0, 0), BackgroundColor3 = C.card,
	}, wrap)
	corner(c, 8)

	local mutName, mut = readMutation(a.mutation)
	local th = mutName and THEMES[mutName:lower()] or nil
	a._valHex = th and th.valHex or nil
	local txtMain = th and th.text or C.white
	local txtSub  = th and th.sub or C.ash

	-- border takes the colour of the egg variety; themed cards get a thicker glowing one
	local cardStroke = mk("UIStroke", {
		Color = (th and th.glow) or (mut and mut.bg) or C.line,
		Thickness = th and 2 or (mut and 1.8 or 1),
	}, c)
	if (mut and mut.rainbow) or (th and th.rainbow) then
		mk("UIGradient", { Color = RAINBOW }, cardStroke)
	end

	local bgGrad, sweep, strokeGrad
	if th then
		c.BackgroundColor3 = Color3.new(1, 1, 1)          -- the gradient provides the colour
		c.ClipsDescendants = true
		bgGrad = mk("UIGradient", { Color = th.bg, Rotation = 28 }, c)
		strokeGrad = cardStroke:FindFirstChildOfClass("UIGradient")
		-- glossy top half
		local gloss = mk("Frame", {
			Size = UDim2.new(1, 0, 0.55, 0), BackgroundColor3 = Color3.new(1, 1, 1), BorderSizePixel = 0,
		}, c)
		corner(gloss, 8)
		mk("UIGradient", {
			Rotation = 90,
			Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.5), NumberSequenceKeypoint.new(1, 1) }),
		}, gloss)
		-- light sweep that glides across now and then
		sweep = mk("Frame", {
			Size = UDim2.new(0.22, 0, 2.2, 0), AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.new(-0.3, 0, 0.5, 0),
			Rotation = 18, BackgroundColor3 = Color3.new(1, 1, 1), BorderSizePixel = 0,
		}, c)
		mk("UIGradient", {
			Transparency = NumberSequence.new({
				NumberSequenceKeypoint.new(0, 1), NumberSequenceKeypoint.new(0.5, 0.3), NumberSequenceKeypoint.new(1, 1),
			}),
		}, sweep)
	end

	-- picture (egg / pet). Starts empty and fills in once downloaded.
	local img
	if CONFIG.IMAGES then
		local frame = mk("Frame", {
			Size = UDim2.new(0, 52, 0, 52), Position = UDim2.new(0, 8, 0.5, -26), BackgroundColor3 = C.box,
		}, c)
		corner(frame, 8)
		img = mk("ImageLabel", {
			Size = UDim2.new(1, -4, 1, -4), Position = UDim2.new(0, 2, 0, 2), BackgroundTransparency = 1,
			ScaleType = Enum.ScaleType.Fit, Image = "",
		}, frame)
		loadImage(imageUrlsFor(a.egg), function(asset)
			if img and img.Parent then img.Image = asset end
		end)
	end

	local textX = 10 + IMG_W

	-- row 1: pet name (+ variety chip on the right)
	local chipW = 0
	if mutName then
		chipW = TextService:GetTextSize(mutName:upper(), 9, Enum.Font.GothamBlack, Vector2.new(200, 16)).X + 14
		local chip = mk("Frame", {
			Size = UDim2.new(0, chipW, 0, 16), Position = UDim2.new(1, -(88 + chipW), 0, 8),
			BackgroundColor3 = th and DARK_TILE or mut.bg,
		}, c)
		corner(chip, 4)
		if not th and mut.rainbow then mk("UIGradient", { Color = RAINBOW }, chip) end
		local chipLabel = mk("TextLabel", {
			Size = UDim2.new(1, 0, 1, 0), BackgroundTransparency = 1, Text = mutName:upper(),
			TextColor3 = th and th.chipText or mut.fg, Font = Enum.Font.GothamBlack, TextSize = 9,
		}, chip)
		if th and th.rainbow then mk("UIGradient", { Color = RAINBOW }, chipLabel) end
	end
	mk("TextLabel", {
		Size = UDim2.new(1, -(textX + 88 + (chipW > 0 and chipW + 4 or 0)), 0, 20), Position = UDim2.new(0, textX, 0, 6),
		BackgroundTransparency = 1,
		Text = a.egg or "Egg", TextColor3 = txtMain, Font = Enum.Font.GothamBlack, TextSize = 15,
		TextXAlignment = Enum.TextXAlignment.Left, TextTruncate = Enum.TextTruncate.AtEnd,
	}, c)

	-- row 2: tier badge + value
	local badgeStyle = TIER_BADGE[a.tier]
	local badge = mk("Frame", {
		Size = UDim2.new(0, 68, 0, 16), Position = UDim2.new(0, textX, 0, 29),
		BackgroundColor3 = badgeStyle and badgeStyle.bg or C.track,
	}, c)
	corner(badge, 4)
	if th then mk("UIStroke", { Color = DARK_TILE, Thickness = 1.2 }, badge) end
	mk("TextLabel", {
		Size = UDim2.new(1, 0, 1, 0), BackgroundTransparency = 1,
		Text = (a.tier ~= "" and a.tier or "?"):upper(), TextColor3 = badgeStyle and badgeStyle.fg or C.ashLite,
		Font = Enum.Font.GothamBlack, TextSize = 9,
	}, badge)
	mk("TextLabel", {
		Size = UDim2.new(1, -(textX + 68 + 6 + 84), 0, 16), Position = UDim2.new(0, textX + 74, 0, 29), BackgroundTransparency = 1, RichText = true,
		Text = valueText(a), Font = Enum.Font.GothamBlack, TextSize = 13, TextColor3 = txtMain,
		TextXAlignment = Enum.TextXAlignment.Left, TextTruncate = Enum.TextTruncate.AtEnd,
	}, c)

	-- row 3: kg / players / age
	local sub = mk("TextLabel", {
		Size = UDim2.new(1, -(textX + 84), 0, 16), Position = UDim2.new(0, textX, 0, 48), BackgroundTransparency = 1,
		Text = metaText(a), TextColor3 = txtSub, Font = Enum.Font.GothamBold, TextSize = 10,
		TextXAlignment = Enum.TextXAlignment.Left, TextTruncate = Enum.TextTruncate.AtEnd,
	}, c)

	local join = mk("TextButton", {
		Size = UDim2.new(0, 70, 0, 40), Position = UDim2.new(1, -78, 0.5, -20), BackgroundColor3 = C.light,
		Text = "Join", TextColor3 = C.black, Font = Enum.Font.GothamBlack, TextSize = 16,
	}, c)
	corner(join, 8)
	if th then
		join.BackgroundColor3 = DARK_TILE
		join.TextColor3 = C.white
	end
	join.MouseButton1Click:Connect(function()
		if isExpired(a) then return end
		joinServer(a)
	end)

	-- keep the shiny layers underneath the text and buttons
	if th then
		for _, ch in ipairs(c:GetChildren()) do
			if ch:IsA("GuiObject") then ch.ZIndex = 2 end
		end
		for _, ch in ipairs(c:GetChildren()) do
			if ch == sweep or (ch:IsA("Frame") and ch.Size.Y.Scale == 0.55) then ch.ZIndex = 1 end
		end
	end

	local items = collect(c)
	setAlpha(items, true)
	local entry = { wrap = wrap, card = c, sub = sub, items = items, join = join, img = img, expired = false }
	cards[a] = entry
	if isExpired(a) then styleExpired(entry) end

	task.delay(delay or 0, function()
		if not wrap.Parent then return end
		tween(wrap, 0.22, { Size = UDim2.new(1, -6, 0, CARD_H) })
		fadeItems(items, 0.28, false)
		tween(c, 0.3, { Position = UDim2.new(0, 0, 0, 0) }, Enum.EasingStyle.Back)
	end)

	-- shine animations (only themed cards): pulsing glow, gliding sweep, flowing rainbow
	if th then
		task.delay((delay or 0) + 0.7, function()
			if not wrap.Parent then return end
			local pulse = TweenInfo.new(0.9, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, -1, true)
			TweenService:Create(cardStroke, pulse, { Thickness = 3.4, Transparency = 0.35 }):Play()
			if strokeGrad then
				TweenService:Create(strokeGrad, TweenInfo.new(2.6, Enum.EasingStyle.Linear, Enum.EasingDirection.Out, -1, false), { Rotation = 360 }):Play()
			end
			if th.rainbow and bgGrad then
				bgGrad.Offset = Vector2.new(-0.35, 0)
				TweenService:Create(bgGrad, TweenInfo.new(2.4, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, -1, true), { Offset = Vector2.new(0.35, 0) }):Play()
			end
		end)
		task.spawn(function()
			task.wait((delay or 0) + 0.5 + math.random() * 1.5)
			while wrap.Parent and not stopped do
				sweep.Position = UDim2.new(-0.3, 0, 0.5, 0)
				tween(sweep, 0.9, { Position = UDim2.new(1.3, 0, 0.5, 0) }, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut)
				task.wait(3.3)
			end
		end)
	end
end

local function removeCard(a)
	local e = cards[a]
	if not e then return end
	cards[a] = nil
	fadeItems(e.items, 0.18, true, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
	tween(e.card, 0.18, { Position = UDim2.new(0, -36, 0, 0) }, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
	tween(e.wrap, 0.22, { Size = UDim2.new(1, -6, 0, 0) })
	task.delay(0.26, function() e.wrap:Destroy() end)
end

syncCards = function()
	local shown = 0
	for _, a in ipairs(alerts) do
		if passes(a) then
			shown = shown + 1
			if not cards[a] then makeCard(a, CONFIG.STAGGER and math.min(0.4, (shown - 1) * 0.04) or 0) end
		else
			removeCard(a)
		end
	end
	emptyLabel.Visible = shown == 0
	emptyLabel.Text = ACC.checking and "Checking login..."
		or (not ACC.session) and "Log in to see eggs. Tap STATUS."
		or (#alerts == 0) and "Waiting for alerts..." or "No alerts match your filters"
end
env.EGG_HUB_SYNC = syncCards

local function addAlert(a, skipSync)
	if type(a) ~= "table" or not a.jobId then return end
	if a.id and a.id > lastId then lastId = a.id end
	for _, e in ipairs(alerts) do
		if a.id and e.id == a.id then return end
	end
	-- latency probe: only for brand-new alerts (not history) that carry the hopper's send time
	if CONFIG.DEBUG_LATENCY and tonumber(a.sent) and a.sent > 0 and (tonumber(a.age) or 0) < 10000 then
		local now = DateTime.now().UnixTimestampMillis
		local ts  = tonumber(a.ts) or now
		-- the card shows hopper->relay: that one compares the hopper's clock with the relay's, and both
		-- are accurate. (now - sent would use THIS device's clock, which can be seconds off and
		-- showed up as a negative delay.) The last number printed is relay->you PLUS this device's clock error.
		a.lat = math.max(0, ts - a.sent)
		print(("[latency] %s | hopper->relay %dms | relay->you+clock error %dms | via %s")
			:format(tostring(a.egg), ts - a.sent, now - ts, wsLive and "WebSocket" or "HTTP"))
	end
	seqCount = seqCount + 1
	a.seq = seqCount
	a.valueNum = tonumber(a.value) or 0
	a.born = os.clock() - ((tonumber(a.age) or 0) / 1000)

	-- all eggs of a wave disappear together: one deadline per session, counted from
	-- the first egg reported in it. An egg born after that deadline starts a new session.
	if CONFIG.CYCLE_SYNC then
		-- The egg dies at the next 5-minute boundary after it was reported. This is worked out
		-- on the RELAY's clock (alert time `ts`, plus `age` = how old it was when the relay sent
		-- it to us) and turned into a countdown on this device, so it does not matter if this
		-- device's own clock is seconds off. History alerts from an earlier cycle arrive expired.
		local period = tonumber(CONFIG.CYCLE_SECS) or 300
		local tsMs   = tonumber(a.ts)
		if tsMs then
			local expiry   = (math.floor(tsMs / 1000 / period) + 1) * period
			local relayNow = (tsMs + (tonumber(a.age) or 0)) / 1000
			a.expireAt = os.clock() + (expiry - relayNow)
		else
			-- no relay timestamp on this alert: fall back to this device's clock
			local reported = os.time() - math.floor((tonumber(a.age) or 0) / 1000)
			a.expireUnix = (math.floor(reported / period) + 1) * period
		end
	else
		if not sessionEnd or a.born >= sessionEnd then
			sessionEnd = a.born + CONFIG.EXPIRE_SECS
		end
		a.expireAt = sessionEnd
	end

	-- clean the name and pin the tier from the table so it can never be mislabelled
	a.egg = tostring(a.egg or "Egg"):gsub("%s+[Ee]gg$", "")
	local mutRaw = a.mutation or a.variety or a.variant or a.mut
	local prefix, rest = splitMutationPrefix(a.egg)
	if prefix then
		a.egg = rest
		if readMutation(mutRaw) == nil then mutRaw = prefix end
	end
	a.mutation = readMutation(mutRaw)   -- nil when none
	a.tier = PET_TIER[norm(a.egg)] or tostring(a.tier or "")

	table.insert(alerts, 1, a)
	while #alerts > CONFIG.MAX_CARDS do
		removeCard(table.remove(alerts))
	end
	if not skipSync then syncCards() end
	return a
end

