local target = nil      -- { egg =, jobId =, tier = } of the server we are standing in
-- the "Egg in Server" box at the top of the screen was removed
local function startMonitor() end

-- remember which egg we are joining for, so the next server can show the box
local function saveTarget(a)
	if type(writefile) == "function" then
		pcall(writefile, TARGET_FILE, HttpService:JSONEncode({ egg = a.egg, jobId = a.jobId, tier = a.tier }))
	end
end

local function readTarget()
	local t = env.EGG_JOIN_TARGET
	env.EGG_JOIN_TARGET = nil
	if type(t) == "table" then return t end
	local ok, d = pcall(function()
		if type(isfile) == "function" and type(readfile) == "function" and isfile(TARGET_FILE) then
			return HttpService:JSONDecode(readfile(TARGET_FILE))
		end
	end)
	if ok and type(d) == "table" then return d end
	return nil
end

local function joinServer(a)
	if joining or stopped then return end
	if a.jobId == game.JobId then
		setHub("HERE", false)
		target = { egg = a.egg, jobId = a.jobId, tier = a.tier }
		saveTarget(a)
		startMonitor()
		return
	end
	saveTarget(a)
	joining = true
	setHub("JOINING", true)

	local q = queue_on_teleport or queueonteleport
	if q and CONFIG.SCRIPT_URL ~= "" then
		local tjson = HttpService:JSONEncode({ egg = a.egg, jobId = a.jobId, tier = a.tier })
		local sjson = HttpService:JSONEncode({ autoOn = auto.on, autoMin = auto.minValue })
		pcall(q, ('getgenv().EGG_HUB_RUNNING=nil; getgenv().EGG_JOIN_TARGET=game:GetService("HttpService"):JSONDecode([==[%s]==]); getgenv().EGG_JOIN_SETTINGS=game:GetService("HttpService"):JSONDecode([==[%s]==]); loadstring(game:HttpGet("%s"))()'):format(tjson, sjson, CONFIG.SCRIPT_URL))
	end

	local ok, err = pcall(function()
		TeleportService:TeleportToPlaceInstance(tonumber(a.placeId), a.jobId, LocalPlayer)
	end)
	if not ok then
		warn("[egg-finder] teleport error: " .. tostring(err))
		joining = false
		setHub("FAILED", false)
	end
	task.delay(12, function() joining = false end)
end

TeleportService.TeleportInitFailed:Connect(function(_, result, msg)
	joining = false
	setHub("FAILED", false)
	warn("[egg-finder] join failed: " .. tostring(result) .. " " .. tostring(msg))
end)

-- AUTO JOIN: take a brand-new alert that is still alive, passes the list filters and
-- is worth at least MIN JOIN. Alerts that were already waiting when we connected
-- are never auto-joined.
local autoDone = {}
local function tryAutoJoin(a)
	if not auto.on or joining or stopped then return end
	if not a or isExpired(a) or autoDone[a.jobId] then return end
	if a.jobId == game.JobId then return end
	if (a.valueNum or 0) < auto.minValue then return end
	if not passes(a) then return end
	autoDone[a.jobId] = true
	joinServer(a)
end

