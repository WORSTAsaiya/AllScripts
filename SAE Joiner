-- --------------------------------------------------------------- data sources
local function handleMessage(raw)
	local ok, d = pcall(function() return HttpService:JSONDecode(raw) end)
	if not ok or type(d) ~= "table" then return end
	if d.type == "history" and type(d.alerts) == "table" then
		for i = #d.alerts, 1, -1 do addAlert(d.alerts[i], true) end
		syncCards()
	elseif d.type == "alert" then
		local a = addAlert(d.alert)
		if a then tryAutoJoin(a) end
	end
end

local function runWebSocket()
	if not (WebSocket and WebSocket.connect) then return false end
	local ok, ws = pcall(WebSocket.connect, CONFIG.HUB_WS .. "/?key=" .. CONFIG.KEY)
	if not ok or not ws then return false end
	setHub("LIVE", true)
	wsLive = true
	local closed = false
	ws.OnMessage:Connect(handleMessage)
	ws.OnClose:Connect(function() closed = true end)
	while not closed and not stopped do task.wait(0.5) end
	wsLive = false
	setHub("RECONNECT", false)
	return true
end

local pollPrimed = false
local function runPolling(seconds)
	if not reqFn then return end
	local t0 = os.clock()
	setHub("POLL", true)
	while not stopped and os.clock() - t0 < seconds do
		local ok, res = pcall(reqFn, {
			Url = ("%s/recent?key=%s&since=%d"):format(CONFIG.HUB_HTTP, CONFIG.KEY, lastId),
			Method = "GET",
		})
		if ok and res and res.StatusCode == 200 then
			local okj, d = pcall(function() return HttpService:JSONDecode(res.Body) end)
			if okj and type(d.alerts) == "table" then
				local fresh = {}
				for _, a in ipairs(d.alerts) do
					local added = addAlert(a, true)
					if added then fresh[#fresh + 1] = added end
				end
				syncCards()
				if pollPrimed then
					for _, a in ipairs(fresh) do tryAutoJoin(a) end
				end
				pollPrimed = true
			end
			setHub("POLL", true)
		else
			setHub("OFFLINE", false)
		end
		task.wait(0.4)
	end
end

-- One quick HTTP pull of everything newer than lastId. Used at startup (so the list fills
-- the moment the window opens, without waiting for the WebSocket) and as a bridge while
-- the WebSocket is still connecting or reconnecting. Duplicates are ignored by id.
local function pull(autoJoin)
	if not reqFn then return end
	local ok, res = pcall(reqFn, {
		Url = ("%s/recent?key=%s&since=%d"):format(CONFIG.HUB_HTTP, CONFIG.KEY, lastId),
		Method = "GET",
	})
	if not (ok and res and res.StatusCode == 200) then return end
	local okj, d = pcall(function() return HttpService:JSONDecode(res.Body) end)
	if not (okj and type(d) == "table" and type(d.alerts) == "table") then return end
	local fresh = {}
	for _, a in ipairs(d.alerts) do
		local added = addAlert(a, true)
		if added then fresh[#fresh + 1] = added end
	end
	if #fresh > 0 then
		syncCards()
		if autoJoin then for _, a in ipairs(fresh) do tryAutoJoin(a) end end
	end
end

