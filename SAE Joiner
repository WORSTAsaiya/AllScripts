task.spawn(function()
	if CONFIG.DEMO then return runDemo() end

	-- 1) fill the list right now over plain HTTP (does not wait for the WebSocket)
	task.spawn(function() pull(false) end)

	-- 2) while the WebSocket is not connected yet, keep pulling so nothing is missed
	if WebSocket and WebSocket.connect then
		task.spawn(function()
			while not stopped do
				if not wsLive then pull(true) end
				task.wait(0.4)
			end
		end)
	end

	-- 3) the WebSocket itself: instant pushes once it is up
	while not stopped do
		local hadWS = runWebSocket()
		if not hadWS then runPolling(60) else task.wait(0.3) end
	end
end)
