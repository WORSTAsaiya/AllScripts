-- remember which egg we are joining for, so the next server can show the box
local function saveTarget(a)
	if type(writefile) == "function" then
		pcall(writefile, TARGET_FILE, HttpService:JSONEncode({ egg = a.egg, jobId = a.jobId, tier = a.tier }))
	end
end

local function readTarget()
	local t = env.EGG_JOIN_TARGET
	env.EGG_JOIN_TARGET = nil
	if type(t) == "table" then return t end
	local ok, d = pcall(function()
		if type(isfile) == "function" and type(readfile) == "function" and isfile(TARGET_FILE) then
			return HttpService:JSONDecode(readfile(TARGET_FILE))
		end
	end)
	if ok and type(d) == "table" then return d end
	return nil
end

local function joinServer(a)
	if joining or stopped then return end
	if a.jobId == game.JobId then
		setHub("HERE", false)
		target = { egg = a.egg, jobId = a.jobId, tier = a.tier }
		saveTarget(a)
		startMonitor()
		return
	end
	saveTarget(a)
	if auto.mode == "farm" then auto.farmCycle = math.max(auto.farmCycle or 0, auto.cycleOf(a)) end
	joining = true
	setHub("JOINING", true)

	local q = queue_on_teleport or queueonteleport
	-- the link is passed along through every hop, so it keeps working even if the hosted copy has SCRIPT_URL empty
	local reloadUrl = (CONFIG.SCRIPT_URL ~= "" and CONFIG.SCRIPT_URL) or (type(env.EGG_SCRIPT_URL) == "string" and env.EGG_SCRIPT_URL) or ""
	if q and reloadUrl ~= "" then
		local tjson = HttpService:JSONEncode({ egg = a.egg, jobId = a.jobId, tier = a.tier })
		local sjson = HttpService:JSONEncode({ autoOn = auto.on, autoMode = auto.mode, farmCycle = auto.farmCycle, autoMin = auto.minValue, showMin = filters.minValue, rarity = filters.rarity, sort = filters.sort })
		pcall(q, ('getgenv().EGG_SCRIPT_URL="%s"; getgenv().EGG_HUB_RUNNING=nil; getgenv().EGG_JOIN_TARGET=game:GetService("HttpService"):JSONDecode([==[%s]==]); getgenv().EGG_JOIN_SETTINGS=game:GetService("HttpService"):JSONDecode([==[%s]==]); loadstring(game:HttpGet("%s"))()'):format(reloadUrl, tjson, sjson, reloadUrl))
	end

	local ok, err = pcall(function()
		TeleportService:TeleportToPlaceInstance(tonumber(a.placeId), a.jobId, LocalPlayer)
	end)
	if not ok then
		warn("[egg-finder] teleport error: " .. tostring(err))
		joining = false
		setHub("FAILED", false)
	end
	task.delay(12, function() joining = false end)
end

TeleportService.TeleportInitFailed:Connect(function(_, result, msg)
	joining = false
	setHub("FAILED", false)
	warn("[egg-finder] join failed: " .. tostring(result) .. " " .. tostring(msg))
end)

-- AUTO JOIN: take a brand-new alert that is still alive, passes the list filters and
-- is worth at least MIN JOIN. Alerts that were already waiting when we connected
-- are never auto-joined.
local autoDone = {}
local function tryAutoJoin(a)
	if not auto.on or joining or stopped then return end
	if not a or isExpired(a) or autoDone[a.jobId] then return end
	if a.jobId == game.JobId then return end
	if auto.secsLeft(a) < (tonumber(CONFIG.JOIN_CUTOFF) or 20) then return end   -- too late to steal anything
	if (a.valueNum or 0) < auto.minValue then return end
	if not passes(a) then return end
	autoDone[a.jobId] = true
	joinServer(a)
end

-- FARM re-arm: every alert that is added (live OR history) passes through here. While farm is WAITING,
-- a Secret / Eternal / Divine egg from a LATER cycle than the one we joined for switches auto join back on.
-- MIN JOIN and the list filters are ignored on purpose; they still apply to the actual join.
auto.observe = function(a)
	if auto.mode ~= "farm" or auto.on or stopped then return end
	if not RARITY.top[a.tier] or isExpired(a) then return end
	if auto.farmCycle and auto.cycleOf(a) <= auto.farmCycle then return end
	auto.on = true
	saveSettings()
	refreshAutoUI(true)
end

