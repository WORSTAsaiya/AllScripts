-- ------------------------------------------------------------------ login
-- Nothing is fetched and no egg is listed until a key has been accepted by the relay.
ACC.tokenFile  = "WorstEggFinder_token.txt"
ACC.deviceFile = "WorstEggFinder_device.txt"

-- one id per device: a key works on one device at a time, so a second login kicks the first
ACC.getDevice = function()
	local id
	pcall(function() id = game:GetService("RbxAnalyticsService"):GetClientId() end)
	if type(id) ~= "string" or id == "" then
		pcall(function() if isfile and readfile and isfile(ACC.deviceFile) then id = readfile(ACC.deviceFile) end end)
		if type(id) ~= "string" or id == "" then
			id = HttpService:GenerateGUID(false)
			pcall(function() if writefile then writefile(ACC.deviceFile, id) end end)
		end
	end
	return (tostring(id):gsub("%s+", ""))
end

ACC.readToken = function()
	if type(CONFIG.KEY) == "string" and CONFIG.KEY ~= "" then return CONFIG.KEY end
	local ok, d = pcall(function() if isfile and readfile and isfile(ACC.tokenFile) then return readfile(ACC.tokenFile) end end)
	if ok and type(d) == "string" then
		d = d:gsub("%s+", "")
		if d ~= "" then return d end
	end
	return nil
end
ACC.saveToken  = function(t) pcall(function() if writefile then writefile(ACC.tokenFile, t) end end) end
ACC.clearToken = function() pcall(function() if writefile then writefile(ACC.tokenFile, "") end end) end

ACC.startFeed = function()
	ACC.gen = ACC.gen + 1
	local gen = ACC.gen
	task.spawn(function()
		-- 1) fill the list right now over plain HTTP (does not wait for the WebSocket)
		task.spawn(function() pull(false, gen) end)

		-- 2) while the WebSocket is not connected yet, keep pulling so nothing is missed
		if WebSocket and WebSocket.connect then
			task.spawn(function()
				while ACC.live(gen) do
					if not wsLive then pull(true, gen) end
					task.wait(0.4)
				end
			end)
		end

		-- 3) the WebSocket itself: instant pushes once it is up
		while ACC.live(gen) do
			local hadWS = runWebSocket(gen)
			if not hadWS then runPolling(60, gen) else task.wait(0.3) end
		end
	end)
end

-- returns ok, errorText, rejected   (rejected = the relay said no; false = could not reach it)
-- throws away the current list and stops the running feed (used by logout and when a key replaces the free version)
ACC.resetFeed = function()
	ACC.gen = ACC.gen + 1
	wsLive = false
	for _, a in ipairs(alerts) do removeCard(a) end
	alerts = {}
	sessionEnd = nil
	lastId = 0
	autoDone = {}
	pollPrimed = false
end

-- joins the free feed (no key). Returns ok, errorText like ACC.login
ACC.startFree = function()
	if not CONFIG.FREE then return false, "Log in to see eggs. Tap STATUS." end
	return ACC.login("@free", true)
end

ACC.login = function(token, isFree)
	if not reqFn then return false, "This executor can't make web requests.", false end
	local okR, res = pcall(reqFn, {
		Url = CONFIG.HUB_HTTP .. "/client/login", Method = "POST",
		Headers = { ["Content-Type"] = "application/json" },
		Body = HttpService:JSONEncode({ token = token, device = ACC.device, player = LocalPlayer.Name }),
	})
	if not okR or type(res) ~= "table" then return false, "Could not reach the server.", false end
	local okJ, d = pcall(function() return HttpService:JSONDecode(res.Body) end)
	if not okJ or type(d) ~= "table" then return false, "Server error. Try again.", false end
	if d.ok ~= true then
		if tostring(d.error or ""):find("Hopper accounts", 1, true) then
			ACC.killHopper()
			return false, "", false
		end
		return false, tostring(d.error or "Login failed."), (tonumber(res.StatusCode or res.status) == 401)
	end
	if ACC.session then ACC.resetFeed() end   -- a key replacing the free version: start from a clean list
	ACC.session = { token = token, free = isFree == true, unlimited = d.unlimited == true or isFree == true, expireClock = os.clock() + (tonumber(d.secondsLeft) or 0), bots = d.bots, name = (type(d.label) == "string") and d.label or nil, freeMax = tonumber(d.freeMax), delayMs = tonumber(d.delayMs) }
	ACC.checking = false
	if not isFree then ACC.saveToken(token) end
	ACC.refreshStatus()
	syncCards()
	ACC.startFeed()
	return true
end

ACC.logout = function(reason, keepToken, noFree)
	do   -- an expired key is remembered, so the "expired" message shows (also on the next servers)
		local S, r = ACC.session, tostring(reason or ""):lower()
		if r:find("time has run out", 1, true) or r:find("expired", 1, true) then
			ACC.writeLastKey({ label = (S and not S.free and S.name) or ACC.readLastKey().label, expired = true })
		end
	end
	ACC.session = nil
	ACC.checking = false
	ACC.resetFeed()                -- stops the running feed and clears the list
	ACC.connBad = false
	if not keepToken then ACC.clearToken() end
	syncCards()
	ACC.refreshStatus()
	if CONFIG.FREE and not noFree then
		-- back to the free version, with the login window open so they can enter another key
		task.spawn(function() ACC.startFree(); ACC.bannerForFree(false); ACC.notifyLogin(reason) end)
	else
		ACC.bannerForFree(false)
		ACC.showLogin(reason)   -- no free version to fall back to: the login window opens
	end
end

