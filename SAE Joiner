		TextXAlignment = Enum.TextXAlignment.Left, TextTruncate = Enum.TextTruncate.AtEnd,
	}, c)

	-- row 3: kg / players / age
	local sub = mk("TextLabel", {
		Size = UDim2.new(1, -(textX + 84), 0, 16), Position = UDim2.new(0, textX, 0, 48), BackgroundTransparency = 1,
		Text = metaText(a), TextColor3 = txtSub, Font = Enum.Font.GothamBold, TextSize = 10,
		TextXAlignment = Enum.TextXAlignment.Left, TextTruncate = Enum.TextTruncate.AtEnd,
	}, c)

	local join = mk("TextButton", {
		Size = UDim2.new(0, 70, 0, 40), Position = UDim2.new(1, -78, 0.5, -20), BackgroundColor3 = C.light,
		Text = "Join", TextColor3 = C.black, Font = Enum.Font.GothamBlack, TextSize = 16,
	}, c)
	corner(join, 8)
	if th then
		join.BackgroundColor3 = DARK_TILE
		join.TextColor3 = C.white
	end
	join.MouseButton1Click:Connect(function()
		if isExpired(a) then return end
		joinServer(a)
	end)

	-- two varieties: everything normal sits above layer 1, where the colour panes will slide
	if dual then
		c.ClipsDescendants = true
		for _, ch in ipairs(c:GetChildren()) do
			if ch:IsA("GuiObject") then ch.ZIndex = 2 end
		end
	end

	-- keep the shiny layers underneath the text and buttons
	if th then
		for _, ch in ipairs(c:GetChildren()) do
			if ch:IsA("GuiObject") then ch.ZIndex = 2 end
		end
		for _, ch in ipairs(c:GetChildren()) do
			if ch == sweep or (ch:IsA("Frame") and ch.Size.Y.Scale == 0.55) then ch.ZIndex = 1 end
		end
	end

	local items = collect(c)
	setAlpha(items, true)
	local entry = { wrap = wrap, card = c, sub = sub, items = items, join = join, img = img, expired = false }
	cards[a] = entry
	if isExpired(a) then styleExpired(entry) end

	-- TWO VARIETIES: the first colour slides in from the left, the second from the right, they hit in the
	-- middle (white flash, border pulse), then the colours merge with a blended glow where they met and the
	-- text turns dark so it stays readable. It plays once and nothing keeps running afterwards.
	if dual then
		local dark, darkSub, darkHex = Color3.fromRGB(16, 16, 22), Color3.fromRGB(44, 48, 58), "#101016"
		local mixCol = seqAt(thA.bg, 0.8):Lerp(seqAt(thB.bg, 0.2), 0.5)

		local function recolor(instant)
			a._valHex = darkHex
			valLbl.Text = valueText(a)
			if instant then
				nameLbl.TextColor3, valLbl.TextColor3, sub.TextColor3 = dark, dark, darkSub
			else
				local ti = TweenInfo.new(0.3, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
				TweenService:Create(nameLbl, ti, { TextColor3 = dark }):Play()
				TweenService:Create(valLbl, ti, { TextColor3 = dark }):Play()
				TweenService:Create(sub, ti, { TextColor3 = darkSub }):Play()
			end
		end

		local function pane(thm, pos)
			local p = mk("Frame", {
				Size = UDim2.new(0.52, 0, 1, 0), Position = pos, BackgroundColor3 = Color3.new(1, 1, 1),
				BorderSizePixel = 0, ZIndex = 1,
			}, c)
			corner(p, 8)
			mk("UIGradient", { Color = thm.bg, Rotation = 28 }, p)
			return p
		end

		clash = function(e, instant)
			if not wrap.Parent or stopped then return end
			local left  = pane(thA, instant and UDim2.new(0, 0, 0, 0) or UDim2.new(-0.55, 0, 0, 0))
			local right = pane(thB, instant and UDim2.new(0.48, 0, 0, 0) or UDim2.new(1.03, 0, 0, 0))
			-- soft blended glow over the seam (invisible until the clash)
			local mix = mk("Frame", {
				Size = UDim2.new(0.6, 0, 1, 0), AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 0),
				BackgroundColor3 = mixCol, BackgroundTransparency = 1, BorderSizePixel = 0, ZIndex = 1,
			}, c)
			corner(mix, 8)
			mk("UIGradient", {
				Transparency = NumberSequence.new({
					NumberSequenceKeypoint.new(0, 1), NumberSequenceKeypoint.new(0.5, 0.12), NumberSequenceKeypoint.new(1, 1),
				}),
			}, mix)
			e.extra = { left, right, mix }

			if instant then   -- already-old alert: just fade in the finished look
				left.BackgroundTransparency, right.BackgroundTransparency = 1, 1
				tween(left, 0.3, { BackgroundTransparency = 0 })
				tween(right, 0.3, { BackgroundTransparency = 0 })
				tween(mix, 0.3, { BackgroundTransparency = 0 })
				recolor(true)
				return
			end

			local slide = TweenInfo.new(0.45, Enum.EasingStyle.Quad, Enum.EasingDirection.In)   -- speeds up into the hit
			TweenService:Create(left,  slide, { Position = UDim2.new(0, 0, 0, 0) }):Play()
			TweenService:Create(right, slide, { Position = UDim2.new(0.48, 0, 0, 0) }):Play()
			task.delay(0.45, function()
				if not wrap.Parent or stopped then return end
				local flash = mk("Frame", {
					Size = UDim2.new(0.1, 0, 1, 0), AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 0),
					BackgroundColor3 = Color3.new(1, 1, 1), BackgroundTransparency = 0.05, BorderSizePixel = 0, ZIndex = 3,
				}, c)
				mk("UIGradient", {
					Transparency = NumberSequence.new({
						NumberSequenceKeypoint.new(0, 1), NumberSequenceKeypoint.new(0.5, 0), NumberSequenceKeypoint.new(1, 1),
					}),
				}, flash)
				tween(flash, 0.35, { Size = UDim2.new(0.9, 0, 1, 0), BackgroundTransparency = 1 })
				tween(mix, 0.45, { BackgroundTransparency = 0 })
				TweenService:Create(cardStroke, TweenInfo.new(0.18, Enum.EasingStyle.Sine, Enum.EasingDirection.Out, 0, true), { Thickness = 4.5 }):Play()
				recolor(false)
				task.delay(0.45, function() flash:Destroy() end)
			end)
		end

		local old = (os.clock() - (a.born or os.clock())) >= 8
		if old and not CONFIG.CLASH_ON_OLD then
			task.delay((delay or 0) + 0.05, function() clash(entry, true) end)
		else
			task.delay((delay or 0) + 0.4, function() clash(entry, false) end)   -- after the card has slid in
		end
	end

	task.delay(delay or 0, function()
		if not wrap.Parent then return end
		tween(wrap, 0.22, { Size = UDim2.new(1, -6, 0, CARD_H) })
		fadeItems(items, 0.28, false)
		tween(c, 0.3, { Position = UDim2.new(0, 0, 0, 0) }, Enum.EasingStyle.Back)
	end)

	-- shine animations (only themed cards): pulsing glow, gliding sweep, flowing rainbow.
	-- These never stop, so they are skipped when CONFIG.LOW_FX is on.
	if th and not CONFIG.LOW_FX then
		task.delay((delay or 0) + 0.7, function()
			if not wrap.Parent then return end
			local pulse = TweenInfo.new(0.9, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, -1, true)
			TweenService:Create(cardStroke, pulse, { Thickness = 3.4, Transparency = 0.35 }):Play()
			if strokeGrad then
				TweenService:Create(strokeGrad, TweenInfo.new(2.6, Enum.EasingStyle.Linear, Enum.EasingDirection.Out, -1, false), { Rotation = 360 }):Play()
			end
			if th.rainbow and bgGrad then
				bgGrad.Offset = Vector2.new(-0.35, 0)
				TweenService:Create(bgGrad, TweenInfo.new(2.4, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, -1, true), { Offset = Vector2.new(0.35, 0) }):Play()
			end
		end)
		task.spawn(function()
			task.wait((delay or 0) + 0.5 + math.random() * 1.5)
			while wrap.Parent and not stopped do
				sweep.Position = UDim2.new(-0.3, 0, 0.5, 0)
				tween(sweep, 0.9, { Position = UDim2.new(1.3, 0, 0.5, 0) }, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut)
				task.wait(3.3)
			end
		end)
	end
end

local function removeCard(a)
	local e = cards[a]
	if not e then return end
	cards[a] = nil
	-- no per-element fades (that was ~20 tweens per card): the card just slides out and the slot collapses
	tween(e.card, 0.18, { Position = UDim2.new(-1, 0, 0, 0) }, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
	tween(e.wrap, 0.22, { Size = UDim2.new(1, -6, 0, 0) })
	task.delay(0.26, function() e.wrap:Destroy() end)
end

-- staggered removal: expired cards leave one at a time instead of all in the same frame
FX.rmQueue, FX.rmBusy = {}, false
FX.queueRemove = function(a)
	FX.rmQueue[#FX.rmQueue + 1] = a
	if FX.rmBusy then return end
	FX.rmBusy = true
	task.spawn(function()
		while not stopped and #FX.rmQueue > 0 do
			local x = table.remove(FX.rmQueue, 1)
			if cards[x] then
				removeCard(x)
				task.wait(tonumber(CONFIG.REMOVE_DELAY) or 0.04)
			end
		end
		FX.rmBusy = false
	end)
end

-- list order: highest value first (ties: newest first), or newest first
local function sortAlerts(list)
	if (filters.sort or CONFIG.SORT) ~= "newest" then
		table.sort(list, function(x, y)
			local vx, vy = x.valueNum or 0, y.valueNum or 0
			if vx ~= vy then return vx > vy end
			return (x.seq or 0) > (y.seq or 0)
		end)
	else
		table.sort(list, function(x, y) return (x.seq or 0) > (y.seq or 0) end)
	end
end

local function reorderCards()
	local order = {}
	for _, a in ipairs(alerts) do if cards[a] then order[#order + 1] = a end end
	sortAlerts(order)
	for i, a in ipairs(order) do cards[a].wrap.LayoutOrder = i end
end

-- card queue: alerts that still need a card wait here and are built one every CONFIG.CARD_DELAY seconds
local pendingCards, queuedCards, pumping = {}, {}, false
local function pumpCards()
	if pumping then return end
	pumping = true
	task.spawn(function()
		while not stopped and #pendingCards > 0 do
			local a = table.remove(pendingCards, 1)
			queuedCards[a] = nil
			-- skip it if it expired, was filtered out or already has a card in the meantime
			if not cards[a] and passes(a) and table.find(alerts, a) then
				local ok, err = pcall(makeCard, a, 0)
				if not ok then warn("[egg-finder] card error: " .. tostring(err)) end
				reorderCards()
				task.wait(tonumber(CONFIG.CARD_DELAY) or 0.1)
			end
		end
		pumping = false
	end)
end

syncCards = function()
	local shown = 0
	local gap = tonumber(CONFIG.CARD_DELAY) or 0
	for _, a in ipairs(alerts) do
		if passes(a) then
			shown = shown + 1
			if not cards[a] then
				if gap > 0 then
					if not queuedCards[a] then
						queuedCards[a] = true
						pendingCards[#pendingCards + 1] = a
					end
				else
					makeCard(a, 0)
				end
			end
		else
			removeCard(a)
		end
	end
	if #pendingCards > 0 then
		sortAlerts(pendingCards)   -- most valuable first, so the top of the list fills in first
		pumpCards()
	end
	reorderCards()
	emptyLabel.Visible = shown == 0
	emptyLabel.Text = ACC.checking and "Checking login..."
		or (not ACC.session) and "Log in to see eggs. Tap STATUS."
		or (#alerts == 0) and "Waiting for alerts..." or "No alerts match your filters"
end
env.EGG_HUB_SYNC = syncCards

local function addAlert(a, skipSync)
	if type(a) ~= "table" or not a.jobId then return end
	if a.id and a.id > lastId then lastId = a.id end
	for _, e in ipairs(alerts) do
		if a.id and e.id == a.id then return end
	end
	-- latency probe: only for brand-new alerts (not history) that carry the hopper's send time
	if CONFIG.DEBUG_LATENCY and tonumber(a.sent) and a.sent > 0 and (tonumber(a.age) or 0) < 10000 then
		local now = DateTime.now().UnixTimestampMillis
		local ts  = tonumber(a.ts) or now
		-- the card shows hopper->relay: that one compares the hopper's clock with the relay's, and both
		-- are accurate. (now - sent would use THIS device's clock, which can be seconds off and
		-- showed up as a negative delay.) The last number printed is relay->you PLUS this device's clock error.
		a.lat = math.max(0, ts - a.sent)
		print(("[latency] %s | hopper->relay %dms | relay->you+clock error %dms | via %s")
			:format(tostring(a.egg), ts - a.sent, now - ts, wsLive and "WebSocket" or "HTTP"))
	end
	seqCount = seqCount + 1
	a.seq = seqCount
	a.valueNum = tonumber(a.value) or 0
	a.born = os.clock() - ((tonumber(a.age) or 0) / 1000)

	-- all eggs of a wave disappear together: one deadline per session, counted from
	-- the first egg reported in it. An egg born after that deadline starts a new session.
	if CONFIG.CYCLE_SYNC then
		-- The egg dies at the next 5-minute boundary after it was reported. This is worked out
		-- on the RELAY's clock (alert time `ts`, plus `age` = how old it was when the relay sent
		-- it to us) and turned into a countdown on this device, so it does not matter if this
		-- device's own clock is seconds off. History alerts from an earlier cycle arrive expired.
		local period = tonumber(CONFIG.CYCLE_SECS) or 300
		local tsMs   = tonumber(a.ts)
		if tsMs then
			local foundMs  = tonumber(a.found) or tsMs   -- when the egg was SEEN (a slow hopper post must not make an old egg look new)
			local expiry   = (math.floor(foundMs / 1000 / period) + 1) * period
			local relayNow = (tsMs + (tonumber(a.age) or 0)) / 1000
			a.expireAt = os.clock() + (expiry - relayNow)
		else
			-- no relay timestamp on this alert: fall back to this device's clock
			local reported = os.time() - math.floor((tonumber(a.age) or 0) / 1000)
			a.expireUnix = (math.floor(reported / period) + 1) * period
		end
	else
		if not sessionEnd or a.born >= sessionEnd then
			sessionEnd = a.born + CONFIG.EXPIRE_SECS
		end
		a.expireAt = sessionEnd
	end

	-- an egg from an earlier cycle (already over) is never listed at all
	if CONFIG.REMOVE_ON_EXPIRE and isExpired(a) then return nil end

	-- clean the name and pin the tier from the table so it can never be mislabelled
	a.egg = tostring(a.egg or "Egg"):gsub("%s+[Ee]gg$", "")
	local mutRaw = a.mutation or a.mutations or a.variety or a.variant or a.mut
	local prefix, rest = splitMutationPrefix(a.egg)
	local mlist = readMutations(mutRaw)
	if prefix then
		a.egg = rest
		if #mlist == 0 then mlist = readMutations(prefix) end
	end
	a.mutList = mlist   -- every variety, in order (two = the clash card)
	do
		local names = {}
		for _, m in ipairs(mlist) do names[#names + 1] = m.name end
		a.mutation = #names > 0 and table.concat(names, ", ") or nil   -- nil when none
	end
	a.tier = PET_TIER[norm(a.egg)] or tostring(a.tier or "")
	auto.observe(a)

	table.insert(alerts, 1, a)
	if FX.min and FX.bump and passes(a) and (tonumber(a.age) or 0) < 8000 then FX.bump() end
	do
		local cap = tonumber(CONFIG.MAX_CARDS) or 0
		if cap > 0 then
			local lowCount = 0
			for _, x in ipairs(alerts) do if LOW_TIER[x.tier] then lowCount = lowCount + 1 end end
			for i = #alerts, 1, -1 do   -- oldest first; top tiers are skipped
				if lowCount <= cap then break end
				if LOW_TIER[alerts[i].tier] then
					removeCard(table.remove(alerts, i))
					lowCount = lowCount - 1
				end
			end
		end
	end
	if not skipSync then syncCards() end
	return a
end

