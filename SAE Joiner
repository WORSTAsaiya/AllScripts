		TextColor3 = C.white, Font = Enum.Font.GothamBlack, TextSize = 22, TextScaled = true, TextWrapped = true,
		TextXAlignment = Enum.TextXAlignment.Center, TextYAlignment = Enum.TextYAlignment.Center, Visible = false,
	}, card)
	mk("UITextSizeConstraint", { MaxTextSize = 24, MinTextSize = 12 }, ui.who)
	ui.input = mk("TextBox", {
		Size = UDim2.new(1, -28, 0, 36), Position = UDim2.new(0, 14, 0, 58), BackgroundColor3 = C.box, Text = "",
		PlaceholderText = "Paste your key here", PlaceholderColor3 = C.ash, TextColor3 = C.white,
		Font = Enum.Font.GothamBold, TextSize = 13, ClearTextOnFocus = false,
	}, card)
	corner(ui.input, 6)
	stroke(ui.input, C.line, 1.5)
	ui.btn = mk("TextButton", {
		Size = UDim2.new(1, -28, 0, 36), Position = UDim2.new(0, 14, 0, 102), BackgroundColor3 = C.light,
		Text = "Login", TextColor3 = C.black, Font = Enum.Font.GothamBlack, TextSize = 14,
	}, card)
	corner(ui.btn, 8)
	ui.status = label(UDim2.new(1, -28, 0, 40), UDim2.new(0, 14, 0, 144), "", C.ash, Enum.Font.GothamBold, 11)
	ui.status.TextWrapped = true
	ui.status.TextYAlignment = Enum.TextYAlignment.Top
	local x = mk("TextButton", {
		Size = UDim2.new(0, 26, 0, 22), Position = UDim2.new(1, -36, 0, 8), BackgroundColor3 = C.line,
		Text = "X", TextColor3 = C.white, Font = Enum.Font.GothamBold, TextSize = 12,
	}, card)
	corner(x, 6)
	x.MouseButton1Click:Connect(function() ACC.hideLogin() end)

	local function submit()
		if ACC.busy then return end
		if ACC.session and not ACC.session.free then ACC.logout("Logged out.") return end
		local t = (ui.input.Text or ""):gsub("%s+", "")
		if t == "" then ACC.say("Enter your key first.", true) return end
		ACC.busy = true
		ui.btn.Text = "Checking..."
		ACC.say("Checking key...", false)
		task.spawn(function()
			local ok, err = ACC.login(t)
			ACC.busy = false
			ui.btn.Text = "Login"
			if ok then
				ui.input.Text = ""
				ACC.hideLogin()
				ACC.afterKey()
			else
				ACC.say(err or "Login failed.", true)
			end
		end)
	end
	ui.btn.MouseButton1Click:Connect(submit)
	ui.input.FocusLost:Connect(function(enter) if enter and (not ACC.session or ACC.session.free) then submit() end end)
	ui.items = collect(dim)
	ACC.ui = ui
	return ui
end

ACC.hideLogin = function()
	local ui = ACC.ui
	if not ui or not ui.open then return end
	ui.open = false
	fadeItems(ui.items, 0.16, true, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
	tween(ui.scale, 0.18, { Scale = 0.8 }, Enum.EasingStyle.Back, Enum.EasingDirection.In)
	task.delay(0.2, function()
		if not ui.open then ui.dim.Visible = false end
	end)
end

-- Only opened by the player (STATUS / Login button). Messages that come up while the window is
-- closed (bad saved key, kicked, time ran out, free unreachable) wait in ACC.pending and are shown
-- the next time the player presses Login.
ACC.notifyLogin = function(msg, prefill)
	if ACC.ui and ACC.ui.open then
		ACC.showLogin(msg, prefill)            -- already open: just refresh it in place
	else
		ACC.pending = { msg = msg, prefill = prefill }
	end
end

ACC.showLogin = function(msg, prefill)
	local ui = ACC.build()
	if not ui.open then
		ui.open = true
		ui.dim.Visible = true
		setAlpha(ui.items, true)
		ui.scale.Scale = 0.8
		fadeItems(ui.items, 0.2, false)
		tween(ui.scale, 0.3, { Scale = 1 }, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
	end
	if msg == nil and prefill == nil and ACC.pending then
		msg, prefill = ACC.pending.msg, ACC.pending.prefill
	end
	ACC.pending = nil
	local on = ACC.session ~= nil and not ACC.session.free
	ui.title.Text = on and "ACCOUNT" or "LOGIN"
	ui.input.Visible = not on
	ui.btn.Text = on and "Log out" or "Login"
	if prefill and not on then ui.input.Text = prefill end
	if on then
		local S = ACC.session
		ui.sub.Text = ""
		ui.who.Visible = true
		if S.unlimited then ui.who.Text = "Logged in\nNo time limit"
		elseif S.name and S.name ~= "" then ui.who.Text = "Logged in as:\n" .. S.name
		else ui.who.Text = "Logged in" end
		local b = S.bots
		local n = (type(b) == "table") and tonumber(b.total) or nil
		ACC.say(n and ("You have " .. tostring(n) .. (n == 1 and " bot" or " bots")) or "", false)
		ui.status.TextXAlignment = Enum.TextXAlignment.Center
		ui.status.TextSize = 14
		ui.status.TextColor3 = C.white
	else
		ui.who.Visible = false
		ui.status.TextXAlignment = Enum.TextXAlignment.Left
		ui.status.TextSize = 11
		local isFree = ACC.session ~= nil and ACC.session.free == true
		ui.sub.Text = isFree and "Free version. Enter a key for full access." or "Enter the key you were given."
		local cap = isFree and tonumber(ACC.session.freeMax) or nil
		local capText = (cap and cap > 0 and cap < 1e18) and ("Free: eggs up to $" .. fmt(cap) .. "/s, shown a moment late.") or "Free: shown a moment late."
		if (msg == nil or msg == "") and isFree then ACC.say(capText, false)
		else ACC.say(msg or "", msg ~= nil and msg ~= "") end
	end
end

-- hopper account detected while running: stop every feed and remove the window completely
ACC.killHopper = function()
	if stopped then return end
	stopped = true
	ACC.gen = ACC.gen + 1
	env.EGG_HUB_RUNNING = nil
	env.EGG_HUB_SYNC = nil
	warn("[Joiner] This account runs SAE HOPPERS - the Joiner can't be used here.")
	pcall(function() gui:Destroy() end)
end

ACC.device = ACC.getDevice()
task.spawn(function()
	while not stopped do
		task.wait(5)
		if hopperRunning() then
			stopped = true
			env.EGG_HUB_RUNNING = nil
			env.EGG_HUB_SYNC = nil
			warn("[Joiner] SAE HOPPERS started on this device - closing the Joiner.")
			pcall(function() gui:Destroy() end)
			break
		end
	end
end)
