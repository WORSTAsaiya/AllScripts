local function loadSettings()
	local fromHop = type(env.EGG_JOIN_SETTINGS) == "table"
	local t = env.EGG_JOIN_SETTINGS
	env.EGG_JOIN_SETTINGS = nil
	if type(t) ~= "table" then
		local ok, d = pcall(function()
			if type(isfile) == "function" and type(readfile) == "function" and isfile(SETTINGS_FILE) then
				return HttpService:JSONDecode(readfile(SETTINGS_FILE))
			end
		end)
		t = (ok and type(d) == "table") and d or nil
	end
	if t then
		auto.on = t.autoOn == true
		auto.mode = (t.autoMode == "once" or t.autoMode == "farm") and t.autoMode or (auto.on and "once" or nil)
		auto.farmCycle = tonumber(t.farmCycle)
		auto.minValue = tonumber(t.autoMin) or 0
		filters.minValue = tonumber(t.showMin) or 0
		if type(t.rarity) == "string" then filters.rarity = t.rarity end
		if t.sort == "value" or t.sort == "newest" then filters.sort = t.sort end
	end
	-- these settings were carried over by a hop: Auto Join turns itself off so it
	-- cannot hop away while you are stealing the egg
	-- ONCE: done after this join (mode cleared). FARM: stays in farm mode but WAITING for the next cycle.
	if fromHop and auto.on then
		auto.on = false
		if auto.mode == "once" then auto.mode = nil end
		saveSettings()
	end
end

