local auto       = { on = false, minValue = 0, mode = nil, farmCycle = nil }
-- cycle number of an alert, on the relay's clock when it has one (this device's clock can be off)
auto.cycleOf = function(a)
	local period = tonumber(CONFIG.CYCLE_SECS) or 300
	local ms = tonumber(a.found) or tonumber(a.ts)
	if ms then return math.floor(ms / 1000 / period) end
	if a.expireUnix then return math.floor(a.expireUnix / period) - 1 end
	return math.floor(os.time() / period)
end
-- seconds left until this alert's cycle ends (same source as isExpired)
auto.secsLeft = function(a)
	if a.expireUnix ~= nil then return a.expireUnix - os.time() end
	if a.expireAt ~= nil then return a.expireAt - os.clock() end
	return math.huge
end
