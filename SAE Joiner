		Text = titleText, TextColor3 = C.ash, Font = Enum.Font.GothamBold, TextSize = 11,
		TextXAlignment = Enum.TextXAlignment.Left,
	}, frame)
	local valueLabel = mk("TextLabel", {
		Size = UDim2.new(0.5, -12, 0, 20), Position = UDim2.new(0.5, 0, 0, 8), BackgroundTransparency = 1,
		Text = "0", TextColor3 = C.white, Font = Enum.Font.GothamBlack, TextSize = 16,
		TextXAlignment = Enum.TextXAlignment.Right,
	}, frame)

	local area = mk("Frame", { Size = UDim2.new(1, -28, 0, 44), Position = UDim2.new(0, 14, 0, 38), BackgroundTransparency = 1 }, frame)
	local track = mk("Frame", { Size = UDim2.new(1, 0, 0, 8), Position = UDim2.new(0, 0, 0, 8), BackgroundColor3 = C.track }, area)
	corner(track, 4)
	local fill = mk("Frame", { Size = UDim2.new(0, 0, 1, 0), BackgroundColor3 = C.ashLite }, track)
	corner(fill, 4)

	for _, t in ipairs({ { "0", 0, 0 }, { "M", valueToPos(1e6), 0.5 }, { "B", valueToPos(1e9), 0.5 }, { "T", valueToPos(1e12), 0.5 }, { "Qa", 1, 1 } }) do
		mk("TextLabel", {
			Size = UDim2.new(0, 24, 0, 14), Position = UDim2.new(t[2], 0, 0, 26), AnchorPoint = Vector2.new(t[3], 0),
			BackgroundTransparency = 1, Text = t[1], TextColor3 = C.ash,
			Font = Enum.Font.GothamBold, TextSize = 10,
		}, area)
	end

	local knob = mk("Frame", {
		Size = UDim2.new(0, 22, 0, 22), AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.new(0, 0, 0, 12),
		BackgroundColor3 = C.white,
	}, area)
	corner(knob, 11)
	stroke(knob, C.ash, 3)
	pop.items = collect(frame)

	local pos = 0
	local function setPos(p)
		pos = math.clamp(p, 0, 1)
		knob.Position = UDim2.new(pos, 0, 0, 12)
		fill.Size = UDim2.new(pos, 0, 1, 0)
		local v = posToValue(pos)
		valueLabel.Text = fmt(v) .. "/s"
		onValue(v)
	end

	local dragging, lastLive = false, 0
	local function fromInput(i)
		local w = area.AbsoluteSize.X
		if w <= 0 then return end
		setPos((i.Position.X - area.AbsolutePosition.X) / w)
		-- act WHILE dragging (throttled so phones don't lag)
		if onLive and os.clock() - lastLive > 0.06 then
			lastLive = os.clock()
			onLive()
		end
	end
	area.InputBegan:Connect(function(i)
		if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
			dragging = true
			fromInput(i)
		end
	end)
	UIS.InputChanged:Connect(function(i)
		if dragging and (i.UserInputType == Enum.UserInputType.MouseMovement or i.UserInputType == Enum.UserInputType.Touch) then
			fromInput(i)
		end
	end)
	UIS.InputEnded:Connect(function(i)
		if dragging and (i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch) then
			dragging = false
			onValue(posToValue(pos))
			if onDone then onDone() end
		end
	end)

	return pop, setPos
end

