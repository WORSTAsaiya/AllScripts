-- true once the shared "eggs disappear" deadline of this alert's session has passed
local function isExpired(a)
	if a.expireUnix ~= nil then
		return os.time() >= a.expireUnix   -- cycle sync: the wall-clock boundary has passed
	end
	return a.expireAt ~= nil and os.clock() >= a.expireAt
end

local function styleExpired(e)
	e.expired = true
	e.join.BackgroundColor3 = C.track
	e.join.TextColor3 = C.ash
	e.join.AutoButtonColor = false
	e.join.Active = false
	if e.img then e.img.ImageColor3 = Color3.fromRGB(95, 95, 100) end
end

local function passes(a)
	if (a.valueNum or 0) < filters.minValue then return false end
	local r = filters.rarity
	if r == "RareTop" then
		if not RARITY.top[a.tier] then return false end
	elseif r ~= "All" and a.tier ~= r then
		return false
	end
	return true
end

