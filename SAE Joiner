-- moves the joiner window down while the banner would cover it, and back up afterwards
ACC.banShift = function(want)
	local b = ACC.ban
	if not b then return end
	local cur = b.shift or 0
	local need = 0
	if want and main.Visible and b.frame.Visible then
		local cam = workspace.CurrentCamera
		local vp = cam and cam.ViewportSize or Vector2.new(1280, 720)
		local bw, bh = b.frame.AbsoluteSize.X, b.frame.AbsoluteSize.Y
		local bLeft, bBottom = vp.X / 2 - bw / 2, 10 + bh + 8
		local mPos, mSize = main.AbsolutePosition, main.AbsoluteSize
		local top = mPos.Y - cur
		if mPos.X < bLeft + bw and mPos.X + mSize.X > bLeft and top < bBottom then need = math.ceil(bBottom - top) end
	end
	if need == cur then return end
	b.shift = need
	tween(main, 0.25, { Position = main.Position + UDim2.new(0, 0, 0, need - cur) })
end

ACC.banner = function(kind, opts)
	if stopped or CONFIG.DEMO then return end
	opts = opts or {}
	local b = ACC.banBuild()
	b.gen = (b.gen or 0) + 1
	local gen = b.gen
	b.kind = kind
	local link, body, note = nil, "", ""
	if kind == "verifying" then
		b.title.Text = "Verifying..."
	elseif kind == "verified" then
		b.title.Text = "Verified!"
		body = (opts.name and opts.name ~= "") and ("Hello <b>" .. ACC.rt(opts.name) .. "</b>") or "Welcome back"
	elseif kind == "expired" then
		b.title.Text = "Key expired"
		body = ((opts.name and opts.name ~= "") and ("<b>" .. ACC.rt(opts.name) .. "</b> your key has expired.") or "Your key has expired.")
			.. " Renew or keep using the free version."
		link = "Renew at <u>" .. ACC.SHOP_URL .. "</u>"
		note = "Tap the link to copy it."
	elseif kind == "welcome" then
		local S = ACC.session or {}
		local max = tonumber(S.freeMax) or 0
		local delay = (tonumber(S.delayMs) or 0) / 1000
		local delayText = delay > 0 and (("%g"):format(math.floor(delay * 10 + 0.5) / 10) .. "s") or "no delay"
		b.title.Text = "Hello <b>" .. ACC.rt(LocalPlayer.Name) .. "</b> and thank you for running WORST - Egg Finder"
		body = (max >= 1e18)
			and ("You are currently on <b>Free Mode</b> and can see every egg with a delay of <b>" .. delayText .. "</b>.")
			or ("You are currently on <b>Free Mode</b> and can only see up to <b>$" .. fmt(max) .. "/s</b> with a delay of <b>" .. delayText .. "</b>.")
		link = "If you wish to purchase premium, visit <u>" .. ACC.SHOP_URL .. "</u>"
		note = "Tap the link to copy it."
	else -- "free"
		b.title.Text = "You are on Free mode"
		link = "Visit <u>" .. ACC.SHOP_URL .. "</u> to purchase one"
		note = "Tap the link to copy it."
	end
	b.body.Text, b.body.Visible = body, body ~= ""
	b.link.Text, b.link.Visible = link or "", link ~= nil
	b.noteText = note
	b.note.Text, b.note.TextColor3, b.note.Visible = note, C.ashLite, note ~= ""

	-- size: phones keep the normal size, bigger screens (PC) scale it up so it is easy to read
	local cam = workspace.CurrentCamera
	local vp = cam and cam.ViewportSize or Vector2.new(1280, 720)
	local sc = math.clamp(vp.Y / 720, 1, 1.45)
	b.scale.Scale = sc
	b.frame.Size = UDim2.new(0, math.min(520, (vp.X - 24) / sc), 0, 0)
	if not b.frame.Visible then
		b.frame.Position = UDim2.new(0.5, 0, 0, -160)
		b.frame.Visible = true
		tween(b.frame, 0.35, { Position = UDim2.new(0.5, 0, 0, 10) }, Enum.EasingStyle.Back)
	end
	task.delay(0.05, function() if b.gen == gen then ACC.banShift(true) end end)

	if kind == "verifying" then   -- animated dots while the relay answers
		task.spawn(function()
			local n = 0
			while b.gen == gen and not stopped do
				n = n % 3 + 1
				b.title.Text = "Verifying" .. string.rep(".", n)
				task.wait(0.35)
			end
		end)
	end
	if opts.hideAfter then
		task.delay(opts.hideAfter, function() if b.gen == gen then ACC.bannerHide() end end)
	end
end

ACC.bannerHide = function()
	local b = ACC.ban
	if not b or not b.frame.Visible then return end
	b.gen = (b.gen or 0) + 1
	b.kind = nil
	local gen = b.gen
	ACC.banShift(false)
	tween(b.frame, 0.25, { Position = UDim2.new(0.5, 0, 0, -(b.frame.AbsoluteSize.Y + 30)) }, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
	task.delay(0.27, function() if b.gen == gen then b.frame.Visible = false end end)
end

