-- ...and only then check the saved key, so no card exists yet to be caught by it
task.spawn(function()
	if CONFIG.DEMO then
		ACC.checking = false
		ACC.session = { token = "demo", unlimited = true, expireClock = 0 }
		ACC.refreshStatus()
		syncCards()
		return runDemo()
	end
	local first = ACC.firstRun()
	ACC.banner("verifying")
	local saved = ACC.readToken()
	if saved then
		local ok, err, rejected = ACC.login(saved)
		if ok then ACC.afterKey() return end
		if rejected then ACC.clearToken() end
		if rejected and tostring(err):lower():find("expired", 1, true) then
			local last = ACC.readLastKey()
			last.expired = true
			ACC.writeLastKey(last)
		end
		ACC.startFree()   -- a bad or expired key falls back to the free version
		ACC.checking = false
		ACC.refreshStatus()
		syncCards()
		ACC.bannerForFree(false)
		ACC.notifyLogin(err, (not rejected) and saved or nil)   -- no pop up on execute: waits for the Login button
	else
		local okF, errF = ACC.startFree()
		ACC.checking = false
		ACC.refreshStatus()
		syncCards()
		ACC.bannerForFree(first)
		if not okF then ACC.showLogin(errF) end   -- the login window only pops up if free is off or unreachable
	end
end)
