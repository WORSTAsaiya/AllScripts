local POPUP_Y = 122   -- popups open just under the second row

-- onValue(v)  every time the value changes (also while dragging)
-- onLive()    while dragging, throttled      onDone()  when the finger lets go
local function makeSlider(titleText, onValue, onLive, onDone)
	local frame = mk("Frame", {
		Size = UDim2.new(1, -16, 0, 98), Position = UDim2.new(0, 8, 0, POPUP_Y), BackgroundColor3 = C.popup,
		Visible = false, ZIndex = 20,
	}, body)
