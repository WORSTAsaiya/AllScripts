-- live "x ago" refresh
task.spawn(function()
	while not stopped do
		if CONFIG.REMOVE_ON_EXPIRE then
			for i = #alerts, 1, -1 do   -- cycle over: the card slides out (one at a time) and the egg is forgotten
				local a = alerts[i]
				if isExpired(a) then
					FX.queueRemove(a)
					table.remove(alerts, i)
				end
			end
		end
		for a, e in pairs(cards) do
			if e.sub and e.sub.Parent then e.sub.Text = metaText(a) end
			if not e.expired and isExpired(a) then styleExpired(e) end
		end
		ACC.refreshStatus()
		if FX.dot then FX.dot.BackgroundColor3 = (ACC.session and not ACC.connBad) and Color3.fromRGB(90, 255, 150) or C.ash end
		local S = ACC.session
		if S and not S.unlimited and os.clock() >= S.expireClock and ACC.logout then ACC.logout("Your time has run out.") end
		task.wait(1)
	end
end)

-- --------------------------------------------------------------- data sources
ACC.q = function(v) return HttpService:UrlEncode(tostring(v)) end
-- a feed lives only while a login is active and nothing newer (another login / a logout) has started since
ACC.live = function(g) return not stopped and ACC.session ~= nil and g == ACC.gen end
ACC.setLeft = function(sec, bots, name)
	local S = ACC.session
	if not S then return end
	if tonumber(sec) then S.unlimited = false; S.expireClock = os.clock() + tonumber(sec) end
	if type(bots) == "table" then S.bots = bots end
	if type(name) == "string" then S.name = name end
	ACC.refreshStatus()
end

local function handleMessage(raw)
	local ok, d = pcall(function() return HttpService:JSONDecode(raw) end)
	if not ok or type(d) ~= "table" then return end
	if d.type == "kicked" then
		if tostring(d.reason or ""):find("Hopper accounts", 1, true) then return ACC.killHopper() end
		local S = ACC.session
		if S and S.free then ACC.logout(tostring(d.reason or "Logged out."), true, true)   -- free is off / full: ask for a key
		else ACC.logout(tostring(d.reason or "Logged out.")) end
	elseif not ACC.session then
		return
	elseif d.type == "status" then
		if d.freeMax and ACC.session.free then ACC.session.freeMax = tonumber(d.freeMax) end
		ACC.setLeft(d.secondsLeft, d.bots, d.label)
	elseif d.type == "history" and type(d.alerts) == "table" then
		local before = #alerts
		for i = #d.alerts, 1, -1 do addAlert(d.alerts[i], true) end
		syncCards()
		if CONFIG.DEBUG_LATENCY then print(("[history] relay sent %d alert(s), %d are still live and listed"):format(#d.alerts, #alerts - before)) end
	elseif d.type == "alert" then
		local a = addAlert(d.alert)
		if a then tryAutoJoin(a) end
	end
end

local function runWebSocket(gen)
	local S = ACC.session
	if not (S and WebSocket and WebSocket.connect) then return false end
	local url = ("%s/?key=%s&dev=%s&player=%s"):format(CONFIG.HUB_WS, ACC.q(S.token), ACC.q(ACC.device), ACC.q(LocalPlayer.Name))
	local ok, ws = pcall(WebSocket.connect, url)
	if not ok or not ws then return false end
	setHub("LIVE", true)
	wsLive = true
	local closed = false
	ws.OnMessage:Connect(function(raw) if gen == ACC.gen then handleMessage(raw) end end)
	ws.OnClose:Connect(function() closed = true end)
	while not closed and ACC.live(gen) do task.wait(0.5) end
	if not closed then pcall(function() ws:Close() end) end
	wsLive = false
	if ACC.live(gen) then setHub("RECONNECT", false) end
	return true
end

local pollPrimed = false
local function runPolling(seconds, gen)
	if not reqFn then return end
	local t0 = os.clock()
	setHub("POLL", true)
	while ACC.live(gen) and os.clock() - t0 < seconds do
		local S = ACC.session
		local ok, res = pcall(reqFn, {
			Url = ("%s/recent?key=%s&dev=%s&player=%s&since=%d"):format(CONFIG.HUB_HTTP, ACC.q(S.token), ACC.q(ACC.device), ACC.q(LocalPlayer.Name), lastId),
			Method = "GET",
		})
		if ok and res and res.StatusCode == 403 then ACC.killHopper() return end
		if ok and res and res.StatusCode == 401 then
			if ACC.live(gen) then ACC.logout("Session ended. Log in again.") end
			return
		end
		if ok and res and res.StatusCode == 200 and ACC.live(gen) then
			local okj, d = pcall(function() return HttpService:JSONDecode(res.Body) end)
			if okj and type(d) == "table" and type(d.alerts) == "table" then
				ACC.setLeft(d.secondsLeft)
				local fresh = {}
				for _, a in ipairs(d.alerts) do
					local added = addAlert(a, true)
					if added then fresh[#fresh + 1] = added end
				end
				syncCards()
				if pollPrimed then
					for _, a in ipairs(fresh) do tryAutoJoin(a) end
				end
				pollPrimed = true
			end
			setHub("POLL", true)
		elseif not ok or not res or res.StatusCode ~= 200 then
			setHub("OFFLINE", false)
		end
		task.wait(0.4)
	end
end

-- One quick HTTP pull of everything newer than lastId. Used at startup (so the list fills
-- the moment you log in, without waiting for the WebSocket) and as a bridge while
-- the WebSocket is still connecting or reconnecting. Duplicates are ignored by id.
local function pull(autoJoin, gen)
	local S = ACC.session
	if not (reqFn and S and ACC.live(gen)) then return end
	local ok, res = pcall(reqFn, {
		Url = ("%s/recent?key=%s&dev=%s&player=%s&since=%d"):format(CONFIG.HUB_HTTP, ACC.q(S.token), ACC.q(ACC.device), ACC.q(LocalPlayer.Name), lastId),
		Method = "GET",
	})
	if ok and res and res.StatusCode == 403 then ACC.killHopper() return end
	if ok and res and res.StatusCode == 401 then
		if ACC.live(gen) then ACC.logout("Session ended. Log in again.") end
		return
	end
	if not (ok and res and res.StatusCode == 200 and ACC.live(gen)) then return end
	local okj, d = pcall(function() return HttpService:JSONDecode(res.Body) end)
	if not (okj and type(d) == "table" and type(d.alerts) == "table") then return end
	ACC.setLeft(d.secondsLeft)
	local fresh = {}
	for _, a in ipairs(d.alerts) do
		local added = addAlert(a, true)
		if added then fresh[#fresh + 1] = added end
	end
	if #fresh > 0 then
		syncCards()
		if autoJoin then for _, a in ipairs(fresh) do tryAutoJoin(a) end end
	end
end

